    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :salesRestrictions ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :salesRestrictions ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_SalesAvailabilityConstraintDef ] .

:TrainLinkDef a owl:Class ;
