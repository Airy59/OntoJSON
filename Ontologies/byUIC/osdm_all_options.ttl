            owl:allValuesFrom :TrainResourceLocationDef ;
            owl:onProperty :trainLocations ],
        [ a owl:Restriction ;
            owl:allValuesFrom :CarrierResourceLocationDef ;
            owl:onProperty :carrierLocations ] .

