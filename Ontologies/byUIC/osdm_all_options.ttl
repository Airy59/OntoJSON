    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://example.org/ontology#individual/MONTHS> <http://example.org/ontology#individual/DAYS> <http://example.org/ontology#individual/HOURS> <http://example.org/ontology#individual/MINUTES> ) ] .

:TrainResourceLocationDef a owl:Class ;
    rdfs:label "TrainResourceLocationDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :carrier_TrainResourceLocationDef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :onlineResource_TrainResourceLocationDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :trainId ],
        [ a owl:Restriction ;
            owl:allValuesFrom :OnlineResourceDef ;
            owl:onProperty :onlineResource_TrainResourceLocationDef ] .

:TravelClassDef a owl:Class ;
    rdfs:label "TravelClassDef" ;
    rdfs:comment "Generic class classification, mostly used to harmonize choice and representation across multiple carriers" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://example.org/ontology#individual/FIRST> <http://example.org/ontology#individual/SECOND> <http://example.org/ontology#individual/ANY_CLASS> ) ] .

:TripAllocationConstraintDef a owl:Class ;
    rdfs:label "TripAllocationConstraintDef" ;
    rdfs:comment "constraint on the use of a multiple trip ticket" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :allocationUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom :TripAllocationProcess ;
            owl:onProperty :requiredProcesses_TripAllocationConstraintDef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :requiredProcesses_TripAllocationConstraintDef ] .

:TripInterruptionConstraintDef a owl:Class ;
    rdfs:label "TripInterruptionConstraintDef" ;
    rdfs:comment "rules on allowed trip interruptions. Interruptions due to a train change  indicated by a trip search must not be included here." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :TripInterruptionProcess ;
            owl:onProperty :requiredProcesses_TripInterruptionConstraintDef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :requiredProcesses_TripInterruptionConstraintDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :maxInterruptions ] .

:VatScopeDef a owl:Class ;
    rdfs:label "VatScopeDef" ;
    rdfs:comment "scope where the VAT applies" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://example.org/ontology#individual/INTERNATIONAL> <http://example.org/ontology#individual/NATIONAL> <http://example.org/ontology#individual/SHORT_DISTANCE> <http://example.org/ontology#individual/LONG_DISTANCE> ) ] .

:CurrencyPriceDef a owl:Class ;
    rdfs:label "CurrencyPriceDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom :VatDetailDef ;
            owl:onProperty :vatDetails ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :amount_CurrencyPriceDef ] .

:FareTypeDef a owl:Class ;
    rdfs:label "FareTypeDef" ;
    rdfs:comment "UIC fare types" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://example.org/ontology#individual/ADMISSION> <http://example.org/ontology#individual/RESERVATION> <http://example.org/ontology#individual/INTEGRATED_RESERVATION> <http://example.org/ontology#individual/ANCILLARY> ) ] .

:ServiceClassDefinitionDef a owl:Class ;
    rdfs:label "ServiceClassDefinitionDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_ServiceClassDefinitionDef ] .

:carrier a owl:ObjectProperty ;
    rdfs:label "carrier" .

:AfterSalesRuleDef a owl:Class ;
    rdfs:label "AfterSalesRuleDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :transactionType ] .

:BarCodeTypesDef a owl:Class ;
    rdfs:label "BarCodeTypesDef" ;
    rdfs:comment "Item according to IRS 90918-9: FCB, TLB, SSB" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://example.org/ontology#individual/FCB> <http://example.org/ontology#individual/TLB> <http://example.org/ontology#individual/SSB> ) ] .

:GeoCoordinate a owl:Class ;
    rdfs:label "GeoCoordinate" ;
    rdfs:comment "Used to provide any geo-encoded location, regardless of environment, using longitude and latitude coordinates." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :latitude ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :longitude ] .

:LineDef a owl:Class ;
    rdfs:label "LineDef" ;
    rdfs:comment "terminalStation - in case the product requires a destination within the zone (e.g. local ticket  to go to the main rail station).  entryStation - Station to enter the zone in case the product requires to enter the zone via a  specific station (e.g. local zone ticket to start from the main rail station)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :carrier_LineDef ] .

:LuggageConstraint a owl:Class ;
    rdfs:label "LuggageConstraint" ;
    rdfs:comment "constraints on luggage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :LuggageRestriction ;
            owl:onProperty :restrictedLuggageItems ],
        [ a owl:Restriction ;
            owl:allValuesFrom :LuggageRestrictionRule ;
            owl:onProperty :luggageRules ] .

:ReservationParameterDef a owl:Class ;
    rdfs:label "ReservationParameterDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_ReservationParameterDef ] .

:ServiceBrandCodeDef a owl:Class ;
    rdfs:label "ServiceBrandCodeDef" ;
    rdfs:comment "Service brand codes allowed in response, code list can be found on  [https:/uic.org/passenger/passenger-services-group/article/service-brand-code-list] (https:/uic.org/passenger/passenger-services-group/article/service-brand-code-list)" .

:ServiceConstraintDef a owl:Class ;
    rdfs:label "ServiceConstraintDef" ;
    rdfs:comment "Either excluded or included service brands can be set." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_ServiceConstraintDef ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ServiceBrandCodeDef ;
            owl:onProperty :excludedServiceBrands ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ServiceBrandCodeDef ;
            owl:onProperty :includedServiceBrands ] .

:ServiceLevelDef a owl:Class ;
    rdfs:label "ServiceLevelDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_ServiceLevelDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :textRef_ServiceLevelDef ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ServiceClassIdDef ;
            owl:onProperty :combiningServiceClassIds ] .

:TranslationDef a owl:Class ;
    rdfs:label "TranslationDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :textUtf8_TranslationDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :language ] .

:CalendarDef a owl:Class ;
    rdfs:label "CalendarDef" ;
    rdfs:comment "calendar" .

:ConnectionPointDef a owl:Class ;
    rdfs:label "ConnectionPointDef" ;
    rdfs:comment "connection point connecting two fare regimes. The connection is possible between stations of the two provided station sets." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :stationSets ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_ConnectionPointDef ] .

:FareReferenceStationSetDef a owl:Class ;
    rdfs:label "FareReferenceStationSetDef" ;
    rdfs:comment "set of stations used in the fare equivalently. E.g. Brussels-Region). The set is identified by the fare provider and a code unique within the fare provider." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :code_FareReferenceStationSetDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :fareProvider_FareReferenceStationSetDef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :stations_FareReferenceStationSetDef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :stations_FareReferenceStationSetDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :legacyCode_FareReferenceStationSetDef ],
        [ a owl:Restriction ;
            owl:allValuesFrom :StationDef ;
            owl:onProperty :stations_FareReferenceStationSetDef ] .

:LegacyReservationParameterDef a owl:Class ;
    rdfs:label "LegacyReservationParameterDef" ;
    rdfs:comment "reservation parameter to support the UIC 90918-1 interface for booking" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :serviceLevelCode ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :serviceCode ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :travelClass_LegacyReservationParameterDef ] .

:ReductionCardReferenceDef a owl:Class ;
    rdfs:label "ReductionCardReferenceDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :cardValue ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :cardName ] .

:VatDetailDef a owl:Class ;
    rdfs:label "VatDetailDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :country_VatDetailDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :amount_VatDetailDef ] .

:ZoneDef a owl:Class ;
    rdfs:label "ZoneDef" ;
    rdfs:comment "carrier - carrier responsible for the transport. entryStation - Station to enter the zone in case the product requires to enter the zone via a specific station (e.g. local zone ticket to start from the main rail station). terminalStation - Terminal station in case the product requires a destination within the zone (e.g. local ticket to go to the main rail station)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :carrier_ZoneDef ] .

:FareDeliveryDetailsDef a owl:Class ;
    rdfs:label "FareDeliveryDetailsDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :deliveryId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :version_FareDeliveryDetailsDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :fareProvider_FareDeliveryDetailsDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :acceptedVersion ] .

:FulfillmentConstraintDef a owl:Class ;
    rdfs:label "FulfillmentConstraintDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :acceptedControlSecurityTypes ],
        [ a owl:Restriction ;
            owl:allValuesFrom :BarCodeTypesDef ;
            owl:onProperty :acceptedBarCodes ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ControlSecurityTypeDef ;
            owl:onProperty :acceptedControlSecurityTypes ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_FulfillmentConstraintDef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :acceptedControlSecurityTypes ],
        [ a owl:Restriction ;
            owl:allValuesFrom :BarCodeTypesDef ;
            owl:onProperty :requiredBarCodes ] .

:RegionalConstraintDef a owl:Class ;
    rdfs:label "RegionalConstraintDef" ;
    rdfs:comment "regional constraint of the fare-offline bulk data use the id of connection points whereas in an online environment the connection point is included" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :regionalValidity ] .

:ZoneDefinitionDef a owl:Class ;
    rdfs:label "ZoneDefinitionDef" ;
    rdfs:comment "definition of a zone used to define regional validity. The area of the zone can be defined via a geo-polygon, a complete list of all contained stations or area codes from the NUTS code list. The carrier is either the carrier or transport authority responsible for the definition." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :zoneId ],
        [ a owl:Restriction ;
            owl:allValuesFrom :StationDef ;
            owl:onProperty :stationList ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :carrier_ZoneDefinitionDef ] .

:FareCombinationModelDef a owl:Class ;
    rdfs:label "FareCombinationModelDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :CompanyDef ;
            owl:onProperty :combinableCarrier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :model ],
        [ a owl:Restriction ;
            owl:allValuesFrom :CompanyDef ;
            owl:onProperty :allowedAllocators ],
        [ a owl:Restriction ;
            owl:allValuesFrom :CompanyDef ;
            owl:onProperty :allowedDistributors ],
        [ a owl:Restriction ;
            owl:allValuesFrom :CompanyDef ;
            owl:onProperty :allowedCommonContracts ] .

:FulfillmentMediaTypeDef a owl:Class ;
    rdfs:label "FulfillmentMediaTypeDef" ;
    rdfs:comment "Fulfillment types. RCT2, RCCST and UIC-PDF are official UIC standards." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://example.org/ontology#individual/RCT2> <http://example.org/ontology#individual/RCCST> <http://example.org/ontology#individual/UIC_PDF> <http://example.org/ontology#individual/PDF_A4> <http://example.org/ontology#individual/PKPASS> <http://example.org/ontology#individual/TICKETLESS> <http://example.org/ontology#individual/ALLOCATOR_APP> <http://example.org/ontology#individual/SOCIAL_MEDIA_ACCOUNTS> ) ] .

:OnlineResourceDef a owl:Class ;
    rdfs:label "OnlineResourceDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :interfaceType ] .

:ServiceClassIdDef a owl:Class ;
    rdfs:label "ServiceClassIdDef" ;
    rdfs:comment "Level of quality, finer grained than the comfort class." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://example.org/ontology#individual/BEST> <http://example.org/ontology#individual/HIGH> <http://example.org/ontology#individual/STANDARD> <http://example.org/ontology#individual/BASIC> <http://example.org/ontology#individual/ANY_CLASS> ) ] .

:StationNamesDef a owl:Class ;
    rdfs:label "StationNamesDef" ;
    rdfs:comment "station names included temporarily until MERITS can provide the names" .

:TravelValidityConstraintDef a owl:Class ;
    rdfs:label "TravelValidityConstraintDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :validityRange ] .

:ReductionCardDef a owl:Class ;
    rdfs:label "ReductionCardDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :ServiceClassIdDef ;
            owl:onProperty :serviceClasses ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_ReductionCardDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :nameRef_ReductionCardDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :issuer_ReductionCardDef ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ReductionCardReferenceDef ;
            owl:onProperty :includedCards ] .

:PassengerConstraintDef a owl:Class ;
    rdfs:label "PassengerConstraintDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :passengerType ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :nameRef_PassengerConstraintDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_PassengerConstraintDef ] .

:FareConstraintBundle a owl:Class ;
    rdfs:label "FareConstraintBundle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :salesAvailabilityConstraintRef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :defaultFareType ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :combinationConstraintRef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_FareConstraintBundle ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :travelValidityConstraintRef ] .

:TextDef a owl:Class ;
    rdfs:label "TextDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_TextDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :text_TextDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :textUtf8_TextDef ],
        [ a owl:Restriction ;
            owl:allValuesFrom :TranslationDef ;
            owl:onProperty :translations ] .

:ViaStationsDef a owl:Class ;
    rdfs:label "ViaStationsDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :ViaStationsDef ;
            owl:onProperty :alternativeRoute ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ViaStationsDef ;
            owl:onProperty :route ] .

:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "Basic product definition of products. A products covers multiple regional validities, passenger types or reductions. Fares might be included in Products of a distributor depending on the combination models and then loose their original product definition. " ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_Product ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ConditionText ;
            owl:onProperty :conditions ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :name_Product ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :code_Product ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :summary ] .

:StationDef a owl:Class ;
    rdfs:label "StationDef" ;
    rdfs:comment "Used to represent a station location. This is a location that can be used as origin and destination for a train journey" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :country_StationDef ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :code_StationDef ] .

:CompanyDef a owl:Class ;
    rdfs:label "CompanyDef" ;
    rdfs:comment "RICS company code or the upcoming compatible ERA company code. In case proprietary codes are used on a bilateral base the  codes must have at least 5 positions and start with x" .

:FareDef a owl:Class ;
    rdfs:label "FareDef" ;
    rdfs:comment "single fare within a blk fare data delivery" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :fareType ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :bundleRef ],
        [ a owl:Restriction ;
            owl:allValuesFrom :CompanyDef ;
            owl:onProperty :involvedTCOs ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_FareDef ] .

:FareDataDef a owl:Class ;
    rdfs:label "FareDataDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :fareConstraintBundles ],
        [ a owl:Restriction ;
            owl:allValuesFrom :PassengerCombinationConstraintDef ;
            owl:onProperty :passengerCombinationConstraints ],
        [ a owl:Restriction ;
            owl:allValuesFrom :FareConstraintBundle ;
            owl:onProperty :fareConstraintBundles ],
        [ a owl:Restriction ;
            owl:allValuesFrom :RegionalConstraintDef ;
            owl:onProperty :regionalConstraints ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ServiceLevelDef ;
            owl:onProperty :serviceLevelDefinitions ],
        [ a owl:Restriction ;
            owl:allValuesFrom :PriceDef ;
            owl:onProperty :prices ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ZoneDefinitionDef ;
            owl:onProperty :zoneDefinitions ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ConnectionPointDef ;
            owl:onProperty :connectionPoints ],
        [ a owl:Restriction ;
            owl:allValuesFrom :SalesAvailabilityConstraintDef ;
            owl:onProperty :salesAvailabilityConstraint ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :regionalConstraints ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :serviceClassDefinitions ],
        [ a owl:Restriction ;
            owl:allValuesFrom :FareCombinationConstraintDef ;
            owl:onProperty :combinationConstraints ],
        [ a owl:Restriction ;
            owl:allValuesFrom :TravelValidityConstraintDef ;
            owl:onProperty :travelValidityConstraints ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :fares ],
        [ a owl:Restriction ;
            owl:allValuesFrom :CalendarDef ;
            owl:onProperty :calendars ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :calendars ],
        [ a owl:Restriction ;
            owl:allValuesFrom :StationNamesDef ;
            owl:onProperty :stationNames ],
        [ a owl:Restriction ;
            owl:allValuesFrom :AfterSalesConditionDef ;
            owl:onProperty :afterSalesConditions ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ServiceClassDefinitionDef ;
            owl:onProperty :serviceClassDefinitions ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ReservationParameterDef ;
            owl:onProperty :reservationParameters ],
        [ a owl:Restriction ;
            owl:allValuesFrom :FareDef ;
            owl:onProperty :fares ],
        [ a owl:Restriction ;
            owl:allValuesFrom :Product ;
            owl:onProperty :products_FareDataDef ],
        [ a owl:Restriction ;
            owl:allValuesFrom :FareReferenceStationSetDef ;
            owl:onProperty :fareReferenceStationSetDefinitions ],
        [ a owl:Restriction ;
            owl:allValuesFrom :LuggageConstraint ;
            owl:onProperty :luggageConstraints ],
        [ a owl:Restriction ;
            owl:allValuesFrom :TextDef ;
            owl:onProperty :texts ],
        [ a owl:Restriction ;
            owl:allValuesFrom :PassengerConstraintDef ;
            owl:onProperty :passengerConstraints ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ServiceConstraintDef ;
            owl:onProperty :serviceConstraints ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :combinationConstraints ],
        [ a owl:Restriction ;
            owl:allValuesFrom :FulfillmentConstraintDef ;
            owl:onProperty :fulfillmentConstraints ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :fares ],
        [ a owl:Restriction ;
            owl:allValuesFrom :PersonalDataConstraintDef ;
            owl:onProperty :personalDataConstraints ],
        [ a owl:Restriction ;
            owl:allValuesFrom :CarrierConstraintDef ;
            owl:onProperty :carrierConstraints ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ReductionCardDef ;
            owl:onProperty :reductionCards ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :salesAvailabilityConstraint ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :fareConstraintBundles ],
        [ a owl:Restriction ;
            owl:allValuesFrom :ReductionConstraintDef ;
            owl:onProperty :reductionConstraints ] .

