            owl:onProperty :id_AfterSalesConditionDef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :afterSalesRules ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :afterSalesRules ] .

:ComfortClassDef a owl:Class ;
    rdfs:label "ComfortClassDef" ;
    rdfs:comment "Generic class classification, mostly used to harmonize choice and representation across multiple carriers" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://example.org/ontology#individual/FIRST> <http://example.org/ontology#individual/SECOND> <http://example.org/ontology#individual/ANY_CLASS> ) ] .

