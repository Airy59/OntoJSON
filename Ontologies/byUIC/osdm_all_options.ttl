    rdfs:label "PersonalDataConstraintDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :requiredData ] .

:StationResourceLocationDef a owl:Class ;
    rdfs:label "StationResourceLocationDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :OnlineResourceDef ;
            owl:onProperty :onlineResource_StationResourceLocationDef ],
