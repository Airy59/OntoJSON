    rdfs:label "ControlSecurityTypeDef" ;
    rdfs:comment "SIP: secure paper tickets; SID: security in data (signed bar code); SIS: security in system" ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://example.org/ontology#individual/SIP> <http://example.org/ontology#individual/SID> <http://example.org/ontology#individual/SIS> ) ] .

