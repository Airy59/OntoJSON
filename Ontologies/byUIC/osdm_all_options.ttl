            owl:cardinality 1 ;
            owl:onProperty :timeValue ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :timeReference ] .

:SalesAvailabilityConstraintDef a owl:Class ;
