            owl:cardinality 1 ;
            owl:onProperty :fromStation ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :train ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :travelDate ] .

:ValidityRange a owl:Class ;
