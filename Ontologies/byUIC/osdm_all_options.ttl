    rdfs:comment "ISO 3166 2A codes" .

:FareCombinationConstraintDef a owl:Class ;
    rdfs:label "FareCombinationConstraintDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :combinationModels ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :combinationModels ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :id_FareCombinationConstraintDef ],
        [ a owl:Restriction ;
            owl:allValuesFrom :FareCombinationModelDef ;
            owl:onProperty :combinationModels ] .

:FareResourceLocationDef a owl:Class ;
    rdfs:label "FareResourceLocationDef" ;
