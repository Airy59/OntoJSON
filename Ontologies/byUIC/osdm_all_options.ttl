:FareDeliveryDef a owl:Class ;
    rdfs:label "FareDeliveryDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :fareStructure ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :delivery ] .

:FulfillmentOption a owl:Class ;
    rdfs:label "FulfillmentOption" ;
    rdfs:comment "CIT paper implies printing on value paper which is stock controlled." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :FulfillmentMediaTypeDef ;
            owl:onProperty :media ] .

:LuggageRestrictionRule a owl:Class ;
    rdfs:label "LuggageRestrictionRule" ;
    :extensible-enum "['CAN_CARRY']" ;
    rdfs:comment "named luggage restriction rule: CAN_CARRY = weight is ok if you can carry it yourself" .

:PolygonDef a owl:Class ;
    rdfs:label "PolygonDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :GeoCoordinate ;
            owl:onProperty :edge ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :edge ] .

:RegulatoryConditionsDef a owl:Class ;
    rdfs:label "RegulatoryConditionsDef" ;
    rdfs:comment "regulatory condition" .

:ReservationOptionGroupDef a owl:Class ;
    rdfs:label "ReservationOptionGroupDef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :preferenceGroup ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :preferences ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :preferences ] .

:TripAllocationProcess a owl:Class ;
    rdfs:label "TripAllocationProcess" ;
    :extensible-enum "['NONE', 'MANUAL', 'ACTIVATION', 'FULFILLMENT']" ;
    rdfs:comment "NONE: Individual trips don't need to be allocated. MANUAL: The passenger has to allocate a trip manually (This should not be used as it is by desiugn non-interoperable). ACTIVATION: Individual trips can be allocatted by activation of the ticket. FULFILLMENT A new fulfillment needs to be created to allocate a trip" .

:TripInterruptionProcess a owl:Class ;
    rdfs:label "TripInterruptionProcess" ;
    :extensible-enum "['NONE', 'MANUAL', 'ACTIVATION']" ;
    rdfs:comment "MANUAL: passenger needs manual confirmation of train or station staff to interrupt the trip. ACTIVATION: Passenger needs to deactivate the ticket during the interruption (via an app)." .

