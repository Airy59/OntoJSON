@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/ontology> a owl:Ontology ;
    rdfs:label "OSDM Offline Fare Delivery" ;
    :schemaVersion "https://json-schema.org/draft/2020-12/schema" ;
    rdfs:comment "OSDM extract of offline fare delivery" ;
    rdfs:seeAlso "http://uic.org//schemas/passenger/eticket/v4/offlineOSDM.json" .

:TravelerTypeDef a owl:Class ;
    rdfs:label "TravelerTypeDef" ;
    rdfs:comment "Subset of the values from the traveler type code list IRS 90918-10 " .

:accuracy a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "accuracy" ;
    rdfs:comment "to be provided in degree." ;
    rdfs:domain :GeoCoordinate ;
    rdfs:range xsd:decimal .

:addId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "addId" ;
    rdfs:comment "sequential number of regional validities (leading positions in case the series is too short" ;
    rdfs:domain :LegacyAccountingIdentifierDef ;
    rdfs:range xsd:integer .

:afterSalesRulesRef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "afterSalesRulesRef" ;
    rdfs:domain :FareDef ;
    rdfs:range xsd:string .

:ageLimitForReservation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ageLimitForReservation" ;
    rdfs:domain :PassengerConstraintDef ;
    rdfs:range xsd:integer .

:ageLimitToTravelAlone a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ageLimitToTravelAlone" ;
    rdfs:domain :PassengerConstraintDef ;
    rdfs:range xsd:integer .

:allowedChanges a owl:ObjectProperty ;
    rdfs:label "allowedChanges" ;
    rdfs:domain :PersonalDataConstraintDef ;
    rdfs:range :AllowedChangesItem .

:allowedClusters a owl:DatatypeProperty ;
    rdfs:label "allowedClusters" ;
    rdfs:comment "In case of CLUSTERING model: the other clusters that allow a combination" ;
    rdfs:domain :FareCombinationModelDef ;
    rdfs:range xsd:string .

:applicationTime a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "applicationTime" ;
    rdfs:domain :AfterSalesRuleDef ;
    rdfs:range :RelativeTimeDef .

:berthType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "berthType" ;
    rdfs:domain :LegacyReservationParameterDef ;
    rdfs:range xsd:string .

:binaryLineId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "binaryLineId" ;
    rdfs:comment "Id to support local traffic standards (e.g. VDV,...)." ;
    rdfs:domain :LineDef ;
    rdfs:range xsd:string .

:binaryZoneId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "binaryZoneId" ;
    rdfs:comment "Id to support local traffic standards (e.g. VDV,...)" ;
    rdfs:domain :ZoneDef ;
    rdfs:range xsd:string .

:cardIdRequired a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "cardIdRequired" ;
    rdfs:comment "the card id must be delivered in online sales " ;
    rdfs:domain :ReductionCardDef ;
    rdfs:range xsd:boolean .

:cardValueType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "cardValueType" ;
    rdfs:comment "code list for the cardValue provided" ;
    rdfs:domain :ReductionCardReferenceDef ;
    rdfs:range xsd:string .

:carrierConstraintRef_FareDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "carrierConstraintRef" ;
    rdfs:domain :FareDef ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :carrierConstraintRef .

:carrierConstraintRef_ViaStationsDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "carrierConstraintRef" ;
    rdfs:comment "restriction to a specific carriers" ;
    rdfs:domain :ViaStationsDef ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :carrierConstraintRef .

:carrierConstraintText a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "carrierConstraintText" ;
    rdfs:comment "carrier constraint description of the entire product, not including restrictions based on routes or trips." ;
    rdfs:domain :Product ;
    rdfs:range :TextDef .

:carrier_ViaStationsDef a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "carrier" ;
    rdfs:domain :ViaStationsDef ;
    rdfs:range :CompanyDef ;
    rdfs:subPropertyOf :carrier .

:city_LineDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "city" ;
    rdfs:domain :LineDef ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :city .

:city_ZoneDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "city" ;
    rdfs:domain :ZoneDef ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :city .

:coachTypeCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "coachTypeCode" ;
    rdfs:domain :LegacyReservationParameterDef ;
    rdfs:range xsd:string .

:codeList a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "codeList" ;
    rdfs:domain :StationDef ;
    rdfs:range :StationCodeListDef .

:code_StationNamesDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "code" ;
    rdfs:comment "code " ;
    rdfs:domain :StationNamesDef ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :code .

:combinationConstraint a owl:ObjectProperty ;
    rdfs:label "combinationConstraint" ;
    rdfs:comment "constraints on accompanying passengers" ;
    rdfs:domain :PassengerConstraintDef ;
    rdfs:range :CombinationConstraintItem .

:comfortClass a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "comfortClass" ;
    rdfs:domain :ServiceClassDefinitionDef ;
    rdfs:range :ComfortClassDef .

:compartmentTypeCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "compartmentTypeCode" ;
    rdfs:domain :LegacyReservationParameterDef ;
    rdfs:range xsd:string .

:connectionPointIds a owl:DatatypeProperty ;
    rdfs:label "connectionPointIds" ;
    rdfs:domain :StationResourceLocationDef ;
    rdfs:range xsd:string .

:country_StationNamesDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "country" ;
    rdfs:comment "uic country code" ;
    rdfs:domain :StationNamesDef ;
    rdfs:range xsd:integer .

:dates a owl:DatatypeProperty ;
    rdfs:label "dates" ;
    rdfs:comment "dates included in the calendar. In case no dates are provided the range is assumed to be valid" ;
    rdfs:domain :CalendarDef ;
    rdfs:range xsd:string .

:defaultCarrierConstraintRef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "defaultCarrierConstraintRef" ;
    rdfs:comment "CarrierConstraint" ;
    rdfs:domain :FareConstraintBundle ;
    rdfs:range xsd:string .

:defaultLuggageConstraintRef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "defaultLuggageConstraintRef" ;
    rdfs:domain :FareConstraintBundle ;
    rdfs:range xsd:string .

:defaultRegulatoryConditions a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "defaultRegulatoryConditions" ;
    rdfs:domain :FareConstraintBundle ;
    rdfs:range :RegulatoryConditionsDef .

:description_Product a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "description" ;
    rdfs:comment "Detailed description of the product." ;
    rdfs:domain :Product ;
    rdfs:range :TextDef ;
    rdfs:subPropertyOf :description .

:distance a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "distance" ;
    rdfs:comment "distance in km for statistics " ;
    rdfs:domain :RegionalConstraintDef ;
    rdfs:range xsd:integer .

:doesNotIncludeClassName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "doesNotIncludeClassName" ;
    rdfs:comment "indicates that the class name is not included" ;
    rdfs:domain :ServiceLevelDef ;
    rdfs:range xsd:boolean .

:durationUnit a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "durationUnit" ;
    rdfs:comment "multiples of this duration can be allocated" ;
    rdfs:domain :TripAllocationConstraintDef ;
    rdfs:range xsd:string .

:entryConnectionPoint a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "entryConnectionPoint" ;
    rdfs:domain :RegionalConstraintDef ;
    rdfs:range :ConnectionPointDef .

:entryConnectionPointId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "entryConnectionPointId" ;
    rdfs:comment "connection point connecting two fare regimes" ;
    rdfs:domain :RegionalConstraintDef ;
    rdfs:range xsd:string .

:entryStation_LineDef a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "entryStation" ;
    rdfs:domain :LineDef ;
    rdfs:range :StationDef ;
    rdfs:subPropertyOf :entryStation .

:entryStation_ZoneDef a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "entryStation" ;
    rdfs:domain :ZoneDef ;
    rdfs:range :StationDef ;
    rdfs:subPropertyOf :entryStation .

:excludedTimeRange a owl:ObjectProperty ;
    rdfs:label "excludedTimeRange" ;
    rdfs:comment "time ranges excluded from the validity (e.g. off peak fulfillments)" ;
    rdfs:domain :TravelValidityConstraintDef ;
    rdfs:range :ExcludedTimeRangeItem .

:exitConnectionPoint a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "exitConnectionPoint" ;
    rdfs:domain :RegionalConstraintDef ;
    rdfs:range :ConnectionPointDef .

:exitConnectionPointId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "exitConnectionPointId" ;
    rdfs:comment "connection point connecting two fare regimes" ;
    rdfs:domain :RegionalConstraintDef ;
    rdfs:range xsd:string .

:fareDetailDescriptionRef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "fareDetailDescriptionRef" ;
    rdfs:comment "reference to a text with the details of the fare" ;
    rdfs:domain :FareDef ;
    rdfs:range xsd:string .

:fareResourceLocation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "fareResourceLocation" ;
    rdfs:domain :FareDataDef ;
    rdfs:range :FareResourceLocationDef .

:feeRef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "feeRef" ;
    rdfs:comment "Reference to a price data item defining the fee; optional in case there is no fee but the  after sales transaction is allowed. Online services include fee directly in the fee tag." ;
    rdfs:domain :AfterSalesRuleDef ;
    rdfs:range xsd:string .

:fromDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "fromDate" ;
    rdfs:domain :CalendarDef ;
    rdfs:range xsd:string .

:fulfillmentConstraintRef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "fulfillmentConstraintRef" ;
    rdfs:domain :FareConstraintBundle ;
    rdfs:range xsd:string .

:fulfillmentType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "fulfillmentType" ;
    rdfs:domain :FulfillmentOption ;
    rdfs:range xsd:string .

:geoCoordinate a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "geoCoordinate" ;
    rdfs:domain :StationDef ;
    rdfs:range :GeoCoordinate .

:hoursAfterMidnight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "hoursAfterMidnight" ;
    rdfs:comment "validity extended after midnight" ;
    rdfs:domain :ValidityRange ;
    rdfs:range xsd:decimal .

:id_CalendarDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:comment "\\*** BULK-ONLY *** identification within the bulk data mandatory in bulk data exchange" ;
    rdfs:domain :CalendarDef ;
    rdfs:range xsd:string .

:id_CarrierConstraintDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:domain :CarrierConstraintDef ;
    rdfs:range xsd:string .

:id_LuggageConstraint a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:domain :LuggageConstraint ;
    rdfs:range xsd:string .

:id_PersonalDataConstraintDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:domain :PersonalDataConstraintDef ;
    rdfs:range xsd:string .

:id_PriceDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:comment "required for bulk data transfer" ;
    rdfs:domain :PriceDef ;
    rdfs:range xsd:string .

:id_ReductionConstraintDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:comment "in bulk data only" ;
    rdfs:domain :ReductionConstraintDef ;
    rdfs:range xsd:string .

:id_RegionalConstraintDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:domain :RegionalConstraintDef ;
    rdfs:range xsd:string .

:id_TravelValidityConstraintDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "id" ;
    rdfs:comment "mandatory in bulk data exchange" ;
    rdfs:domain :TravelValidityConstraintDef ;
    rdfs:range xsd:string .

:includedFreePassenger a owl:ObjectProperty ;
    rdfs:label "includedFreePassenger" ;
    rdfs:domain :PassengerConstraintDef ;
    rdfs:range :IncludedFreePassengerItem .

:individualContracts_AfterSalesRuleDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "individualContracts" ;
    rdfs:comment "indicates that the after sales of this fare can be treated independently per person." ;
    rdfs:domain :AfterSalesRuleDef ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :individualContracts .

:individualContracts_FareDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "individualContracts" ;
    rdfs:comment "indicates that the fare can be treated independently per person although booked for more than one person." ;
    rdfs:domain :FareDef ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :individualContracts .

:individualTicketingPermitted a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "individualTicketingPermitted" ;
    rdfs:comment "a separate fulfillment per traveler is permitted" ;
    rdfs:domain :FulfillmentConstraintDef ;
    rdfs:range xsd:boolean .

:isAncillaryItem a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "isAncillaryItem" ;
    rdfs:domain :PassengerConstraintDef ;
    rdfs:range xsd:boolean .

:isCarrierFee a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "isCarrierFee" ;
    rdfs:comment "indicates that the fee belongs to the allocator" ;
    rdfs:domain :AfterSalesRuleDef ;
    rdfs:range xsd:boolean .

:isExchangeableAfterValidity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "isExchangeableAfterValidity" ;
    rdfs:domain :Product ;
    rdfs:range xsd:boolean .

:isExchangeablebeforeValidity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "isExchangeablebeforeValidity" ;
    rdfs:domain :Product ;
    rdfs:range xsd:boolean .

:isRefundableAfterValidity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "isRefundableAfterValidity" ;
    rdfs:domain :Product ;
    rdfs:range xsd:boolean .

:isRefundableBeforeValidity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "isRefundableBeforeValidity" ;
    rdfs:domain :Product ;
    rdfs:range xsd:boolean .

:isReturnProduct a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "isReturnProduct" ;
    rdfs:comment "the product includes a return journey" ;
    rdfs:domain :Product ;
    rdfs:range xsd:boolean .

:isTrainBound a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "isTrainBound" ;
    rdfs:comment "the product is at least in some parts bound to specific trains" ;
    rdfs:domain :Product ;
    rdfs:range xsd:boolean .

:issuer_ReductionCardReferenceDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "issuer" ;
    rdfs:comment "RICS company code or the upcoming compatible ERA company code. In case proprietary codes are used on a bilateral base the codes must have at least 5 positions and start with x." ;
    rdfs:domain :ReductionCardReferenceDef ;
    rdfs:range xsd:string .

:legacyAccountingIdentifier a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "legacyAccountingIdentifier" ;
    rdfs:domain :FareDef ;
    rdfs:range :LegacyAccountingIdentifierDef .

:legacyBorderPointCode_ConnectionPointDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "legacyBorderPointCode" ;
    rdfs:domain :ConnectionPointDef ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :legacyBorderPointCode .

:legacyBorderPointCode_StationNamesDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "legacyBorderPointCode" ;
    rdfs:domain :StationNamesDef ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :legacyBorderPointCode .

:legacyCode_ServiceConstraintDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "legacyCode" ;
    rdfs:comment "id used in B.1 as fake local station code " ;
    rdfs:domain :ServiceConstraintDef ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :legacyCode .

:legacyConversion a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "legacyConversion" ;
    rdfs:comment "options for legacy conversion to B.1: NO ( no conversion) YES (conversion allowed), ONLY (fare is provided only for conversion and should not be used otherwise " ;
    rdfs:domain :FareDef ;
    rdfs:range xsd:string .

:lineId a owl:DatatypeProperty ;
    rdfs:label "lineId" ;
    rdfs:domain :LineDef ;
    rdfs:range xsd:string .

:localCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "localCode" ;
    rdfs:comment "local code deprecated with version 1.4" ;
    rdfs:domain :StationNamesDef ;
    rdfs:range xsd:integer .

:lowerAgeLimit a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "lowerAgeLimit" ;
    rdfs:domain :PassengerConstraintDef ;
    rdfs:range xsd:integer .

:luggageConstraintRef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "luggageConstraintRef" ;
    rdfs:comment "constraints on luggage. Eigther free included luggage in a fare for persons of restrictions on the luggage itself on a fare for luggage" ;
    rdfs:domain :FareDef ;
    rdfs:range xsd:string .

:maxDuration a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "maxDuration" ;
    rdfs:comment "maximum duration of one interruption" ;
    rdfs:domain :TripInterruptionConstraintDef ;
    rdfs:range xsd:string .

:maxHandLuggage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "maxHandLuggage" ;
    rdfs:comment "Standard hand luggage pieces" ;
    rdfs:domain :LuggageConstraint ;
    rdfs:range xsd:integer .

:maxLargeLuggage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "maxLargeLuggage" ;
    rdfs:comment "Standard non-hand luggage pieces" ;
    rdfs:domain :LuggageConstraint ;
    rdfs:range xsd:integer .

:maxUnits a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "maxUnits" ;
    rdfs:comment "maximum number of allowed units to be allocated" ;
    rdfs:domain :TripAllocationConstraintDef ;
    rdfs:range xsd:integer .

:maxWeightedPassengers a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "maxWeightedPassengers" ;
    rdfs:comment "The total weighted number of passengers on the offer is restricted to be equal or smaller than this maximum" ;
    rdfs:domain :PassengerCombinationConstraintDef ;
    rdfs:range xsd:decimal .

:minWeightedPassengers a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "minWeightedPassengers" ;
    rdfs:comment "The total weighted number of passengers on the offer is restricted to equal or larger than this minimum" ;
    rdfs:domain :PassengerCombinationConstraintDef ;
    rdfs:range xsd:decimal .

:nameRef_FareDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "nameRef" ;
    rdfs:comment "reference to the fare name" ;
    rdfs:domain :FareDef ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :nameRef .

:nameUtf8_FareReferenceStationSetDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "nameUtf8" ;
    rdfs:domain :FareReferenceStationSetDef ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :nameUtf8 .

:nameUtf8_StationNamesDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "nameUtf8" ;
    rdfs:comment "station name with upper and lower case letters in UTF8" ;
    rdfs:domain :StationNamesDef ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :nameUtf8 .

:nameUtf8_ZoneDefinitionDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "nameUtf8" ;
    rdfs:domain :ZoneDefinitionDef ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :nameUtf8 .

:name_ConnectionPointDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "name" ;
    rdfs:domain :ConnectionPointDef ;
    rdfs:range xsd:string .

:name_FareReferenceStationSetDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "name" ;
    rdfs:comment "name to be used in route descriptions" ;
    rdfs:domain :FareReferenceStationSetDef ;
    rdfs:range xsd:string .

:name_ReductionCardDef a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "name" ;
    rdfs:domain :ReductionCardDef ;
    rdfs:range :TextDef .

:name_StationDef a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "name" ;
    rdfs:domain :StationDef ;
    rdfs:range :TextDef .

:name_StationNamesDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "name" ;
    rdfs:comment "station name with upper and lower case letters in ASCII" ;
    rdfs:domain :StationNamesDef ;
    rdfs:range xsd:string .

:name_ZoneDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "name" ;
    rdfs:comment "Name of the zone to be used in descriptions for the regional validity." ;
    rdfs:domain :ZoneDef ;
    rdfs:range xsd:string .

:name_ZoneDefinitionDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "name" ;
    rdfs:domain :ZoneDefinitionDef ;
    rdfs:range xsd:string .

:numberOfTravelDays a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "numberOfTravelDays" ;
    rdfs:comment "number of allowed travel days (e.g. 3 travel days within 2 weeks)" ;
    rdfs:domain :TravelValidityConstraintDef ;
    rdfs:range xsd:integer .

:nutsCode_LineDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "nutsCode" ;
    rdfs:comment """Nomenclature des units territoriales statistiques  
 COMMISSION REGULATION (EU) No 31/2011""" ;
    rdfs:domain :LineDef ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :nutsCode .

:nutsCode_ZoneDef a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "nutsCode" ;
    rdfs:comment "Nomenclature des units territoriales statistiques COMMISSION REGULATION (EU) No 31/2011" ;
    rdfs:domain :ZoneDef ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :nutsCode .

:nutsCodes a owl:DatatypeProperty ;
    rdfs:label "nutsCodes" ;
    rdfs:domain :ZoneDefinitionDef ;
    rdfs:range xsd:string .

:offerType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "offerType" ;
    rdfs:comment "The resource provides offers bases on trains or based on areas. Train based offers must start and end at a real station and are not split between a train run. Values TRAIN, AREA" ;
    rdfs:domain :OnlineResourceDef ;
    rdfs:range xsd:string .

:onlyWhenCombined a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "onlyWhenCombined" ;
    rdfs:comment "This combination model applies only in case the fare is combined with another carrier" ;
    rdfs:domain :FareCombinationModelDef ;
    rdfs:range xsd:boolean .

:optionalDelivery a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "optionalDelivery" ;
    rdfs:comment "this delivery is not mandatory to be downloaded. " ;
    rdfs:domain :FareDeliveryDetailsDef ;
    rdfs:range xsd:boolean .

