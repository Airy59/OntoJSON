    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :value_ValidityRange ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :timeUnit_ValidityRange ] .

:code a owl:DatatypeProperty ;
    rdfs:label "code" .

:CarrierConstraintDef a owl:Class ;
    rdfs:label "CarrierConstraintDef" ;
    rdfs:comment "Either excluded or included carriers can be set." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :CompanyDef ;
            owl:onProperty :excludedCarrier ],
        [ a owl:Restriction ;
            owl:allValuesFrom :CompanyDef ;
