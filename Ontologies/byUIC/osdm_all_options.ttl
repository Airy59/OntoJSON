    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :price ],
        [ a owl:Restriction ;
            owl:allValuesFrom :CurrencyPriceDef ;
            owl:onProperty :price ] .

:ReductionConstraintDef a owl:Class ;
