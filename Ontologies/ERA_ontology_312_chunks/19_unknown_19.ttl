                                                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/permitUseReflectivePlates
:permitUseReflectivePlates rdf:type owl:DatatypeProperty ;
                           rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( :CommonCharacteristicsSubset
                                                       :RunningTrack
                                                     )
                                       ] ;
                           rdfs:range xsd:boolean ;
                           :applicable "Y/N/NYA" ;
                           :legalDeadline "12 months after publication of Article 7 Guide"@en ;
                           :rinfIndex "1.1.1.1.7.12" ;
                           <http://purl.org/dc/terms/created> "2023-03-14"^^xsd:date ;
                           rdfs:comment "Sections where is permitted to use the reflective plates on rail freight corridors, with a view to prioritise the current bottlenecks. Specific case for Belgium, France, Italy, Portugal and Spain until 1.1.2026"@en ;
                           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                           rdfs:label "Permit of use of reflective plates"@en ;
                           rdfs:seeAlso "4.2.2.1.3.2 of TSI OPE (Commission Implementing Regulation (EU) 2019/773 of 16 May 2019)" ;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                           <http://www.w3.org/2004/02/skos/core#scopeNote> "From TSI OPE: Member States shall in particular endeavour to permit the use of reflective plates on rail freight corridors, with a view to prioritise the current bottlenecks. These sections and details of any conditions pertaining to them shall be recorded in the RINF. Until the information is encoded in RINF, the infrastructure manager shall ensure the information is communicated to railway undertakings by other appropriate means. The infrastructure manager shall identify the sections of lines on which 2 steady red lights are required in the RINF. "@en .


###  http://data.europa.eu/949/permittedContactForce
:permittedContactForce rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf :requirementsRollingStockDataParameter ;
                       rdf:type owl:FunctionalProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( :CommonCharacteristicsSubset
                                                   :RunningTrack
                                                 )
                                   ] ;
                       rdfs:range xsd:string ;
                       :XMLName "ERS_ContactForce" ;
                       :applicable "Y/N" ;
                       :dependencyNote "A value is mandatory if the value  Overhead contact line (OCL)  is selected for parameter \"Type of contact line system\""@en ;
                       :formatNote "The force is either given as: a value of the static force and of the maximum force expressed in newtons, or as a formula for function of the speed" ;
                       :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                       :rinfIndex "1.1.1.2.5.2" ;
                       :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PermittedContactForce> ,
                                                 <http://data.europa.eu/949/shapes/PermittedContactForceApplicability> ;
                       :unitOfMeasure <http://qudt.org/vocab/unit/N> ;
                       :usedInRCCCalculations "true"^^xsd:boolean ;
                       <http://purl.org/dc/terms/created> "2020-08-25"^^xsd:date ;
                       <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ;
                       rdfs:comment "Indication of contact force allowed expressed in newton."@en ;
                       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                       rdfs:label "Contact force permitted"@en ;
                       rdfs:seeAlso """LOC&PAS TSI: 4.2.8.2.9.6
ENE TSI: 4.2.11
EN 50367:2020+A1:2022 Table 6""" ;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> """The formula of the function shall represent the curve describing the value of the contact force in relation to the speed.
Static and maximum forces are given only for the maximum permitted line speed (see parameter number 1.1.1.1.2.5)."""@en .


###  http://data.europa.eu/949/phaseInfo
:phaseInfo rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:string ;
           <http://purl.org/dc/terms/created> "2021-08-08"^^xsd:date ;
           <http://purl.org/dc/terms/isReplacedBy> :PhaseInfo ,
                                                   :phaseInfoKm ,
                                                   :phaseInfoLength ,
                                                   :phaseInfoPantographLowered ,
                                                   :phaseInfoSwitchOffBreaker ,
                                                   :trackPhaseInfo ;
           <http://purl.org/dc/terms/modified> "2023-04-05"^^xsd:date ;
           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
           rdfs:label "Information on phase separation"@en ;
           owl:deprecated "true"^^xsd:boolean ;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
           <http://www.w3.org/2004/02/skos/core#editorialNote> """ Deprecated because of replacement by three properties. The reason is that the property is composed of three values: length [NNN] - the length of the phase separation in metres; switch off breaker [Y/N], single selection of 'yes' or 'no' to show whether the breaker has to be switched off; and lower pantograph [Y/N], single selection of 'yes' or 'no' to show whether the pantograph has to be lowered,
                   Km [NNN.NNN] - the location from the start of the line where the new value is valid."""@en .


###  http://data.europa.eu/949/phaseInfoChangeSupplySystem
:phaseInfoChangeSupplySystem rdf:type owl:DatatypeProperty ;
                             rdfs:domain :PhaseInfo ;
                             rdfs:range xsd:boolean ;
                             :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PhaseInfoChangeSupplySystem> ;
                             <http://purl.org/dc/terms/created> "2024-02-05"^^xsd:date ;
                             <http://purl.org/dc/terms/modified> "2025-03-11"^^xsd:date ,
                                                                 "2025-06-09"^^xsd:date ;
                             rdfs:comment "Part of the phase info of a track that corresponds to the single selection of Y=yes or N=no to show if the energy supply system changes"@en ;
                             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                             rdfs:label "Phase info change supply system"@en ;
                             owl:deprecated "true"^^xsd:boolean ;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                             <http://www.w3.org/2004/02/skos/core#scopeNote> " The phase info is the indication of required several information on phase separation."@en .


###  http://data.europa.eu/949/phaseInfoDistanceType
:phaseInfoDistanceType rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :PhaseInfo ;
                       rdfs:range xsd:string ;
                       :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PhaseInfoDistanceType> ;
                       <http://purl.org/dc/terms/created> "2024-02-05"^^xsd:date ;
                       <http://purl.org/dc/terms/modified> "2025-03-11"^^xsd:date ;
                       rdfs:comment "Part of the phase info of a track that corresponds to the single selection of 'MIN=minimum' or 'MAX=maximum' to show whether the length is a minimum distance between the inner contact strips of the pantographs or a maximum distance between the outer contact strips of the pantographs. Multiple strings for this parameter are accepted."@en ;
                       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                       rdfs:label "Phase info distance type"@en ;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> " The phase info is the indication of required several information on phase separation."@en .


