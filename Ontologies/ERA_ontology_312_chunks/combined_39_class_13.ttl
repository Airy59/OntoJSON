                        :rinfIndex "1.2.2.0.4.6" ;
                        :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasElectricShoreSupply> ;
                        <http://purl.org/dc/terms/created> "2021-08-10"^^xsd:date ;
                        <http://purl.org/dc/terms/modified> "2021-08-10"^^xsd:date ,
                                                            "2024-09-19"^^xsd:date ,
                                                            "2025-03-11"^^xsd:date ;
                        <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
