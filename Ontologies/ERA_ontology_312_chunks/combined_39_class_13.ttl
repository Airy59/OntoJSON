                              :tsiOPEAppendixD2Index "3.2.3" ;
                              <http://purl.org/dc/terms/created> "2022-10-27"^^xsd:date ;
                              <http://purl.org/dc/terms/modified> "2023-03-14"^^xsd:date ,
                                                                  "2024-09-19"^^xsd:date ,
                                                                  "2025-02-28"^^xsd:date ;
                              <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
                              rdfs:comment "Indication of existence of evacuation and rescue points"@en ;
