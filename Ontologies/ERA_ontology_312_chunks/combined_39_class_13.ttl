                     :XMLName "ITS_ExternalCleaning" ;
                     :applicable "Y/N" ;
                     :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                     :rinfIndex "1.2.2.0.4.2" ;
                     :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasExternalCleaning> ;
                     <http://purl.org/dc/terms/created> "2021-08-10"^^xsd:date ;
                     <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                                         "2024-09-19"^^xsd:date ,
                                                         "2025-03-11"^^xsd:date ;
                     <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
                     rdfs:comment "Indication whether exists an installation of external cleaning facility (fixed installation for servicing trains) as defined in TSI INF"@en ;
                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
