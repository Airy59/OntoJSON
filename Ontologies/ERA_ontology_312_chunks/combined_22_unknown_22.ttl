                                         <http://purl.org/dc/terms/identifier> ;
                      rdf:type owl:FunctionalProperty ;
                      rdfs:domain :Tunnel ;
                      rdfs:range xsd:string ;
                      :XMLName "OPSidingTunnelIdentification" ,
                               "OPTrackTunnelIdentification" ,
                               "SOLTunnelIdentification" ;
                      :applicable "Y" ;
                      :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                      :rinfIndex "1.1.1.1.8.2" ,
                                 "1.2.1.0.5.2" ,
                                 "1.2.2.0.5.2" ;
                      :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TunnelIdentification> ;
                      :tsiOPEAppendixD2Index "3.2.3" ;
                      <http://purl.org/dc/terms/created> "2021-08-03"^^xsd:date ;
                      <http://purl.org/dc/terms/modified> "2021-09-13"^^xsd:date ,
                                                          "2024-09-19"^^xsd:date ,
                                                          "2025-03-08"^^xsd:date ;
                      <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
                      rdfs:comment "Unique tunnel identification or unique tunnel number within Member State"@en ;
                      rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                      rdfs:label "Tunnel identification"@en ;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Here should be given the name, number, code or any other expression which is normally used for the identification of the tunnel other than mentioned in parameters 1.1.1.1.8.3   1.1.1.1.8.4. In case when tunnel does not have its own identification within the Member State, the IM should deliver it himself"@en .


###  http://data.europa.eu/949/tunnelKilometerEnd
:tunnelKilometerEnd rdf:type owl:DatatypeProperty ;
                    rdfs:range xsd:double ;
                    :XMLName "SOLTunnelEnd" ;
                    :rinfIndex "1.1.1.1.8.4" ;
                    <http://purl.org/dc/terms/created> "2023-03-29"^^xsd:date ;
                    <http://purl.org/dc/terms/isReplacedBy> :lineReferenceTunnelEnd ;
                    <http://purl.org/dc/terms/modified> "2024-02-05"^^xsd:date ,
                                                        "2024-09-19"^^xsd:date ;
                    rdfs:comment """Part of the End of tunnel that indicates the km of the line at the end of a tunnel.
The End of tunnel is the Geographical coordinates in decimal degrees and km of the line at the end of a tunnel. The reason for deprecation is that the property is now a subproperty of lineReference in order to represent the kilometer in relation to a national railway line"""@en ;
                    rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                    rdfs:label "(deprecated) End of tunnel kilometer"@en ;
                    owl:deprecated "true"^^xsd:boolean ;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


