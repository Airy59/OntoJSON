       <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
       <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                           "2024-09-25"^^xsd:date ,
                                           "2025-02-28"^^xsd:date ;
       <http://purl.org/dc/terms/relation> :contactLineSystemType ;
       rdfs:comment "Highest non-permanent voltage (Umax2) for France on lines not compliant with values defined in the EN50163:2004+A1:2007+A2:2020+A3:2022"@en ;
       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
