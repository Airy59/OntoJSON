###  http://data.europa.eu/949/lineReferenceTunnelEnd
:lineReferenceTunnelEnd rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :tunnelObjParameter ;
                        rdf:type owl:FunctionalProperty ;
                        rdfs:domain :Tunnel ;
                        rdfs:range :NetPointReference ;
                        :XMLName "SOLTunnelEnd" ;
                        :rinfIndex "1.1.1.1.8.4" ;
                        :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LineReferenceTunnelEnd> ;
                        <http://purl.org/dc/terms/created> "2024-02-05"^^xsd:date ;
                        <http://purl.org/dc/terms/modified> "2024-09-19"^^xsd:date ,
                                                            "2024-10-24"^^xsd:date ,
                                                            "2024-11-29"^^xsd:date ,
                                                            "2025-02-18"^^xsd:date ;
                        <http://purl.org/dc/terms/replaces> :tunnelKilometerEnd ;
                        rdfs:comment """Part of the End of tunnel that indicates the km of the line at the end of a tunnel.

The End of tunnel is the Geographical coordinates in decimal degrees and km of the line at the end of a tunnel."""@en ;
                        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                        rdfs:label "End of tunnel kilometer"@en ;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                        <http://www.w3.org/2004/02/skos/core#example> "Kilometer=`0.270`" ;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "Parameters of this group (from 1.1.1.1.8.1 to 1.1.1.1.8.13) are only applicable if tunnels exist on the SoL"@en .


###  http://data.europa.eu/949/lineReferenceTunnelStart
:lineReferenceTunnelStart rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf :tunnelObjParameter ;
                          rdf:type owl:FunctionalProperty ;
                          rdfs:domain :Tunnel ;
                          rdfs:range :NetPointReference ;
                          :XMLName "SOLTunnelStart" ;
                          :applicable "Y" ;
                          :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                          :rinfIndex "1.1.1.1.8.3" ;
                          :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LineReferenceTunnelStart> ;
                          <http://purl.org/dc/terms/created> "2024-02-05"^^xsd:date ;
                          <http://purl.org/dc/terms/modified> "2024-09-19"^^xsd:date ,
                                                              "2024-10-24"^^xsd:date ,
                                                              "2024-11-29"^^xsd:date ,
                                                              "2025-02-18"^^xsd:date ;
                          <http://purl.org/dc/terms/replaces> :tunnelKilometerStart ;
                          rdfs:comment """Part of the Start of tunnel that indicates the km of the line at the beginning of a tunnel.

The Start of tunnel is the Geographical coordinates in decimal degrees and km of the line at the beginning of a tunnel."""@en ;
                          rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                          rdfs:label "Start of tunnel kilometer"@en ;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                          <http://www.w3.org/2004/02/skos/core#example> "Kilometer=`0.895`" ;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> """Geographical coordinates according to the standard World Geodetic System (WGS).  Precision for both geographical latitude and geographical longitude is assumed as [NN.NNNNNNN] in degrees with decimals what gives discretion of 10 cm in the network.
Kilometre shall concern the national line identification given in 1.1.0.0.0.2
Location of the point which is assumed to be the beginning of the tunnel it is the point on the track centre line where is laid the vertical shadow of the extreme part of the tunnel s portal."""@en .


###  http://data.europa.eu/949/lineSideSystemDegradedSituationObjParameter
:lineSideSystemDegradedSituationObjParameter rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf :ccsSubsystemObjParameter ;
                                             :rinfIndex "1.1.1.3.10" ,
                                                        "1.2.1.1.9" ;
                                             <http://purl.org/dc/terms/created> "2024-10-31"^^xsd:date ;
                                             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
