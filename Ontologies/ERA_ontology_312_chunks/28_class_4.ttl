                              "1.2.1.1.5.1" ;
                   :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LegacyRadioSystem> ,
                                             <http://data.europa.eu/949/shapes/LegacyRadioSystemSKOS> ;
                   :tsiOPEAppendixD2Index "3.1.7" ;
