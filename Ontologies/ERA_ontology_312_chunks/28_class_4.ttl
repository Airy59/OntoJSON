                                       <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
                                       rdfs:comment "Indication of the side along the track where the lineside indication is positioned (left or right, or both sides)."@en ;
                                       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                       rdfs:label "Lineside distance indication positioning"@en ;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


