###  http://data.europa.eu/949/trackObjParameter
:trackObjParameter rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :infraSubsystemObjParameter ;
                   :rinfIndex "1.1.1.1.4" ,
                              "1.2.1.0.4" ;
                   <http://purl.org/dc/terms/created> "2024-10-31"^^xsd:date ;
                   rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                   rdfs:label "Track parameters"@en .


###  http://data.europa.eu/949/trackPhaseInfo
:trackPhaseInfo rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :oclSeparationSectionsObjParameter ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :CommonCharacteristicsSubset
                                            :RunningTrack
                                          )
                            ] ;
                rdfs:range :PhaseInfo ;
                :XMLName "EOS_InfoPhase" ;
                :applicable "Y/N" ;
                :dependencyNote "A value is mandatory only if 1.1.1.2.4.1.1 parameter \"Phase separation\" value is \"Y\" (true), otherwise applicability flag is \"N\" (not applicable)"@en ;
                :formatNote """In RDF the range is an instance of the era:PhaseInfo class with all its properties.

For RINF XML data sets:
As long as the data provision through XML data sets is allowed, the data format is a character string with the following structure: distance type [MIN/MAX] + length [NNN] + switch off breaker [Y/N] + lower pantograph [Y/N] + km [NNN.NNN]. The structure of the string is as follows:
- distance type [MIN/MAX] - single selection of 'MIN=minimum' or 'MAX=maximum' to show whether the length is a minimum distance between the inner contact strips of the pantographs or a maximum distance between the outer contact strips of the pantographs. Multiple strings for this parameter are accepted;
- length [NNN] - the length of the phase separation in meters;
- switch off breaker [Y/N], single selection of 'yes' or 'no' to show whether the breaker has to be switched off;
- lower pantograph [Y/N], single selection of 'yes' or 'no' to show whether the pantograph has to be lowered,
- Km [NNN.NNN] - the location from the start of the line where the new value is valid."""@en ;
                :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                :rinfIndex "1.1.1.2.4.1.2" ;
                :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrackPhaseInfo> ,
                                          <http://data.europa.eu/949/shapes/TrackPhaseInfoApplicability> ;
                <http://purl.org/dc/terms/created> "2023-04-05"^^xsd:date ;
                <http://purl.org/dc/terms/modified> "2025-02-18"^^xsd:date ,
                                                    "2025-02-28"^^xsd:date ,
                                                    "2025-06-09"^^xsd:date ;
                <http://purl.org/dc/terms/replaces> :phaseInfo ;
                rdfs:comment "Relates the Track with PhaseInfo. Indication of required several information on phase separation."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Information on phase separation"@en ;
                rdfs:seeAlso "ENE TSI: 4.2.15" ;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/trackRaisedPantographsDistanceAndSpeed
:trackRaisedPantographsDistanceAndSpeed rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf :pantographObjParameter ;
                                        rdfs:domain [ rdf:type owl:Class ;
                                                      owl:unionOf ( :CommonCharacteristicsSubset
                                                                    :RunningTrack
                                                                  )
                                                    ] ;
                                        rdfs:range :RaisedPantographsDistanceAndSpeed ;
                                        :XMLName "EPA_NumRaisedSpeed" ;
                                        :applicable "Y/N" ;
                                        :dependencyNote "Mandatory only if â€œOverhead contact line (OCL)â€ is selected in 1.1.1.2.2.1.1, otherwise the parameter is not applicable."@en ;
                                        :formatNote "Three values: [N] is number of pantographs; [NNN] is minimum distance between pantographs, in metres; [NNN] is the speed considered in km/h." ;
                                        :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                                        :rinfIndex "1.1.1.2.3.3" ;
                                        :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrackRaisedPantographDistanceAndSpeedApplicability> ,
                                                                  <http://data.europa.eu/949/shapes/TrackRaisedPantographsDistanceAndSpeed> ;
                                        :usedInRCCCalculations "true"^^xsd:boolean ;
                                        <http://purl.org/dc/terms/created> "2023-04-05"^^xsd:date ;
                                        <http://purl.org/dc/terms/modified> "2024-09-25"^^xsd:date ,
                                                                            "2025-02-28"^^xsd:date ;
                                        <http://purl.org/dc/terms/relation> :contactLineSystemType ;
                                        <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1301/2023-09-28> ,
                                                                          <http://data.europa.eu/eli/reg/2014/1302/2023-09-28> ;
                                        rdfs:comment "Indication of maximum number of raised pantographs per train allowed and minimum spacing centre line to centre line of adjacent pantograph heads, expressed in metres, at the given speed."@en ;
                                        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                        rdfs:label "Requirements for number of raised pantographs and spacing between them, at the given speed"@en ;
                                        rdfs:seeAlso """ENE TSI: 4.2.13 ;
LOC&PAS TSI: 4.2.8.2.9.7""" ;
                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                        <http://www.w3.org/2004/02/skos/core#editorialNote> "Relates the track with the class RaisedPantographsDistanceAndSpeed." ;
                                        <http://www.w3.org/2004/02/skos/core#scopeNote> """This parameter gives the information about the number of pantographs and the distance between them at a given speed for which the Overhead Contact Line (OCL) has been designed.

As for different speeds different combinations of number of pantographs and distance between them may exist, so this parameter can be repeated to present all of them.

The raised pantographs distance and speed is the indication of maximum number of raised pantographs per train allowed and minimum spacing centre line to centre line of adjacent pantograph heads, expressed in metres, at the given speed.

See 4.2.13 (TSI ENE) and 4.2.8.2.9.7 (TSI LOC&PAS)"""@en .


###  http://data.europa.eu/949/trackResistanceToAppliedLoadsObjParameter
:trackResistanceToAppliedLoadsObjParameter rdf:type owl:ObjectProperty ;
                                           rdfs:subPropertyOf :infraSubsystemObjParameter ;
                                           :rinfIndex "1.1.1.1.6" ;
