###  http://data.europa.eu/949/trackId
:trackId rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf :trackGenericDataParameter ,
                            <http://purl.org/dc/terms/identifier> ;
         rdf:type owl:FunctionalProperty ;
         rdfs:domain :RunningTrack ;
         rdfs:range xsd:string ;
         :XMLName "OPTrackIdentification" ,
                  "SOLTrackIdentification" ;
         :applicable "Y" ;
         :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
         :rinfIndex "1.1.1.0.0.1" ,
                    "1.2.1.0.0.2" ;
         :shaclShapeValidationRule <http://data.europa.eu/949/shapes/NoRepeatedTrackIdsOP> ,
                                   <http://data.europa.eu/949/shapes/NoRepeatedTrackIdsSoL> ,
                                   <http://data.europa.eu/949/shapes/TrackId> ;
         :tsiOPEAppendixD2Index "2.2.1.1" ;
         <http://purl.org/dc/terms/created> "2021-09-09"^^xsd:date ;
         <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                             "2024-09-19"^^xsd:date ,
                                             "2025-03-08"^^xsd:date ,
                                             "2025-03-11"^^xsd:date ;
         <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
         rdfs:comment "Unique track identification or unique track number within operational point or section of line"@en ;
         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
         rdfs:label "Identification of track"@en ;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> """Each track shall have unique identification or number within the SoL. This number cannot be used for naming any other track in the same SoL.
The check regarding the uniqueness of the ID within the SoL has to be done on national level (preferably by IM)."""@en .


