                                                    <http://data.europa.eu/949/shapes/RollingStockFireCategoryApplicability> ,
                                                    <http://data.europa.eu/949/shapes/RollingStockFireCategorySKOS> ;
                          :tsiOPEAppendixD2Index "3.2.3" ;
                          :usedInRCCCalculations "true"^^xsd:boolean ;
                          <http://purl.org/dc/terms/created> "2020-07-29"^^xsd:date ;
                          <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
