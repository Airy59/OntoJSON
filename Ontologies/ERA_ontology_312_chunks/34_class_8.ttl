###  http://data.europa.eu/949/tdsFrenchTrainDetectionSystemLimitation
:tdsFrenchTrainDetectionSystemLimitation rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf :otherTrainDetectionSystemsObjParameter ;
                                         rdf:type owl:FunctionalProperty ;
                                         rdfs:domain :TrainDetectionSystem ;
                                         rdfs:range :FrenchTrainDetectionSystemLimitation ;
                                         :applicable "Y/N/NYA" ;
                                         :dependencyNote "Only applicable on running tracks in France"@en ;
                                         :formatNote """The value of this parameter is an instance of the era:FrenchTrainDetectionSystemLimitation class with all its properties:
 - true/false for the existence of a section with train detection limitation
 - list of values from 1 to 8 defined in the taxonomy""" ;
                                         :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                                        "16 January 2020"@en ;
                                         :rinfIndex "1.1.1.3.7.1.4" ,
                                                    "1.2.1.1.6.3" ;
                                         :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TdsFrenchTrainDetectionSystemLimitation> ;
                                         :usedInRCCCalculations "true"^^xsd:boolean ;
                                         <http://purl.org/dc/terms/created> "2023-04-05"^^xsd:date ;
                                         <http://purl.org/dc/terms/modified> "2025-02-18"^^xsd:date ,
                                                                             "2025-03-04"^^xsd:date ,
                                                                             "2025-03-11"^^xsd:date ;
                                         <http://purl.org/dc/terms/relation> :frenchTrainDetectionSystemLimitationApplicable ,
                                                                             :frenchTrainDetectionSystemLimitationNumber ;
                                         <http://purl.org/dc/terms/replaces> :frenchTrainDetectionSystemLimitation ;
                                         rdfs:comment "Specific for route compatibility check on French network."@en ;
                                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                         rdfs:label "Section with train detection limitation"@en ;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                         <http://www.w3.org/2004/02/skos/core#scopeNote> """Relates the class train detection system with the class that represents the section with train detection limitation. Select the special condition as applicable through National Rule from the List.

For RINF XML data sets:
As long as the data provision through XML data sets is allowed, the data format is a character string with the following structure:
[Y/N]+[N]
where:
- [Y/N] - is the existence of section with train detection limitation
- [N] is a number from 1 to 8 referring to sections with:
    [1] Tonnage circulated per track is inferior to 15000 tons/day/track
    [2] Directional Interlocking
    [3] 45-second delay for directional interlocking
    [4] Installation with track circuit announcement
    [5] Absence of a shunting assistance pedal in the normal direction of circulation for non-reversible double track lines
    [6] Absence of a shunting assistance pedal regardless of the direction of traffic for single track lines and tracks for two way working
    [7] Absence of a pedal announcement mechanism
    [8] 45-second delay for specific announcement reset devices."""@en .


###  http://data.europa.eu/949/tdsMaximumMagneticField
:tdsMaximumMagneticField rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :trainDetectionSystemBasedFrequencyBandsObjParameter ;
                         rdf:type owl:FunctionalProperty ;
                         rdfs:domain :TrainDetectionSystem ;
                         rdfs:range :MaximumMagneticField ;
                         :applicable "Y/N/NYA" ;
                         :dependencyNote "Mandatory for train detection systems based on axle counters"@en ;
                         :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                        """For train detection system compliant with TSIs, 12 months after publication of Article 7 Guide.
For train detection system not TSI compliant: in relation to article 13 of TSI CCS"""@en ;
                         :rinfIndex "1.1.1.3.4.2.3" ,
                                    "1.2.1.1.3.2.3" ;
                         :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TdsMaximumMagneticField> ,
                                                   <http://data.europa.eu/949/shapes/TdsMaximumMagneticFieldApplicability> ;
                         :usedInRCCCalculations "true"^^xsd:boolean ;
                         <http://purl.org/dc/terms/created> "2023-03-14"^^xsd:date ;
                         <http://purl.org/dc/terms/modified> "2024-04-18"^^xsd:date ,
                                                             "2024-09-19"^^xsd:date ,
                                                             "2025-02-28"^^xsd:date ,
                                                             "2025-03-04"^^xsd:date ;
                         <http://purl.org/dc/terms/relation> :trainDetectionSystemType ;
                         <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/2023-09-08> ;
                         rdfs:comment """The maximum magnetic field limits allowed for axle counters (in dB ÂµA/m) for a defined frequency band.
It should be provided in 3 directions."""@en ;
                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                         rdfs:label "Maximum magnetic field"@en ;
                         rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index077_-_ERA_ERTMS_033281_v5.pdf"^^xsd:anyURI ;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Relates the Axle Counter TrainDetectionSystem with its MaximumMagneticField in (X,Y,Z). Verification of compliance with TSI includes application of notified national rules (when they exist)."@en .


