###  http://data.europa.eu/949/maximumBrakingDistance
:maximumBrakingDistance rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf :brakeRelatedDataParameter ;
                        rdf:type owl:FunctionalProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :CommonCharacteristicsSubset
                                                    :RunningTrack
                                                  )
                                    ] ;
                        rdfs:range xsd:integer ;
                        :XMLName "CBP_MaxBrakeDist" ;
                        :applicable "Y/N" ;
                        :formatNote "NNNNN" ;
                        :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                        :rinfIndex "1.1.1.3.11.1" ;
                        :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumBrakingDistance> ;
                        :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
                        :usedInRCCCalculations "true"^^xsd:boolean ;
                        <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                        <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                            "2024-06-26"^^xsd:date ,
                                                            "2024-09-19"^^xsd:date ;
                        <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ,
                                                          <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                        rdfs:comment "The maximum value of the braking distance [in metres] of a train shall be given for the maximum line speed."@en ;
                        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                        rdfs:label "Maximum braking distance requested"@en ;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> """This distance corresponds to the smallest physical distance between signals of the section of line at V max, taking into account the effect of gradient, minus the value of the safety margin used by the IM.

The braking capability of a train allows it to respect this braking distance.

Note that the OPE TSI provides for an exchange of detailed information between the infrastructure manager and the railway undertaking to ensure safe operation.

See also:
- OPE TSI: 4.2.2.6
- CCS TSI: 4.2.2"""@en .


###  http://data.europa.eu/949/maximumContactWireHeight
:maximumContactWireHeight rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf :contactLineSystemDataParameter ,
                                             :vehicleTypeTechnicalDataCharacteristic ;
                          rdf:type owl:FunctionalProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( :ContactLineSystem
                                                      :Siding
                                                      :VehicleType
                                                    )
                                      ] ;
                          rdfs:range xsd:double ;
                          :XMLName "ECS_MaxWireHeight" ;
                          :applicable "Y/N" ;
                          :dependencyNote "Mandatory only if â€œOverhead contact line (OCL)â€ is selected in 1.1.1.2.2.1.1, otherwise the parameter is not applicable."@en ;
                          :eratvIndex "4.10.5" ;
                          :formatNote "N.NN" ;
                          :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                          :rinfIndex "1.1.1.2.2.5" ;
                          :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumContactWireHeight> ,
                                                    <http://data.europa.eu/949/shapes/MaximumContactWireHeightApplicability> ;
                          :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
                          :usedInRCCCalculations "true"^^xsd:boolean ;
                          <http://purl.org/dc/terms/created> "2020-08-25"^^xsd:date ;
                          <http://purl.org/dc/terms/modified> "2021-09-11"^^xsd:date ,
                                                              "2024-09-25"^^xsd:date ,
                                                              "2025-02-28"^^xsd:date ;
                          <http://purl.org/dc/terms/relation> :contactLineSystemType ;
                          rdfs:comment "Indication of the maximum contact wire height expressed in metres."@en ;
                          rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                          rdfs:label "Maximum contact wire height"@en ;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> """The value given can be design value or the last known measured value. If there is no change in height, nominal value will be given.

Values shall be given in metres with precision of 0.01 m."""@en .


