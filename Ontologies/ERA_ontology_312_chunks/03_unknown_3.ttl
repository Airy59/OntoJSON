###  http://data.europa.eu/949/atoCommunicationSystem
:atoCommunicationSystem rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :automatedTrainOperationObjParameter ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :CommonCharacteristicsSubset
                                                    :RunningTrack
                                                  )
                                    ] ;
                        rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                        :applicable "Y/N/NYA" ;
                        :dependencyNote "Applicable when 'ATO Grade of Automation' is applicable"@en ;
                        :inSkosConceptScheme <http://data.europa.eu/949/concepts/ato-commsys/ATOCommSystem> ;
                        :legalDeadline "12 months after publication of Article 7 Guide"@en ;
                        :rinfIndex "1.1.1.3.13.3" ,
                                   "1.2.1.1.10.3" ;
                        :shaclShapeValidationRule <http://data.europa.eu/949/shapes/AtoCommunicationSystem> ,
                                                  <http://data.europa.eu/949/shapes/AtoCommunicationSystemSKOS> ;
                        :tsiOPEAppendixD2Index "3.4.9" ;
                        <http://purl.org/dc/terms/created> "2023-03-14"^^xsd:date ;
                        <http://purl.org/dc/terms/modified> "2024-04-18"^^xsd:date ,
                                                            "2024-12-05"^^xsd:date ;
                        <http://purl.org/dc/terms/relation> :atoGradeAutomation ,
                                                            :etcsBaseline ;
                        <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                        rdfs:comment "Supported ATO communication systems from trackside."@en ;
                        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                        rdfs:label "ATO communication system"@en ;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable" ;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> """ATO system communication system to the specification referenced in TSI CCS (4.2.4 & 4.2.19).
                           Parameter only applicable when ETCS Baseline > 4 MR1 and ATO is implemented"""@en .


