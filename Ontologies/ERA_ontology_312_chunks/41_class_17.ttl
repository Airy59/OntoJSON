                        rdfs:label "subsidiary location name"@en .


###  http://data.europa.eu/949/switchProtectControlWarning
:switchProtectControlWarning rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf :transitionsBetweenSystemsDataParameter ;
                             rdf:type owl:FunctionalProperty ;
                             rdfs:domain [ rdf:type owl:Class ;
                                           owl:unionOf ( :CommonCharacteristicsSubset
                                                         :Track
                                                       )
                                         ] ;
                             rdfs:range xsd:boolean ;
                             :applicable "Y/N/NYA" ;
                             :dependencyNote "Applicable when at least two different protection, control and warning systems exist."@en ;
                             :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                            "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                             :rinfIndex "1.1.1.3.8.1" ,
                                        "1.2.1.1.7.1" ;
                             :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SwitchProtectControlWarning> ,
                                                       <http://data.europa.eu/949/shapes/SwitchProtectControlWarningApplicability> ;
                             :tsiOPEAppendixD2Index "3.4.2" ;
                             <http://purl.org/dc/terms/created> "2021-08-09"^^xsd:date ;
                             <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                                 "2025-03-04"^^xsd:date ;
                             <http://purl.org/dc/terms/relation> :conditionsSwitchTrainProtectionSystems ;
                             <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ,
                                                               <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                             rdfs:comment "Indication whether a switch over between different systems whilst running exists."@en ;
                             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                             rdfs:label "Existence of switch over between different protection, control and warning systems while running"@en ;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                             <http://www.w3.org/2004/02/skos/core#scopeNote> "Switch over between different systems whilst running. Installation depends on local conditions. "@en .


###  http://data.europa.eu/949/switchRadioSystem
:switchRadioSystem rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf :transitionsBetweenSystemsDataParameter ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :CommonCharacteristicsSubset
                                               :Track
                                             )
                               ] ;
                   rdfs:range xsd:boolean ;
                   :applicable "Y/N/NYA" ;
                   :dependencyNote "Applicable when at least two different radio systems exist. "@en ;
                   :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                  "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                   :rinfIndex "1.1.1.3.8.2" ,
                              "1.2.1.1.7.2" ;
                   :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SwitchRadioSystem> ,
                                             <http://data.europa.eu/949/shapes/SwitchRadioSystemApplicability> ;
                   :tsiOPEAppendixD2Index "3.4.4" ;
                   <http://purl.org/dc/terms/created> "2021-08-09"^^xsd:date ;
                   <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                       "2024-09-19"^^xsd:date ,
                                                       "2025-03-04"^^xsd:date ;
                   <http://purl.org/dc/terms/relation> :legacyRadioSystem ;
                   <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ,
                                                     <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                   rdfs:comment "Indication whether a switch over between different radio systems and no communication system whilst running exists."@en ;
                   rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                   rdfs:label "Existence of switch over between different radio systems"@en ;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> """Switch over between different radio systems and no communication system whilst running. Installation depends on local conditions.

The \"Indication if other radio systems in normal operation are installed line-side\" is given in parameter 1.1.1.3.6.1 / SOL Track Parameter CRS_Installed"""@en .


