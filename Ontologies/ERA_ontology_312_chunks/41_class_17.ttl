:subsidiaryLocationName rdf:type owl:DatatypeProperty ;
                        rdfs:domain :SubsidiaryLocation ;
                        rdfs:range xsd:string ;
                        <http://purl.org/dc/terms/created> "2024-06-03"^^xsd:date ;
