###  http://data.europa.eu/949/minVehicleImpedance
:minVehicleImpedance rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :trainDetectionSystemBasedFrequencyBandsObjParameter ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain :TrainDetectionSystem ;
                     rdfs:range :MinVehicleImpedance ;
                     :applicable "Y/N/NYA" ;
                     :dependencyNote "Mandatory only for track circuits" ;
                     :formatNote "The values is an instance of era:MinVehicleImpedance class with its 2 properties.	Per voltage : input Capacitance (Cin) and Input Impedance (Zin)"@en ;
                     :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                    """For train detection system compliant with TSIs, 12 months after publication of Article 7 Guide.
For train detection system not TSI compliant: in relation to article 13 of TSI CCS"""@en ;
                     :rinfIndex "1.1.1.3.4.2.2" ,
                                "1.2.1.1.3.2.2" ;
                     :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MinVehicleImpedance> ,
                                               <http://data.europa.eu/949/shapes/MinVehicleImpedanceApplicability> ;
                     :usedInRCCCalculations "true"^^xsd:boolean ;
                     <http://purl.org/dc/terms/modified> "2025-02-28"^^xsd:date ;
                     rdfs:comment "Impedance as defined in the specification referenced in Appendix A-1, index [D]"@en ;
                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                     rdfs:label "Vehicle impedance"@en ;
                     rdfs:seeAlso "https://eur-lex.europa.eu/eli/reg_impl/2023/1695/oj"^^xsd:anyURI ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Compatibility with track circuits. A track circuit is only able to detect rolling stock if the impedance between rails does not exceed a certain value."@en .


