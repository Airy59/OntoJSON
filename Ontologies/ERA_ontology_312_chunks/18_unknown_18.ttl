###  http://data.europa.eu/949/minimumContactWireHeight
:minimumContactWireHeight rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf :contactLineSystemDataParameter ,
                                             :vehicleTypeTechnicalDataCharacteristic ;
                          rdf:type owl:FunctionalProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( :ContactLineSystem
                                                      :VehicleType
                                                    )
                                      ] ;
                          rdfs:range xsd:double ;
                          :XMLName "ECS_MinWireHeight" ;
                          :applicable "Y/N" ;
                          :dependencyNote "When `not electrified` is chosen in parameter 1.1.1.2.2.1.1, then this parameter is not applicable."@en ;
                          :eratvIndex "4.10.5" ;
                          :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                          :rinfIndex "1.1.1.2.2.6" ;
                          :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MinimumContactWireHeight> ,
                                                    <http://data.europa.eu/949/shapes/MinimumContactWireHeightApplicability> ;
                          :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
                          :usedInRCCCalculations "true"^^xsd:boolean ;
                          <http://purl.org/dc/terms/created> "2020-08-25"^^xsd:date ;
                          <http://purl.org/dc/terms/modified> "2021-09-11"^^xsd:date ,
                                                              "2024-09-25"^^xsd:date ;
                          <http://purl.org/dc/terms/relation> :contactLineSystemType ;
                          rdfs:comment "Indication of the minimum contact wire height expressed in metres."@en ;
                          rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                          rdfs:label "Minimum contact wire height"@en ;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> """The value given can be design value or the last known measured value. If there is no change in height, nominal value will be given.

Values shall be given in metres with precision of 0.01 m."""@en .


