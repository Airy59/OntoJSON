###  http://data.europa.eu/949/offsetFromOrigin
:offsetFromOrigin rdf:type owl:DatatypeProperty ;
                  rdfs:domain :TopologicalCoordinate ;
                  rdfs:range xsd:positiveInteger ;
                  :shaclShapeValidationRule <http://data.europa.eu/949/shapes/OffsetFromOrigin> ;
                  :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
                  <http://purl.org/dc/terms/created> "2024-11-29"^^xsd:date ;
                  <http://purl.org/dc/terms/modified> "2025-01-30"^^xsd:date ;
                  rdfs:comment "Offset from the origin in a topological coordinate."@en ;
                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                  rdfs:label "offset from origin"@en .


