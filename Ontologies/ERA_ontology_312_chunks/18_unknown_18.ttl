###  http://data.europa.eu/949/minimumWheelDiameter
:minimumWheelDiameter rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :switchesAndCrossingsDataParameter ,
                                         :vehicleTypeTechnicalDataCharacteristic ;
                      rdf:type owl:FunctionalProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :CommonCharacteristicsSubset
                                                  :RunningTrack
                                                  :VehicleType
                                                )
                                  ] ;
                      rdfs:range xsd:integer ;
                      :XMLName "ISC_MinWheelDiaFixObtuseCrossings" ;
                      :applicable "Y" ;
                      :eratvIndex "4.8.2" ;
                      :formatNote "NNN" ;
                      :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                      :rinfIndex "1.1.1.1.5.2" ;
                      :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MinimumWheelDiameter> ;
                      :unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
                      :usedInRCCCalculations "true"^^xsd:boolean ;
                      <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                      <http://purl.org/dc/terms/modified> "2021-09-10"^^xsd:date ,
                                                          "2024-09-19"^^xsd:date ,
                                                          "2025-02-28"^^xsd:date ;
                      <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
                      rdfs:comment "Maximum unguided length of fixed obtuse crossings is based on a minimum wheel diameter in service expressed in millimetres."@en ;
                      rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                      rdfs:label "Minimum wheel diameter for fixed obtuse crossings"@en ;
                      rdfs:seeAlso "INF TSI:  4.2.5.3" ;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> """The minimum TSI value is 330 mm and this shall be used as a default value unless advised otherwise. If the value of the wheel diameter is bigger than 330 mm, it has to be specified.
New lines are assumed to be compliant with the TSI INF. When the line is compliant to TSI the default value of 330 mm has to be presented."""@en .


###  http://data.europa.eu/949/multipleTrainProtectionRequired
:multipleTrainProtectionRequired rdf:type owl:DatatypeProperty ;
                                 rdfs:range xsd:boolean ;
                                 :rinfIndex "1.1.1.3.5.2" ;
                                 <http://purl.org/dc/terms/created> "2021-08-09"^^xsd:date ;
                                 <http://purl.org/dc/terms/modified> "2023-03-14"^^xsd:date ;
                                 rdfs:comment "Deprecated according to the amendment to the Regulation (EU) 2019/777. Indication whether more than one train protection, control and warning system is required to be on-board and active simultaneously."@en ;
                                 rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                 rdfs:label "Need for more than one train protection, control and warning system required on board"@en ;
                                 owl:deprecated "true"^^xsd:boolean ;
                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable" .


###  http://data.europa.eu/949/nationalLoadCapability
:nationalLoadCapability rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf :performanceDataParameter ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :CommonCharacteristicsSubset
                                                    :RunningTrack
                                                  )
                                    ] ;
                        rdfs:range xsd:string ;
                        :XMLName "IPP_NCLoadCap" ;
                        :applicable "Y/N" ;
                        :legalDeadline "16 January 2020"@en ;
                        :rinfIndex "1.1.1.1.2.4.1" ;
                        :shaclShapeValidationRule <http://data.europa.eu/949/shapes/NationalLoadCapability> ;
                        :usedInRCCCalculations "true"^^xsd:boolean ;
                        <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                        <http://purl.org/dc/terms/modified> "2021-09-10"^^xsd:date ,
                                                            "2024-09-19"^^xsd:date ;
                        rdfs:comment "National classification for load capability"@en ;
                        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                        rdfs:label "National classification for load capability"@en ;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                        <http://www.w3.org/2004/02/skos/core#example> "The French IM SNCF reseau is using the concept of 'groupe Demeaux' with the following definition is 'Groupe de classification de la voie tenant compte de la resistance de son armement en flexion verticale'." ;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "Some Networks are using National classification for load capability (instead of parameter 1.1.1.1.2.4 Load capability that provide load capability in accordance with EN 15528)"@en .


###  http://data.europa.eu/949/nationalRollingStockFireCategory
:nationalRollingStockFireCategory rdf:type owl:DatatypeProperty ;
                                  rdfs:subPropertyOf :tunnelDataParameter ;
                                  rdf:type owl:FunctionalProperty ;
                                  rdfs:domain [ rdf:type owl:Class ;
                                                owl:unionOf ( :CommonCharacteristicsSubset
                                                              :Tunnel
                                                            )
                                              ] ;
                                  rdfs:range xsd:string ;
                                  :XMLName "ITU_NatFireCatReq" ;
                                  :applicable "Y/N" ;
                                  :dependencyNote "Mandatory for tunnels without value for 1.1.1.8.10 and where national values exist."@en ;
                                  :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                                  :rinfIndex "1.1.1.1.8.11" ,
                                             "1.2.1.0.5.8" ,
                                             "1.2.2.0.5.8" ;
                                  :shaclShapeValidationRule <http://data.europa.eu/949/shapes/NationalRollingStockFireCategory> ,
                                                            <http://data.europa.eu/949/shapes/NationalRollingStockFireCategoryApplicability> ;
                                  :usedInRCCCalculations "true"^^xsd:boolean ;
                                  <http://purl.org/dc/terms/created> "2020-07-29"^^xsd:date ;
                                  <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                                                      "2024-09-19"^^xsd:date ,
                                                                      "2025-02-28"^^xsd:date ;
                                  <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1303/2024-01-29> ;
                                  rdfs:comment "Categorisation of how a passenger train with a fire on board will continue to operate for a defined time period - according to national rules if they exist."@en ;
                                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                  rdfs:label "National fire category of rolling stock required"@en ;
                                  rdfs:seeAlso """SRT TSI: 4.2.3.3.4
                                     LOC&PAS TSI : 4.2.10.4.4""" ;
                                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                  <http://www.w3.org/2004/02/skos/core#scopeNote> """Data shall include both the category and brief name of the document introducing the categorisation.
A value is mandatory only for tunnels when the value of the parameter 1.1.1.1.8.10 is  none  and national rules exist.
It may be not applicable when respective national rules do not exist"""@en .


###  http://data.europa.eu/949/nationalValuesBrakeModel
:nationalValuesBrakeModel rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf :etcsNationalValuesDataParameter ;
                          rdf:type owl:FunctionalProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( :CommonCharacteristicsSubset
                                                      :RunningTrack
                                                    )
                                      ] ;
                          rdfs:range xsd:string ;
                          :applicable "Y/N/NYA" ;
                          :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
                          :legalDeadline "12 months after publication of Article 7 Guide"@en ;
                          :rinfIndex "1.1.1.3.2.16.13" ,
                                     "1.2.1.1.1.16.13" ;
                          :shaclShapeValidationRule <http://data.europa.eu/949/shapes/NationalValuesBrakeModel> ,
                                                    <http://data.europa.eu/949/shapes/NationalValuesBrakeModelApplicability> ;
                          :tsiOPEAppendixD3Index "1.5.13" ;
                          <http://purl.org/dc/terms/created> "2023-03-14"^^xsd:date ;
                          <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                                              "2024-04-18"^^xsd:date ,
                                                              "2024-12-05"^^xsd:date ;
                          <http://purl.org/dc/terms/relation> :etcsLevelType ;
                          <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                          rdfs:comment """Set of parameters for adapting the braking curves calculated by the ETCS on-board system to match accuracy, performance and safety margins imposed by the infrastructure manager.
It copies the content of Packet 3 or of Packet 203 as defined in the specification referenced in Appendix A-1, index [C]."""@en ;
                          rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                          rdfs:label "National Values used for the brake model"@en ;
                          rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "Non-harmonizable character string: [Contents of P3/P203] (TSI CCS, Annex I, Appendix A, Table A.2 - Subset-026)"@en .


