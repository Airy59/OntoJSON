###  http://data.europa.eu/949/endLocation
:endLocation rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :tunnelObjParameter ,
                                <http://www.opengis.net/ont/geosparql#hasGeometry> ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain :Tunnel ;
             rdfs:range <http://www.opengis.net/ont/sf#Point> ;
             :XMLName "SOLTunnelEnd" ;
             :applicable "Y" ;
             :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
             :rinfIndex "1.1.1.1.8.4" ;
             :shaclShapeValidationRule <http://data.europa.eu/949/shapes/EndLocation> ;
             <http://purl.org/dc/terms/created> "2020-07-29"^^xsd:date ;
             <http://purl.org/dc/terms/modified> "2024-02-05"^^xsd:date ,
                                                 "2024-09-19"^^xsd:date ;
             rdfs:comment "Geographical coordinates in decimal degrees and km of the line at the end of a tunnel."@en ;
             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
             rdfs:label "End of tunnel"@en ;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
             <http://www.w3.org/2004/02/skos/core#example> "Latitude=`51.5479123` Longitude=`-0.076732`" ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> """Geographical coordinates according to the standard World Geodetic System (WGS).  Precision for both geographical latitude and geographical longitude is assumed as [NN.NNNNNNN] in degrees with decimals what gives discretion of 10 cm in the network.
Kilometre shall concern the national line identification given in 1.1.0.0.0.2
Location of the point which is assumed to be the end of the tunnel it is the point on the track centre line where is laid the vertical shadow of the extreme part of the tunnel s portal."""@en .


