###  http://data.europa.eu/949/isQuietRoute
:isQuietRoute rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
              rdf:type owl:FunctionalProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :CommonCharacteristicsSubset
                                          :RunningTrack
                                        )
                          ] ;
              rdfs:range xsd:boolean ;
              :XMLName "IHS_QuietRoute" ;
              :applicable "Y" ;
              :formatNote "in XML: Y/N" ;
              :legalDeadline "1 January 2021"@en ;
              :rinfIndex "1.1.1.1.7.11" ;
              :shaclShapeValidationRule <http://data.europa.eu/949/shapes/IsQuietRoute> ;
              <http://purl.org/dc/terms/created> "2020-11-04"^^xsd:date ;
              <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                                  "2025-02-28"^^xsd:date ;
              rdfs:comment "Belonging to a 'quieter route' in accordance with Article 5b of TSI NOI."@en ;
              rdfs:isDefinedBy <http://data.europa.eu/949/> ;
              rdfs:label "Belonging to a quieter route"@en ;
              rdfs:seeAlso "Art 5b of Regulation (EU) 1304/2014 (amended by Regulation (EU) 2019/774) of 16 May 2019" ;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> """Art 5B: A quieter route means a part of the railway infrastructure with a minimum length of 20 km on which the average number of daily operated freight trains during the night-time as defined in national legislation transposing Directive 2002/49/EC of the European Parliament and of the Council (5) was higher than 12. The freight traffic in the years 2015, 2016 and 2017 shall be the basis for the calculation of that average number. In case the freight traffic due to exceptional circumstances diverges in a given year from that average number by more than 25 %, the Member State concerned can calculate the average number on the basis of the remaining two years.
Art 5.C 1:   Member States shall designate quieter routes in accordance with Article 5b and the procedure set out in Appendix D.1 of the Annex. They shall provide the European Union Agency for Railways ( the Agency ) with a list of quieter routes six months after the date of publication of this Regulation at the latest. The Agency shall publish those lists on its website."""@en .


###  http://data.europa.eu/949/kilometer
:kilometer rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf :signalDataParameter ,
                              :tunnelDataParameter ;
           rdfs:domain :KilometricPost ;
           rdfs:range xsd:double ;
           :XMLName "OPRailwayLocation" ;
           :applicable "Y/N" ;
           :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
           :rinfIndex "1.2.0.0.0.6" ;
           :shaclShapeValidationRule <http://data.europa.eu/949/shapes/Kilometer> ;
           :tsiOPEAppendixD2Index "2.2.2" ;
           :unitOfMeasure <http://qudt.org/vocab/unit/KiloM> ;
           <http://purl.org/dc/terms/created> "2021-01-29"^^xsd:date ;
           <http://purl.org/dc/terms/modified> "2021-01-29"^^xsd:date ,
                                               "2024-09-19"^^xsd:date ,
                                               "2024-10-24"^^xsd:date ,
                                               "2025-01-30"^^xsd:date ;
           <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
           rdfs:comment "Kilometer number of the kilometric post related to line identification defining the location of an infrastructure element."@en ;
           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
           rdfs:label "kilometer number"@en ;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "Railway location of Operational point"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> """For walkways: Value provided in Kilometric point of the start of the walkway and the length in m. Repeatable values for each location.
For rescue points: Value provided in Kilometric point of the start of the point of evacuation and rescue point and the length in m. Repeatable values for each location.
For signals: Relative position to the line identified under parameter 1.1.0.0.0.2, given in km ([reference point, via era:referent] / [NNN.NNN] )."""@en .


###  http://data.europa.eu/949/kmPostName
:kmPostName rdf:type owl:DatatypeProperty ;
            rdfs:domain :KilometricPost ;
