###  http://data.europa.eu/949/lengthOfTunnel
:lengthOfTunnel rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :length ,
                                   :tunnelDataParameter ;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain :Tunnel ;
                rdfs:range xsd:double ;
                :XMLName "ITU_Length" ;
                :applicable "Y" ;
                :dependencyNote "Only applicable for a tunnel with length of 100 metres or more."@en ;
                :formatNote "NNNNN" ;
                :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                :rinfIndex "1.1.1.1.8.7" ,
                           "1.2.1.0.5.5" ,
                           "1.2.2.0.5.5" ;
                :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LengthOfTunnel> ;
                :tsiOPEAppendixD2Index "3.2.3" ;
                :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
                :usedInRCCCalculations "true"^^xsd:boolean ;
                <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
                <http://purl.org/dc/terms/modified> "2024-09-19"^^xsd:date ,
                                                    "2025-03-08"^^xsd:date ;
                <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
                rdfs:comment "Length of a tunnel in metres from entrance portal to exit portal."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Length of tunnel"@en ;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Length of a tunnel is expressed in metres from portal to portal at the level of the top of rail. "@en .


