###  http://data.europa.eu/949/instructionsSwitchRadioSystems
:instructionsSwitchRadioSystems rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf :transitionsBetweenSystemsObjParameter ;
                                rdfs:domain [ rdf:type owl:Class ;
                                              owl:unionOf ( :CommonCharacteristicsSubset
                                                            :RunningTrack
                                                          )
                                            ] ;
                                rdfs:range :Document ;
                                :applicable "Y/N/NYA" ;
                                :dependencyNote "Applicable when at least two different radio systems exist. "@en ;
                                :legalDeadline "12 months after publication of Article 7 Guide"@en ;
                                :rinfIndex "1.1.1.3.8.2.1" ,
                                           "1.2.1.1.7.2.1" ;
                                :shaclShapeValidationRule <http://data.europa.eu/949/shapes/InstructionsSwitchRadioSystems> ,
                                                          <http://data.europa.eu/949/shapes/InstructionsSwitchRadioSystemsApplicability> ;
                                :tsiOPEAppendixD2Index "3.4.4" ;
                                <http://purl.org/dc/terms/created> "2022-10-28"^^xsd:date ;
                                <http://purl.org/dc/terms/modified> "2023-03-14"^^xsd:date ,
                                                                    "2024-04-18"^^xsd:date ,
                                                                    "2024-11-04"^^xsd:date ,
                                                                    "2025-02-28"^^xsd:date ;
                                <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ,
                                                                  <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                                rdfs:comment "Name and/or reference of the document specifying the Special instructions to switch over between different radio systems."@en ;
                                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                rdfs:label "Special instructions to switch over between different radio systems"@en ;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                <http://www.w3.org/2004/02/skos/core#scopeNote> """The details of the conditions to switch radio systems must be published.

The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .


###  http://data.europa.eu/949/isPartOf
:isPartOf rdf:type owl:ObjectProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :InfrastructureElement ;
          rdfs:range :InfrastructureElement ;
          :shaclShapeValidationRule <http://data.europa.eu/949/shapes/IsPartOf> ;
          <http://purl.org/dc/terms/created> "2024-05-24"^^xsd:date ;
          <http://purl.org/dc/terms/modified> "2025-01-30"^^xsd:date ;
          rdfs:comment """Indicates that an infrastructure element is a part of another (distinct) infrastructure element.
An element cannot be part of itself.
This property is the inverse of era:hasPart and represents the partial or whole-part relationship between infrastructure elements."""@en ;
          rdfs:isDefinedBy <http://data.europa.eu/949/> ;
          rdfs:label "is part of"@en .


