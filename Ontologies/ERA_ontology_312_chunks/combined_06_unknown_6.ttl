###  http://data.europa.eu/949/magneticBraking
:magneticBraking rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :trackResistanceToAppliedLoadsObjParameter ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :CommonCharacteristicsSubset
                                             :RunningTrack
                                           )
                             ] ;
                 rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                 :applicable "Y/N/NYA" ;
                 :inSkosConceptScheme <http://data.europa.eu/949/concepts/magnetic-braking/MagneticBraking> ;
                 :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                 :rinfIndex "1.1.1.1.6.3" ,
                            "1.2.1.0.4.3" ;
                 :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MagneticBraking> ,
                                           <http://data.europa.eu/949/shapes/MagneticBrakingSKOS> ;
                 :tsiOPEAppendixD2Index "3.4.6" ;
                 :usedInRCCCalculations "true"^^xsd:boolean ;
                 <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                 <http://purl.org/dc/terms/modified> "2022-09-12"^^xsd:date ,
                                                     "2024-09-19"^^xsd:date ,
                                                     "2025-02-28"^^xsd:date ,
                                                     "2025-03-04"^^xsd:date ;
                 <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ,
                                                   <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
                 rdfs:comment "Indication of limitations on the use of magnetic brakes."@en ;
                 rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                 rdfs:label "Use of magnetic brakes"@en ;
                 rdfs:seeAlso """INF TSI: 4.2.6.2.2
                    OPE TSI: 4.2.2.6.2 (1) (iv)""" ;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                 <http://www.w3.org/2004/02/skos/core#changeNote> "This property has been modified to be a RINF parameter (its eratvIndex is deleted). It is treated as a SKOS by RINF and as a boolean by ERATV. A new ERATV datatype property has been defined, magneticBrakingFitted with boolean values."@en .


