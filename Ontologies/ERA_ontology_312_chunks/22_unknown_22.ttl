              <http://www.w3.org/2004/02/skos/core#scopeNote> "Sections of EIRENE not covered by references in TSI. GSM-R (parameter 1.1.1.3.3.1) and ETCS L2 (parameter 1.1.1.3.2.1) must be installed for this parameter to be applicable."@en .


###  http://data.europa.eu/949/vNvallowovtrp
:vNvallowovtrp rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :etcsNationalValuesDataParameter ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :CommonCharacteristicsSubset
                                           :RunningTrack
                                         )
                           ] ;
               rdfs:range [ rdf:type rdfs:Datatype ;
                            owl:onDatatype xsd:unsignedInt ;
                            owl:withRestrictions ( [ xsd:minInclusive "0"^^xsd:unsignedInt
                                                   ]
                                                   [ xsd:maxInclusive "600"^^xsd:unsignedInt
                                                   ]
                                                 )
                          ] ;
               :applicable "Y/N/NYA" ;
               :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
               :formatNote "NNF, with N a decimal number (0 9), NNF must be divisible by 5, so F=(0|5), max. `600`" ;
               :legalDeadline "12 months after publication of Article 7 Guide"@en ;
               :rinfIndex "1.1.1.3.2.16.3" ,
                          "1.2.1.1.1.16.3" ;
               :shaclShapeValidationRule <http://data.europa.eu/949/shapes/VNvallowovtrp> ,
                                         <http://data.europa.eu/949/shapes/VNvallowovtrpApplicability> ;
               :tsiOPEAppendixD3Index "1.5.3" ;
               :unitOfMeasure <http://qudt.org/vocab/unit/KiloM-PER-HR> ;
               <http://purl.org/dc/terms/created> "2022-11-07"^^xsd:date ;
               <http://purl.org/dc/terms/modified> "2023-03-14"^^xsd:date ,
                                                   "2024-09-19"^^xsd:date ,
                                                   "2024-12-05"^^xsd:date ;
               <http://purl.org/dc/terms/relation> :etcsLevelType ;
               <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
               rdfs:comment """Speed limit allowing the driver to select the  override  function in km/h
According to the specification referenced in Appendix A-1, index [C]"""@en ;
               rdfs:isDefinedBy <http://data.europa.eu/949/> ;
               rdfs:label "V_NVALLOWOVTRP"@en ;
               rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> """Format: [NNF], with N a decimal number (0Ã·9), [NNF] must be divisible by 5, so F=(0|5), max. `600`.

See: TSI CCS (Subset-026, Chapter 7. 7.5.1.161)"""@en .


