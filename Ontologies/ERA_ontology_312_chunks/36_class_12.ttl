           rdfs:label "Has bridge"@en ;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
           <http://www.w3.org/2004/02/skos/core#definition> "Whether or not a track is associated with a bridge."@en .


