###  http://data.europa.eu/949/maximumInterferenceCurrent
:maximumInterferenceCurrent rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf :trainDetectionSystemBasedFrequencyBandsDataParameter ;
                            rdf:type owl:FunctionalProperty ;
                            rdfs:domain :TrainDetectionSystem ;
                            rdfs:range xsd:double ;
                            :applicable "Y/N/NYA" ;
                            :dependencyNote "Evaluation parameters must be added if preferred bands are not used."@en ;
                            :formatNote "NNN. An optional value could be filled in era:maximumInterferenceCurrentEvaluation" ;
                            :legalDeadline """For train detection system compliant with TSIs: 12 months after publication of Article 7 Guide.
For train detection system not TSI compliant: in relation to article 13 of TSI CCS"""@en ;
                            :rinfIndex "1.1.1.3.4.2.1" ,
                                       "1.2.1.1.3.2.1" ;
                            :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumInterferenceCurrent> ;
                            :unitOfMeasure <http://qudt.org/vocab/unit/A-PER-M> ;
                            :usedInRCCCalculations "true"^^xsd:boolean ;
                            <http://purl.org/dc/terms/created> "2023-03-14"^^xsd:date ;
                            <http://purl.org/dc/terms/modified> "2024-04-18"^^xsd:date ,
                                                                "2025-02-28"^^xsd:date ;
                            <http://purl.org/dc/terms/relation> :maximumInterferenceCurrentEvaluation ,
                                                                :trainDetectionSystemType ;
                            <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                            rdfs:comment "Maximum interference current limits allowed for track circuits for a defined frequency band."@en ;
                            rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                            rdfs:label "Maximum interference current"@en ;
                            rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index077_-_ERA_ERTMS_033281_v5.pdf"^^xsd:anyURI ;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                            <http://www.w3.org/2004/02/skos/core#scopeNote> """To be expressed in A/m. Verification of compliance with TSI includes application of notified national rules (when they exist).

Evaluation parameters must be added if preferred bands are not used. """@en .


###  http://data.europa.eu/949/maximumInterferenceCurrentEvaluation
:maximumInterferenceCurrentEvaluation rdf:type owl:DatatypeProperty ;
                                      rdfs:subPropertyOf :trainDetectionSystemBasedFrequencyBandsDataParameter ;
