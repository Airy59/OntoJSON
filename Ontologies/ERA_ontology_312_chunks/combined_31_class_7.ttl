:safeConsistLengthInformationNecessary rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemObjParameter ;
                                       rdf:type owl:FunctionalProperty ;
                                       rdfs:domain [ rdf:type owl:Class ;
                                                     owl:unionOf ( :CommonCharacteristicsSubset
                                                                   :RunningTrack
                                                                 )
                                                   ] ;
                                       rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                                       :applicable "Y/N/NYA" ;
                                       :dependencyNote "A value has to be provided when ETCS is present and the level of ETCS is 2 (parameter 1.1.1.3.2.1)."@en ;
                                       :inSkosConceptScheme <http://data.europa.eu/949/concepts/safe-consist-length/SafeConsistLengthNecessary> ;
                                       :legalDeadline "12 months after publication of Article 7 Guide"@en ;
                                       :rinfIndex "1.1.1.3.2.11" ,
                                                  "1.2.1.1.1.11" ;
                                       :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SafeConsistLengthInformationNecessary> ,
                                                                 <http://data.europa.eu/949/shapes/SafeConsistLengthInformationNecessaryApplicability> ,
                                                                 <http://data.europa.eu/949/shapes/SafeConsistLengthInformationNecessarySKOS> ;
                                       :usedInRCCCalculations "true"^^xsd:boolean ;
                                       <http://purl.org/dc/terms/created> "2023-03-14"^^xsd:date ;
                                       <http://purl.org/dc/terms/modified> "2024-04-18"^^xsd:date ,
                                                                           "2024-09-19"^^xsd:date ,
                                                                           "2025-02-28"^^xsd:date ;
                                       <http://purl.org/dc/terms/relation> :etcsLevelType ;
                                       <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                                       rdfs:comment "Indication whether safe consist train length information from on-board is required to access the line for safety reasons and the required safety integrity level."@en ;
                                       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                       rdfs:label "Safe consist length information from on-board necessary for access the line and SIL"@en ;
                                       rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                       <http://www.w3.org/2004/02/skos/core#scopeNote> "See: TSI CCS (Subset-026, Chapter 7, 7.5.1.112.1 and P10)"@en .


###  http://data.europa.eu/949/side
