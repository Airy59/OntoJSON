                         :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TdsMaximumMagneticField> ,
                                                   <http://data.europa.eu/949/shapes/TdsMaximumMagneticFieldApplicability> ;
                         :usedInRCCCalculations "true"^^xsd:boolean ;
                         <http://purl.org/dc/terms/created> "2023-03-14"^^xsd:date ;
