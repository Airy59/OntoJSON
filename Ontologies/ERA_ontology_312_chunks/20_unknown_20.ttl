###  http://data.europa.eu/949/relativeDistanceDangerPoint
:relativeDistanceDangerPoint rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf :signalDataParameter ;
                             rdfs:domain :Signal ;
                             rdfs:range xsd:integer ;
                             :applicable "Y/N/NYA" ;
                             :formatNote "NNN" ;
                             :legalDeadline "12 months after publication of Article 7 Guide"@en ;
                             :rinfIndex "1.1.1.3.14.4" ,
                                        "1.2.1.0.8.4" ;
                             :shaclShapeValidationRule <http://data.europa.eu/949/shapes/RelativeDistanceDangerPoint> ;
                             :tsiOPEAppendixD2Index "2.2.3" ,
                                                    "2.3.3" ;
                             :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
                             <http://purl.org/dc/terms/created> "2023-03-14"^^xsd:date ;
                             <http://purl.org/dc/terms/modified> "2024-04-18"^^xsd:date ;
                             <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
                             rdfs:comment "Distance in meters to the danger point"@en ;
                             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                             rdfs:label "Relative distance of the danger point"@en ;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                             <http://www.w3.org/2004/02/skos/core#scopeNote> """Danger point is defined in ERTMS/ETCS - Glossary of Terms and Abbreviations - version  4.0.0 - date 05/07/2023. For installations without ERTMS, the signalling definition is equivalent.
See: TSI OPE Appendix D2 (2.3.3), the danger point relative distance from the signal itself."""@en .


