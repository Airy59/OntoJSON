###  http://data.europa.eu/949/highSpeedLoadModelCompliance
:highSpeedLoadModelCompliance rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf :performanceDataParameter ;
                              rdf:type owl:FunctionalProperty ;
                              rdfs:domain [ rdf:type owl:Class ;
                                            owl:unionOf ( :CommonCharacteristicsSubset
                                                          :RunningTrack
                                                        )
                                          ] ;
                              rdfs:range xsd:boolean ;
                              :XMLName "IPP_HSLMCompliant" ;
                              :applicable "Y/N" ;
                              :legalDeadline "16 January 2020"@en ;
                              :rinfIndex "1.1.1.1.2.4.2" ;
                              :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HighSpeedLoadModelCompliance> ;
                              :usedInRCCCalculations "true"^^xsd:boolean ;
                              <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                              <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                                                  "2024-09-19"^^xsd:date ;
                              <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2023-09-28#tocId3> ,
                                                                <http://data.europa.eu/eli/reg/2014/1299/2023-09-28#tocId30> ;
                              rdfs:comment "For sections of line with a maximum permitted speed of 200 km/h or more. Information regarding the procedure to be used to perform the dynamic compatibility check."@en ;
                              rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                              rdfs:label "Compliance of structures with the High Speed Load Model (HSLM)"@en ;
                              rdfs:seeAlso """Annex D1 OPE TSI
INF TSI: 4.2.7.1.2(2)""" ;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                              <http://www.w3.org/2004/02/skos/core#scopeNote> "(TSI INF 4.2.7.1.2(2)) Applicable if the maximum permitted speed of the running track is more than 200km/h and the structures within the section of line are all compatible with the High Speed Load Model (HSLM); information regarding the procedure to be used to perform the dynamic compatibility check shall be provided as well."@en .


###  http://data.europa.eu/949/hotAxleBoxDetectorGeneration
:hotAxleBoxDetectorGeneration rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
                              rdf:type owl:FunctionalProperty ;
                              rdfs:domain :HABD ;
                              rdfs:range xsd:string ;
                              :XMLName "IHS_HABDGen" ;
                              :applicable "Y/N" ;
                              :dependencyNote "Mandatory if the HABD is not TSI compliant (the value of parameter 1.1.1.1.7.5 (Trackside HABD TSI compliant) is 'False')"@en ;
                              :legalDeadline "16 January 2020"@en ;
                              :rinfIndex "1.1.1.1.7.7" ;
                              :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HotAxleBoxDetectorGeneration> ,
                                                        <http://data.europa.eu/949/shapes/HotAxleBoxDetectorGenerationApplicability> ;
                              :usedInRCCCalculations "true"^^xsd:boolean ;
                              <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                              <http://purl.org/dc/terms/modified> "2021-09-11"^^xsd:date ,
                                                                  "2025-02-28"^^xsd:date ;
                              rdfs:comment """Specific for the French Italian and Swedish networks.
Generation of trackside hot axle box detector."""@en ;
                              rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                              rdfs:label "Generation of trackside HABD"@en ;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                              <http://www.w3.org/2004/02/skos/core#scopeNote> "Waiting provision of possible answers by the French, Italian and Swedish NREs "@en .


###  http://data.europa.eu/949/hotAxleBoxDetectorIdentification
:hotAxleBoxDetectorIdentification rdf:type owl:DatatypeProperty ;
                                  rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
                                  rdf:type owl:FunctionalProperty ;
                                  rdfs:domain :HABD ;
                                  rdfs:range xsd:string ;
                                  :XMLName "IHS_HABDID" ;
                                  :applicable "Y/N" ;
                                  :dependencyNote "Mandatory if the HABD is not TSI compliant (the value of parameter 1.1.1.1.7.5 (Trackside HABD TSI compliant) is 'False')"@en ;
                                  :legalDeadline "16 January 2020"@en ;
                                  :rinfIndex "1.1.1.1.7.6" ;
                                  :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HotAxleBoxDetectorIdentification> ,
                                                            <http://data.europa.eu/949/shapes/HotAxleBoxDetectorIdentificationApplicability> ;
                                  :usedInRCCCalculations "true"^^xsd:boolean ;
                                  <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                                  <http://purl.org/dc/terms/modified> "2021-09-11"^^xsd:date ,
                                                                      "2025-02-28"^^xsd:date ;
                                  rdfs:comment """Specific for the French, Italian and Swedish networks.
Applicable if trackside HABD is not TSI compliant, identification of trackside hot axle box detector."""@en ;
                                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                  rdfs:label "Identification of trackside HABD"@en ;
                                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/hotAxleBoxDetectorLocation
:hotAxleBoxDetectorLocation rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
                            rdfs:domain :HABD ;
                            rdfs:range xsd:double ;
                            :XMLName "IHS_HABDLoc" ;
                            :applicable "Y/N" ;
                            :dependencyNote "Mandatory if the HABD is not TSI compliant (the value of parameter 1.1.1.1.7.5 (Trackside HABD TSI compliant) is 'False')"@en ;
                            :legalDeadline "16 January 2020"@en ;
                            :rinfIndex "1.1.1.1.7.8" ;
                            :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HotAxleBoxDetectorLocation> ,
                                                      <http://data.europa.eu/949/shapes/HotAxleBoxDetectorLocationApplicability> ;
                            :usedInRCCCalculations "true"^^xsd:boolean ;
                            <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                            <http://purl.org/dc/terms/modified> "2021-09-11"^^xsd:date ,
                                                                "2025-02-28"^^xsd:date ;
                            rdfs:comment """Specific for the French Italian and Swedish networks.
Applicable if trackside HABD is not TSI compliant, localisation of trackside hot axle box detector."""@en ;
                            rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                            rdfs:label "Railway location of trackside HABD"@en ;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                            <http://www.w3.org/2004/02/skos/core#scopeNote> """The location (generally the distance from the origin of the line to the point of interest) on a line is given in kilometres with decimals (precision of 0.001).

It may be also possible to provide the location of the HABD as an era:netReference property for the HABD pointing to an era:NetPointReference with (at least)era:LinearPositioningSystemCoordinate"""@en .


###  http://data.europa.eu/949/hotAxleBoxDetectorTSICompliant
:hotAxleBoxDetectorTSICompliant rdf:type owl:DatatypeProperty ;
                                rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
                                rdf:type owl:FunctionalProperty ;
                                rdfs:domain :HABD ;
                                rdfs:range xsd:boolean ;
                                :XMLName "IHS_TSIHABD" ;
                                :applicable "Y" ;
                                :legalDeadline "16 January 2020"@en ;
                                :rinfIndex "1.1.1.1.7.5" ;
                                :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HotAxleBoxDetectorTSICompliant> ;
                                :usedInRCCCalculations "true"^^xsd:boolean ;
                                <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                                <http://purl.org/dc/terms/modified> "2021-09-11"^^xsd:date ;
                                rdfs:comment """Specific for the French, Italian and Swedish networks.
Trackside HABD compliant to TSI means that the HABD Trackside is compliant with:
- EN 15437-1:2009 referred in TSIs (LOC&PAS: 4.2.3.3.2.2, WAG TSI: 4.2.3.4),
- Specific cases mentioned in TSIs (LOC&PAS TSI, WAG TSI)."""@en ;
                                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                rdfs:label "Trackside HABD TSI compliant"@en ;
                                rdfs:seeAlso """TSI LOC&PAS: 4.2.3.3.2.2, and 7.3.2.3
WAG TSI: 4.2.3.4 and 7.3.2.2
EN 15437-1:2009""" ;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/idPhoneErtmsRadioBlockCenter
:idPhoneErtmsRadioBlockCenter rdf:type owl:DatatypeProperty ;
                              rdfs:range xsd:string ;
                              :applicable "Y/N/NYA" ;
                              :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
                              :legalDeadline "12 months after publication of Article 7 Guide"@en ;
                              :rinfIndex "1.1.1.3.2.17" ,
                                         "1.2.1.1.1.17" ;
                              :tsiOPEAppendixD2Index "3.4.7" ;
                              <http://purl.org/dc/terms/created> "2023-03-14"^^xsd:date ;
                              <http://purl.org/dc/terms/isReplacedBy> :rbcID ,
                                                                      :rbcPhone ;
                              <http://purl.org/dc/terms/modified> "2024-04-18"^^xsd:date ,
                                                                  "2024-12-05"^^xsd:date ;
                              <http://purl.org/dc/terms/relation> :etcsLevelType ;
                              <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                              rdfs:comment "Unique RBC identification (NID_C+NID_RBC) and calling number (NID_RADIO) as defined in the specification referenced in Appendix A-1, index [C]."@en ;
                              rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                              rdfs:label "(deprecated) ID and phone number of ERTMS/ETCS Radio Block Center"@en ;
                              owl:deprecated "true"^^xsd:boolean ;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                              <http://www.w3.org/2004/02/skos/core#scopeNote> "Non-harmonizable character string: [Contents of P42, not P143]"@en .


###  http://data.europa.eu/949/imCode
:imCode rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
        rdf:type owl:FunctionalProperty ;
        rdfs:domain :OrganisationRole ;
        rdfs:range xsd:string ;
        <http://purl.org/dc/terms/created> "2021-08-02"^^xsd:date ;
        <http://purl.org/dc/terms/isReplacedBy> :organisationCode ;
        <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                            "2024-06-03"^^xsd:date ,
                                            "2024-09-19"^^xsd:date ,
                                            "2024-10-30"^^xsd:date ,
                                            "2024-11-12"^^xsd:date ;
        <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/dec_impl/2018/1614> ,
                                          <http://data.europa.eu/eli/dir/2012/34/oj> ,
                                          <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
        rdfs:comment """Infrastructure manager means any body or firm responsible in particular for establishing, managing and maintaining railway infrastructure, including traffic management and control-command signalling;
the functions of the infrastructure manager on a network or part of a network may be allocated to different bodies or firms. Definition in (Article 3(2))"""@en ;
        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
        rdfs:label "Infrastructure manager (IM)'s code"@en ;
        rdfs:seeAlso "https://eur-lex.europa.eu/eli/dir/2012/34/oj#d1e885-32-1"^^xsd:anyURI ;
        owl:deprecated "true"^^xsd:boolean ;
        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/infraSubsystemDataParameter
