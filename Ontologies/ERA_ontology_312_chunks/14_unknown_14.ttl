###  http://data.europa.eu/949/hasETCSRestrictionsConditions
:hasETCSRestrictionsConditions rdf:type owl:DatatypeProperty ;
                               rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemDataParameter ;
                               rdf:type owl:FunctionalProperty ;
                               rdfs:domain [ rdf:type owl:Class ;
                                             owl:unionOf ( :CommonCharacteristicsSubset
                                                           :RunningTrack
                                                         )
                                           ] ;
                               rdfs:range xsd:boolean ;
                               :applicable "Y/N/NYA" ;
                               :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
                               :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                              "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                               :rinfIndex "1.1.1.3.2.6" ,
                                          "1.2.1.1.1.6" ;
                               :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasETCSRestrictionsConditions> ,
                                                         <http://data.europa.eu/949/shapes/HasETCSRestrictionsConditionsApplicability> ;
                               <http://purl.org/dc/terms/created> "2021-08-08"^^xsd:date ;
                               <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                                                   "2024-04-18"^^xsd:date ,
                                                                   "2024-11-20"^^xsd:date ,
                                                                   "2025-02-28"^^xsd:date ;
                               <http://purl.org/dc/terms/relation> :etcsLevelType ;
                               <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                               rdfs:comment "Indication whether restrictions or conditions due to partial compliance with the TSI CCS exist."@en ;
                               rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                               rdfs:label "Existence of operating restrictions or conditions"@en ;
                               rdfs:seeAlso "https://www.era.europa.eu/content/certification-issues"^^xsd:anyURI ,
                                            "https://www.era.europa.eu/system/files/2022-11/restrictions_and_added_functions_en_1.doc"^^xsd:anyURI ;
                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                               <http://www.w3.org/2004/02/skos/core#scopeNote> """If operational restrictions and conditions are applicable, a document will be provided as a value of era:era:etcsRestrictionsConditionsDoc property. The RU has to contact the IM to be informed about these conditions.

These conditions and restrictions of use are considered in section 6.4 of the CCS TSI. They should be described using the template available on Agency website (Certification
and deviations - Guidelines for using the ERA template) with the following link: https://www.era.europa.eu/activities/european-rail-traffic-management-system-ertms_en#meeting6."""@en .


###  http://data.europa.eu/949/hasElectricShoreSupply
:hasElectricShoreSupply rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf :sidingFixedInstalationsDataParameter ;
                        rdf:type owl:FunctionalProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :CommonCharacteristicsSubset
                                                    :Siding
                                                  )
                                    ] ;
                        rdfs:range xsd:boolean ;
                        :XMLName "ITS_ElectricShoreSupply" ;
                        :applicable "Y/N" ;
                        :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                        :rinfIndex "1.2.2.0.4.6" ;
                        :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasElectricShoreSupply> ;
                        <http://purl.org/dc/terms/created> "2021-08-10"^^xsd:date ;
                        <http://purl.org/dc/terms/modified> "2021-08-10"^^xsd:date ,
                                                            "2024-09-19"^^xsd:date ,
                                                            "2025-03-11"^^xsd:date ;
                        <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
                        rdfs:comment "Indication whether exists an installation of electric shore supply (fixed installation for servicing trains)."@en ;
                        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                        rdfs:label "Existence of electric shore supply"@en ;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/hasEmergencyPlan
:hasEmergencyPlan rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf :tunnelDataParameter ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :CommonCharacteristicsSubset
                                              :Tunnel
                                            )
                              ] ;
                  rdfs:range xsd:boolean ;
                  :XMLName "ITU_EmergencyPlan" ;
                  :applicable "Y/N" ;
                  :dependencyNote "Mandatory for tunnels longer than 1 km"@en ;
                  :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                  :rinfIndex "1.1.1.1.8.9" ,
                             "1.2.1.0.5.6" ,
                             "1.2.2.0.5.6" ;
                  :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasEmergencyPlan> ,
                                            <http://data.europa.eu/949/shapes/HasEmergencyPlanApplicability> ;
                  <http://purl.org/dc/terms/created> "2021-08-03"^^xsd:date ;
                  <http://purl.org/dc/terms/modified> "2021-08-10"^^xsd:date ,
                                                      "2024-09-19"^^xsd:date ;
                  <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1303/2024-01-29> ;
                  rdfs:comment "Indication whether emergency plan exists."@en ;
                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                  rdfs:label "Existence of emergency plan"@en ;
                  rdfs:seeAlso """SRT TSI: 4.4.2
OPE TSI: 4.2.3.7""" ;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> """A value may not be applicable for tunnels shorter than 1 km, as for them the fire category according SRT TSI does not exist.
Emergency plan has to be a document developed for each tunnel under the direction of the IM, in co-operation, where appropriate, with RUs, Rescue services and relevant authorities. It shall be consistent with the self-rescue, evacuation and rescue facilities provided.
It is applicable for tunnels longer than 1 km, in accordance with section 4.4.2 of SRT TSI, the emergency plan is mandatory only for tunnel length of more than 1km.

SRT TSI: 4.4.2
OPE TSI: 4.2.3.7"""@en .


###  http://data.europa.eu/949/hasEtcsNationalPacket44
:hasEtcsNationalPacket44 rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemDataParameter ;
                         rdf:type owl:FunctionalProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :CommonCharacteristicsSubset
                                                     :Track
                                                   )
                                     ] ;
                         rdfs:range xsd:boolean ;
                         :dependencyNote "Only applicable when selected value for 1.1.1.3.2.1 (ETCS present)."@en ;
                         :rinfIndex "1.1.1.3.2.5" ,
                                    "1.2.1.1.1.5" ;
                         :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasEtcsNationalPacket44> ,
                                                   <http://data.europa.eu/949/shapes/HasEtcsNationalPacket44Applicability> ;
                         <http://purl.org/dc/terms/created> "2024-11-20"^^xsd:date ;
                         <http://purl.org/dc/terms/modified> "2025-05-05"^^xsd:date ;
                         <http://purl.org/dc/terms/replaces> :etcsNationalPacket44 ;
                         <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                         rdfs:comment "Indication whether data for national packet 44 applications is transmitted between track and train."@en ;
                         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                         rdfs:label "has ETCS national packet 44 application implemented"@en ;
                         rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> """Value can be `false` or a link to the implemented functions. The hasEtcsNationalPacket44 property represents the true or false value. The etcsNationalPacket44Function represents the functions.

Packets 44 are the means to transmit data for national applications between train and track and vice versa, using the data transmission facilities included within the ETCS.
NID_XUSER values managed by ERA in a document about ETCS variables available on ERA website.

See: TSI CCS (7.4.3 & 6.2.4.2)."""@en .


###  http://data.europa.eu/949/hasEvacuationAndRescuePoints
:hasEvacuationAndRescuePoints rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf :tunnelDataParameter ;
                              rdf:type owl:FunctionalProperty ;
