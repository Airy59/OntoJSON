###  http://data.europa.eu/949/hasAdditionalBrakingInformation
:hasAdditionalBrakingInformation rdf:type owl:DatatypeProperty ;
                                 rdfs:subPropertyOf :brakeRelatedDataParameter ;
                                 rdf:type owl:FunctionalProperty ;
                                 rdfs:domain [ rdf:type owl:Class ;
                                               owl:unionOf ( :CommonCharacteristicsSubset
                                                             :RunningTrack
                                                           )
                                             ] ;
                                 rdfs:range xsd:boolean ;
                                 :XMLName "CBP_AddInfoAvailable" ;
                                 :applicable "Y/N" ;
                                 :legalDeadline "16 January 2020"@en ;
                                 :rinfIndex "1.1.1.3.11.2" ;
                                 :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasAdditionalBrakingInformation> ;
                                 :usedInRCCCalculations "true"^^xsd:boolean ;
                                 <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                                 <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ;
                                 rdfs:comment "Availability by the IM of additional information as defined in point (2) of point 4.2.2.6.2 of Regulation (EU) 2023/1693 - TSI OPE"@en ;
                                 rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                 rdfs:label "Availability by the IM of additional information"@en ;
                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "[See TSI OPE 4.2.2.6.2 (2)]"@en .


###  http://data.europa.eu/949/hasAutomaticDroppingDevice
:hasAutomaticDroppingDevice rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf :vehicleTypeTechnicalDataCharacteristic ;
                            rdfs:domain :VehicleType ;
                            rdfs:range xsd:boolean ;
                            :eratvIndex "4.10.11" ;
                            <http://purl.org/dc/terms/created> "2020-08-25"^^xsd:date ;
                            <http://purl.org/dc/terms/modified> "2020-11-03"^^xsd:date ;
                            rdfs:comment "Automatic dropping device (ADD) fitted (to be indicated for each energy supply system the vehicle is equipped for)."@en ;
                            rdfs:isDefinedBy <http://data.europa.eu/949/> ;
