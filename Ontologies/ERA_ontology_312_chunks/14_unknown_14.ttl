###  http://data.europa.eu/949/existenceOfIndustrialRisk
:existenceOfIndustrialRisk rdf:type owl:DatatypeProperty ;
                           rdfs:subPropertyOf :routeBookDataParameter ;
                           rdf:type owl:FunctionalProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( :CommonCharacteristicsSubset
                                                       :SectionOfLine
                                                     )
                                       ] ;
                           rdfs:range xsd:boolean ;
                           :applicable "Y/N" ;
                           :formatNote "Y/N" ;
                           :legalDeadline "12 months after publication of Article 7 Guide"@en ;
                           :rinfIndex "1.1.0.0.1.1" ;
                           :tsiOPEAppendixD2Index "3.2.5" ;
                           <http://purl.org/dc/terms/created> "2025-01-30"^^xsd:date ;
                           rdfs:comment "Indication that the full section of line (or a part of it) it is identified by the Infrastructure Managers (and communicated to the RU) where drivers are not supposed to get off the locomotive."@en ;
                           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                           rdfs:label "Industrial risks â€” locations where it is dangerous for the driver to step out"@en ;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                           <http://www.w3.org/2004/02/skos/core#scopeNote> """Although it is just an indication of existence of an industrial risk, the area covering the industrial risk should be references on the topological network.
For the route book purpose, the industrial risks should be defined as linear references instead of area. SpecialArea of type \"industrial risk\" should be used"""@en .


