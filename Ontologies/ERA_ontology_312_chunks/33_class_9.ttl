###  http://data.europa.eu/949/cantDefficiency
:cantDefficiency rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :vehicleTypeTechnicalDataCharacteristic ;
                 rdfs:domain :VehicleType ;
                 rdfs:range xsd:integer ;
                 :eratvIndex "4.6.1" ;
                 :unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
                 <http://purl.org/dc/terms/created> "2021-08-26"^^xsd:date ;
                 <http://purl.org/dc/terms/modified> "2021-08-26"^^xsd:date ,
                                                     "2024-06-26"^^xsd:date ,
                                                     "2025-03-05"^^xsd:date ;
                 rdfs:comment "Cant deficiency (maximum uncompensated lateral acceleration) for which the vehicle has been assessed. For dual gauge vehicles values for each gauge have to be indicated."@en ;
                 rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                 rdfs:label "Cant defficiency"@en ;
                 owl:deprecated "true"^^xsd:boolean ;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/cantDeficiency
:cantDeficiency rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :trackDataParameter ;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :CommonCharacteristicsSubset
                                            :RunningTrack
                                          )
                            ] ;
                rdfs:range xsd:integer ;
                :XMLName "ITP_CantDeficiency" ;
                :applicable "Y" ;
                :formatNote "+/-NNN" ;
                :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                :rinfIndex "1.1.1.1.4.2" ;
                :shaclShapeValidationRule <http://data.europa.eu/949/shapes/CantDeficiency> ;
                :unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
                :usedInRCCCalculations "true"^^xsd:boolean ;
                <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                <http://purl.org/dc/terms/modified> "2021-09-10"^^xsd:date ,
                                                    "2024-09-19"^^xsd:date ,
                                                    "2025-02-28"^^xsd:date ;
                <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
                rdfs:comment "Maximum cant deficiency expressed in millimetres defined as difference between the applied cant and a higher equilibrium cant the line has been designed for."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Cant deficiency"@en ;
                rdfs:seeAlso "INF TSI: 4.2.4.3" ;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "In case of positive value of cant deficiency or zero symbol  '+' shall be applied. In case of negative cant deficiency symbol '-' has to be selected. Value of the cant deficiency shall be given in millimetres. In case of lateral uncompensated acceleration on a 1435 mm track gauge of 1.0 m/s2 the value of 153 mm may be published."@en .


