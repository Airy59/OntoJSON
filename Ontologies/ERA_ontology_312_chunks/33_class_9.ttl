###  http://data.europa.eu/949/voiceRadioCompatible
:voiceRadioCompatible rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :tsiCompliantRadioObjParameter ,
                                         :vehicleTypeTechnicalObjectCharacteristic ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :CommonCharacteristicsSubset
                                                  :RunningTrack
                                                  :VehicleType
                                                )
                                  ] ;
                      rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                      :applicable "Y/N/NYA" ;
                      :dependencyNote """GSM-R must be installed for this parameter to be applicable.
In case of RSC-EU-0 or None, no other values are allowed."""@en ;
                      :eratvIndex "4.13.2.5" ;
                      :inSkosConceptScheme <http://data.europa.eu/949/concepts/radio-system-compatibilities-voice/RadioSystemCompatibilitiesVoice> ;
                      :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                     "16 January 2020"@en ;
                      :rinfIndex "1.1.1.3.3.9" ,
                                 "1.2.1.1.2.9" ;
                      :shaclShapeValidationRule <http://data.europa.eu/949/shapes/VoiceRadioCompatible> ,
                                                <http://data.europa.eu/949/shapes/VoiceRadioCompatibleApplicability> ,
                                                <http://data.europa.eu/949/shapes/VoiceRadioCompatibleSKOS> ;
                      :usedInRCCCalculations "true"^^xsd:boolean ;
                      <http://purl.org/dc/terms/created> "2020-08-31"^^xsd:date ;
                      <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                          "2024-04-18"^^xsd:date ,
                                                          "2024-09-19"^^xsd:date ;
                      rdfs:comment "Radio requirements used for demonstrating technical compatibility voice."@en ;
                      rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                      rdfs:label "Radio system compatibility voice"@en ;
                      rdfs:seeAlso "https://www.era.europa.eu/era-folder/radio-system-compatibility-rsc-voice-and-data-documents"^^xsd:anyURI ,
                                   "https://www.era.europa.eu/system/files/2023-05/esc-rsc_technical_document_en.pdf"^^xsd:anyURI ;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> """Information on RSC voice requirements per country is given in the referred document.

Vehicles are considered compatible with the infrastructure regarding this parameter, if any of the values declared matches.
In case the value â€œNot Definedâ€ or â€œRSC-EU-0â€ is used, repetitions with additional values are not expected."""@en .


###  http://data.europa.eu/949/wheelSetGauge
:wheelSetGauge rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :trackObjParameter ,
                                  :vehicleTypeTechnicalObjectCharacteristic ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :CommonCharacteristicsSubset
                                           :RunningTrack
                                           :VehicleType
                                         )
                           ] ;
               rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
               :XMLName "ITP_NomGauge" ;
               :applicable "Y" ;
               :eratvIndex "4.1.3" ;
               :inSkosConceptScheme <http://data.europa.eu/949/concepts/nominal-track-gauges/NominalTrackGauges> ;
               :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
               :rinfIndex "1.1.1.1.4.1" ,
                          "1.2.1.0.4.1" ;
               :shaclShapeValidationRule <http://data.europa.eu/949/shapes/WheelSetGauge> ,
                                         <http://data.europa.eu/949/shapes/WheelSetGaugeSKOS> ;
               :usedInRCCCalculations "true"^^xsd:boolean ;
               <http://purl.org/dc/terms/created> "2020-07-29"^^xsd:date ;
               <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                                   "2024-09-19"^^xsd:date ,
                                                   "2025-02-28"^^xsd:date ;
               <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
               rdfs:comment "A single value expressed in millimetres that identifies the track gauge."@en ;
               rdfs:isDefinedBy <http://data.europa.eu/949/> ;
               rdfs:label "Nominal track gauge"@en ;
               rdfs:seeAlso "INF TSI: 4.2.4.1" ;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "In case of multi-rail track, a set of data is to be published separately to each pair of rails to be operated as separate track (the whole set of parameters for the separate track has to be delivered be careful then with the track identification). Nominal track gauges provided by the INF TSI are only 1435, 1520, 1524, 1600 and 1668."@en .


