###  http://data.europa.eu/949/dataRadioCompatible
:dataRadioCompatible rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :tsiCompliantRadioObjParameter ,
                                        :vehicleTypeTechnicalObjectCharacteristic ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :CommonCharacteristicsSubset
                                                 :RunningTrack
                                                 :VehicleType
                                               )
                                 ] ;
                     rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                     :applicable "Y/N/NYA" ;
                     :dependencyNote "GSM-R  and ETCS L2 must be installed for this parameter to be applicable."@en ;
                     :eratvIndex "4.13.2.8" ;
                     :inSkosConceptScheme <http://data.europa.eu/949/concepts/radio-system-compatibilities-data/RadioSystemCompatibilitiesData> ;
                     :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                    "16 January 2020"@en ;
                     :rinfIndex "1.1.1.3.3.10" ,
                                "1.2.1.1.2.10" ;
                     :shaclShapeValidationRule <http://data.europa.eu/949/shapes/DataRadioCompatible> ,
                                               <http://data.europa.eu/949/shapes/DataRadioCompatibleApplicability> ,
                                               <http://data.europa.eu/949/shapes/DataRadioCompatibleSKOS> ;
                     :usedInRCCCalculations "true"^^xsd:boolean ;
                     <http://purl.org/dc/terms/created> "2020-08-31"^^xsd:date ;
                     <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                         "2024-04-18"^^xsd:date ,
                                                         "2024-09-19"^^xsd:date ,
                                                         "2025-03-04"^^xsd:date ;
                     <http://purl.org/dc/terms/relation> :etcsLevelType ;
                     <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                     rdfs:comment "Radio requirements used for demonstrating technical compatibility data."@en ;
                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                     rdfs:label "Radio system compatibility data"@en ;
                     rdfs:seeAlso "https://www.era.europa.eu/era-folder/radio-system-compatibility-rsc-voice-and-data-documents"^^xsd:anyURI ,
                                  "https://www.era.europa.eu/system/files/2023-05/esc-rsc_technical_document_en.pdf"^^xsd:anyURI ;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> """Information on RSC data requirements per country.

Vehicles are considered compatible with the infrastructure regarding this parameter, if any of the values declared matches.
In case the value â€œNot Definedâ€ or â€œRSC-EU-0â€ is used, repetitions with additional values are not expected."""@en .


