                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable" ;
                            <http://www.w3.org/2004/02/skos/core#scopeNote> """Verification of compliance with TSI includes application of notified national rules (when they exist).

Multiple selection from a predefined list:
- Axle Counters: bands A1-A3
- Track circuits: bands A1-A8"""@en .


###  http://data.europa.eu/949/gaugingProfile
:gaugingProfile rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :lineLayoutObjParameter ,
                                   :vehicleTypeTechnicalObjectCharacteristic ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :CommonCharacteristicsSubset
                                            :RunningTrack
                                            :VehicleType
                                          )
                            ] ;
                rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                :XMLName "ILL_Gauging" ;
                :applicable "Y" ;
                :eratvIndex "3.1.2.3" ,
                            "4.2.1" ;
                :inSkosConceptScheme <http://data.europa.eu/949/concepts/gaugings/GaugingProfiles> ;
                :legalDeadline "16 January 2020"@en ;
                :rinfIndex "1.1.1.1.3.1.1" ,
                           "1.2.1.0.3.4" ;
                :shaclShapeValidationRule <http://data.europa.eu/949/shapes/GaugingProfile> ,
                                          <http://data.europa.eu/949/shapes/GaugingProfileSKOS> ;
                :usedInRCCCalculations "true"^^xsd:boolean ;
                <http://purl.org/dc/terms/created> "2020-07-29"^^xsd:date ;
                <http://purl.org/dc/terms/modified> "2023-03-14"^^xsd:date ,
                                                    "2024-06-26"^^xsd:date ,
                                                    "2024-09-19"^^xsd:date ,
                                                    "2025-03-08"^^xsd:date ;
                <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ,
                                                  <http://data.europa.eu/eli/reg/2014/1302/2023-09-28> ;
                rdfs:comment "Gauges as defined in European standard or other local gauges, including lower or upper part."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Gauging"@en ;
                rdfs:seeAlso "https://www.era.europa.eu/system/files/2022-11/list_harmonised_national_restriction_codes_en.pdf"^^xsd:anyURI ;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> """It is possible to include additional values than the already identified and included in the concept scheme. They will be introduced by the Agency on request via a process of change request.

                   UK in respect of the Northern Ireland have a reference profile, but defined based on national rule:
7.3.2.2 Specific case Ireland and UK for Northern Ireland ('P')
It is permissible for the reference profile of the upper and the lower part of the unit to be established in accordance with the national technical rules notified for this purpose.

                   See also:
- Annex D1 OPE TSI
- INF TSI: 4.2.3.1, 4.2.3.2 """@en .


###  http://data.europa.eu/949/gaugingTransversalDocument
:gaugingTransversalDocument rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf :lineLayoutObjParameter ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( :CommonCharacteristicsSubset
                                                        :RunningTrack
                                                      )
                                        ] ;
                            rdfs:range :Document ;
                            :XMLName "ILL_GaugeCheckDocRef" ;
                            :applicable "Y/N" ;
                            :legalDeadline "16 January 2020"@en ;
                            :rinfIndex "1.1.1.1.3.1.3" ,
                                       "1.2.1.0.3.6" ;
                            :shaclShapeValidationRule <http://data.europa.eu/949/shapes/GaugingTransversalDocument> ;
                            :usedInRCCCalculations "true"^^xsd:boolean ;
                            <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                            <http://purl.org/dc/terms/modified> "2024-04-23"^^xsd:date ,
                                                                "2024-09-19"^^xsd:date ;
                            rdfs:comment "Electronic document available from the IM stored by the Agency with the transversal section of the particular points requiring specific checks due to deviations from gauging referred to in parameter \"Gauging\". Where relevant, guidance for the check with the particular point may be attached to the document with the transversal section."@en ;
                            rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                            rdfs:label "Document with the transversal section of the particular points requiring specific checks"@en ;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                            <http://www.w3.org/2004/02/skos/core#changeNote> "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
                            <http://www.w3.org/2004/02/skos/core#scopeNote> """The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .


###  http://data.europa.eu/949/gsmRActiveMobiles
:gsmRActiveMobiles rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :tsiCompliantRadioObjParameter ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :CommonCharacteristicsSubset
                                               :RunningTrack
                                             )
                               ] ;
                   rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                   :applicable "Y/N/NYA" ;
                   :dependencyNote "GSM-R and ETCS level 2 must be installed for this parameter to be applicable."@en ;
                   :inSkosConceptScheme <http://data.europa.eu/949/concepts/gsmr-number-active-mobiles/NumberActiveMobiles> ;
                   :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                  "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                   :rinfIndex "1.1.1.3.3.2" ,
                              "1.2.1.1.2.2" ;
                   :shaclShapeValidationRule <http://data.europa.eu/949/shapes/GsmRActiveMobiles> ,
                                             <http://data.europa.eu/949/shapes/GsmRActiveMobilesApplicability> ,
                                             <http://data.europa.eu/949/shapes/GsmRActiveMobilesSKOS> ;
                   <http://purl.org/dc/terms/created> "2021-08-08"^^xsd:date ;
                   <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                       "2024-04-18"^^xsd:date ;
                   <http://purl.org/dc/terms/relation> :etcsLevelType ;
                   <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                   rdfs:comment "Number of simultaneous communication session on board for ETCS level 2 required for a smooth running of the train. This relates to the radio block centre (RBC) handling of communication sessions. Not safety critical and no matter of interoperability."@en ;
                   rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                   rdfs:label "Number of active GSM-R mobiles (EDOR) or simultaneous communication session on board for ETCS level 2 needed to perform radio block centre handovers without having an operational disruption"@en ;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> """In case there is no ETCS Level 2 in the line, do this parameter must be flagged as Not Applicable.
In case there is ETCS Level 2 in the line, the minimum number of EDOR required on board would be 1.
In case ETCS baseline 3 release 2 or baseline 4 is selected, select \"2\" .
Please select \" 1\"  or \"2\" , taking into account that TSI compliant trains may only be fitted with 1 EDOR."""@en .


###  http://data.europa.eu/949/gsmRAdditionalInfo
:gsmRAdditionalInfo rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :tsiCompliantRadioObjParameter ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :CommonCharacteristicsSubset
                                                :RunningTrack
                                              )
                                ] ;
                    rdfs:range :Document ;
                    :applicable "Y/N/NYA" ;
                    :dependencyNote "GSM-R must be installed for this parameter to be applicable"@en ;
                    :legalDeadline "1 January 2021"@en ,
                                   "12 months after publication of Article 7 Guide for OP tracks"@en ;
                    :rinfIndex "1.1.1.3.3.3.1" ,
                               "1.2.1.1.2.3.1" ;
                    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/GsmRAdditionalInfo> ,
                                              <http://data.europa.eu/949/shapes/GsmRAdditionalInfoApplicability> ;
                    <http://purl.org/dc/terms/created> "2021-08-08"^^xsd:date ;
                    <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                        "2024-04-18"^^xsd:date ,
                                                        "2024-09-19"^^xsd:date ;
                    <http://purl.org/dc/terms/relation> :gprsForETCS ;
                    rdfs:comment "Any additional information on network characteristics or corresponding document available from the IM and stored by the Agency, e.g.; interference level, leading to the recommendation of additional on-board protection."@en ;
                    rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                    rdfs:label "Additional information on network characteristics"@en ;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                    <http://www.w3.org/2004/02/skos/core#changeNote> "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> """Please use this field to indicate any additional information on the GSM-R network.

The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .


###  http://data.europa.eu/949/gsmROptionalFunctions
:gsmROptionalFunctions rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :tsiCompliantRadioObjParameter ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( :CommonCharacteristicsSubset
                                                   :RunningTrack
                                                 )
                                   ] ;
                       rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                       :applicable "Y/N/NYA" ;
                       :dependencyNote "GSM-R (parameter 1.1.1.3.3.1) must be installed for this parameter to be applicable"@en ;
                       :inSkosConceptScheme <http://data.europa.eu/949/concepts/gsmr-optional-functions/OptionalFunctions> ;
                       :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                      "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                       :rinfIndex "1.1.1.3.3.3" ,
                                  "1.2.1.1.2.3" ;
                       :shaclShapeValidationRule <http://data.europa.eu/949/shapes/GsmROptionalFunctions> ,
                                                 <http://data.europa.eu/949/shapes/GsmROptionalFunctionsApplicability> ,
                                                 <http://data.europa.eu/949/shapes/GsmROptionalFunctionsSKOS> ;
                       <http://purl.org/dc/terms/created> "2021-08-08"^^xsd:date ;
                       <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                           "2024-04-18"^^xsd:date ;
                       rdfs:comment "Use of optional GSM-R functions which might improve operation on the line. They are for information only and not for network access criteria."@en ;
                       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                       rdfs:label "Optional GSM-R functions"@en ;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> """(*1) These inputs refer to the expected behaviour by the network, i.e. if there is any area or point where an automatic selection of network should be done or if there is any location where balises to instruct a change of radio network have been installed.
In order to be able to attend to these indications (automatic network, network change by balise) some configuration is needed in the mobile.
In case there is a balise used to announce the change of the network, or if there are locations where the network selection is planned by the IM to be done automatically (and not manually, as stated in the requirements). It should be considered as an item that is related to the design of the infrastructure.

(*2) the possibility to dial 112 is something specific to the network that should be communicated to the vehicles accessing it.

(*3) the use of broadcast calls is something specific to the network that has to be configured in it.

(*4) it is something specific to the network that has to be configured in it if the service is provided.

(*5) it is something specific to the network that has to be configured in it if the service is provided; something may need to be configured on the network but also in the mobile subscriber data if it wants to use the service. What is requested here is the information of the network capability.

(*6) if they are configured on the network. Please indicate which in the \"Other information\" box.

(*7) To be selected if other data applications, different from ETCS L2, can be used within the network -

(*8) if it is configured on the network.
 \"GSM-R Shunting used\" in order to make public if the GSM-R is used in the network for shunting activities.

(*9) Please specify in the \"Other information\" box for which services /applications are they planned and which are the frequencies in use.

(*11) Please use this field to indicate any additional information on network characteristics, e.g.; interference level, leading to the need of additional on-board protection;
"""@en .


###  http://data.europa.eu/949/gsmRRadioDataCommunication
:gsmRRadioDataCommunication rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf :vehicleTypeTechnicalObjectCharacteristic ;
                            rdfs:domain :VehicleType ;
                            rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                            :eratvIndex "4.13.2.7" ;
                            :inSkosConceptScheme <http://data.europa.eu/949/concepts/gsm-r-radio-data-communication/GSMRRadioDataCommunications> ;
                            <http://purl.org/dc/terms/created> "2021-08-31"^^xsd:date ;
                            <http://purl.org/dc/terms/modified> "2021-08-31"^^xsd:date ;
                            rdfs:comment "GSM-R Radio Data communication on board and its Baseline."@en ;
                            rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                            rdfs:label "GSM-R radio data communication"@en ;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/gsmRVersion
:gsmRVersion rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :tsiCompliantRadioObjParameter ,
                                :vehicleTypeTechnicalObjectCharacteristic ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :CommonCharacteristicsSubset
                                         :RunningTrack
                                         :VehicleType
                                       )
                         ] ;
             rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
             :applicable "Y/N/NYA" ;
             :dependencyNote "GSM-R must be installed for this parameter to be applicable and a value to be provided. If this property is not used, all GSM-R related properties should not be used either."@en ;
             :eratvIndex "4.13.2.1" ;
             :inSkosConceptScheme <http://data.europa.eu/949/concepts/gsmr-versions/GSMRVersions> ;
             :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                            "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
             :rinfIndex "1.1.1.3.3.1" ,
                        "1.2.1.1.2.1" ;
             :shaclShapeValidationRule <http://data.europa.eu/949/shapes/GsmRVersion> ,
                                       <http://data.europa.eu/949/shapes/GsmRVersionSKOS> ;
             :tsiOPEAppendixD2Index "3.1.7" ;
             <http://purl.org/dc/terms/created> "2021-08-08"^^xsd:date ;
             <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                 "2024-04-18"^^xsd:date ,
                                                 "2025-02-28"^^xsd:date ;
             <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
             rdfs:comment "GSM-R functional requirements specification and system requirements specification in accordance with the specification respectively referenced in Appendix A-1, index [E] and index [F], version number installed lineside."@en ;
             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
             rdfs:label "GSM-R version"@en ;
             rdfs:seeAlso "Referenced in Appendix A-1, index [E] and index [F]"@en ;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> """GSM-R functional requirements specification and system requirements specification in accordance with the specification respectively referenced in TSI CCS (Annex ), version number installed lineside.

Since more than one version may be installed in different areas, this property can have multiple values.
In case there is no GSM-R network available, this property shall be flagged as not applicable and all other GSM-R parameters ('Number of active GSM-R mobiles (EDOR) or simultaneous communication session on-board for ETCS Level 2 needed to perform radio block centre handovers without having an operational disruption' and 'Optional GSM-R functions') shall be flagged as not applicable."""@en .


###  http://data.europa.eu/949/gsmrConstraintsOperateOnlyInCircuitSwitch
:gsmrConstraintsOperateOnlyInCircuitSwitch rdf:type owl:ObjectProperty ;
                                           rdfs:subPropertyOf :tsiCompliantRadioObjParameter ;
                                           rdfs:domain [ rdf:type owl:Class ;
                                                         owl:unionOf ( :CommonCharacteristicsSubset
                                                                       :RunningTrack
                                                                     )
                                                       ] ;
                                           rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                                           :applicable "Y/N/NYA" ;
                                           :dependencyNote "GSM-R and ETCS L2 must be installed for this parameter to be applicable. Multiple values are allowed."@en ;
                                           :inSkosConceptScheme <http://data.europa.eu/949/concepts/gsmr-cs-constraints/GSMRConstraints> ;
                                           :legalDeadline "12 months after publication of Article 7 Guide"@en ;
                                           :rinfIndex "1.2.1.1.2.12" ;
                                           :shaclShapeValidationRule <http://data.europa.eu/949/shapes/GsmrConstraintsOperateOnlyInCircuitSwitchApplicability> ;
                                           :tsiOPEAppendixD3Index "2.2" ;
                                           <http://purl.org/dc/terms/created> "2023-03-14"^^xsd:date ;
                                           <http://purl.org/dc/terms/modified> "2024-04-18"^^xsd:date ;
                                           <http://purl.org/dc/terms/relation> :etcsLevelType ;
                                           <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                                           rdfs:comment "These constraints, where applicable, are meant to manage the limited number of circuit-switched radio connections that can be handled simultaneously by a Radio Block Center."@en ;
                                           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                           rdfs:label "Specific constraints imposed by the GSM-R network operator on ETCS on-board units only able to operate in circuit-switch"@en ;
                                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/gsmrNetworkCoverage
:gsmrNetworkCoverage rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :tsiCompliantRadioObjParameter ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :CommonCharacteristicsSubset
                                                 :RunningTrack
                                               )
                                 ] ;
                     rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                     :applicable "Y/N/NYA" ;
                     :dependencyNote "GSM-R must be installed for this parameter to be applicable"@en ;
                     :inSkosConceptScheme <http://data.europa.eu/949/concepts/gsmr-networks/GSMRNetworks> ;
                     :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                    "16 January 2020"@en ;
                     :rinfIndex "1.1.1.3.3.5" ,
                                "1.2.1.1.2.5" ;
                     :shaclShapeValidationRule <http://data.europa.eu/949/shapes/GsmrNetworkCoverage> ,
                                               <http://data.europa.eu/949/shapes/GsmrNetworkCoverageApplicability> ,
                                               <http://data.europa.eu/949/shapes/GsmrNetworkCoverageSKOS> ;
                     :usedInRCCCalculations "true"^^xsd:boolean ;
                     <http://purl.org/dc/terms/created> "2020-08-31"^^xsd:date ;
                     <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ;
                     rdfs:comment "Name of the own GSM-R network and list of GSM-R networks which are covered by a roaming agreement (for CS services)."@en ;
                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                     rdfs:label "GSM-R networks covered by a roaming agreement"@en ;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> """Name of the own GSM-R network and list of GSM-R networks which are covered by a roaming agreement for CS services.
This list is managed by UIC. The Agency will monitor it in order to update the list of possible values when necessary.
For Route Compatibility purposes and simplicity, the own network needs to be declared by the IM, so the RUs can systematically check the compatibility.
For voice services, roaming for CS is applicable.  For ETCS, as long as roaming for CS is ensured, the interoperability will be guaranteed."""@en .


###  http://data.europa.eu/949/hasAbstraction
:hasAbstraction rdf:type owl:ObjectProperty ;
                rdfs:domain :InfrastructureElement ;
                <http://purl.org/dc/terms/created> "2020-07-29"^^xsd:date ;
                <http://purl.org/dc/terms/modified> "2022-10-27"^^xsd:date ,
                                                    "2025-02-18"^^xsd:date ;
                rdfs:comment "Property that links a physical entity with its topological abstraction representation."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Has abstraction"@en ;
                owl:deprecated "true"^^xsd:boolean ;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/hasImplementation
:hasImplementation rdf:type owl:ObjectProperty ;
                   rdfs:range :InfrastructureElement ;
                   <http://purl.org/dc/terms/created> "2020-07-29"^^xsd:date ;
                   <http://purl.org/dc/terms/modified> "2022-10-27"^^xsd:date ,
                                                       "2025-02-18"^^xsd:date ;
                   rdfs:comment "Property that links a topological abstraction entity with its physical representation."@en ;
                   rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                   rdfs:label "Has implementation"@en ;
                   owl:deprecated "true"^^xsd:boolean ;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/hasLRS
:hasLRS rdf:type owl:ObjectProperty ;
        rdfs:domain :KilometricPost ;
        rdfs:range :LinearPositioningSystem ;
        :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasLrsCoordinate> ;
        <http://purl.org/dc/terms/created> "2024-11-29"^^xsd:date ;
        <http://purl.org/dc/terms/modified> "2025-03-10"^^xsd:date ;
        rdfs:comment "Specifies the linear referencing system to which the kilometre post is referenced. The linear referencing system is commonly the main railway line and it provides the framework for identifying the post's location along the railway line, using distance measurements rather than geographical coordinates."@en ;
        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
        rdfs:label "has linear referencing system"@en .


###  http://data.europa.eu/949/hasLrsCoordinate
:hasLrsCoordinate rdf:type owl:ObjectProperty ;
                  rdfs:domain :NetPointReference ;
                  rdfs:range :LinearPositioningSystemCoordinate ;
                  :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasLrsCoordinate> ;
                  <http://purl.org/dc/terms/created> "2024-11-29"^^xsd:date ;
                  rdfs:comment "Specifies the LRS coordinate associated with a topological coordinate."@en ;
                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                  rdfs:label "has line referencing system coordinate"@en .


###  http://data.europa.eu/949/hasOrganisationRole
:hasOrganisationRole rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :OrganisationRole ;
                     rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                     :inSkosConceptScheme <http://data.europa.eu/949/concepts/organisation-roles/OrgRoles> ;
                     :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasOrganisationRole> ,
                                               <http://data.europa.eu/949/shapes/HasOrganisationRoleSKOS> ;
                     <http://purl.org/dc/terms/created> "2024-06-03"^^xsd:date ;
                     rdfs:comment "Relates the Organisation role instance (the role played by an Organisation)  with the specific role in the taxonomy of organisation roles."@en ;
                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                     rdfs:label "has organisation role"@en .


###  http://data.europa.eu/949/hasOrientation
:hasOrientation rdf:type owl:ObjectProperty ;
                rdfs:domain :Signal ;
                rdfs:range :Orientation ;
                <http://purl.org/dc/terms/created> "2024-10-28"^^xsd:date ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "has orientation"@en .


###  http://data.europa.eu/949/hasPart
:hasPart rdf:type owl:ObjectProperty ;
         owl:inverseOf :isPartOf ;
         rdf:type owl:IrreflexiveProperty ;
         rdfs:domain :InfrastructureElement ;
         rdfs:range :InfrastructureElement ;
         :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasPart> ,
                                   <http://data.europa.eu/949/shapes/HasPartOP> ;
         <http://purl.org/dc/terms/created> "2024-05-24"^^xsd:date ;
         <http://purl.org/dc/terms/modified> "2025-01-30"^^xsd:date ,
                                             "2025-02-18"^^xsd:date ;
         <http://purl.org/dc/terms/replaces> :siding ,
                                             :track ;
         rdfs:comment """Indicates that an infrastructure element is composed of one or more other (distinct) infrastructure elements.
This property is used to represent part-whole relationships between infrastructure elements.
An element cannot be a part of itself."""@en ;
         rdfs:isDefinedBy <http://data.europa.eu/949/> ;
         rdfs:label "has part"@en .


###  http://data.europa.eu/949/hasSequence
