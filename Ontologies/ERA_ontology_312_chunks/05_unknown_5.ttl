###  http://data.europa.eu/949/etcsInfill
:etcsInfill rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemObjParameter ,
                               :vehicleTypeTechnicalObjectCharacteristic ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :ETCS
                                        :VehicleType
                                      )
                        ] ;
            rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
            :applicable "Y/N/NYA" ;
            :dependencyNote "Mandatory in case of ETCS level 1 and infill device(s) are installed. Otherwise it is not applicable."@en ;
            :eratvIndex "4.13.1.3" ;
            :inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-infills/ETCSInfills> ;
            :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                           "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
            :rinfIndex "1.1.1.3.2.4" ,
                       "1.2.1.1.1.4" ;
            :shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsInfill> ,
                                      <http://data.europa.eu/949/shapes/EtcsInfillApplicability> ,
                                      <http://data.europa.eu/949/shapes/EtcsInfillSKOS> ;
            <http://purl.org/dc/terms/created> "2021-08-08"^^xsd:date ;
            <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                "2024-04-18"^^xsd:date ,
                                                "2024-09-19"^^xsd:date ,
                                                "2025-03-04"^^xsd:date ;
            <http://purl.org/dc/terms/relation> :etcsLevelType ;
            <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
            rdfs:comment "Information about installed trackside equipment capable to transmit infill information by loop or Global System for Mobile communications for Railways (GSM-R) for level 1 installations."@en ;
            rdfs:isDefinedBy <http://data.europa.eu/949/> ;
            rdfs:label "ETCS infill installed line-side"@en ;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "TSI CCS (4.2.2 & 4.3.3)"@en .


###  http://data.europa.eu/949/etcsLevelType
:etcsLevelType rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemObjParameter ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :ETCS ;
               rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
               :applicable "Y/N" ;
               :inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-levels/ETCSLevels> ;
               :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
               :rinfIndex "1.1.1.3.2.1" ,
                          "1.2.1.1.1.1" ;
               :shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsLevelType> ,
                                         <http://data.europa.eu/949/shapes/EtcsLevelTypeSKOS> ;
               :tsiOPEAppendixD2Index "3.2.7" ;
               <http://purl.org/dc/terms/created> "2021-08-07"^^xsd:date ;
               <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                                   "2024-04-18"^^xsd:date ,
                                                   "2024-08-13"^^xsd:date ,
                                                   "2025-02-28"^^xsd:date ;
               <http://purl.org/dc/terms/relation> :cantDeficiencyBasicSSP ,
                                                   :etcsBaseline ,
                                                   :etcsDegradedSituation ,
                                                   :etcsMVersion ,
                                                   :etcsSystemCompatibility ,
                                                   :etcsTransmittedTrackConditions ,
                                                   :gsmRActiveMobiles ,
                                                   :rbcID ,
                                                   :rbcPhone ;
               <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
               rdfs:comment "ETCS application level related to the track side equipment."@en ;
               rdfs:isDefinedBy <http://data.europa.eu/949/> ;
               rdfs:label "European Train Control System (ETCS) level"@en ;
               rdfs:seeAlso "TSI CCS (Subset-026, Chapter 2, 2.6)" ;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> """The different ERTMS / ETCS application levels are a way to express the possible operating relationships between track and train.

Level definitions are principally related to the track side equipment used, to the way the track side information reaches the on-board units and to which functions are processed in the track side and in the on-board equipment respectively.

If ETCS is on the trackside (one or more levels are selected), all other ETCS parameters (from 1.1.1.3.2.2 to 1.1.1.3.2.10) are applicable and mandatory to be populated with values .
If the line is only equipped with Class B, this should be reflected in Parameter 1.1.1.3.5.3, and this parameter is â€œNâ€(not applicable).

The ETCS value NTC is only relevant when the line is dual equipped with ETCS (i.e., balises are placed in the track) and Class B system, and both systems are in operation at the same time.
In those cases, this parameter should be filled relevant ETCS Level and repeated with the value NTC.

If the line is only equipped with Class B, this should be reflected in Parameter 1.1.1.3.5.3, and this parameter etcsLevelType should not be used.

See: TSI CCS (Subset-026, Chapter 2, 2.6)"""@en .


