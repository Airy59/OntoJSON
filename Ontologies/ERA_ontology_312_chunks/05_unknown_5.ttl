              rdfs:comment "ETCS M_version according to the specification referenced in Appendix A-1, index [C], SRS 7.5.1.9."@en ;
              rdfs:isDefinedBy <http://data.europa.eu/949/> ;
              rdfs:label "ETCS M_version"@en ;
