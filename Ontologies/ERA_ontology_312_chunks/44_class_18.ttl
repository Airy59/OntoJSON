                             :rinfIndex "1.1.1.3.3.7" ,
                                        "1.2.1.1.2.7" ;
                             :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PublicNetworkRoamingDetails> ,
                                                       <http://data.europa.eu/949/shapes/PublicNetworkRoamingDetailsApplicability> ;
