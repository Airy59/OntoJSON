                                                                    "2.2.2" ,
                                                                    "3.2.5" ;
                                             <http://purl.org/dc/terms/contributor> "Matthew Perry" ;
                                             <http://purl.org/dc/terms/creator> "OGC GeoSPARQL 1.0 Standard Working Group" ;
                                             <http://purl.org/dc/terms/date> "2011-06-16"^^xsd:date ;
                                             rdfs:comment """
