                   :rinfIndex "1.1.1.3.6.1" ,
                              "1.2.1.1.5.1" ;
                   :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LegacyRadioSystem> ,
                                             <http://data.europa.eu/949/shapes/LegacyRadioSystemSKOS> ;
                   :tsiOPEAppendixD2Index "3.1.7" ;
                   :usedInRCCCalculations "true"^^xsd:boolean ;
                   <http://purl.org/dc/terms/created> "2020-08-31"^^xsd:date ;
                   <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                       "2024-04-18"^^xsd:date ,
                                                       "2024-09-19"^^xsd:date ;
                   <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ,
                                                     <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                   rdfs:comment "Indication of radio legacy systems installed."@en ;
