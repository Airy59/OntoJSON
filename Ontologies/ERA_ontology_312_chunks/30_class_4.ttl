###  http://data.europa.eu/949/hasLRS
:hasLRS rdf:type owl:ObjectProperty ;
        rdfs:domain :KilometricPost ;
        rdfs:range :LinearPositioningSystem ;
        :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasLrsCoordinate> ;
        <http://purl.org/dc/terms/created> "2024-11-29"^^xsd:date ;
        <http://purl.org/dc/terms/modified> "2025-03-10"^^xsd:date ;
