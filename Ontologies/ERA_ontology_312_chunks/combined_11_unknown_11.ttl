###  http://data.europa.eu/949/vehicleCategory
:vehicleCategory rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :vehicleTypeTechnicalObjectCharacteristic ;
                 rdfs:domain :VehicleType ;
                 rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                 :eratvIndex "1.4" ;
                 :inSkosConceptScheme <http://data.europa.eu/949/concepts/vehicle-types/Categories> ;
                 <http://purl.org/dc/terms/created> "2025-02-13"^^xsd:date ;
                 <http://purl.org/dc/terms/modified> "2025-05-09"^^xsd:date ;
                 <http://purl.org/dc/terms/replaces> :category ;
                 rdfs:comment "Indicates the core purpose of a railway vehicle: delivering traction, transporting goods or passengers or serving as a special vehicle."@en ;
                 rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                 rdfs:label "Vehicle category"@en ;
                 rdfs:seeAlso "https://eur-lex.europa.eu/eli/dec_impl/2011/665/2023-09-08#anx_III"^^xsd:anyURI ;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/vehicleKeeper
:vehicleKeeper rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :vehicleTechnicalObjCharacteristic ;
               rdfs:domain :Vehicle ;
               rdfs:range :OrganisationRole ;
               <http://purl.org/dc/terms/created> "2020-11-23"^^xsd:date ;
               <http://purl.org/dc/terms/modified> "2024-06-03"^^xsd:date ,
                                                   "2024-10-24"^^xsd:date ,
                                                   "2025-02-18"^^xsd:date ;
               <http://purl.org/dc/terms/replaces> :VehicleKeeper ;
               rdfs:comment """The natural or legal person that, being the owner of a vehicle or having the right to use it,
exploits the vehicle as a means of transport and is registered as such in a vehicle register referred to in Article 47 of (EU)2016/797."""@en ;
               rdfs:isDefinedBy <http://data.europa.eu/949/> ;
               rdfs:label "vehicle keeper"@en ;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


