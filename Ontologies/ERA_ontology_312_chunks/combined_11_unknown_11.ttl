###  http://data.europa.eu/949/altitudeRangeDetail
:altitudeRangeDetail rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf :vehicleTypeTechnicalDataCharacteristic ;
                     rdfs:domain :VehicleType ;
                     rdfs:range xsd:integer ;
                     :eratvIndex "4.3.2.1" ;
                     <http://purl.org/dc/terms/created> "2021-08-26"^^xsd:date ;
                     <http://purl.org/dc/terms/modified> "2021-08-26"^^xsd:date ;
                     rdfs:comment "Altitude range value for 'X' if value 'AX' is selected in altitude range."@en ;
