###  http://data.europa.eu/949/vehicleTypesCompatibleTrafficLoad
:vehicleTypesCompatibleTrafficLoad rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf :verifiedRccObjParameter ;
                                   rdfs:domain :CommonCharacteristicsSubset ;
                                   rdfs:range [ rdf:type owl:Class ;
                                                owl:unionOf ( :Document
