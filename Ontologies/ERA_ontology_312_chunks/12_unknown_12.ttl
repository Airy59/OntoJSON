###  http://data.europa.eu/949/axleSpacing
:axleSpacing rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf :vehicleTypeTechnicalDataCharacteristic ;
             rdfs:domain :VehicleType ;
             rdfs:range xsd:string ;
             :eratvIndex "4.5.3.4" ;
             <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
             <http://purl.org/dc/terms/modified> "2021-08-26"^^xsd:date ;
             rdfs:comment "Position of the axles along the unit. a: Distance between axles; b: Distance from end axle to the end of the nearest coupling plane; c: distance between two inside axles."@en ;
             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
             rdfs:label "Axle spacing"@en ;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/bigMetalMass
:bigMetalMass rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemDataParameter ;
              rdf:type owl:FunctionalProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :CommonCharacteristicsSubset
                                          :RunningTrack
                                        )
                          ] ;
              rdfs:range xsd:boolean ;
              :applicable "Y/N/NYA" ;
              :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
              :formatNote "Y/N" ;
              :legalDeadline "12 months after publication of Article 7 Guide"@en ,
                             "12 months after publication of Article 7 Guide for OP tracks"@en ;
              :rinfIndex "1.1.1.3.2.18" ,
                         "1.2.1.1.1.18" ;
              :shaclShapeValidationRule <http://data.europa.eu/949/shapes/BigMetalMass> ,
                                        <http://data.europa.eu/949/shapes/BigMetalMassApplicability> ;
              :tsiOPEAppendixD2Index "3.4.10" ;
              <http://purl.org/dc/terms/created> "2023-03-14"^^xsd:date ;
              <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                                  "2024-04-18"^^xsd:date ;
              <http://purl.org/dc/terms/relation> :etcsLevelType ;
              <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
              rdfs:comment "Indication of existence of metal mass in the vicinity of the location, susceptible of perturbating the reading of balises by the on-board system."@en ;
              rdfs:isDefinedBy <http://data.europa.eu/949/> ;
              rdfs:label "Big Metal Mass"@en ;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "According to the specification referenced in TSI CCS."@en .


