:loadCapabilitySpeed rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :LoadCapability ;
                     rdfs:range xsd:integer ;
                     :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LoadCapabilitySpeed> ;
                     :unitOfMeasure <http://qudt.org/vocab/unit/KiloM-PER-HR> ;
                     <http://purl.org/dc/terms/created> "2023-01-20"^^xsd:date ;
                     <http://purl.org/dc/terms/modified> "2025-02-18"^^xsd:date ,
                                                         "2025-03-11"^^xsd:date ;
                     <http://purl.org/dc/terms/replaces> :loadCapability ;
                     <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
                     rdfs:comment "Part of the load capability of a track that corresponds to the speed of the load model"@en ;
                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                     rdfs:label "Load capability speed"@en ;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/loadingPlatformHeight
:loadingPlatformHeight rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf :vehicleTypeTechnicalDataCharacteristic ;
                       rdfs:domain :VehicleType ;
                       rdfs:range xsd:integer ;
                       :eratvIndex "4.8.7" ;
                       <http://purl.org/dc/terms/created> "2021-08-31"^^xsd:date ;
                       <http://purl.org/dc/terms/modified> "2021-08-31"^^xsd:date ;
                       rdfs:comment "Height of loading platform (for flat wagons and combined transport), given in mm."@en ;
                       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                       rdfs:label "Loading platform height"@en ;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/localRulesOrRestrictions
:localRulesOrRestrictions rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf :rulesDataParameter ;
                          rdf:type owl:FunctionalProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( :CommonCharacteristicsSubset
                                                      :OperationalPoint
                                                      :RunningTrack
                                                    )
                                      ] ;
                          rdfs:range xsd:boolean ;
                          :XMLName "RUL_LocalRulesOrRestrictions" ;
                          :applicable "Y/N" ;
                          :formatNote "Y/N" ;
                          :legalDeadline "1 January 2021"@en ;
                          :rinfIndex "1.1.1.4.1" ,
                                     "1.2.3.1" ;
                          :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LocalRulesOrRestrictions> ;
                          <http://purl.org/dc/terms/created> "2021-08-09"^^xsd:date ;
                          <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                              "2025-03-11"^^xsd:date ;
                          rdfs:comment "Existence of rules and restrictions of a strictly local nature"@en ;
                          rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                          rdfs:label "Existence of rules and restrictions of a strictly local nature"@en ;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> """There is a general obligation for Member States to notify existing national rules but:  Member States may decide not to notify rules and restrictions of a strictly local nature. In such cases, Member States shall mention those rules and restrictions in the registers of infrastructure.
In this eventuality, this parameter allows the IM accordingly to its Member State decision to declare the existence of such rules and to provide them with the parameter 'Documents regarding the rules or restrictions of a strictly local nature available by the IM'"""@en .


###  http://data.europa.eu/949/mNvderun
:mNvderun rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf :etcsNationalValuesDataParameter ;
          rdf:type owl:FunctionalProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :CommonCharacteristicsSubset
                                      :RunningTrack
                                    )
                      ] ;
          rdfs:range xsd:boolean ;
          :applicable "Y/N/NYA" ;
          :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
          :legalDeadline "12 months after publication of Article 7 Guide"@en ;
          :rinfIndex "1.1.1.3.2.16.10" ,
                     "1.2.1.1.1.16.10" ;
          :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MNvderun> ,
                                    <http://data.europa.eu/949/shapes/MNvderunApplicability> ;
          :tsiOPEAppendixD3Index "1.5.10" ;
          <http://purl.org/dc/terms/created> "2022-11-07"^^xsd:date ;
          <http://purl.org/dc/terms/modified> "2023-03-14"^^xsd:date ,
                                              "2023-04-18"^^xsd:date ;
          <http://purl.org/dc/terms/relation> :etcsLevelType ;
          <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
          rdfs:comment "Entry of Driver ID permitted while running According to the specification referenced in Appendix A-1, index [C]"@en ;
          rdfs:isDefinedBy <http://data.europa.eu/949/> ;
          rdfs:label "M_NVDERUN"@en ;
          rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "See: TSI CCS (Subset 26, chapter 7. 7.5.1.75 M_NVDERUN)"@en .


