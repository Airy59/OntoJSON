###  http://data.europa.eu/949/startLocation
:startLocation rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :tunnelObjParameter ,
                                  <http://www.opengis.net/ont/geosparql#hasGeometry> ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :Tunnel ;
               rdfs:range <http://www.opengis.net/ont/sf#Point> ;
               :XMLName "SOLTunnelStart" ;
               :rinfIndex "1.1.1.1.8.3" ;
               :shaclShapeValidationRule <http://data.europa.eu/949/shapes/StartLocation> ;
               <http://purl.org/dc/terms/created> "2020-07-29"^^xsd:date ;
               <http://purl.org/dc/terms/modified> "2024-02-05"^^xsd:date ;
               rdfs:comment """Part of the Start of tunnel that indicates the Geographical coordinates according to the standard World Geodetic System (WGS). Precision for both geographical latitude and geographical longitude is assumed as [NN.NNNNNNN] in degrees with decimals what gives discretion of 10 cm in the network.
The Start of tunnel is the Geographical coordinates in decimal degrees and km of the line at the beginning of a tunnel."""@en ;
               rdfs:isDefinedBy <http://data.europa.eu/949/> ;
               rdfs:label "Start of tunnel location"@en ;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


