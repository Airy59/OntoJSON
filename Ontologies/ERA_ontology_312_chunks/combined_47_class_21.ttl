#################################################################
#    Classes
#################################################################

###  http://data.europa.eu/949/Body
:Body rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Class ;
                        owl:unionOf ( <http://www.w3.org/ns/org#Organization>
                                      <http://xmlns.com/foaf/0.1/Person>
                                    )
                      ] ;
      owl:disjointWith :InfrastructureElement ,
                       :OrganisationRole ;
      :shaclShapeValidationRule <http://data.europa.eu/949/shapes/BodyRoleShape> ;
      <http://purl.org/dc/terms/created> "2024-06-03"^^xsd:date ;
      <http://purl.org/dc/terms/modified> "2025-02-18"^^xsd:date ;
      <http://purl.org/dc/terms/replaces> :InfrastructureManager ,
                                          :Manufacturer ,
                                          :VehicleKeeper ;
      rdfs:comment "Is an organisation or a physical person"@en ;
      rdfs:isDefinedBy <http://data.europa.eu/949/> ;
      rdfs:label "Body"@en .


###  http://data.europa.eu/949/Bridge
:Bridge rdf:type owl:Class ;
        rdfs:subClassOf :InfrastructureElement ;
        owl:disjointWith :HABD ,
                         :KilometricPost ,
                         :LevelCrossing ,
                         :OperationalPoint ,
                         :PlatformEdge ,
                         :PrimaryLocation ,
                         :RadioBlockCenter ,
                         :RunningTrack ,
                         :SectionOfLine ,
                         :Siding ,
                         :Signal ,
                         :SpecialArea ,
                         :Switch ,
                         :Track ,
                         :Tunnel ;
        <http://purl.org/dc/terms/modified> "2025-01-30"^^xsd:date ,
                                            "2025-03-01"^^xsd:date ;
        rdfs:comment "It is a structure constructed for the exclusive purpose of carrying railroad traffic across an obstruction. It can be used for defining non-stopping areas, big metal mass, resistance to traffic load etc."@en ;
        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
        rdfs:label "Bridge"@en .


###  http://data.europa.eu/949/Certificate
:Certificate rdf:type owl:Class ;
             <http://purl.org/dc/terms/created> "2022-06-15"^^xsd:date ;
             <http://purl.org/dc/terms/modified> "2022-06-15"^^xsd:date ,
                                                 "2024-10-24"^^xsd:date ;
             rdfs:comment "Certificate of a vehicle type. Can be in one of the following states: Amended, New, Suspended, Withdrawn."@en ;
             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
             rdfs:label "Certificate"@en ;
             owl:deprecated "true"^^xsd:boolean ;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/CommonCharacteristicsSubset
:CommonCharacteristicsSubset rdf:type owl:Class ;
                             rdfs:subClassOf rdf:List ;
                             :shaclShapeValidationRule <http://data.europa.eu/949/shapes/CommonCharacteristicsSubsetShape> ;
                             <http://purl.org/dc/terms/created> "2022-11-04"^^xsd:date ;
                             <http://purl.org/dc/terms/modified> "2023-03-14"^^xsd:date ,
                                                                 "2024-10-31"^^xsd:date ;
                             rdfs:comment "A set of different infrastructure objects sharing the same common technical characteristics. The parameters may not be restricted to only one railway subsystem, but it can include common characteristics from each one of them (infrastructure, energy, track-side CCS)"@en ;
                             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                             rdfs:label "Subset with common characteristics"@en ;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


