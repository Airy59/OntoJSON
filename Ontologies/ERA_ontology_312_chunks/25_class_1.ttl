                       <http://www.w3.org/2004/02/skos/core#altLabel> "Appendix D3 index"@en ;
                       rdfs:range xsd:string .


###  http://data.europa.eu/949/unitOfMeasure
:unitOfMeasure rdf:type owl:AnnotationProperty ;
               <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
               <http://purl.org/dc/terms/modified> "2024-08-13"^^xsd:date ;
