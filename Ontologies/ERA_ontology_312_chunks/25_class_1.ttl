###  http://data.europa.eu/949/TSIMagneticFields
:TSIMagneticFields rdf:type owl:ObjectProperty ;
                   rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                   :applicable "Y/N/NYA" ;
                   :inSkosConceptScheme <http://data.europa.eu/949/concepts/tsi-existence-and-compliances/TSIExistenceAndCompliances> ;
                   :legalDeadline "12 months after publication of Article 7 Guide"@en ,
                                  "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                   :rinfIndex "1.1.1.3.9.1" ,
                              "1.2.1.1.8.1" ;
                   <http://purl.org/dc/terms/created> "2021-08-09"^^xsd:date ;
                   <http://purl.org/dc/terms/isReplacedBy> :tsiMagneticFields ;
                   <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                       "2024-04-25"^^xsd:date ,
                                                       "2025-03-04"^^xsd:date ;
                   rdfs:comment "Indication whether rules exist and are compliant with the TSI."@en ;
                   rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                   rdfs:label "Existence and TSI compliance of rules for magnetic fields emitted by a vehicle"@en ;
                   rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index077_-_ERA_ERTMS_033281_v5.pdf"^^xsd:anyURI ;
                   owl:deprecated "true"^^xsd:boolean ;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/TSITractionHarmonics
:TSITractionHarmonics rdf:type owl:ObjectProperty ;
                      rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                      :applicable "Y/N/NYA" ;
                      :inSkosConceptScheme <http://data.europa.eu/949/concepts/tsi-compliances/TSICompliances> ;
                      :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en ,
                                     "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                      :rinfIndex "1.1.1.3.9.2" ,
                                 "1.2.1.1.8.2" ;
                      <http://purl.org/dc/terms/created> "2021-08-09"^^xsd:date ;
                      <http://purl.org/dc/terms/isReplacedBy> :tsiTractionHarmonics ;
                      <http://purl.org/dc/terms/modified> "2021-09-12"^^xsd:date ,
                                                          "2025-03-04"^^xsd:date ;
                      <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                      rdfs:comment "Indication whether rules exist and are compliant with the TSI."@en ;
                      rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                      rdfs:label "Existence and TSI compliance of limits in harmonics in the traction current of vehicles"@en ;
                      owl:deprecated "true"^^xsd:boolean ;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> """Compatibility with track circuits and wheel detectors of axle counters. The harmonics in the traction current in the rails can interfere with the operation of track circuits. The DC current in the rails may saturate the detectors of the axle counters, preventing their  operation.
 none  shall be selected when respective national rules do not exist."""@en .


###  http://data.europa.eu/949/accelerationLevelCrossing
:accelerationLevelCrossing rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf :healthSafetyAndEnvironmentObjParameter ;
                           rdf:type owl:FunctionalProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( :CommonCharacteristicsSubset
                                                       :Track
                                                     )
                                       ] ;
                           rdfs:range :Document ;
                           :XMLName "IHS_AccelerationLevelCrossing" ;
                           :applicable "Y/N" ;
                           :dependencyNote "Mandatory value when the level crossing is defined"@en ;
                           :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                           :rinfIndex "1.1.1.1.7.3" ;
                           :shaclShapeValidationRule <http://data.europa.eu/949/shapes/AccelerationLevelCrossing> ,
                                                     <http://data.europa.eu/949/shapes/AccelerationLevelCrossingApplicability> ;
                           <http://purl.org/dc/terms/created> "2021-08-03"^^xsd:date ;
                           <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                                               "2024-11-20"^^xsd:date ;
                           rdfs:comment "Existence of limit for acceleration of train if stopping or recovering speed close to a level crossing expressed in a specific reference acceleration curve."@en ;
                           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                           rdfs:label "Acceleration allowed near level crossing"@en ;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                           <http://www.w3.org/2004/02/skos/core#scopeNote> """The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .


###  http://data.europa.eu/949/additionalBrakingInformationDocument
:additionalBrakingInformationDocument rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf :brakeRelatedObjParameter ;
                                      rdfs:domain [ rdf:type owl:Class ;
                                                    owl:unionOf ( :CommonCharacteristicsSubset
                                                                  :RunningTrack
                                                                )
                                                  ] ;
                                      rdfs:range :Document ;
                                      :XMLName "CBP_BrakePerfDocRef" ;
                                      :applicable "Y/N" ;
                                      :dependencyNote "Only applicable when for parameter 1.1.1.3.11.2 True is selected"@en ;
                                      :legalDeadline "16 January 2020"@en ;
                                      :rinfIndex "1.1.1.3.11.3" ;
                                      :shaclShapeValidationRule <http://data.europa.eu/949/shapes/AdditionalBrakingInformationDocument> ,
                                                                <http://data.europa.eu/949/shapes/AdditionalBrakingInformationDocumentApplicability> ;
                                      :usedInRCCCalculations "true"^^xsd:boolean ;
                                      <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                                      <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                                                          "2024-04-23"^^xsd:date ;
                                      rdfs:comment "Electronic document available in two EU languages from the IM stored by the Agency providing additional information as defined in point (2) of point 4.2.2.6.2 of TSI OPE."@en ;
                                      rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                                      rdfs:label "Documents available by the IM relating to braking performance"@en ;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                                      <http://www.w3.org/2004/02/skos/core#changeNote> "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
                                      <http://www.w3.org/2004/02/skos/core#scopeNote> """The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .


###  http://data.europa.eu/949/aggregates
:aggregates rdf:type owl:ObjectProperty ;
            rdfs:domain :NonLinearElement ;
            rdfs:range :LinearElement ;
            :shaclShapeValidationRule <http://data.europa.eu/949/shapes/Aggregates> ;
            <http://purl.org/dc/terms/created> "2024-11-29"^^xsd:date ;
            rdfs:comment "Specifies the linear elements aggregated by a non-linear element."@en ;
