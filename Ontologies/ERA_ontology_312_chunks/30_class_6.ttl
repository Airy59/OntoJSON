                              rdfs:domain :Vehicle ;
                              rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                              :inSkosConceptScheme <http://publications.europa.eu/resource/authority/country> ;
                              <http://purl.org/dc/terms/created> "2020-11-23"^^xsd:date ;
