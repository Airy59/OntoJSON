                :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
                :inSkosConceptScheme <http://data.europa.eu/949/concepts/adhf-qualifier/AdhesionFactorChange> ;
                :legalDeadline "12 months after publication of Article 7 Guide"@en ;
                :rinfIndex "1.1.1.3.2.16.11" ,
                           "1.2.1.1.1.16.11" ;
                :shaclShapeValidationRule <http://data.europa.eu/949/shapes/QNvdriverAdhes> ,
                                          <http://data.europa.eu/949/shapes/QNvdriverAdhesApplicability> ,
                                          <http://data.europa.eu/949/shapes/QNvdriverAdhesSKOS> ;
                :tsiOPEAppendixD3Index "1.5.11" ;
                <http://purl.org/dc/terms/created> "2024-04-18"^^xsd:date ;
                <http://purl.org/dc/terms/modified> "2024-09-20"^^xsd:date ;
                <http://purl.org/dc/terms/relation> :etcsLevelType ;
                <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
                rdfs:comment """Qualifier determining whether the driver is allowed to modify the adhesion factor used by the ETCS on-board to calculate the braking curves.
According to the specification referenced in Appendix A-1, index [C]"""@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Q_NVDRIVER_ADHES"@en ;
                rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "See: TSI CCS (Subset 26, chapter 7. 7.5.1.122 Q_NVDRIVER_ADHES)"@en .


###  http://data.europa.eu/949/qNvemrrls
:qNvemrrls rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :etcsNationalValuesObjParameter ;
           rdf:type owl:FunctionalProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :CommonCharacteristicsSubset
                                       :RunningTrack
                                     )
                       ] ;
           rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
           :applicable "Y/N/NYA" ;
           :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
           :inSkosConceptScheme <http://data.europa.eu/949/concepts/ebr-qualifier/EBReleaseQualifier> ;
           :legalDeadline "12 months after publication of Article 7 Guide"@en ;
           :rinfIndex "1.1.1.3.2.16.2" ,
                      "1.2.1.1.1.16.2" ;
           :shaclShapeValidationRule <http://data.europa.eu/949/shapes/QNvemrrls> ,
                                     <http://data.europa.eu/949/shapes/QNvemrrlsApplicability> ,
                                     <http://data.europa.eu/949/shapes/QNvemrrlsSKOS> ;
           :tsiOPEAppendixD3Index "1.5.2" ;
           <http://purl.org/dc/terms/created> "2023-03-14"^^xsd:date ;
           <http://purl.org/dc/terms/modified> "2024-04-18"^^xsd:date ;
           <http://purl.org/dc/terms/relation> :etcsLevelType ;
           <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
           rdfs:comment """Qualifier defining whether the application of the emergency brake for reasons other than a trip can be revoked as soon as the conditions for it have disappeared or after the train has come to a complete standstill.
According to the specification referenced in Appendix A-1, index [C]"""@en ;
           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
           rdfs:label "Q_NVEMRRLS"@en ;
           rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "According to the specification referenced in Appendix A-1, index [C] - TSI CCS (Subset-026, chapter 7, 7.5.1.123 Q_NVEMRRLS)"@en .


###  http://data.europa.eu/949/quieterRoutesExemptedCountry
:quieterRoutesExemptedCountry rdf:type owl:ObjectProperty ;
