###  http://data.europa.eu/949/platformHeight
:platformHeight rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :platformObjParameter ;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :CommonCharacteristicsSubset
                                            :PlatformEdge
                                          )
                            ] ;
                rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                :XMLName "IPL_Height" ;
                :applicable "Y/" ;
                :inSkosConceptScheme <http://data.europa.eu/949/concepts/platform-heights/PlatformHeights> ;
                :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                :rinfIndex "1.2.1.0.6.5" ;
                :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PlatformHeightP> ,
                                          <http://data.europa.eu/949/shapes/PlatformHeightSKOS> ;
                :tsiOPEAppendixD2Index "2.3.7" ;
                :usedInRCCCalculations "true"^^xsd:boolean ;
                <http://purl.org/dc/terms/created> "2021-08-02"^^xsd:date ;
                <http://purl.org/dc/terms/modified> "2021-08-02"^^xsd:date ,
                                                    "2024-09-19"^^xsd:date ,
                                                    "2025-03-11"^^xsd:date ;
                <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ,
                                                  <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
                rdfs:comment "Distance between the upper surface of platform and running surface of the neighbouring track. It is the nominal value expressed in millimetres."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "Height of platform"@en ;
                rdfs:seeAlso """INF TSI: 4.2.9.2
PRM TSI: 4.2.2.11
OPE TSI: 2.3.7 of Appendix D2""" ;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> """Values included in the list are taken from PRM and INF TSIs including Specific Cases. They are the values which are mandatory for the design of the platform at the respective part of the network. They are not real values measured at real platforms.
Platform dimensions are always related to one neighbouring track at a time.
So, if two tracks are along a platform, this platform should be divided into two or more â€˜RINF platformsâ€™ to have precise description of each."""@en .


