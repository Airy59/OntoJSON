                             rdfs:label "minimum Vehicle Impedance (Voltage applicable)"@en ;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/minimumVerticalRadius
:minimumVerticalRadius rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :sidingObjParameter ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( :CommonCharacteristicsSubset
                                                   :Siding
                                                 )
                                   ] ;
                       rdfs:range :MinimumVerticalRadius ;
                       :XMLName "ILL_MinRadVertCurve" ;
                       :applicable "Y/N" ;
                       :formatNote """In RDF: the values points to an instance of era:MinimumVerticalRadius class with 2 properties for the crest and hollow values.
                                                  In XML: NNN+NNN"""@en ;
                       :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                       :rinfIndex "1.2.2.0.3.3" ;
                       :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MinimumVerticalRadius> ;
                       :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
                       :usedInRCCCalculations "true"^^xsd:boolean ;
                       <http://purl.org/dc/terms/created> "2020-08-24"^^xsd:date ;
                       <http://purl.org/dc/terms/modified> "2023-04-05"^^xsd:date ,
                                                           "2024-09-19"^^xsd:date ,
                                                           "2024-12-12"^^xsd:date ,
                                                           "2025-03-11"^^xsd:date ;
                       <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2019-06-16> ;
                       rdfs:comment "Radius of the smallest vertical curve expressed in metres."@en ;
                       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                       rdfs:label "Minimum radius of vertical curve"@en ;
                       rdfs:seeAlso "INF TSI: 4.2.3.54" ;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "The radius of vertical curves (except for humps in marshalling yards) shall be at least 500 m on a crest or 900 m in a hollow."@en .


###  http://data.europa.eu/949/nationalLine
:nationalLine rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :solGenericObjParameter ;
              rdfs:domain :SectionOfLine ;
              rdfs:range :LinearPositioningSystem ;
              :XMLName "SOLLineIdentification" ;
              :rinfIndex "1.1.0.0.0.2" ;
              :shaclShapeValidationRule <http://data.europa.eu/949/shapes/NationalLineSoL> ;
              <http://purl.org/dc/terms/created> "2024-05-24"^^xsd:date ;
              <http://purl.org/dc/terms/modified> "2024-10-24"^^xsd:date ,
                                                  "2024-11-18"^^xsd:date ,
                                                  "2024-11-29"^^xsd:date ,
                                                  "2025-02-18"^^xsd:date ,
                                                  "2025-03-11"^^xsd:date ;
              <http://purl.org/dc/terms/replaces> :lineNationalId ,
                                                  :lineReference ;
              rdfs:comment """Indicates a relationship with a national railway line at a specific kilometer point.
For a Section of Line: unique line identification or unique line number within Member State."""@en ;
              rdfs:isDefinedBy <http://data.europa.eu/949/> ;
              rdfs:label "national line identification"@en ;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> """Each SoL can belong to only one national line.

In case when SoL is the track connecting between OPs within big node (resulting from division of big station into several smaller) the line can be identified using the name of this track."""@en .


###  http://data.europa.eu/949/navigability
:navigability rdf:type owl:ObjectProperty ;
              rdfs:domain :NetRelation ;
              rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
              :inSkosConceptScheme <http://data.europa.eu/949/concepts/navigabilities/Navigabilities> ;
              :rinfIndex "1.1.1.0.1.2" ,
                         "1.2.4.1" ;
              :shaclShapeValidationRule <http://data.europa.eu/949/shapes/Navigability> ,
                                        <http://data.europa.eu/949/shapes/NavigabilitySKOS> ;
              <http://purl.org/dc/terms/created> "2021-04-01"^^xsd:date ;
              <http://purl.org/dc/terms/modified> "2021-08-03"^^xsd:date ,
                                                  "2024-11-29"^^xsd:date ;
              rdfs:comment "Indicates the navigation possibilities between two related topological linear elements."@en ;
              rdfs:isDefinedBy <http://data.europa.eu/949/> ;
              rdfs:label "Navigability"@en ;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Internal connection"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> """â€¢	AB: Trains can move from element A to element B.
â€¢	BA: Trains can move from element B to element A.
â€¢	Both: Movement is bidirectional.
â€¢	None: No movement is allowed between the two elements.
"""@en .


###  http://data.europa.eu/949/netElement
:netElement rdf:type owl:ObjectProperty ;
            <http://purl.org/dc/terms/created> "2021-04-01"^^xsd:date ;
            <http://purl.org/dc/terms/modified> "2022-09-06"^^xsd:date ;
            rdfs:comment """References an associated topological object.
The reason for deprecating this property is that it is defined as \"References an associated topological object.\" and the vocabulary has already a property \"hasAbstraction\" which relates the implementation layer with the topological layer, https://citnet.tech.ec.europa.eu/CITnet/confluence/pages/viewpage.action?pageId=1122974879."""@en ;
            rdfs:isDefinedBy <http://data.europa.eu/949/> ;
            rdfs:label "Net element"@en ;
            owl:deprecated "true"^^xsd:boolean ;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


