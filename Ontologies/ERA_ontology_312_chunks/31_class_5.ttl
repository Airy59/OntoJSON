:lineNationalId rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :LineReference
                                            :SectionOfLine
                                          )
                            ] ;
                rdfs:range :NationalRailwayLine ;
                :XMLName "SOLLineIdentification" ;
                :rinfIndex "1.1.0.0.0.2" ;
                :tsiOPEAppendixD2Index "2.2.1.1" ;
                <http://purl.org/dc/terms/created> "2020-09-30"^^xsd:date ;
                <http://purl.org/dc/terms/isReplacedBy> :nationalLine ;
                <http://purl.org/dc/terms/modified> "2023-03-14"^^xsd:date ,
                                                    "2024-09-19"^^xsd:date ,
                                                    "2024-10-28"^^xsd:date ;
                rdfs:comment "Unique line identification or unique line number within Member State."@en ;
                rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                rdfs:label "(deprecated) National line identification"@en ;
                owl:deprecated "true"^^xsd:boolean ;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


