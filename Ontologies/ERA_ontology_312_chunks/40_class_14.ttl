           :applicable "Y/N" ;
           :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
           :rinfIndex "1.2.0.0.0.6" ;
           :shaclShapeValidationRule <http://data.europa.eu/949/shapes/Kilometer> ;
           :tsiOPEAppendixD2Index "2.2.2" ;
           :unitOfMeasure <http://qudt.org/vocab/unit/KiloM> ;
           <http://purl.org/dc/terms/created> "2021-01-29"^^xsd:date ;
           <http://purl.org/dc/terms/modified> "2021-01-29"^^xsd:date ,
                                               "2024-09-19"^^xsd:date ,
                                               "2024-10-24"^^xsd:date ,
                                               "2025-01-30"^^xsd:date ;
           <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
           rdfs:comment "Kilometer number of the kilometric post related to line identification defining the location of an infrastructure element."@en ;
           rdfs:isDefinedBy <http://data.europa.eu/949/> ;
           rdfs:label "kilometer number"@en ;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "Railway location of Operational point"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> """For walkways: Value provided in Kilometric point of the start of the walkway and the length in m. Repeatable values for each location.
For rescue points: Value provided in Kilometric point of the start of the point of evacuation and rescue point and the length in m. Repeatable values for each location.
For signals: Relative position to the line identified under parameter 1.1.0.0.0.2, given in km ([reference point, via era:referent] / [NNN.NNN] )."""@en .


###  http://data.europa.eu/949/kmPostName
:kmPostName rdf:type owl:DatatypeProperty ;
            rdfs:domain :KilometricPost ;
            rdfs:range xsd:string ;
            :shaclShapeValidationRule <http://data.europa.eu/949/shapes/KmPostName> ;
            <http://purl.org/dc/terms/created> "2024-05-24"^^xsd:date ;
            <http://purl.org/dc/terms/modified> "2024-10-24"^^xsd:date ,
                                                "2024-11-29"^^xsd:date ,
                                                "2025-03-10"^^xsd:date ;
            rdfs:comment "Name of the kilometric post (optional)."@en ;
            rdfs:isDefinedBy <http://data.europa.eu/949/> ;
            rdfs:label "kilometric post name"@en ;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "mileage post"@en .


###  http://data.europa.eu/949/length
:length rdf:type owl:DatatypeProperty ;
        :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
        :usedInRCCCalculations "true"^^xsd:boolean ;
        <http://purl.org/dc/terms/created> "2021-04-01"^^xsd:date ;
        <http://purl.org/dc/terms/modified> "2024-01-08"^^xsd:date ,
                                            "2024-11-04"^^xsd:date ;
        rdfs:comment "Generic super-property for different types of length"@en ;
        rdfs:isDefinedBy <http://data.europa.eu/949/> ;
        rdfs:label "Length"@en ;
        rdfs:seeAlso "ERA" ;
        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> """Position of the start of the walkway:  [integer] m (from the same origin point of the kilometer post.)
Lenght of the walkway: [integer] m"""@en ,
                                                        """The length can be
- a section of line (For operational length, use era:lengthOfSectionOfLine),
- a tunnel (For operational length, use era:lengthOfTunnel),
- a platform (For its usable length, use era:lengthOfPlatform),
- a siding (For its usable length, use era:lengthOfSiding), and
- length of other areas such as
  - a non-stopping area (accuracy +- 10m),
  - a walkway,
  - an evacuation and rescue point.
- a vehicle length."""@en .


###  http://data.europa.eu/949/lengthOfNetLinearElement
:lengthOfNetLinearElement rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf :length ;
                          rdf:type owl:FunctionalProperty ;
                          rdfs:domain :LinearElement ;
                          rdfs:range xsd:double ;
                          :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LengthOfNetLinearElement> ;
                          :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
                          <http://purl.org/dc/terms/created> "2024-11-29"^^xsd:date ;
                          rdfs:comment "Length of a topological linear element."@en ;
                          rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                          rdfs:label "length of net linear element"@en .


###  http://data.europa.eu/949/lengthOfPlatform
:lengthOfPlatform rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf :length ,
                                     :platformDataParameter ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain :PlatformEdge ;
                  rdfs:range xsd:double ;
                  :XMLName "IPL_Length" ;
                  :applicable "Y/N" ;
                  :formatNote "NNNN" ;
                  :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                  :rinfIndex "1.2.1.0.6.4" ;
                  :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LengthP> ;
                  :tsiOPEAppendixD2Index "2.3.6" ,
                                         "3.2.3" ;
                  :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
                  :usedInRCCCalculations "true"^^xsd:boolean ;
                  <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
                  <http://purl.org/dc/terms/modified> "2024-09-19"^^xsd:date ,
                                                      "2025-03-11"^^xsd:date ;
                  <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ,
                                                    <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
                  rdfs:comment "The maximum continuous length (expressed in metres) of that part of platform in front of which a train is intended to remain stationary in normal operating conditions for passengers to board and alight from the train, making appropriate allowance for stopping tolerances."@en ;
                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                  rdfs:label "Usable length of platform"@en ;
                  rdfs:seeAlso """INF TSI: 4.2.1, 4.2.9.1
OPE TSI: 4.2.2.5.2, 4.2.2.7.2""" ;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> """Platform dimensions are always related to one neighbouring track at a time.
So, if two tracks are along a platform, this platform should be divided into two RINF platforms to have precise description of each."""@en .


###  http://data.europa.eu/949/lengthOfSectionOfLine
:lengthOfSectionOfLine rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf :length ,
                                          :solGenericDataParameter ;
                       rdf:type owl:FunctionalProperty ;
                       rdfs:domain :SectionOfLine ;
                       rdfs:range xsd:double ;
                       :XMLName "SOLLength" ;
                       :applicable "Y" ;
                       :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
                       :rinfIndex "1.1.0.0.0.5" ;
                       :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SolLength> ;
                       :tsiOPEAppendixD2Index "3.2.3" ;
                       :unitOfMeasure <http://qudt.org/vocab/unit/KiloM> ;
                       :usedInRCCCalculations "true"^^xsd:boolean ;
                       <http://purl.org/dc/terms/created> "2024-05-16"^^xsd:date ;
                       <http://purl.org/dc/terms/modified> "2025-03-11"^^xsd:date ;
                       rdfs:comment "Length between operational points at start and end of section of line."@en ;
                       rdfs:isDefinedBy <http://data.europa.eu/949/> ;
                       rdfs:label "Length of section of line"@en ;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://data.europa.eu/949/lengthOfSiding
:lengthOfSiding rdf:type owl:DatatypeProperty ;
