:hasRelatedTransportOperationalIdentifiers rdfs:domain :TrainOperationalIdentification .

:hasRollingRoadUnit a owl:ObjectProperty ;
    rdfs:label "has RollingRoadUnit" ;
    rdfs:domain :GoodsInWagon ;
    rdfs:range :RollingRoadUnit .

:hasRollingRoadUnitDetails a owl:ObjectProperty ;
    rdfs:label "has RollingRoadUnitDetails" ;
    rdfs:domain :RollingRoadUnit ;
    rdfs:range :RollingRoadUnitDetails .

:hasRollingStockDataset a owl:ObjectProperty ;
    rdfs:label "has RollingStockDataset" ;
    rdfs:domain [ ] ;
    rdfs:range :RollingStockDataset .

:hasRouting rdfs:domain :WagonStatusMessage .

:hasSectionFrom rdfs:domain :Carriers .

:hasSectionTo rdfs:domain :Carriers .

:hasShippingLocation rdfs:domain :WagonStatusMessage .

