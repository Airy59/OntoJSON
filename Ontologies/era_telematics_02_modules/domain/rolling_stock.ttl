    rdfs:domain :COM ;
    rdfs:range :Wagons .

:sequenceID rdfs:domain :Carriers .

:TrainActivity a owl:Class ;
    rdfs:label "TrainActivity" ;
    rdfs:comment """Since the activites can be related to attaching / detaching of wagons
				and/or cars to different trains, the reference to other trains should be possible to
				be indicated.""" .

:TrainID a owl:Class ;
    rdfs:label "TrainID" .

:TrainLocation a owl:Class ;
    rdfs:label "TrainLocation" ;
    rdfs:comment """Handover, Interchange, Handling and Reporting point: if
							needed, track could be identify directly via subsidiar code """ .

:WagonTelematics a owl:Class ;
    rdfs:label "WagonTelematics" ;
    rdfs:comment """Information about telematics
										devices mounted on the wagon.""" .

:CarriersInvolved a owl:Class ;
    rdfs:label "CarriersInvolved" .

:RollingStockDatasetQueryMessage a owl:Class ;
    rdfs:label "RollingStockDatasetQueryMessage" ;
    rdfs:comment "Rolling Stock adminsitrative and Technical Dataset" .

:TrainRunningInterruptionStatus a owl:Class ;
    rdfs:label "TrainRunningInterruptionStatus" .

:Vehicles a owl:Class ;
    rdfs:label "Vehicles" ;
    rdfs:comment """List of vehicles loaded (i.e. truck and
										trailer).""" .

:WagonAtDeparture a owl:Class ;
    rdfs:label "WagonAtDeparture" ;
    rdfs:comment "Departure point of a wagon with location and departure time" .

:WagonPickupAtOrigin a owl:Class ;
    rdfs:label "WagonPickupAtOrigin" ;
    rdfs:comment """Place and Date and Time of when the wagon is ready to be taken over by
				the RU/Service Provider at the customer sidings""" .

:WagonStatusMessages a owl:Class ;
    rdfs:label "WagonStatusMessages" ;
    rdfs:comment """Always MANDATORY, independent whether only one or more messages are in
				the file """ .

:Carrier a owl:Class ;
    rdfs:label "Carrier" ;
    rdfs:comment "Carrier(s) involved" .

:ReferenceTrainIDSubCalendar a owl:Class ;
    rdfs:label "ReferenceTrainIDSubCalendar" ;
    rdfs:comment """ReferenceTrainIDSubCalendar contains all days of Reference Train
				(TRIDv00) for days provided in PlannedCalendar. The days in PlannedCalendar may
				shifted depending on value in element OffsetToReference, ie the following condition
				must always be true : ReferenceTrainIDSubCalendar + OffsetToReference =
				PlannedCalender\"""" .

:RollingStockDataset a owl:Class ;
    rdfs:label "RollingStockDataset" ;
    rdfs:comment "Rolling Stock adminsitrative and Technical Dataset" .

:RollingStockDatasetMessage a owl:Class ;
    rdfs:label "RollingStockDatasetMessage" ;
    rdfs:comment "Rolling Stock adminsitrative and Technical Dataset" .

:TrainDelay a owl:Class ;
    rdfs:label "TrainDelay" ;
    rdfs:comment """Identifies the Delta delay time of a train against the booked schedule
				as well as against the referenced time """ .

:TrainJourneyModification a owl:Class ;
    rdfs:label "TrainJourneyModification" ;
    rdfs:comment """This element shows which locations are changed during the running of a
				train""" .

:TrainOperationalIdentification a owl:Class ;
    rdfs:label "TrainOperationalIdentification" .

:WagonJourneyIrregularity a owl:Class ;
    rdfs:label "WagonJourneyIrregularity" .

:OperationalTrainNumberIdentifier a owl:Class ;
    rdfs:label "OperationalTrainNumberIdentifier" .

:RefusedWagonNumbers a owl:Class ;
    rdfs:label "RefusedWagonNumbers" .

:RollingRoadUnit a owl:Class ;
    rdfs:label "RollingRoadUnit" ;
    rdfs:comment "Describes the type and content of a Rolling road unit" .

:TrainForecastAtReportingLocationMessage a owl:Class ;
    rdfs:label "TrainForecastAtReportingLocationMessage" ;
    rdfs:comment """This message is issued following receipt of an enquiry about train
				forecasts at a particular reporting location. It gives a report of the forecasted
				time for all trains of the enquirer at a specified location. """ .

:TrainInformation a owl:Class ;
    rdfs:label "TrainInformation" ;
    rdfs:comment """Train information provided by the RUs as an overview for the entire
				train journey from origin to destination""" .

:WagonEventInformation a owl:Class ;
    rdfs:label "WagonEventInformation" ;
    rdfs:comment """This is a WIMO element that is derived from the Wagon Release Notice
				and Event Messages""" .

:WagonTypeDetails a owl:Class ;
    rdfs:label "WagonTypeDetails" ;
    rdfs:comment """These elements are only needed, if the
											wagon has to be treated as CUV (empty wagon).""" .

:Train a owl:Class ;
    rdfs:label "Train" .

:TrainReadyStatus a owl:Class ;
    rdfs:label "TrainReadyStatus" .

:WagonETI_ETA_Message a owl:Class ;
    rdfs:label "WagonETI_ETA_Message" ;
    rdfs:comment """This message is sent by the RU to the next RU in the transport chain
				to give him the calculation of its ETI. The last RU sends this message with ETA to
				the Lead RU, which may inform its customer. Following the handover information from
				the IM, the RU sends with this message also the updated ETI to the next RU and the
				last RU sends the updated ETA to the LRU.""" .

:WagonInformation a owl:Class ;
    rdfs:label "WagonInformation" ;
    rdfs:comment """This element shows the unique wagon number together with the
				transportation units, loaded on the wagon, the used capacity and the weight of the
				complete load of the wagon""" .

:TrainCompositionJourneySection a owl:Class ;
    rdfs:label "TrainCompositionJourneySection" ;
    rdfs:comment "Defines the make up of a train for each section of its journey" .

:TrainRunningData a owl:Class ;
    rdfs:label "TrainRunningData" ;
    rdfs:comment "Train relevant data for a running train" .

:WagonData a owl:Class ;
    rdfs:label "WagonData" ;
    rdfs:comment "Wagon relevant data for the wagons within a running train" .

:Wagons a owl:Class ;
    rdfs:label "Wagons" ;
    rdfs:comment "Content of the wagon" .

:RollingRoadUnitDetails a owl:Class ;
    rdfs:label "RollingRoadUnitDetails" ;
    rdfs:comment "Details for Rolling Road units on wagon" .

:TrainCompositionMessage a owl:Class ;
    rdfs:label "TrainCompositionMessage" ;
    rdfs:comment """This message is sent from an RU to an IM defining the composition of
				the proposed train.""" .

:TrainLocationReport a owl:Class ;
    rdfs:label "TrainLocationReport" ;
    rdfs:comment """Specifies the relevant running data of a train related to a specific
				location""" .

:LeadCarrier a owl:Class ;
    rdfs:label "LeadCarrier" ;
    rdfs:comment "LeadCarrier/ Contractual carrier" .

:TrainAtLocation a owl:Class ;
    rdfs:label "TrainAtLocation" ;
    rdfs:comment "Specifies information about a train at a specific location" .

:TrainDelayCauseMessage a owl:Class ;
    rdfs:label "TrainDelayCauseMessage" ;
    rdfs:comment """This message is issued to make known the cause for additional delay
				during the Train's Journey (Changed name of the message from Reason to Cause)
				Description changed """ .

:TrainRunningForecastMessage a owl:Class ;
    rdfs:label "TrainRunningForecastMessage" ;
    rdfs:comment """This message is issued from the IM to the neighbouring IM upon
				departure from or movement past agreed points or prior to reaching the first
				reporting point if, owing to a delay, the train has not reached the bilaterally
				agreed initial running time. This message is also issued from the IM to the RU when,
				at the next stopping or handling station, out-of-schedule running is anticipated
				that exceeds the threshold agreed with the RU responsible for the train. This
				message is also issued in any cases for handover points, interchange points, for the
				destination point and for each other reporting point predefined by contract""" .

:TrainRunningInformationMessage a owl:Class ;
    rdfs:label "TrainRunningInformationMessage" ;
    rdfs:comment """This message is issued upon 1) Arrrival, departure or run-through in
				agreed reporting points and/or 2) Attainment of the agreed initial running time
				and/or 3) A new divergence between nominal and actual being achieved in excess of
				the agreed threshold value 4) as a response to the
				EnquiryTrainsAtReportingLocationMessage. There will only be one train reported per
				message and will include one response per train at a location.""" .

:PlannedTrainData a owl:Class ;
    rdfs:label "PlannedTrainData" ;
    rdfs:comment "Train relevant data for a planning period" .

:TrainRunningInterruptionMessage a owl:Class ;
    rdfs:label "TrainRunningInterruptionMessage" ;
    rdfs:comment """This message is used to inform about the trains which has been already
				interrupted. Message is sent only for those trains, directly interrupted by the
				disruption. """ .

:WagonOperationalData a owl:Class ;
    rdfs:label "WagonOperationalData" ;
    rdfs:comment """Actual wagon parameters, dependent on load or damage. This group and
				its elements are optional (contract defines what IM requires). But if there is
				dangerous goods in the train, then this group is mandatory.""" .

:TrainJourneyModificationMessage a owl:Class ;
    rdfs:label "TrainJourneyModificationMessage" ;
    rdfs:comment """ This message is issued to show, in real time, that the train is
				reroouted-cancelled-stopping pattern is changed""" .

:TrainReadyMessage a owl:Class ;
    rdfs:label "TrainReadyMessage" ;
    rdfs:comment """This message is sent from an RU to an IM indicating that the train is
				ready for access to the network.""" .

:TrainRunningTechData a owl:Class ;
    rdfs:label "TrainRunningTechData" ;
    rdfs:comment "Shows the relevant techical data for a running train" .

:WagonStatusMessage a owl:Class ;
    rdfs:label "WagonStatusMessage" ;
    rdfs:comment """used to describe one event of one wagon (all bounded
							elements are bounded to to obligations of legacy systems)""" .

:WagonTechData a owl:Class ;
    rdfs:label "WagonTechData" ;
    rdfs:comment """This element shows the wagon relevant technical data for the wagons
				within a running train""" .

:Carriers a owl:Class ;
    rdfs:label "Carriers" .

:GoodsInWagon a owl:Class ;
    rdfs:label "GoodsInWagon" ;
    rdfs:comment "Goods" .

:WagonDetails a owl:Class ;
    rdfs:label "WagonDetails" ;
    rdfs:comment "Details for the specific wagon" .

:PlannedTrainTechnicalData a owl:Class ;
    rdfs:label "PlannedTrainTechnicalData" ;
    rdfs:comment "Shows the relevant technical data for a running train" .

