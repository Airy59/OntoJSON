@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ArrivalTrackAtLocation a owl:Class ;
    rdfs:label "ArrivalTrackAtLocation" ;
    :domain "Telematics" ;
    rdfs:comment """Identifies the track of the arrival of a train at a reporting point.
				This is indicated in the LocationSubsidiaryCode in conjunction with the
				LocationPrimaryCode. """ .

:ChannelTunnelPermitted a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ChannelTunnelPermitted" ;
    rdfs:comment """Indication if wagon is allowed to pass the
										Channel Tunnel - if the transport is planned between UK and
										France and should use Eurotunnel infrastructure.""" ;
    rdfs:domain :AdministrativeDataSet ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :dataProperties .

:CommercialRouteCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CommercialRouteCode" ;
    rdfs:comment """Route code (RIP) when
																the customer agreement or the tariff
																applied provide for it. """ ;
    rdfs:domain :ChargingSections ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:DepartureTrackAtLocation a owl:Class ;
    rdfs:label "DepartureTrackAtLocation" ;
    :domain "Telematics" ;
    rdfs:comment """Indicates the track ID on which the train runs. The track of the
				departure of a train at a reporting point. This is indicated in the
				LocationSubsidiaryCode in conjunction with the LocationPrimaryCode.""" .

:DistancePrecision rdfs:domain :NetworkProjectedLocation .

:MaxPayload rdfs:domain :RouteClassPayloads .

:NumberOfVisibleSatellites rdfs:domain :SignalQuality .

:ProportionOfDistanceBetweenLocations rdfs:domain :NetworkProjectedLocation .

:QuieterRoutesExemptionCountry a owl:DatatypeProperty ;
    rdfs:label "QuieterRoutesExemptionCountry" ;
    rdfs:comment """ISO code of country where the wagon has an
										exemption in accordance with TSI Noise to run on quieter
										routes although it is not TSI noise compliant""" ;
    rdfs:domain :AdministrativeDataSet ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:RouteClass a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "RouteClass" ;
    rdfs:comment """Indication of the route class (based on CEN EN 15528: line categories for managing the interface between load limits of vehicles on infrastructure). All the codes in this code list refer to CEN EN 15528: line categories for managing the interface between load limits of vehicles on infrastructure.
CM2, CM3 and CM 4 equal M2, M3 and M4 which might be used in some legacy systems which only support two character codes.""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:RouteCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "RouteCode" ;
    rdfs:comment "Route code (International RouteCode)" ;
    rdfs:domain :RouteSection ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:RouteInformation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "RouteInformation" ;
    rdfs:comment """The route of the journey for a wagon / shipment or Intermodal unit
				assigned by the LRU""" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:RouteText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "RouteText" ;
    rdfs:comment """Description of the
																	specific route section""",
        "Description of the specific route section" ;
    rdfs:domain :RouteSection ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:SatelliteHDOP rdfs:domain :SignalQuality .

:SequenceID rdfs:domain :RouteSection .

:ShippingStationCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ShippingStationCode" ;
    rdfs:comment """UIC Code of the
																shipping station""" ;
    rdfs:domain :ControlLabel ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ShippingStationName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ShippingStationName" ;
    rdfs:comment """Name of the shipping
																station""" ;
    rdfs:domain :ControlLabel ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:TrafficTypeNetwork a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "TrafficTypeNetwork" ;
    rdfs:comment """The code of the company (IM) that has planning
							responsibilty of the network where the TrafficTypeCode applies. If
							NetworkCode isn't used, then the TrafficTypeCode must be a value in the
							common European list.""" ;
    rdfs:domain :TrafficType ;
    rdfs:subPropertyOf :dataProperties .

:hasGeoLocalisation rdfs:domain :GeoLocalisationOnNetwork .

:hasGeoLocalisationOnNetwork a owl:ObjectProperty ;
    rdfs:label "has GeoLocalisationOnNetwork" ;
    rdfs:domain [ ] ;
    rdfs:range :GeoLocalisationOnNetwork .

:hasLocationActualTrack a owl:ObjectProperty ;
    rdfs:label "has LocationActualTrack" ;
    rdfs:domain :ChangeofTrackMessage ;
    rdfs:range :LocationActualTrack .

:hasLocationPlannedTrack a owl:ObjectProperty ;
    rdfs:label "has LocationPlannedTrack" ;
    rdfs:domain :ChangeofTrackMessage ;
    rdfs:range :LocationPlannedTrack .

:hasNetworkProjectedLocation a owl:ObjectProperty ;
    rdfs:label "has NetworkProjectedLocation" ;
    rdfs:domain :GeoLocalisationOnNetwork ;
    rdfs:range :NetworkProjectedLocation .

:hasNetworkSpecificParameter a owl:ObjectProperty ;
    rdfs:label "has NetworkSpecificParameter" ;
    rdfs:domain [ ] ;
    rdfs:range :NetworkSpecificParameter .

:hasNextLocation rdfs:domain :NetworkProjectedLocation .

:hasProductionStation a owl:ObjectProperty ;
    rdfs:label "has ProductionStation" ;
    rdfs:domain [ ] ;
    rdfs:range :ProductionStation .

:hasRouteClassPayloads a owl:ObjectProperty ;
    rdfs:label "has RouteClassPayloads" ;
    rdfs:domain :LoadTable ;
    rdfs:range :RouteClassPayloads .

:hasRouteSection a owl:ObjectProperty ;
    rdfs:label "has RouteSection" ;
    rdfs:domain [ ] ;
    rdfs:range :RouteSection .

:hasSignalQuality a owl:ObjectProperty ;
    rdfs:label "has SignalQuality" ;
    rdfs:domain :GNSS_DynamicPosition ;
    rdfs:range :SignalQuality .

:hasStation a owl:ObjectProperty ;
    rdfs:label "has Station" ;
    rdfs:domain [ ] ;
    rdfs:range :Station .

:LocationActualTrack a owl:Class ;
    rdfs:label "LocationActualTrack" ;
    :domain "Telematics" .

:LocationPlannedTrack a owl:Class ;
    rdfs:label "LocationPlannedTrack" ;
    :domain "Telematics" .

:Station a owl:Class ;
    rdfs:label "Station" ;
    rdfs:comment "Details of station serving the point" .

:GeoLocalisationOnNetwork a owl:Class ;
    rdfs:label "GeoLocalisationOnNetwork" ;
    rdfs:comment "Geolocalisation information crossed with network data. " .

:NetworkSpecificParameter a owl:Class ;
    rdfs:label "NetworkSpecificParameter" ;
    rdfs:comment """The usage of this element must be specified in national rules and has
				to be defined by each IM""" .

:ProductionStation a owl:Class ;
    rdfs:label "ProductionStation" ;
    rdfs:comment """Details of production station serving the point, this element is used
				if the productional station differs from the commercial station""" .

:RouteClassPayloads a owl:Class ;
    rdfs:label "RouteClassPayloads" .

:SignalQuality a owl:Class ;
    rdfs:label "SignalQuality" ;
    rdfs:comment "Indicates satellite communication signal quality" .

:NetworkProjectedLocation a owl:Class ;
    rdfs:label "NetworkProjectedLocation" ;
    rdfs:comment "Projection of a geographical position on a network line. " .

:RouteSection a owl:Class ;
    rdfs:label "RouteSection" ;
    rdfs:comment "Route sequence",
        """Route sequence Sequential
													information about the complete routing of the
													consignment, the LeadRu decides wether to
													provide this information or not""" .

:ChangeofTrackMessage a owl:Class ;
    rdfs:label "ChangeofTrackMessage" ;
    rdfs:comment """ This message is issued to show that the train is arriving at another
				platform to the one that was scheduled""" .

[] rdf:first :ChangeofTrackMessage .

[] rdf:first :ChangeofTrackMessage .

[] rdf:first :ChangeofTrackMessage .

[] rdf:first :ChangeofTrackMessage .

[] rdf:first :ChangeofTrackMessage .

[] rdf:first :ChangeofTrackMessage .

[] rdf:first :ChangeofTrackMessage .

[] rdf:first :ChangeofTrackMessage .

[] rdf:first :NetworkSpecificParameter .

[] rdf:first :ProductionStation .

[] rdf:first :RouteClassPayloads .

[] rdf:first :ChangeofTrackMessage .

[] rdf:first :ChangeofTrackMessage .

[] rdf:first :NetworkSpecificParameter .

[] rdf:first :ProductionStation .

[] rdf:first :ChangeofTrackMessage .

