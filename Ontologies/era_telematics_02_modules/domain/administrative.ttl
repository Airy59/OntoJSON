@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:CoversNonTankWagonsForDangerousGoods rdfs:domain :ECMCertificate .

:CoversTankWagonsForDangerousGoods rdfs:domain :ECMCertificate .

:DateECMCertificateSuspended a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DateECMCertificateSuspended" ;
    rdfs:comment """Date of the suspension of the ECM
													certificate; must be provided in case of
													suspension""" ;
    rdfs:domain :ECMCertificate ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf :dataProperties .

:DocumentInformation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DocumentInformation" ;
    rdfs:comment """Additional information
																regarding the attached document may
																be entered here.""" ;
    rdfs:domain :AttachedDocuments ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:DocumentType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DocumentType" ;
    rdfs:comment """Type code of attached
																document. The UN/DIFACT 1001 list of
																codes is to be used to code
																accompanying documents.""" ;
    rdfs:domain :AttachedDocuments ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf :dataProperties .

:DocumentTypeDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DocumentTypeDescription" ;
    rdfs:comment """Description of
																document type, when it is not in the
																UN/EDIFACT 1001 list included.""" ;
    rdfs:domain :AttachedDocuments ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ECMCertificateSuspended a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ECMCertificateSuspended" ;
    rdfs:comment """Identification if certificate has
													been suspended for any reason""" ;
    rdfs:domain :ECMCertificate ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :dataProperties .

:ECMCertificateValidFrom a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ECMCertificateValidFrom" ;
    rdfs:comment "Certificate valid from date" ;
    rdfs:domain :ECMCertificate ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf :dataProperties .

:ECMCertificateValidTo a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ECMCertificateValidTo" ;
    rdfs:comment "Certificate valid to date" ;
    rdfs:domain :ECMCertificate ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf :dataProperties .

:Filename rdfs:domain :AttachedDocuments .

:StatusOfDocument a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "StatusOfDocument" ;
    rdfs:comment """ Enumerated value for the status of the attached document 1 = not
				electronical attached 2 embedded in ECTD, ECN or PCN """ ;
    rdfs:domain :AttachedDocuments ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:TypeDocumentEIN a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "TypeDocumentEIN" ;
    rdfs:comment """Code List Candidate:
																31, 34""" ;
    rdfs:domain :EINNumber ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:hasAttachedDocuments a owl:ObjectProperty ;
    rdfs:label "has AttachedDocuments" ;
    rdfs:domain :COM ;
    rdfs:range :AttachedDocuments .

:hasECMCertificate a owl:ObjectProperty ;
    rdfs:label "has ECMCertificate" ;
    rdfs:domain :AdministrativeDataSet ;
    rdfs:range :ECMCertificate .

:hasEINNumber rdfs:domain :ECMCertificate .

:AttachedDocuments a owl:Class ;
    rdfs:label "AttachedDocuments" ;
    rdfs:comment """Paper documents accompanying the
													transport""" .

:ECMCertificate a owl:Class ;
    rdfs:label "ECMCertificate" ;
    rdfs:comment "ECM certificate information" .

[] rdf:first :AttachedDocuments .

