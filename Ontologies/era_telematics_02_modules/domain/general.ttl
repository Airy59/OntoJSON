    rdfs:comment """Information
																			about the section to be
																			invoiced.""" .

:PaidUpTo a owl:Class ;
    rdfs:label "PaidUpTo" ;
    rdfs:comment """Charges Paid Up To ...
																This information is being sent by
																the consignor in agreement with the
																contractual carrier so only one
																structure is needed for field 20 and
																49. The carrier is only allowed to
																apply changes, when ordered by the
																consignor.""" .

:PlannedTransportIdentifiers a owl:Class ;
    rdfs:label "PlannedTransportIdentifiers" .

:PreviousConsignmentNumber a owl:Class,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "PreviousConsignmentNumber" ;
    rdfs:comment """This element shows the previous Reference number assigned to a
				consignment by a lead RU""" ;
    rdfs:domain :PreviousConsignmentNumber ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Recipient a owl:Class,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Recipient" ;
    rdfs:comment "Receiver of the message" ;
    rdfs:domain :Recipient ;
    rdfs:subPropertyOf :dataProperties .

:RelatedPlannedTransportIdentifiers a owl:Class ;
    rdfs:label "RelatedPlannedTransportIdentifiers" .

:SectionFrom a owl:Class ;
    rdfs:label "SectionFrom" ;
    rdfs:comment """Start of section to be
																performed by the carrier. This can
																be a station OR a border crossing
																point.""" .

:SectionTo a owl:Class ;
    rdfs:label "SectionTo" ;
    rdfs:comment """End of section to be
																performed by the carrier. This can
																be a station OR a border crossing
																point.""" .

:Sender a owl:Class,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Sender" ;
    rdfs:comment "The sender of the message" ;
    rdfs:domain :Sender ;
    rdfs:subPropertyOf :dataProperties .

:SpecialProvisionsEnvironment a owl:Class ;
    rdfs:label "SpecialProvisionsEnvironment" .

:Start a owl:Class ;
    rdfs:label "Start" ;
    rdfs:comment """Start of the charging
																section""" .

:ConsignmentNumber a owl:Class,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ConsignmentNumber" ;
    rdfs:comment "Reference number assigned to a consignment by a lead RU",
        """Running number and
																check digit of the consignment
																between Lead RU and customer.
																Format: NNNNNC The number consists
																of NNNNN = running number C = check
																digit, """ ;
    rdfs:domain [ ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:DeliveryAtDestination a owl:Class ;
    rdfs:label "DeliveryAtDestination" ;
    rdfs:comment """Place, Date and Time when the wagon is ready to be picked up by the
				customer""" .

:Haulier a owl:Class ;
    rdfs:label "Haulier" ;
    rdfs:comment "Information concerning the haulier." .

:LoadingFacility a owl:Class ;
    rdfs:label "LoadingFacility" ;
    rdfs:comment "Identifies the loading facility (in case of message type = ORU)" .

:ReferenceOTN a owl:Class ;
    rdfs:label "ReferenceOTN" .

:RequestedPeriod a owl:Class ;
    rdfs:label "RequestedPeriod" ;
    rdfs:comment "Date/Time period of a request" .

:RequestedTimeframe a owl:Class ;
    rdfs:label "RequestedTimeframe" ;
    rdfs:comment "To specifiy a time period being requested" .

:Routing a owl:Class ;
    rdfs:label "Routing" ;
    rdfs:comment """Sequential information about the complete routing of the consignment,
				the LeadRu decides wether to provide this information or not""" .

:SectionalInvoicing a owl:Class ;
    rdfs:label "SectionalInvoicing" ;
    rdfs:comment "Sectional Invoicing" .

:Time a owl:Class,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Time" ;
    rdfs:comment "hh:mm:ss" ;
    rdfs:domain :Time ;
    rdfs:range xsd:time ;
    rdfs:subPropertyOf :dataProperties .

:Activities a owl:Class ;
    rdfs:label "Activities" .

:AdditionalCharges a owl:Class ;
    rdfs:label "AdditionalCharges" ;
    rdfs:comment "Additional Charges",
        "None",
        "Sum of Prepaid",
        "Sum of Transferred" .

:Attendants a owl:Class ;
    rdfs:label "Attendants" ;
    rdfs:comment "Attendants during the transport." .

:COMS a owl:Class ;
    rdfs:label "COMS" ;
    rdfs:comment """Message (all bounded optional elements are bounded to to
							obligations of legacy systems)""" .

:CashOnDelivery a owl:Class ;
    rdfs:label "CashOnDelivery" ;
    rdfs:comment """Details of the amount to be
													collected on delivery and the currency code.""" .

:ChangeLog a owl:Class ;
    rdfs:label "ChangeLog" ;
    rdfs:comment """Log of changes made by the LeadRU
													/ contractual carrier during the transport.""" .

:ChargedMass a owl:Class ;
    rdfs:label "ChargedMass" ;
    rdfs:comment """Charged
																			mass [weight in kg]. As
																			appropriate, area in mÂ²
																			or the volume of the
																			wagon or goods in mÂ³ if
																			used as the basis for
																			charging.""" .

:ChargesNote a owl:Class ;
    rdfs:label "ChargesNote" ;
    rdfs:comment "Charges note" .

:CheckingBody a owl:Class ;
    rdfs:label "CheckingBody" ;
    rdfs:comment "Identification of the body which performed the RID check" .

:ConsignmentIdentification a owl:Class ;
    rdfs:label "ConsignmentIdentification" ;
    rdfs:comment """List of Identifications for the consignment In
										order to identify the consignment(s) on the wagon, the
										ControlLabel and or DossierNumber for each consignment must
										be present if the wagon is loaded and the Consignment Note
										is already available""",
        """consignment note number (without carrier (due
										to history))""" .

:ConsignorDeclarations a owl:Class ;
    rdfs:label "ConsignorDeclarations" ;
    rdfs:comment """Consignors declarartions, this
													element contains either declarations of the
													original consignor or declarations of the LeadRU
													as consignor""" .

:CustomsProcedures a owl:Class ;
    rdfs:label "CustomsProcedures" ;
    rdfs:comment "Customs procedures" .

:DeclarationOfValue a owl:Class ;
    rdfs:label "DeclarationOfValue" ;
    rdfs:comment """Details of the value of the goods
													and the currency code when the value exceeds the
													limit given in CIM Article 30 section 2.""" .

:DifferentAcceptance a owl:Class ;
    rdfs:label "DifferentAcceptance" ;
    rdfs:comment """Details of the changes
																of the acceptance point given by the
																consignor.""" .

:EndOfSection a owl:Class ;
    rdfs:label "EndOfSection" .

:ErrorCauseReference a owl:Class ;
    rdfs:label "ErrorCauseReference" ;
    rdfs:comment """The reference to the message and its particular element(s)
							that caused the error is provided here""" .

:EventLevelData a owl:Class ;
    rdfs:label "EventLevelData" .

:Examination a owl:Class ;
    rdfs:label "Examination" ;
    rdfs:comment "Examination" .

:ExceptionReason a owl:Class ;
    rdfs:label "ExceptionReason" ;
    rdfs:comment """Identifies the reason of an unexpected interruption for a wagon during
				the transportation. In addition it allows to put in a more detailed description""" .

:ExceptionalConsignment a owl:Class ;
    rdfs:label "ExceptionalConsignment" ;
    rdfs:comment "Exceptional Consignment" .

:ExceptionalGaugingIdent a owl:Class ;
    rdfs:label "ExceptionalGaugingIdent" ;
    rdfs:comment "Indicates that an exceptional Gauging is in the train or for the wagon " .

:GeoLocalisation a owl:Class ;
    rdfs:label "GeoLocalisation" ;
    rdfs:comment "Geolocalisation that may be between two identified locations. " .

:GoodsInContainer a owl:Class ;
    rdfs:label "GoodsInContainer" .

:Height a owl:Class ;
    rdfs:label "Height" ;
    rdfs:comment "Height of ITU" .

:ITU a owl:Class ;
    rdfs:label "ITU" ;
    rdfs:comment "Describes the type and content of an IntermodalTransportUnit" .

:InterestInDelivery a owl:Class ;
    rdfs:label "InterestInDelivery" ;
    rdfs:comment """Details of the amount and currency
													code of a special interest in delivery.""" .

:InterruptionDuration a owl:Class ;
    rdfs:label "InterruptionDuration" ;
    rdfs:comment "To specifiy the probable duration of the interruption" .

:Length a owl:Class ;
    rdfs:label "Length" ;
    rdfs:comment "Length of ITU." .

:LoadChangeDevice a owl:Class ;
    rdfs:label "LoadChangeDevice" ;
    rdfs:comment "Specific weights for change over air brake systems" .

:LoadTableProduct a owl:Class ;
    rdfs:label "LoadTableProduct" ;
    rdfs:comment """Product description, only applies
													for product-specific load tables""" .

:MadeOut a owl:Class ;
    rdfs:label "MadeOut" ;
    rdfs:comment "Made out" .

:NextIntermediateDestination a owl:Class ;
    rdfs:label "NextIntermediateDestination" ;
    rdfs:comment "Identifies next stopping point on the route of a train" .

:Notes a owl:Class ;
    rdfs:label "Notes" ;
    rdfs:comment "Remarks to be transmitted to IM" .

:PlannedChangeOfECM a owl:Class ;
    rdfs:label "PlannedChangeOfECM" .

:PossibilityToPreventRegenerativeBrake a owl:Class ;
    rdfs:label "PossibilityToPreventRegenerativeBrake" ;
    rdfs:comment """Possibility of preventing the use of the regenerative
							brake """ .

:PrepaymentCustomer a owl:Class ;
    rdfs:label "PrepaymentCustomer" ;
    rdfs:comment """Prepaidcode (given by
																the client)""" .

:RU_Declarations a owl:Class ;
    rdfs:label "RU_Declarations" ;
    rdfs:comment "Carriers declaration" .

:ReferenceNumbers a owl:Class ;
    rdfs:label "ReferenceNumbers" ;
    rdfs:comment """This element contains references according to NCTS or EMCS law.This
				element MUST NOT be empty!""" .

:RegenerativeBrake a owl:Class ;
    rdfs:label "RegenerativeBrake" ;
    rdfs:comment """Information of the Regenerative Brake, only for locomotives/vehicles
				with electrical traction connected external power source """ .

:RemovableAccessories a owl:Class ;
    rdfs:label "RemovableAccessories" .

:RequestedCalendar a owl:Class ;
    rdfs:label "RequestedCalendar" .

:ResponsibilityActualSection a owl:Class ;
    rdfs:label "ResponsibilityActualSection" ;
    rdfs:comment """This element identifies the responsible RU or IM for the actual path
				section""" .

:ResponsibilityNextSection a owl:Class ;
    rdfs:label "ResponsibilityNextSection" ;
    rdfs:comment """This element identifies the responsible RU and IM for the following
				path section""" .

:Seals a owl:Class ;
    rdfs:label "Seals" ;
    rdfs:comment "Describes the seals used for the consignment" .

:Section a owl:Class ;
    rdfs:label "Section" ;
    rdfs:comment "Sectional Invoicing" .

:StartOfSection a owl:Class ;
    rdfs:label "StartOfSection" .

:StatusOfHarmonization a owl:Class ;
    rdfs:label "StatusOfHarmonization" ;
    rdfs:comment """Does not force harmonization, it just sets an
									indication message: has the interchange/handover been harmonized
									or not.""" .

:TemperatureRange a owl:Class ;
    rdfs:label "TemperatureRange" .

:ValidityPeriod a owl:Class ;
    rdfs:label "ValidityPeriod" .

:VesselIndication a owl:Class ;
    rdfs:label "VesselIndication" ;
    rdfs:comment """This element identifies to which extent the transportation unit is
				used""" .

:WIMO_Dataset a owl:Class ;
    rdfs:label "WIMO_Dataset" ;
    rdfs:comment "Comment describing your root element" .

:Width a owl:Class ;
    rdfs:label "Width" ;
    rdfs:comment "Width of ITU" .

:BrakeBlock a owl:Class ;
    rdfs:label "BrakeBlock" ;
    rdfs:comment "Characteristics of brake blocks" .

:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "Information belonging to the event" .

:FormalReports a owl:Class ;
    rdfs:label "FormalReports" ;
    rdfs:comment "Formal report" .

:GeneralInformation a owl:Class ;
    rdfs:label "GeneralInformation" ;
    rdfs:comment """Genearal information about the
													complete consignment""" .

:HandBrake a owl:Class ;
    rdfs:label "HandBrake" .

:Identifiers a owl:Class ;
    rdfs:label "Identifiers" .

:PathInformation a owl:Class ;
    rdfs:label "PathInformation" .

:PlannedCalendar a owl:Class ;
    rdfs:label "PlannedCalendar" ;
    rdfs:comment """This is the calendar item for path request/path details messages -
				used in planning phase""" .

:RU_Declaration a owl:Class ;
    rdfs:label "RU_Declaration" ;
    rdfs:comment """Details of the
																carriers declaration.""" .

:Ship a owl:Class ;
    rdfs:label "Ship" ;
    rdfs:comment """Additional information for transports, which shall be handed over to a
				ship""" .

:CustomsData a owl:Class ;
    rdfs:label "CustomsData" ;
    rdfs:comment "Customs Data" .

:EINNumber a owl:Class ;
    rdfs:label "EINNumber" ;
    rdfs:comment """ECM certificate reference number
													NOTE: this is a placeholder! CR 335 by ERA is
													containing this element and its full description
													and code lists.""" .

:ILU a owl:Class ;
    rdfs:label "ILU" ;
    rdfs:comment "Describes the type and content of an IntermodalTransportUnit" .

:Interruption a owl:Class ;
    rdfs:label "Interruption" .

:InterruptionInformation a owl:Class ;
    rdfs:label "InterruptionInformation" ;
    rdfs:comment """The main part of this complex element is Interruption Reason (Code
				list for Train Interruption): A list of codes that denote the reason why a path is
				no longer available by an IM e.g. Flooding Note: This list is the same as the Code
				List given by the IM during an interruption of a train during its operation. It is
				therefore a code that is reused during the interruption caused in planning. The
				other subelements help describing the interruption information more precisely.""" .

:LoadingTackles a owl:Class ;
    rdfs:label "LoadingTackles" ;
    rdfs:comment "Describes the loading tackles used inside the wagon" .

:Packing a owl:Class ;
    rdfs:label "Packing" ;
    rdfs:comment "Packing information" .

:PrepaymentInstructions a owl:Class ;
    rdfs:label "PrepaymentInstructions" ;
    rdfs:comment "Prepayment" .

:RelatedReference a owl:Class ;
    rdfs:label "RelatedReference" ;
    rdfs:comment "Identifies the message to which the actual message refers" .

:SpecialProvisionsRID a owl:Class ;
    rdfs:label "SpecialProvisionsRID" .

:SpecialTreatments a owl:Class ;
    rdfs:label "SpecialTreatments" ;
    rdfs:comment "Special treatment" .

:SummaryOFGoodsWithSameRID a owl:Class ;
    rdfs:label "SummaryOFGoodsWithSameRID" ;
    rdfs:comment """This element is only in use if the consignment includes more than one
				good with the same UN-Number in , packing group and propershipping name in the
				wagon. The added amount of the dangerous goods are to be stored here""" .

:Timing a owl:Class ;
    rdfs:label "Timing" .

:DamageCodes a owl:Class ;
    rdfs:label "DamageCodes" ;
    rdfs:comment """List of Damage Codes according to
													description in GCU Appendix 9 Annex 1""" .

:Error a owl:Class ;
    rdfs:label "Error" .

:LoadTable a owl:Class ;
    rdfs:label "LoadTable" ;
    rdfs:comment """Indicates the load tables marked on the wagon.
										When load tables are marked on the wagon the information
										must be provided in the RSRD message. Several load tables
										(international, product specific for LPG wagons and
										additional/country specific) can be specified by providing
										the element several times consecutively. For special wagons
										with specific load tables (e.g. heavy haul wagons) no load
										table need to be provided. The complete load table must be
										provided including the empty load row (if existent).""" .

:RID_Checking a owl:Class ;
    rdfs:label "RID_Checking" ;
    rdfs:comment """When RID DG is transported in the train the Ru has to transmit here
				the RID check results from the Carrier, Loader, Filler and Unloader """ .

:TelematicsDevice a owl:Class ;
    rdfs:label "TelematicsDevice" ;
    rdfs:comment """Detailed information about a specific telematics
						device.""" .

:TractionDetails a owl:Class ;
    rdfs:label "TractionDetails" ;
    rdfs:comment """Defines the design series, mode of deployment and technical
				specfications associated with the traction of a train.""" .

:TransitPeriodExtensions a owl:Class ;
    rdfs:label "TransitPeriodExtensions" .

:AffectedSection a owl:Class ;
    rdfs:label "AffectedSection" ;
    rdfs:comment """Indication for the recepient if not the entire path is affected, e.g.
				in case of a partial cancelation for the last part of the path""" .

:ChargingSections a owl:Class ;
    rdfs:label "ChargingSections" ;
    rdfs:comment "Charging section" .

:LocoTypeNumber a owl:Class ;
    rdfs:label "LocoTypeNumber" ;
    rdfs:comment """Composite identifier for the loco types and locomotives. First four
				elements identify the series of the loco, rest can identify the exact individual
				locomotive""" .

:AirBrake a owl:Class ;
    rdfs:label "AirBrake" ;
    rdfs:comment "Characteristics of Air Brakes" .

:Tariff a owl:Class ;
    rdfs:label "Tariff" ;
    rdfs:comment """Freight Charges
																Section Tariff""",
        """Number of customer agreement or
													tariff""" .

:LocoIdent a owl:Class ;
    rdfs:label "LocoIdent" ;
    rdfs:comment """Defines the actual Type, the number and the mode of
							deployment of a traction unit of the freight train""" .

:COM_Header a owl:Class ;
    rdfs:label "COM_Header" ;
    rdfs:comment """Additional Header containing consignment
										related key data such as dossiernumber, version number and a
										change log for modifications""" .

:Goods a owl:Class ;
    rdfs:label "Goods" ;
    rdfs:comment "Describes the goods inside the means of transport" .

:ConsignmentLevelData a owl:Class ;
    rdfs:label "ConsignmentLevelData" .

:Customers a owl:Class ;
    rdfs:label "Customers" ;
    rdfs:comment "Information about the consignor, consignee and freight payers." .

:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "Consignor or Consignee" .

:RID a owl:Class ;
    rdfs:label "RID" ;
    rdfs:comment """The requirement (optional/mandatory) of the RID detail tags depend on
				the dangerous good and the regarding RID regulations.In contrast to the element
				"DangerousGoodsIndication" which only provides information to be provided to the IM
				according to chapter 1.4 RID, "RID" contains all information demanded in chapter 5.4
				RID in order tpo provide all information used for RUs""" .

:AdministrativeDataSet a owl:Class ;
    rdfs:label "AdministrativeDataSet" .

:ILU_Details a owl:Class ;
    rdfs:label "ILU_Details" ;
    rdfs:comment "Details for ILU on wagon" .

:ITU_Details a owl:Class ;
    rdfs:label "ITU_Details" ;
    rdfs:comment "Details for ITU on wagon" .

:COM a owl:Class ;
    rdfs:label "COM" ;
    rdfs:comment "Consignment order message" .

:DesignDataSet a owl:Class ;
    rdfs:label "DesignDataSet" .

:dataProperties a owl:DatatypeProperty ;
    rdfs:label "ERA Telematics Data Properties" ;
    rdfs:comment "Collection of data properties for the ERA Telematics ontology" .

