        "READ: ",
        "WRITE: " ;
    rdfs:domain :Vehicles ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ObjectType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ObjectType" ;
    rdfs:comment """Provides a possibility for differentiation between the objects: Train
				(TR), Route (RO), Path (PA), Case Reference (CR), Path Request (PR), Capacity Needs
				Announcements (CN), Capacity Model (CM), Catalogue Path (CP)""" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Offset a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Offset" ;
    rdfs:domain :Timing ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:OffsetToReference a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "OffsetToReference" ;
    rdfs:comment """ The OffsetToReference (OTR) is the shift of the days between Planned
				Calendar of the related object (route, path request or path) to the days in
				Reference Calendar. The shift is mentioned in days. OTR value is set to zero when
				there is no gap between Planned Calendar and Reference Calendar, OTR value is
				positive if Planned Calendar later than Reference Calendar and negative if Planned
				Calendar earlier than Reference Calendar.>""" ;
    rdfs:domain :PlannedCalendar ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:OnDemandPath a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "OnDemandPath" ;
    rdfs:comment """For the use of on demand or optional path (has to be either activated
				or deactived depending to network rules)""" ;
    rdfs:domain :PlannedJourneyLocation ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :dataProperties .

