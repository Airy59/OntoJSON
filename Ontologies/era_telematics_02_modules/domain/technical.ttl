@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:CommercialSpecificationCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CommercialSpecificationCode" ;
    rdfs:comment "Commercial specifications code" ;
    rdfs:domain :CommercialSpecifications ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:InteropCapability a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "InteropCapability" ;
    rdfs:comment "Identification of the general interoperability capability of the wagon." ;
    rdfs:domain :AdministrativeDataSet ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:LimitedQuantityIndicator a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "LimitedQuantityIndicator" ;
    rdfs:comment """Indicator for labelled dangerous goods in limited quantity
							according to chapter 3.-4 RID""",
        """Indicator for labelled dangerous goods in limited quantity
						according to chapter 3.-4 RID""" ;
    rdfs:domain :RID ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :dataProperties .

:LoadLimit a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "LoadLimit" ;
    rdfs:comment """Load limit from table of load limits in
											[t].""" ;
    rdfs:domain :WagonDetails ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf :dataProperties .

:NoiseByPassLimit a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "NoiseByPassLimit" ;
    rdfs:comment "Noise limit on reference track" ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:SpecificationText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "SpecificationText" ;
    rdfs:comment """Additional Text for
																codes with free text""" ;
    rdfs:domain :CommercialSpecifications ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:hasCommercialSpecifications a owl:ObjectProperty ;
    rdfs:label "has CommercialSpecifications" ;
    rdfs:domain :COM ;
    rdfs:range :CommercialSpecifications .

:hasDimensions a owl:ObjectProperty ;
    rdfs:label "has Dimensions" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ILU_Details :ITU_Details ) ] ;
    rdfs:range :Dimensions .

:Dimensions a owl:Class ;
    rdfs:label "Dimensions" ;
    rdfs:comment "Dimensions of the UTI." .

:CommercialSpecifications a owl:Class ;
    rdfs:label "CommercialSpecifications" ;
    rdfs:comment "Commercial Specification" .

