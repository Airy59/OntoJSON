@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ArrivalTimeAtDestination a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ArrivalTimeAtDestination" ;
    rdfs:comment """The actual Date and Time of the arrival of wagons by train at its
				final destination yard""" ;
    rdfs:domain :ArrivalAtDestination ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:ArrivalTimeAtLocation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ArrivalTimeAtLocation" ;
    rdfs:comment "The actual arrival date and time at the defined location" ;
    rdfs:domain :ArrivalInterchangeReport ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:ArrivalTimeAtLocationActual a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ArrivalTimeAtLocationActual" ;
    rdfs:comment "The actual arrival date and time at the defined location" ;
    rdfs:domain :YardArrival ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:CommercialTrafficType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CommercialTrafficType" ;
    rdfs:domain :PlannedTrainData ;
    rdfs:subPropertyOf :dataProperties .

:ContractNumberMovement a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ContractNumberMovement" ;
    rdfs:comment """Identifies the contract between LeadRU and RU involved in the
				transport""" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:DatePutIntoService a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DatePutIntoService" ;
    rdfs:comment "Original Date of first operation" ;
    rdfs:domain :AdministrativeDataSet ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf :dataProperties .

:DelayCause a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DelayCause" ;
    rdfs:comment "This element identifies the reason for a delay (modified DelayReason)" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DelayCauseTime :TrainReadyStatus ) ] ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:DelayCodingDateTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DelayCodingDateTime" ;
    rdfs:comment "Date and Time of the coding of the delay" ;
    rdfs:domain :DelayCauseTime ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:DelayEventDateTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DelayEventDateTime" ;
    rdfs:comment "Date and Time of delay event " ;
    rdfs:domain :DelayCauseTime ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:DelayMinutes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DelayMinutes" ;
    rdfs:comment "Identifieis the delay (in minutes) of a train for a specified cause" ;
    rdfs:domain :DelayCauseTime ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:DepartureCountry a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DepartureCountry" ;
    rdfs:comment "CODE: ISO-3166-2",
        "Code of departure country of the ILU.",
        "Code of departure country of the UTI." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ILU_Details :ITU_Details ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:DepartureJourneyTrack a owl:Class ;
    rdfs:label "DepartureJourneyTrack" ;
    :domain "Telematics" ;
    rdfs:comment "Indicates the track ID on which the train will start its journey." .

:DepartureTimeAtLocation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DepartureTimeAtLocation" ;
    rdfs:comment "the scheduled departure date and time at a defined location" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DepartureInterchangeReport :WagonAtDeparture :WagonPickupAtOrigin :YardDeparture ) ] ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:JourneyLocationTypeCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "JourneyLocationTypeCode" ;
    rdfs:comment "None" ;
    rdfs:domain :PlannedJourneyLocation ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:ScheduledDateTimeAtTransfer a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ScheduledDateTimeAtTransfer" ;
    rdfs:comment """The referenced date and time of arrival or exit at the border between
				two different IMs""" ;
    rdfs:domain :OperationalTrainNumberIdentifier ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:ScheduledTimeAtHandover a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ScheduledTimeAtHandover" ;
    rdfs:comment """The referenced date and time of departure or entrance at the border
				between two different IMs""" ;
    rdfs:domain :OperationalTrainNumberIdentifier ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:ScheduledTimeAtLocation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ScheduledTimeAtLocation" ;
    rdfs:comment """Scheduled Date and Time at a location related to the status of the
				train or wagon at the given location""" ;
    rdfs:domain :ExceptionPoint ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:SpecialServiceDescriptionCode a owl:DatatypeProperty ;
    rdfs:label "SpecialServiceDescriptionCode" ;
    rdfs:domain :TypeofService ;
    rdfs:subPropertyOf :dataProperties .

:TimetableYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "TimetableYear" ;
    rdfs:comment """Refers to the timetable period in which the business will be carried
				out""" ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:TrafficTypeCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "TrafficTypeCode" ;
    rdfs:domain :TrafficType ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:hasArrivalInterchangeReport a owl:ObjectProperty ;
    rdfs:label "has ArrivalInterchangeReport" ;
    rdfs:domain :WagonETI_ETA_Message ;
    rdfs:range :ArrivalInterchangeReport .

:hasCombinedTrafficLoadProfile a owl:ObjectProperty ;
    rdfs:label "has CombinedTrafficLoadProfile" ;
    rdfs:domain :PlannedTrainData ;
    rdfs:range :CombinedTrafficLoadProfile .

:hasDelayCauseTime a owl:ObjectProperty ;
    rdfs:label "has DelayCauseTime" ;
    rdfs:domain :DelayEventReport ;
    rdfs:range :DelayCauseTime .

:hasDelayEventReport a owl:ObjectProperty ;
    rdfs:label "has DelayEventReport" ;
    rdfs:domain :TrainDelayCauseMessage ;
    rdfs:range :DelayEventReport .

:hasDelayLocation a owl:ObjectProperty ;
    rdfs:label "has DelayLocation" ;
    rdfs:domain :DelayEventReport ;
    rdfs:range :DelayLocation .

:hasDepartureInterchangeReport a owl:ObjectProperty ;
    rdfs:label "has DepartureInterchangeReport" ;
    rdfs:domain :WagonETI_ETA_Message ;
    rdfs:range :DepartureInterchangeReport .

:hasJourneySection a owl:ObjectProperty ;
    rdfs:label "has JourneySection" ;
    rdfs:domain :TrainCompositionJourneySection ;
    rdfs:range :JourneySection .

:hasJourneySectionDestination a owl:ObjectProperty ;
    rdfs:label "has JourneySectionDestination" ;
    rdfs:domain :JourneySection ;
    rdfs:range :JourneySectionDestination .

:hasJourneySectionOrigin a owl:ObjectProperty ;
    rdfs:label "has JourneySectionOrigin" ;
    rdfs:domain :JourneySection ;
    rdfs:range :JourneySectionOrigin .

:hasMovementReferenceNumber a owl:ObjectProperty ;
    rdfs:label "has MovementReferenceNumber" ;
    rdfs:domain :ReferenceNumbers ;
    rdfs:range :MovementReferenceNumber .

:hasPlannedJourneyLocation a owl:ObjectProperty ;
    rdfs:label "has PlannedJourneyLocation" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :PathInformation :TrainInformation ) ] ;
    rdfs:range :PlannedJourneyLocation .

:hasRelatedTransportOperationalIdentifiers a owl:ObjectProperty ;
    rdfs:label "has RelatedTransportOperationalIdentifiers" ;
    rdfs:domain :TrainOperationalIdentification ;
    rdfs:range :RelatedTransportOperationalIdentifiers .

:hasTrafficType a owl:ObjectProperty ;
    rdfs:label "has TrafficType" ;
    rdfs:domain :PlannedTrainData ;
    rdfs:range :TrafficType .

:hasTransportOperationalIdentifiers a owl:ObjectProperty ;
    rdfs:label "has TransportOperationalIdentifiers" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ErrorMessage :TrainCompositionMessage :TrainOperationalIdentification :TrainReadyMessage ) ] ;
    rdfs:range :TransportOperationalIdentifiers .

:hasTypeofService a owl:ObjectProperty ;
    rdfs:label "has TypeofService" ;
    rdfs:domain :PlannedTrainData ;
    rdfs:range :TypeofService .

:ArrivalAtDestination a owl:Class ;
    rdfs:label "ArrivalAtDestination" ;
    rdfs:comment """Arrival of a wagon at its destnation point with Date and Time. The
				location is not the final destination at ustomer sidings, but he location of the
				last RU which has to organise the final delivery of the wagon to customer sidings""" .

:CombinedTrafficLoadProfile a owl:Class ;
    rdfs:label "CombinedTrafficLoadProfile" ;
    rdfs:comment """This element does refer to combined load units that can be used for Freight Requests only.
There are two entry options:
â€¢ One option refers to â€œPâ€ (Semi-trailer/road semi-trailer):
â€¢ The other option refers to â€œCâ€ (Swap body):
The RUs may indicate the relevant values if they are familiar with the IMs line profiles. In case there is a path request for a train with combined traffic load, the IM should indicate the possible max. value for all 4 elements (P1, P2, C1, C2). Further information about Combined Traffic Load Profile can be seen in the UIC 596-6 Leaflet.
""" .

:DelayLocation a owl:Class ;
    rdfs:label "DelayLocation" ;
    :domain "Telematics" ;
    rdfs:comment "Location where the Delay occured" .

:JourneySectionDestination a owl:Class ;
    rdfs:label "JourneySectionDestination" ;
    rdfs:comment "Destination of the section on which train composition is unchanged" .

:JourneySectionOrigin a owl:Class ;
    rdfs:label "JourneySectionOrigin" ;
    rdfs:comment "Origin of the section on which train composition is unchanged" .

:MovementReferenceNumber a owl:Class ;
    rdfs:label "MovementReferenceNumber" ;
    rdfs:comment "Movement Reference Number according to NCTS" .

:RelatedTransportOperationalIdentifiers a owl:Class ;
    rdfs:label "RelatedTransportOperationalIdentifiers" .

:TransportOperationalIdentifiers a owl:Class ;
    rdfs:label "TransportOperationalIdentifiers" .

:YardArrival a owl:Class ;
    rdfs:label "YardArrival" ;
    rdfs:comment """The arrival point of a wagon and the Date and Time when the wagon is
				taken over by the RU/Service Provider""" .

:YardDeparture a owl:Class ;
    rdfs:label "YardDeparture" ;
    rdfs:comment """The departure point of a wagon and the Date and Time when the wagon is
				taken over by the RU/Service Provider""" .

:ArrivalInterchangeReport a owl:Class ;
    rdfs:label "ArrivalInterchangeReport" ;
    rdfs:comment "The arrival or interchange station where ETI end" .

:DepartureInterchangeReport a owl:Class ;
    rdfs:label "DepartureInterchangeReport" ;
    rdfs:comment "Departure or interchange station ETI Orgin" .

:PlannedJourneyLocation a owl:Class ;
    rdfs:label "PlannedJourneyLocation" ;
    rdfs:comment "Any operation point along the train journey or path" .

:TrafficType a owl:Class ;
    rdfs:label "TrafficType" ;
    rdfs:comment """information about the type of traffic (combined, rolling highway,
				etc). It is added here as a placeholder for coded values (e.g. from Merits)""" .

:TypeofService a owl:Class ;
    rdfs:label "TypeofService" ;
    rdfs:comment """Information about the services available on a train. Used for
				publication towards the passenger""" .

:DelayEventReport a owl:Class ;
    rdfs:label "DelayEventReport" ;
    rdfs:comment """Provides the detailed information about a single delay event (Replaced
				DelayReasonReport)""" .

:JourneySection a owl:Class ;
    rdfs:label "JourneySection" ;
    rdfs:comment "Defines the data provided by the IM for a journey section" .

:DelayCauseTime a owl:Class ;
    rdfs:label "DelayCauseTime" ;
    rdfs:comment """Identifies the delay of a train due to a specified reason. In addition
				it allows to put in a more detailed description (Changed from DelayReasonTime)""" .

