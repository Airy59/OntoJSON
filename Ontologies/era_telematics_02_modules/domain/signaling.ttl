@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ControlDigit a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ControlDigit" ;
    rdfs:comment """1 control digit as usual at the end of the 12 digit UIC
							identifier. Not used in Planning""" ;
    rdfs:domain :LocoTypeNumber ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:MessageCreationDateTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageCreationDateTime" ;
    rdfs:comment "Timestamp of Creation of Message",
        """the timestamp is created by the originally
										sending RU, it remains unchanged, when forwarded by the
										central ISR application""" ;
    rdfs:domain :WagonStatusMessage ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:MessageDateTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageDateTime" ;
    rdfs:comment "Generated by the common Interface" ;
    rdfs:domain :MessageReference ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:MessageDateTimeCreated a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageDateTimeCreated" ;
    rdfs:comment "Date and time when the message was created by the legacy system" ;
    rdfs:domain :MessageHeader ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:MessageIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageIdentifier" ;
    rdfs:comment "Identification of the Message" ;
    rdfs:domain :MessageReference ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:MessageReferenceNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageReferenceNumber" ;
    rdfs:comment """Message Reference NumberThis
													identification is being generated during
													creation of the message. This allows the tracing
													of the message.""" ;
    rdfs:domain :COM_Header ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:MessageRoutingID a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageRoutingID" ;
    rdfs:comment """Additional information used to route the message to the correct
				recieving application (if needed)""" ;
    rdfs:domain :MessageHeader ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:MessageSenderReference a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageSenderReference" ;
    rdfs:domain :ErrorCauseReference ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:MessageStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageStatus" ;
    rdfs:comment "Assigned by the Sender 1=creation, 2=modification, 3=deletion" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ChangeofTrackMessage :ErrorMessage :LocationFileDatasetMessage :PathCanceledMessage :PathConfirmedMessage :PathDetailsMessage :PathDetailsRefusedMessage :PathNotAvailableMessage :PathRequestMessage :TrainCompositionMessage :TrainDelayCauseMessage :TrainForecastAtReportingLocationMessage :TrainJourneyModificationMessage :TrainReadyMessage :TrainRunningForecastMessage :TrainRunningInformationMessage :TrainRunningInterruptionMessage ) ] ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:MessageType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageType" ;
    rdfs:comment """To indicate the message type transmitted or referred to. The following
				list was agreed within the sector: 1000 ConsignmentOrderMessage 2001
				PathCanceledMessage 2002 PathConfirmedMessage 2003 PathDetailsMessage 2004
				PathDetailsRefusedMessage 2005 PathNotAvailableMessage 2006 PathRequestMessage 2007
				ReceiptConfirmationMessage -- sector messages (Planning) -- 2500
				PathCoordinationMessage 2501 PathSectionNotificationMessage -- sector message end --
				3003 TrainCompositionMessage 3006 TrainReadyMessage 4001 TrainDelayCauseMessage 4003
				TrainForecastAtReportingLocationMessage 4004 TrainRunningForecastMessage 4005
				TrainRunningInformationMessage 4006 TrainRunningInterruptionMessage -- sector
				message (Operations) -- 4500 PassengerTrainCompositionMessage 4501
				RollingStockRestrictionMessage 4504 ChangeOfTrackMessage 4505
				TrainJourneyModificationMessage 4506 TrainForecastedDelayCauseMessage 4510
				RunningStatusReportMessage -- sector message end -- 5001 AlertMessage 5006
				WagonETI_ETA_Message -- sector message (Wagon interchange) -- 5009
				WagonInterchangeNoticeMessage 5012 WagonReceivedAtInterchangeMessage 5013
				WagonRefusedAtInterchangeMessage -- sector message end -- 5020 WagonStatusMessage
				6002 LocationFileDatasetMessage 6003 RollingStockDatasetMessage 6005
				ILUDataQueryMessage 6006 ILUDataMessage --sector (RU-RU) --- 5500
				WagonPerformanceMessage -- sector end--- 6004 RollingStockDatasetQueryMessage --
				Sector Messages TCR begin -- 6500 TCRMessage 6501 TCRResponseMessage 6502
				TCRCanceledMessage -- Sector Messages TCR end -- -- sector (TrainID) begin -- 8500
				UpateLinkMessage 8501 ObjectInfoMessage -- sector end -- 9000 ErrorMessage
				--Reserved: (IM-RU for SFERA) --- SF00 to SF99 for SFERA messages (see IRS90940) â€“
				Reserved end â€“ """ ;
    rdfs:domain :MessageReference ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:MessageTypeVersion a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageTypeVersion" ;
    rdfs:comment "Version of the Message Type" ;
    rdfs:domain :MessageReference ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:RelatedMessageDateTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "RelatedMessageDateTime" ;
    rdfs:comment "Date Time of related message. " ;
    rdfs:domain :RelatedReference ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:hasControlLabel a owl:ObjectProperty ;
    rdfs:label "has ControlLabel" ;
    rdfs:domain :ConsignmentIdentification ;
    rdfs:range :ControlLabel .

:hasMessageHeader a owl:ObjectProperty ;
    rdfs:label "has MessageHeader" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AlertMessage :ChangeofTrackMessage :ConsignmentOrderMessage :ErrorMessage :LocationFileDatasetMessage :PathCanceledMessage :PathConfirmedMessage :PathDetailsMessage :PathDetailsRefusedMessage :PathNotAvailableMessage :PathRequestMessage :ReceiptConfirmationMessage :RollingStockDatasetMessage :RollingStockDatasetQueryMessage :TrainCompositionMessage :TrainDelayCauseMessage :TrainForecastAtReportingLocationMessage :TrainJourneyModificationMessage :TrainReadyMessage :TrainRunningForecastMessage :TrainRunningInformationMessage :TrainRunningInterruptionMessage :WagonETI_ETA_Message :WagonStatusMessages ) ] ;
    rdfs:range :MessageHeader .

:hasMessageReference a owl:ObjectProperty ;
    rdfs:label "has MessageReference" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ErrorCauseReference :MessageHeader ) ] ;
    rdfs:range :MessageReference .

:AlertMessage a owl:Class ;
    rdfs:label "AlertMessage" ;
    rdfs:comment """Following the comparison betzeen the acual ETA and the commitment to
				the customer, the Lead RU sends this Alert Message to the actual RU in charge and to
				all following RUs involved in the transport chain""" .

:ConsignmentOrderMessage a owl:Class ;
    rdfs:label "ConsignmentOrderMessage" ;
    rdfs:comment "Consignment Order Message from Lead RU to RU" .

:ControlLabel a owl:Class ;
    rdfs:label "ControlLabel" .

:ReceiptConfirmationMessage a owl:Class ;
    rdfs:label "ReceiptConfirmationMessage" ;
    rdfs:comment """This message is sent from the recipient of a message to the original
				sender of the message when the required response cannot be made available within 5
				minutes as defined by the TAF TSI chapter 4.4. The identifiers in this message have
				to be same as those that have come from sender. The same applies to type-of-request
				and type-of-information.""" .

:ErrorMessage a owl:Class ;
    rdfs:label "ErrorMessage" ;
    rdfs:comment """This message should be sent from the receiver to the sender after the
				processing of the previously sent TAF/TAP message in the backend (legacy) system of
				the receiver has failed.""" .

:LocationFileDatasetMessage a owl:Class ;
    rdfs:label "LocationFileDatasetMessage" ;
    rdfs:comment " Used to Create, Modify or Update the LocationIdent Reference File" .

:PathCanceledMessage a owl:Class ;
    rdfs:label "PathCanceledMessage" ;
    rdfs:comment """Path Canceled message according to Short Term Path Request
				specification (WG5)""" .

:PathConfirmedMessage a owl:Class ;
    rdfs:label "PathConfirmedMessage" ;
    rdfs:comment """This message is used by the RU to confirm the proposed path ofthe IM
				(PathDetailsMessage) in response to an RUs Original Request""" .

:PathDetailsMessage a owl:Class ;
    rdfs:label "PathDetailsMessage" ;
    rdfs:comment """This message is used by the IM to the RU confirmaing details of the
				path in response to an RU request""" .

:PathDetailsRefusedMessage a owl:Class ;
    rdfs:label "PathDetailsRefusedMessage" ;
    rdfs:comment """This message is used by the RU to inform the IM that the PathDetails
				(with changed values to the request or to earlier booked path) are not acceptable""" .

:PathNotAvailableMessage a owl:Class ;
    rdfs:label "PathNotAvailableMessage" ;
    rdfs:comment """Path Not Available message according to Short Term Path Request
				specification (WG5) """ .

:PathRequestMessage a owl:Class ;
    rdfs:label "PathRequestMessage" ;
    rdfs:comment """This message serves to request a train path. The message is sent from
				the RU to each IM involved.""" .

:MessageHeader a owl:Class ;
    rdfs:label "MessageHeader" ;
    rdfs:comment "Used for all messages" .

:MessageReference a owl:Class ;
    rdfs:label "MessageReference" ;
    rdfs:comment "This element identifies the message" .

