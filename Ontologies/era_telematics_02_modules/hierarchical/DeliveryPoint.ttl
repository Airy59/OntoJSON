@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasDeliveryPoint rdfs:range :DeliveryPoint .

:DeliveryPoint a owl:Class ;
    rdfs:label "DeliveryPoint" ;
    rdfs:comment """Description of location and time
													for the hand over of the consignment""" .

[] rdf:first :DeliveryPoint .

[] rdf:first :DeliveryPoint .

[] rdf:first :DeliveryPoint .

