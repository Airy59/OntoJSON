@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasInterruptionPoint a owl:ObjectProperty ;
    rdfs:label "has InterruptionPoint" ;
    rdfs:domain :TrainRunningInterruptionMessage ;
    rdfs:range :InterruptionPoint .

:hasTrainRunningInterruptionStatus a owl:ObjectProperty ;
    rdfs:label "has TrainRunningInterruptionStatus" ;
    rdfs:domain :TrainRunningInterruptionMessage ;
    rdfs:range :TrainRunningInterruptionStatus .

:TrainRunningInterruptionMessage a owl:Class ;
    rdfs:label "TrainRunningInterruptionMessage" ;
    rdfs:comment """This message is used to inform about the trains which has been already
				interrupted. Message is sent only for those trains, directly interrupted by the
				disruption. """ .

