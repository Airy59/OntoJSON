@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:RevisedRequest a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "RevisedRequest" ;
    rdfs:comment """Indication for the IM whether wait because the RU will send a revised
				request soon or to make an alternative offer.""" ;
    rdfs:domain :PathDetailsRefusedMessage ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :dataProperties .

:PathDetailsRefusedMessage a owl:Class ;
    rdfs:label "PathDetailsRefusedMessage" ;
    rdfs:comment """This message is used by the RU to inform the IM that the PathDetails
				(with changed values to the request or to earlier booked path) are not acceptable""" .

