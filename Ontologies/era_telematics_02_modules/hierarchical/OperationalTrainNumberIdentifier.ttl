@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ScheduledDateTimeAtTransfer a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ScheduledDateTimeAtTransfer" ;
    rdfs:comment """The referenced date and time of arrival or exit at the border between
				two different IMs""" ;
    rdfs:domain :OperationalTrainNumberIdentifier ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:ScheduledTimeAtHandover a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ScheduledTimeAtHandover" ;
    rdfs:comment """The referenced date and time of departure or entrance at the border
				between two different IMs""" ;
    rdfs:domain :OperationalTrainNumberIdentifier ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:hasOperationalTrainNumberIdentifier rdfs:range :OperationalTrainNumberIdentifier .

:OperationalTrainNumberIdentifier a owl:Class ;
    rdfs:label "OperationalTrainNumberIdentifier" .

[] rdf:first :OperationalTrainNumberIdentifier .

