@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ModificationStatusIndicator a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ModificationStatusIndicator" ;
    rdfs:comment """This elemnt shows if the location has been added or deleted in the
				modified train journey""" ;
    rdfs:domain :LocationModified ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:hasLocationModified rdfs:range :LocationModified .

:LocationModified a owl:Class ;
    rdfs:label "LocationModified" ;
    rdfs:comment """This element shows the Location that has been changed for the train
				run """ .

[] rdf:first :LocationModified .

[] rdf:first :LocationModified .

[] rdf:first :LocationModified .

