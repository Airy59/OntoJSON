@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:RU a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "RU" ;
    rdfs:comment "Carrier (Railway Code)" ;
    rdfs:domain :Carrier ;
    rdfs:subPropertyOf :dataProperties .

:hasCarrier rdfs:range :Carrier .

:Carrier a owl:Class ;
    rdfs:label "Carrier" ;
    rdfs:comment "Carrier(s) involved" .

[] rdf:first :Carrier .

