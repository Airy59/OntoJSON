@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasGoods rdfs:range :Goods .

:hasRID_Checking a owl:ObjectProperty ;
    rdfs:label "has RID_Checking" ;
    rdfs:domain :Goods ;
    rdfs:range :RID_Checking .

:Goods a owl:Class ;
    rdfs:label "Goods" ;
    rdfs:comment "Describes the goods inside the means of transport" .

[] rdf:first :Goods .

