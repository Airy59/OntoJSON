@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Address a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Address" ;
    rdfs:comment "Generic postal address in clear text" ;
    rdfs:domain :AdministrativeContactInformation ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:PhoneNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "PhoneNumber" ;
    rdfs:comment "Generic Phone number in Free text" ;
    rdfs:domain :AdministrativeContactInformation ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:hasAdministrativeContactInformation rdfs:range :AdministrativeContactInformation .

:AdministrativeContactInformation a owl:Class ;
    rdfs:label "AdministrativeContactInformation" ;
    rdfs:comment "Used to define adminstrative contact information" .

[] rdf:first :AdministrativeContactInformation .

[] rdf:first :AdministrativeContactInformation .

[] rdf:first :AdministrativeContactInformation .

[] rdf:first :AdministrativeContactInformation .

