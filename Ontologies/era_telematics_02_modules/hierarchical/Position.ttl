@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasPosition rdfs:range :Position .

:Position a owl:Class ;
    rdfs:label "Position" ;
    rdfs:comment """Geo coordinates of the
																wagon event location in WGS84 as
																used in the CRD""" .

[] rdf:first :Position .

[] rdf:first :Position .

