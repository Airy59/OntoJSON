@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Position a owl:Class ;
    rdfs:label "Position" ;
    rdfs:comment """Geo coordinates of the
																wagon event location in WGS84 as
																used in the CRD""" .

