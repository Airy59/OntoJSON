@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasWagonStatusMessage a owl:ObjectProperty ;
    rdfs:label "has WagonStatusMessage" ;
    rdfs:domain :WagonStatusMessages ;
    rdfs:range :WagonStatusMessage .

:WagonStatusMessages a owl:Class ;
    rdfs:label "WagonStatusMessages" ;
    rdfs:comment """Always MANDATORY, independent whether only one or more messages are in
				the file """ .

[] rdf:first :WagonStatusMessages .

