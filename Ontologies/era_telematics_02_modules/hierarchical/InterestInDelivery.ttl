@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasInterestInDelivery rdfs:range :InterestInDelivery .

:InterestInDelivery a owl:Class ;
    rdfs:label "InterestInDelivery" ;
    rdfs:comment """Details of the amount and currency
													code of a special interest in delivery.""" .

[] rdf:first :InterestInDelivery .

[] rdf:first :InterestInDelivery .

