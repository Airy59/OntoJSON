@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasTrainAtLocation a owl:ObjectProperty ;
    rdfs:label "has TrainAtLocation" ;
    rdfs:domain :TrainForecastAtReportingLocationMessage ;
    rdfs:range :TrainAtLocation .

:TrainForecastAtReportingLocationMessage a owl:Class ;
    rdfs:label "TrainForecastAtReportingLocationMessage" ;
    rdfs:comment """This message is issued following receipt of an enquiry about train
				forecasts at a particular reporting location. It gives a report of the forecasted
				time for all trains of the enquirer at a specified location. """ .

[] rdf:first :TrainForecastAtReportingLocationMessage .

[] rdf:first :TrainForecastAtReportingLocationMessage .

[] rdf:first :TrainForecastAtReportingLocationMessage .

