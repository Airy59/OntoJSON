@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:CreationDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CreationDate" ;
    rdfs:comment """Date when the report was made
														out.""" ;
    rdfs:domain :FormalReports ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf :dataProperties .

:FormalReports a owl:Class ;
    rdfs:label "FormalReports" ;
    rdfs:comment "Formal report" .

