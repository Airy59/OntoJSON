@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:CreationDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CreationDate" ;
    rdfs:comment """Date when the report was made
														out.""" ;
    rdfs:domain :FormalReports ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf :dataProperties .

:hasFormalReports rdfs:range :FormalReports .

:FormalReports a owl:Class ;
    rdfs:label "FormalReports" ;
    rdfs:comment "Formal report" .

[] rdf:first :FormalReports .

[] rdf:first :FormalReports .

