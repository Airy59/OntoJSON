@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:DistancePrecision a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DistancePrecision" ;
    rdfs:comment """Precision of the position along the track. Expressed in
							metres.""" ;
    rdfs:domain :NetworkProjectedLocation ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf :dataProperties .

:ProportionOfDistanceBetweenLocations a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ProportionOfDistanceBetweenLocations" ;
    rdfs:comment """Percentage of the distance between the reporting location,
							and the next location, on a scale from 0 to 100. """ ;
    rdfs:domain :NetworkProjectedLocation ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf :dataProperties .

:hasNextLocation a owl:ObjectProperty ;
    rdfs:label "has NextLocation" ;
    rdfs:domain :NetworkProjectedLocation ;
    rdfs:range :NextLocation .

:NetworkProjectedLocation a owl:Class ;
    rdfs:label "NetworkProjectedLocation" ;
    rdfs:comment "Projection of a geographical position on a network line. " .

