@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasInterruptionInformation a owl:ObjectProperty ;
    rdfs:label "has InterruptionInformation" ;
    rdfs:domain :PathNotAvailableMessage ;
    rdfs:range :InterruptionInformation .

:PathNotAvailableMessage a owl:Class ;
    rdfs:label "PathNotAvailableMessage" ;
    rdfs:comment """Path Not Available message according to Short Term Path Request
				specification (WG5) """ .

