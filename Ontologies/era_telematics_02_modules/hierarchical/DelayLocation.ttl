@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasDelayLocation rdfs:range :DelayLocation .

:DelayLocation a owl:Class ;
    rdfs:label "DelayLocation" ;
    :domain "Telematics" ;
    rdfs:comment "Location where the Delay occured" .

