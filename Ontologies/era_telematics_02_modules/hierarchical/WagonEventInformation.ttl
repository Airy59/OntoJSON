@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:WagonEvent a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "WagonEvent" ;
    rdfs:domain :WagonEventInformation ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:hasWagonEventInformation rdfs:range :WagonEventInformation .

:WagonEventInformation a owl:Class ;
    rdfs:label "WagonEventInformation" ;
    rdfs:comment """This is a WIMO element that is derived from the Wagon Release Notice
				and Event Messages""" .

[] rdf:first :WagonEventInformation .

[] rdf:first :WagonEventInformation .

