@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ContainerNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ContainerNumber" ;
    rdfs:domain :GoodsInWagon ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:hasGoodsInContainer a owl:ObjectProperty ;
    rdfs:label "has GoodsInContainer" ;
    rdfs:domain :GoodsInWagon ;
    rdfs:range :GoodsInContainer .

:hasGoodsInWagon rdfs:range :GoodsInWagon .

:hasILU a owl:ObjectProperty ;
    rdfs:label "has ILU" ;
    rdfs:domain :GoodsInWagon ;
    rdfs:range :ILU .

:hasRollingRoadUnit a owl:ObjectProperty ;
    rdfs:label "has RollingRoadUnit" ;
    rdfs:domain :GoodsInWagon ;
    rdfs:range :RollingRoadUnit .

:GoodsInWagon a owl:Class ;
    rdfs:label "GoodsInWagon" ;
    rdfs:comment "Goods" .

[] rdf:first :GoodsInWagon .

[] rdf:first :GoodsInWagon .

[] rdf:first :GoodsInWagon .

[] rdf:first :GoodsInWagon .

[] rdf:first :GoodsInWagon .

[] rdf:first :GoodsInWagon .

[] rdf:first :GoodsInWagon .

[] rdf:first :GoodsInWagon .

[] rdf:first :GoodsInWagon .

[] rdf:first :GoodsInWagon .

[] rdf:first :GoodsInWagon .

