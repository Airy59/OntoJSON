@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasShippingLocation rdfs:range :ShippingLocation .

:ShippingLocation a owl:Class ;
    rdfs:label "ShippingLocation" ;
    rdfs:comment """Shipping Station ( TAF location code with
										optional SLC type 42 or 36)""",
        """use here the station code of the station the
										wagon has started its transport run""" .

