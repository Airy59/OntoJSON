@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Result a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Result" ;
    rdfs:comment """Details of the results of any
														examination (see CIM Article 11 sections 2
														and 3).""" ;
    rdfs:domain :Examination ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:hasExamination rdfs:range :Examination .

:Examination a owl:Class ;
    rdfs:label "Examination" ;
    rdfs:comment "Examination" .

[] rdf:first :Examination .

