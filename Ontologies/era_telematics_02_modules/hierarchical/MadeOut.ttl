@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Date a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Date" ;
    rdfs:comment "Date",
        """Date at which the
																consignment note was made out.""" ;
    rdfs:domain :MadeOut ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf :dataProperties .

:MadeOut a owl:Class ;
    rdfs:label "MadeOut" ;
    rdfs:comment "Made out" .

