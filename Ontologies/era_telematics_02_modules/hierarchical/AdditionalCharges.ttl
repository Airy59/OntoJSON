@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Code a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Code" ;
    rdfs:comment """Additional
																			charges code""",
        """Additional
																			charges code according
																			CIT GLV-CIM appendix 3""" ;
    rdfs:domain :AdditionalCharges ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AdditionalCharges a owl:Class ;
    rdfs:label "AdditionalCharges" ;
    rdfs:comment "Additional Charges",
        "None",
        "Sum of Prepaid",
        "Sum of Transferred" .

