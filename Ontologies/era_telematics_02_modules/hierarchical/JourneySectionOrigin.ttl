@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasJourneySectionOrigin rdfs:range :JourneySectionOrigin .

:JourneySectionOrigin a owl:Class ;
    rdfs:label "JourneySectionOrigin" ;
    rdfs:comment "Origin of the section on which train composition is unchanged" .

[] rdf:first :JourneySectionOrigin .

