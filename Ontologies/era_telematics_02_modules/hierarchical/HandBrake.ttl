@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:HandBrakedWeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "HandBrakedWeight" ;
    rdfs:comment "Braked weight of the hand brake in tons" ;
    rdfs:domain :HandBrake ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf :dataProperties .

:hasHandBrake rdfs:range :HandBrake .

:HandBrake a owl:Class ;
    rdfs:label "HandBrake" .

[] rdf:first :HandBrake .

[] rdf:first :HandBrake .

