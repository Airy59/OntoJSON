@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:DetailedDescriptionOfLocation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DetailedDescriptionOfLocation" ;
    rdfs:domain :InterruptionPoint ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:hasInterruption a owl:ObjectProperty ;
    rdfs:label "has Interruption" ;
    rdfs:domain :InterruptionPoint ;
    rdfs:range :Interruption .

:hasInterruptionDuration a owl:ObjectProperty ;
    rdfs:label "has InterruptionDuration" ;
    rdfs:domain :InterruptionPoint ;
    rdfs:range :InterruptionDuration .

:InterruptionPoint a owl:Class ;
    rdfs:label "InterruptionPoint" ;
    rdfs:comment """describes the interruption points with location and the reason for the
				interruption""" .

