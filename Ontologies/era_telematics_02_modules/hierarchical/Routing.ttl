@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Routing a owl:Class ;
    rdfs:label "Routing" ;
    rdfs:comment """Sequential information about the complete routing of the consignment,
				the LeadRu decides wether to provide this information or not""" .

