@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:PhonNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "PhonNumber" ;
    rdfs:comment "Telephone Number" ;
    rdfs:domain :Contacts ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:hasContacts rdfs:range :Contacts .

:Contacts a owl:Class ;
    rdfs:label "Contacts" ;
    rdfs:comment "Contact information" .

[] rdf:first :Contacts .

[] rdf:first :Contacts .

