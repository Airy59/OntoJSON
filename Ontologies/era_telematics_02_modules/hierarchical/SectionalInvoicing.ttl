@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasSection a owl:ObjectProperty ;
    rdfs:label "has Section" ;
    rdfs:domain :SectionalInvoicing ;
    rdfs:range :Section .

:SectionalInvoicing a owl:Class ;
    rdfs:label "SectionalInvoicing" ;
    rdfs:comment "Sectional Invoicing" .

