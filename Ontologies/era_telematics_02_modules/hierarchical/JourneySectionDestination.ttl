@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasJourneySectionDestination rdfs:range :JourneySectionDestination .

:JourneySectionDestination a owl:Class ;
    rdfs:label "JourneySectionDestination" ;
    rdfs:comment "Destination of the section on which train composition is unchanged" .

[] rdf:first :JourneySectionDestination .

