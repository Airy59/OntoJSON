@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasEndOfSection a owl:ObjectProperty ;
    rdfs:label "has EndOfSection" ;
    rdfs:domain :AffectedSection ;
    rdfs:range :EndOfSection .

:hasStartOfSection a owl:ObjectProperty ;
    rdfs:label "has StartOfSection" ;
    rdfs:domain :AffectedSection ;
    rdfs:range :StartOfSection .

:AffectedSection a owl:Class ;
    rdfs:label "AffectedSection" ;
    rdfs:comment """Indication for the recepient if not the entire path is affected, e.g.
				in case of a partial cancelation for the last part of the path""" .

