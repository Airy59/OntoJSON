@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasILU_Details a owl:ObjectProperty ;
    rdfs:label "has ILU_Details" ;
    rdfs:domain :ILU ;
    rdfs:range :ILU_Details .

:ILU a owl:Class ;
    rdfs:label "ILU" ;
    rdfs:comment "Describes the type and content of an IntermodalTransportUnit" .

