@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasILU rdfs:range :ILU .

:hasILU_Details a owl:ObjectProperty ;
    rdfs:label "has ILU_Details" ;
    rdfs:domain :ILU ;
    rdfs:range :ILU_Details .

:ILU a owl:Class ;
    rdfs:label "ILU" ;
    rdfs:comment "Describes the type and content of an IntermodalTransportUnit" .

[] rdf:first :ILU .

[] rdf:first :ILU .

[] rdf:first :ILU .

