@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:ProductionStation a owl:Class ;
    rdfs:label "ProductionStation" ;
    rdfs:comment """Details of production station serving the point, this element is used
				if the productional station differs from the commercial station""" .

