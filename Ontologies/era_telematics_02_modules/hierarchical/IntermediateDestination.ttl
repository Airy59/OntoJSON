@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:IntermediateDestination a owl:Class ;
    rdfs:label "IntermediateDestination" ;
    :domain "Telematics" ;
    rdfs:comment "A location on the route of a train" .

