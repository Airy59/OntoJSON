@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:FirstName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "FirstName" ;
    rdfs:comment "AMEND: ",
        """Optional first name of the
													attendant.""",
        "READ: ",
        "WRITE: " ;
    rdfs:domain :Attendants ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:LastName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "LastName" ;
    rdfs:comment "AMEND: ",
        "Last name of attendant.",
        "READ: ",
        "WRITE: " ;
    rdfs:domain :Attendants ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Attendants a owl:Class ;
    rdfs:label "Attendants" ;
    rdfs:comment "Attendants during the transport." .

