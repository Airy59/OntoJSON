@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:HarbourName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "HarbourName" ;
    rdfs:comment """Name of harbour, where the transport will be handed over
							to a ship.""" ;
    rdfs:domain :Ship ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ShipOwner a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ShipOwner" ;
    rdfs:comment "Name of ship owner." ;
    rdfs:domain :Ship ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:hasShip rdfs:range :Ship .

:Ship a owl:Class ;
    rdfs:label "Ship" ;
    rdfs:comment """Additional information for transports, which shall be handed over to a
				ship""" .

[] rdf:first :Ship .

