@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasCOM a owl:ObjectProperty ;
    rdfs:label "has COM" ;
    rdfs:domain :COMS ;
    rdfs:range :COM .

:hasCOM_Header a owl:ObjectProperty ;
    rdfs:label "has COM_Header" ;
    rdfs:domain :COMS ;
    rdfs:range :COM_Header .

:COMS a owl:Class ;
    rdfs:label "COMS" ;
    rdfs:comment """Message (all bounded optional elements are bounded to to
							obligations of legacy systems)""" .

