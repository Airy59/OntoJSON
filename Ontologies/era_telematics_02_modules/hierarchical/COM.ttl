@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:WagonPreviousNumberFreight a owl:DatatypeProperty ;
    rdfs:label "WagonPreviousNumberFreight" ;
    rdfs:comment """Identifies the previous freight
													wagon if a shipment or Intermodal unit has
													changed the wagon during its journey""" ;
    rdfs:domain :COM ;
    rdfs:subPropertyOf :dataProperties .

:hasAcceptancePoint a owl:ObjectProperty ;
    rdfs:label "has AcceptancePoint" ;
    rdfs:domain :COM ;
    rdfs:range :AcceptancePoint .

