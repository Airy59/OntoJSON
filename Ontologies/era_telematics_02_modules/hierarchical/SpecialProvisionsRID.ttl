@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:SpecialProvisionRID5.4 a owl:DatatypeProperty ;
    rdfs:label "SpecialProvisionRID5.4" ;
    rdfs:domain :SpecialProvisionsRID ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:SpecialProvisionsRID3.3 a owl:DatatypeProperty ;
    rdfs:label "SpecialProvisionsRID3.3" ;
    rdfs:domain :SpecialProvisionsRID ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Waste a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Waste" ;
    rdfs:domain :SpecialProvisionsRID ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :dataProperties .

:hasSpecialProvisionsEnvironment a owl:ObjectProperty ;
    rdfs:label "has SpecialProvisionsEnvironment" ;
    rdfs:domain :SpecialProvisionsRID ;
    rdfs:range :SpecialProvisionsEnvironment .

:SpecialProvisionsRID a owl:Class ;
    rdfs:label "SpecialProvisionsRID" .

