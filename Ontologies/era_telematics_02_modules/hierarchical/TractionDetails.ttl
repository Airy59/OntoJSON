@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:TractionWeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "TractionWeight" ;
    rdfs:comment "The weight of the traction unit" ;
    rdfs:domain :TractionDetails ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf :dataProperties .

:TractionDetails a owl:Class ;
    rdfs:label "TractionDetails" ;
    rdfs:comment """Defines the design series, mode of deployment and technical
				specfications associated with the traction of a train.""" .

