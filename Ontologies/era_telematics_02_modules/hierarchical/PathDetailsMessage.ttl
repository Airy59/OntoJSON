@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:PathDetailsMessage a owl:Class ;
    rdfs:label "PathDetailsMessage" ;
    rdfs:comment """This message is used by the IM to the RU confirmaing details of the
				path in response to an RU request""" .

