@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasDepartureInterchangeReport rdfs:range :DepartureInterchangeReport .

:DepartureInterchangeReport a owl:Class ;
    rdfs:label "DepartureInterchangeReport" ;
    rdfs:comment "Departure or interchange station ETI Orgin" .

[] rdf:first :DepartureInterchangeReport .

[] rdf:first :DepartureInterchangeReport .

[] rdf:first :DepartureInterchangeReport .

