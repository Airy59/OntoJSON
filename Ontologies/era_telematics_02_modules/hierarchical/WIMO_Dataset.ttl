@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasConsignmentLevelData a owl:ObjectProperty ;
    rdfs:label "has ConsignmentLevelData" ;
    rdfs:domain :WIMO_Dataset ;
    rdfs:range :ConsignmentLevelData .

:hasEventLevelData a owl:ObjectProperty ;
    rdfs:label "has EventLevelData" ;
    rdfs:domain :WIMO_Dataset ;
    rdfs:range :EventLevelData .

:WIMO_Dataset a owl:Class ;
    rdfs:label "WIMO_Dataset" ;
    rdfs:comment "Comment describing your root element" .

