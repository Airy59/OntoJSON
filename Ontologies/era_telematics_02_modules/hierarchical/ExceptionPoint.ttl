@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ExceptionTimeAtLocation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ExceptionTimeAtLocation" ;
    rdfs:comment """The Date and Time when something unexpected happns during the
				transportation related to a location""" ;
    rdfs:domain :ExceptionPoint ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:ScheduledTimeAtLocation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ScheduledTimeAtLocation" ;
    rdfs:comment """Scheduled Date and Time at a location related to the status of the
				train or wagon at the given location""" ;
    rdfs:domain :ExceptionPoint ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:WagonLocationStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "WagonLocationStatus" ;
    rdfs:comment """identifies the status of a wagon, related to the actual time at a
				reporting point""" ;
    rdfs:domain :ExceptionPoint ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:ExceptionPoint a owl:Class ;
    rdfs:label "ExceptionPoint" ;
    rdfs:comment """Describes the interruption points with location and the time of the
				interruption""" .

