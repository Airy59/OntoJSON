@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasLocationActualTrack a owl:ObjectProperty ;
    rdfs:label "has LocationActualTrack" ;
    rdfs:domain :ChangeofTrackMessage ;
    rdfs:range :LocationActualTrack .

:hasLocationPlannedTrack a owl:ObjectProperty ;
    rdfs:label "has LocationPlannedTrack" ;
    rdfs:domain :ChangeofTrackMessage ;
    rdfs:range :LocationPlannedTrack .

:ChangeofTrackMessage a owl:Class ;
    rdfs:label "ChangeofTrackMessage" ;
    rdfs:comment """ This message is issued to show that the train is arriving at another
				platform to the one that was scheduled""" .

