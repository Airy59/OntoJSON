@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:MessageDateTimeCreated a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageDateTimeCreated" ;
    rdfs:comment "Date and time when the message was created by the legacy system" ;
    rdfs:domain :MessageHeader ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:MessageRoutingID a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageRoutingID" ;
    rdfs:comment """Additional information used to route the message to the correct
				recieving application (if needed)""" ;
    rdfs:domain :MessageHeader ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:SenderReference a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "SenderReference" ;
    rdfs:comment "reference used by the sender (e.g. FTP file name)" ;
    rdfs:domain :MessageHeader ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:hasMessageHeader rdfs:range :MessageHeader .

:MessageHeader a owl:Class ;
    rdfs:label "MessageHeader" ;
    rdfs:comment "Used for all messages" .

[] rdf:first :MessageHeader .

