@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasCashOnDelivery rdfs:range :CashOnDelivery .

:CashOnDelivery a owl:Class ;
    rdfs:label "CashOnDelivery" ;
    rdfs:comment """Details of the amount to be
													collected on delivery and the currency code.""" .

[] rdf:first :CashOnDelivery .

[] rdf:first :CashOnDelivery .

