@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Offset a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Offset" ;
    rdfs:domain :Timing ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:TimingQualifierCode a owl:DatatypeProperty ;
    rdfs:label "TimingQualifierCode" ;
    rdfs:comment "None" ;
    rdfs:domain :Timing ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:Timing a owl:Class ;
    rdfs:label "Timing" .

