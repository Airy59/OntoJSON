@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:PermissionNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "PermissionNumber" ;
    rdfs:comment """Reference/permission number of
														the exceptional consignment.""" ;
    rdfs:domain :ExceptionalConsignment ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:hasExceptionalConsignment rdfs:range :ExceptionalConsignment .

:ExceptionalConsignment a owl:Class ;
    rdfs:label "ExceptionalConsignment" ;
    rdfs:comment "Exceptional Consignment" .

[] rdf:first :ExceptionalConsignment .

