@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasTrainInformation a owl:ObjectProperty ;
    rdfs:label "has TrainInformation" ;
    rdfs:domain :PathRequestMessage ;
    rdfs:range :TrainInformation .

:PathRequestMessage a owl:Class ;
    rdfs:label "PathRequestMessage" ;
    rdfs:comment """This message serves to request a train path. The message is sent from
				the RU to each IM involved.""" .

