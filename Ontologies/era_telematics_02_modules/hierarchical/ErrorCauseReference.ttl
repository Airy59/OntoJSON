@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:MessageSenderReference a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageSenderReference" ;
    rdfs:domain :ErrorCauseReference ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ErrorCauseReference a owl:Class ;
    rdfs:label "ErrorCauseReference" ;
    rdfs:comment """The reference to the message and its particular element(s)
							that caused the error is provided here""" .

