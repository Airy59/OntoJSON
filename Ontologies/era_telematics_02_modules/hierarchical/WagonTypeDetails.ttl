@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:WagonLength a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "WagonLength" ;
    rdfs:comment "Length over buffers in cms" ;
    rdfs:domain :WagonTypeDetails ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf :dataProperties .

:hasWagonTypeDetails rdfs:range :WagonTypeDetails .

:WagonTypeDetails a owl:Class ;
    rdfs:label "WagonTypeDetails" ;
    rdfs:comment """These elements are only needed, if the
											wagon has to be treated as CUV (empty wagon).""" .

[] rdf:first :WagonTypeDetails .

[] rdf:first :WagonTypeDetails .

