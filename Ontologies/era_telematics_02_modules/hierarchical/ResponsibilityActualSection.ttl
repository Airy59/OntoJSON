@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasResponsibilityActualSection rdfs:range :ResponsibilityActualSection .

:ResponsibilityActualSection a owl:Class ;
    rdfs:label "ResponsibilityActualSection" ;
    rdfs:comment """This element identifies the responsible RU or IM for the actual path
				section""" .

[] rdf:first :ResponsibilityActualSection .

[] rdf:first :ResponsibilityActualSection .

