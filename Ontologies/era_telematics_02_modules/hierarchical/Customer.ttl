@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AdditionalInformation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AdditionalInformation" ;
    rdfs:comment "Additional Information supplied by Customer" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ContractualCarrierCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ContractualCarrierCode" ;
    rdfs:comment "Contractual Carrier Code" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CustomerCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CustomerCode" ;
    rdfs:comment "CODE: Customer Code of the Contractal Carrier" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Type a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Type" ;
    rdfs:comment "Customer Type: CR Consignor, CE Consignee" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:hasContacts a owl:ObjectProperty ;
    rdfs:label "has Contacts" ;
    rdfs:domain :Customer ;
    rdfs:range :Contacts .

:hasCustomer rdfs:range :Customer .

:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "Consignor or Consignee" .

[] rdf:first :Customer .

[] rdf:first :Customer .

[] rdf:first :Customer .

[] rdf:first :Customer .

[] rdf:first :Customer .

[] rdf:first :Customer .

[] rdf:first :Customer .

[] rdf:first :Customer .

[] rdf:first :Customer .

