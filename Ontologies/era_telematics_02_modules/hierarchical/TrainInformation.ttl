@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasPathPlanningReferenceLocation a owl:ObjectProperty ;
    rdfs:label "has PathPlanningReferenceLocation" ;
    rdfs:domain :TrainInformation ;
    rdfs:range :PathPlanningReferenceLocation .

:hasTrainInformation rdfs:range :TrainInformation .

:TrainInformation a owl:Class ;
    rdfs:label "TrainInformation" ;
    rdfs:comment """Train information provided by the RUs as an overview for the entire
				train journey from origin to destination""" .

[] rdf:first :TrainInformation .

[] rdf:first :TrainInformation .

