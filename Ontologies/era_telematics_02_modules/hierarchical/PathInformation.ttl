@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasPathInformation rdfs:range :PathInformation .

:hasRequestedCalendar a owl:ObjectProperty ;
    rdfs:label "has RequestedCalendar" ;
    rdfs:domain :PathInformation ;
    rdfs:range :RequestedCalendar .

:PathInformation a owl:Class ;
    rdfs:label "PathInformation" .

[] rdf:first :PathInformation .

[] rdf:first :PathInformation .

