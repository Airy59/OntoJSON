        "Number plate of the vehicle.",
        "READ: ",
        "WRITE: " ;
    rdfs:domain :Vehicles ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ObjectType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ObjectType" ;
    rdfs:comment """Provides a possibility for differentiation between the objects: Train
				(TR), Route (RO), Path (PA), Case Reference (CR), Path Request (PR), Capacity Needs
				Announcements (CN), Capacity Model (CM), Catalogue Path (CP)""" ;
