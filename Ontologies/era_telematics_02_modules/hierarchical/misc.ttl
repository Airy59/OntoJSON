    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:TypeCode1 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "TypeCode1" ;
    rdfs:comment """Value is 9 as it's written in Part 0 of the Appendix 6 of
							the decision 2007/756""" ;
    rdfs:domain :LocoTypeNumber ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:TypeCode2 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
