:UN_Number a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "UN_Number" ;
    rdfs:comment """The UNNumber of the dangerous good according to the RID
							chapter 3.2, table A, column 1. Mandatory, except it concerns a
							declaration of an empty packaging of the type "EMPTY PACKAGING", "EMPTY
							RECEPTACLE <=1000L", "EMPTY IBC" or "EMPTY LARGE PACKAGING" .""",
        """The UNNumber of the dangerous good according to the RID
						chapter 3.2, table A, column 1. Mandatory, except it concerns a declaration
						of an empty packaging of the type "EMPTY PACKAGING", "EMPTY RECEPTACLE
						<=1000L", "EMPTY IBC" or "EMPTY LARGE PACKAGING" .""",
        """The UNNumber of the dangerous good according to the RID chapter 3.2,
				table A, column 1. Mandatory, except it concerns a declaration of an empty packaging
				of the type "EMPTY PACKAGING", "EMPTY RECEPTACLE <=1000L", "EMPTY IBC" or "EMPTY
				LARGE PACKAGING" .""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:UltimateDestinationCountry a owl:DatatypeProperty,
