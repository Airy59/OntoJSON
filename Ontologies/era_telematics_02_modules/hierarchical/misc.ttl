    rdfs:subPropertyOf :dataProperties .

:NormalLoadingGauge a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "NormalLoadingGauge" ;
    rdfs:comment """
			All codes are defined in the UIC leaflet 505-1 and 503, as well as in the EN 15273-2:2013. For details please refer to EN 15273-2:2013 (Railway applications - Gauges - Part 2: Rolling stock gauge). For the existing gauges in the list, the Annex B.3 should be used.
			""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

