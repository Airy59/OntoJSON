        owl:FunctionalProperty ;
    rdfs:label "LivestockOrPeopleIndicator" ;
    rdfs:comment "Indicates that livestock and people (other than train crew) will be carried. Coding: if live animals or people are transported = 1, in opposite case = 0. If code = 1, then at the wagon level for at least one wagon Info- Goods Shape, Type and Danger has to include the code '98' or Restrictions due to Load or Damage has to include code '09.'" ;
    rdfs:domain :TrainCompositionJourneySection ;
