    rdfs:label "WheelsetGauge" ;
    rdfs:comment """Track Gauge measured in mm; multi-entry for wagons with changeable
				wheel set gauge""" ;
    rdfs:domain :DesignDataSet ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:ZIPCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ZIPCode" ;
    rdfs:comment "Postal Code" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Zones a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Zones" ;
    rdfs:comment """Tariff
																						distance,
																						expressed in
																						zones,
																						between the
																						stations or
																						points
																						corresponding
																						to the
																						beginning
																						and end of
																						the charging
																						section.""" ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf :dataProperties .

