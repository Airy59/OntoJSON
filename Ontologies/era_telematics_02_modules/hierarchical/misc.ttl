@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ARC a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ARC" ;
    rdfs:comment """Administrative Reference CodeEMCS (Excise Movement and
							Control System)""",
        "CODE: EU (EC) No 684/2009" ;
    rdfs:domain :ReferenceNumbers ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ATEXCertified a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ATEXCertified" ;
    rdfs:comment """Indication if the telematics device
									is ATEX certified.""" ;
    rdfs:domain :TelematicsDevice ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :dataProperties .

:ATEXLevel a owl:DatatypeProperty ;
    rdfs:label "ATEXLevel" ;
    rdfs:comment """Indication of ATEX level (gas and
									dust if applicable) based on ATEX/IECEx standard; e.g.: II 2G Ex
									ib IIB T4 Gb or II 2D Ex ib IIIC T135Â°C Db.""" ;
    rdfs:domain :TelematicsDevice ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AcceptanceDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AcceptanceDate" ;
    rdfs:comment """Date and time (month,
																day and hour) at which the goods
																were accepted. """,
        "Forwarding Date" ;
    rdfs:domain [ ] ;
    rdfs:range [ ] ;
    rdfs:subPropertyOf :dataProperties .

:ActionRequiredFromCarrier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ActionRequiredFromCarrier" ;
    rdfs:comment """Special action required by the carrier according to
							chapter 5.4.1.2.5.2 RID""" ;
    rdfs:domain :RID ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ActualETA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ActualETA" ;
    rdfs:comment """Identifies the actual ETA date and time of arrival of the Wagon or
				Unit on the final destination of the customer siding.""" ;
    rdfs:domain :AlertMessage ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:ActualETI a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ActualETI" ;
    rdfs:comment """Identifies the actual valid estimated date and time of interchange of
				the Wagon or Unit at an interchange point""" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:ActualEndDateTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ActualEndDateTime" ;
    rdfs:comment """Identifies the actual date and time of arrival of the Wagon or Unit on
				the final destination of the customer siding.""" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:AddidtionalInformation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AddidtionalInformation" ;
    rdfs:domain :Customers ;
    rdfs:subPropertyOf :dataProperties .

:AdditionalCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AdditionalCode" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AdditionalGoodInformation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AdditionalGoodInformation" ;
    rdfs:comment """Additional information regarding the
												loaded good, given by the customer.""",
        """Additional information regarding the loaded good, given by
							the customer.""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AdditionalInformation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AdditionalInformation" ;
    rdfs:comment "Additional Information supplied by Customer" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AdditionalInformationILU a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AdditionalInformationILU" ;
    rdfs:comment "Additional information " ;
    rdfs:domain :ILU_Details ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AdditionalInstruction a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AdditionalInstruction" ;
    rdfs:comment "Additional instructions regarding the wagon or shipment in free text" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Address a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Address" ;
    rdfs:comment "Generic postal address in clear text" ;
    rdfs:domain :AdministrativeContactInformation ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AgainstBooked a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AgainstBooked" ;
    rdfs:comment "Identifies the Delta delay time against the booked schedule in minutes" ;
    rdfs:domain :TrainDelay ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AgainstReferenced a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AgainstReferenced" ;
    rdfs:comment "Delay compared to the referenced Date/Time" ;
    rdfs:domain :TrainDelay ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AgreedTimeOfDelivery a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AgreedTimeOfDelivery" ;
    rdfs:comment """The requested Date and Time for the delivery of a wagon/Shipment or
				Intermodal untis at customer sidings""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:AirBrakeSpecialCharacteristic a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AirBrakeSpecialCharacteristic" ;
    rdfs:comment "Coding in 404-2, chapter 1.8" ;
    rdfs:domain :WagonTechData ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:AirBrakeType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AirBrakeType" ;
    rdfs:comment "Classification of air brake." ;
    rdfs:domain [ ] ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:AirBrakedMass a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AirBrakedMass" ;
    rdfs:comment """General braked weight for wagon without a variation device; Braked
				weight empty for wagons with a variation device; maximum braked weight for wagons
				with linear auto continuous device; "0" for wagons without air brake (in tons).""" ;
    rdfs:domain :AirBrake ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:AirBrakedMassLoaded a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AirBrakedMassLoaded" ;
    rdfs:comment """Braked weight in tonns loaded for change over
										weight""" ;
    rdfs:domain :LoadChangeDevice ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:AllocationCompany a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AllocationCompany" ;
    :domain "Telematics" ;
    rdfs:comment """Name of company who is responsible for allocation and maintenance of
				codes""" ;
    rdfs:domain [ ] ;
    rdfs:subPropertyOf :dataProperties .

:Altitude a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Altitude" ;
    rdfs:comment """Altitude (in m) at the beginning of the SP. Considering ETRS89 as
				reference. Starting at -1000m""" ;
    rdfs:domain :GeographicCoordinates ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:Amount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Amount" ;
    rdfs:comment "Amount" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf :dataProperties .

:AntennaDistanceFromFrontOfTrain a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AntennaDistanceFromFrontOfTrain" ;
    rdfs:comment """Distance of the defined coordinates from the front of the
							train, in meters.""" ;
    rdfs:domain :GNSS_DynamicPosition ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf :dataProperties .

:ArrivalTimeAtDestination a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ArrivalTimeAtDestination" ;
    rdfs:comment """The actual Date and Time of the arrival of wagons by train at its
				final destination yard""" ;
    rdfs:domain :ArrivalAtDestination ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:ArrivalTimeAtLocation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ArrivalTimeAtLocation" ;
    rdfs:comment "The actual arrival date and time at the defined location" ;
    rdfs:domain :ArrivalInterchangeReport ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:ArrivalTimeAtLocationActual a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ArrivalTimeAtLocationActual" ;
    rdfs:comment "The actual arrival date and time at the defined location" ;
    rdfs:domain :YardArrival ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:AssociatedAttachedOTN a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AssociatedAttachedOTN" ;
    rdfs:comment """Identifies the associated train for the activity for traffic
				management purposes by the Dispatcher, GSMR services, etc.""" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AssociatedAttachedTrainServiceNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AssociatedAttachedTrainServiceNumber" ;
    rdfs:comment """Identifies the associated train service line number for the train
				activity connecting service""" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AuthorisationValidUntil a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AuthorisationValidUntil" ;
    rdfs:comment """End date for restricted authorisation (special
										case)""" ;
    rdfs:domain :AdministrativeDataSet ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf :dataProperties .

:Beginning a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Beginning" ;
    rdfs:comment """Beginning of the
																extension.""" ;
    rdfs:domain :TransitPeriodExtensions ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:BitmapDays a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BitmapDays" ;
    rdfs:comment """Structure BitmapDays must be provided if ValidityPeriod of associated
				calendar contains more than one day; it is optional otherwise.""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:BodyID a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BodyID" ;
    rdfs:comment "4N Company Code" ;
    rdfs:domain :CheckingBody ;
    rdfs:subPropertyOf :dataProperties .

:BodyType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BodyType" ;
    rdfs:comment """Following types of bodies are authorised (RID
										1.4.3): 01 Carrier 02 Loader 03 Filler 04 Unloader""" ;
    rdfs:domain :CheckingBody ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:BogiePitch a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BogiePitch" ;
    rdfs:comment "Bogie Wheelbase measured in mm" ;
    rdfs:domain :DesignDataSet ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:BogiePivotPitch a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BogiePivotPitch" ;
    rdfs:comment """Largest distance between two adjacent bogie
										pitches in mm""" ;
    rdfs:domain :DesignDataSet ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subPropertyOf :dataProperties .

:BogieWagonsOnly a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BogieWagonsOnly" ;
    rdfs:comment """Indicates that the train consists of bogie wagons only or not.
				â€œYesâ€/â€trueâ€ means always all wagons of the train are bogie wagons. Then content of
				element is â€œnoâ€/â€falseâ€ or element isnâ€™t used means the train contains of different
				wagons (not homogeneous only with bogie wagons).""" ;
    rdfs:domain :PlannedTrainTechnicalData ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :dataProperties .

:BookedLocationDateTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BookedLocationDateTime" ;
    rdfs:comment """Scheduled Date and Time of a train at a speciied location as defined
				in the path contract""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:BookedLocationTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BookedLocationTime" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:time ;
    rdfs:subPropertyOf :dataProperties .

:BookingNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BookingNumber" ;
    rdfs:comment "XrailBooking number for the consignment" ;
    rdfs:domain :WagonDetails ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:BrakeBlockName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BrakeBlockName" ;
    rdfs:comment """Name of the brake block type,
													including the length in mm""" ;
    rdfs:domain :BrakeBlock ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:BrakeSpecialCharacteristics a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BrakeSpecialCharacteristics" ;
    rdfs:comment """
General brake characteristics. The values refer to UIC leaflet 920-13.
			""" ;
    rdfs:domain :AirBrake ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:BrakeSystem a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BrakeSystem" ;
    rdfs:comment """Abbreviation of air brake system. Following values are
							examples: Kk; Dr; Bo; Hik; Bd; Ch; O; KE; WE; DK; WU; WA; DM; MH, SW; KE
							435; through brake pipe""" ;
    rdfs:domain :AirBrake ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:BrakeType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BrakeType" ;
    rdfs:comment "Type of braking system." ;
    rdfs:domain [ ] ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:BrakeWeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BrakeWeight" ;
    rdfs:comment """Shows the Braked mass of the wagon according to the type of the
				braking system, in Tonnes""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf :dataProperties .

:BrakingPowerVariationDevice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BrakingPowerVariationDevice" ;
    rdfs:comment "Coding in 404-2, chapter 1.8" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:BrakingRatio a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BrakingRatio" ;
    rdfs:comment """Minimum percentage of braking. Expressed as an integer value (no
				percent sign should be added).""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:BufferType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BufferType" ;
    rdfs:comment """ Classification of buffer. The following
										values are mostly used in the sector.: A, AX, B, C, CX, L0
										(130), L0 (150), L2 (130), L2 (150), L4 (130), L4 (150)""" ;
    rdfs:domain :DesignDataSet ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:C1 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "C1" ;
    rdfs:domain :CombinedTrafficLoadProfile ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:C2 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "C2" ;
    rdfs:comment "C2 requires the code in case the gauge of the swap body is greater than 2550 mm less or equal 2600 mm" ;
    rdfs:domain :CombinedTrafficLoadProfile ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CI_InstanceNumber a owl:DatatypeProperty ;
    rdfs:label "CI_InstanceNumber" ;
    rdfs:comment "Number of a Common Interface Instance for the same Company" ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:COM_PreparationDatetime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "COM_PreparationDatetime" ;
    rdfs:comment """Date and Time of preparation of
													the COM""" ;
    rdfs:domain :COM_Header ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:CarrierCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CarrierCode" ;
    rdfs:comment """Code of the carrier
														undertaking the examination (see CIM Article
														11 sections 2 and 3). """,
        """Code of the carrier who made
														it out.""",
        """Code of the shipping
																carrier mentioned in the consignment
																number.""",
        """Contractual carrier,
																railway undertaking (Railway Code).""",
        """Railway Undertaking
																(Railway Code)""",
        """additional carrier
																code belonging to the given contract
																number""" ;
    rdfs:domain [ ] ;
    rdfs:subPropertyOf :dataProperties .

:CarrierName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CarrierName" ;
    rdfs:comment "Name of Carrier",
        """Name of contractual
																carrier""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CarrierStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CarrierStatus" ;
    rdfs:comment """Status of the carrier during the transport 0 Contractual carrier /
				Lead carrier 1 Succesive carrier 2 Substitute carrier 3 to be used for all other
				partners (e.g. subcontractors, relevant applicants) beside the carriers in role 0, 1
				and 2 (which have to be mentioned in the consignment note)""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:ChangeOverWeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ChangeOverWeight" ;
    rdfs:comment """Change over weight of braked weight in tonns
										variation device""" ;
    rdfs:domain :LoadChangeDevice ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:ChannelTunnelPermitted a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ChannelTunnelPermitted" ;
    rdfs:comment """Indication if wagon is allowed to pass the
										Channel Tunnel - if the transport is planned between UK and
										France and should use Eurotunnel infrastructure.""" ;
    rdfs:domain :AdministrativeDataSet ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :dataProperties .

:CharacteristicDescriptionCode a owl:DatatypeProperty ;
    rdfs:label "CharacteristicDescriptionCode" ;
    rdfs:domain :TypeofService ;
    rdfs:subPropertyOf :dataProperties .

:ChargesNoteAvailable a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ChargesNoteAvailable" ;
    rdfs:domain :ChargesNote ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :dataProperties .

:Checkdigit a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Checkdigit" ;
    rdfs:comment "Check digit" ;
    rdfs:domain :ITU_Details ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf :dataProperties .

:CheckingDateTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CheckingDateTime" ;
    rdfs:comment "Date and Time when the check was performed" ;
    rdfs:domain :RID_Checking ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:CheckingResults a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CheckingResults" ;
    rdfs:comment """Description of the checks' results (in conjunction with
							the element CheckingType) and possible need for follow-up: 01 Results
							OK, no follow up needed during transportation 02 Results OK, but follow
							up needed during transportation 03 Results not OK, transportation
							rejected""" ;
    rdfs:domain :RID_Checking ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CheckingType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CheckingType" ;
    rdfs:comment """Following types of checks are authorised (RID 1.4.3):
							Carrier: 01 Prescribed documentation attached to transport docuemnt 02
							Defects, leackages, cracks, missing equipment on wagons or equipment
							Loader: 11 Damage of packing 12 Compliance with prohibition on mixed
							loading 13 Uncleaned empty package Filler: 21 Date of next inspection of
							wagons 22 DG is filled only into authorized tanks 23 Permissible level
							of filling 24 Plackards, plates from RID chapter 5.3 are visible on
							wagon 25 Correct Closure of wagons / tanks 26 Leackage on wagons / tanks
							Unloader: 31 Damage of packages or of tanks 32 Required DG documentation
							available 33 Cleaning, degasing, decontamination of wagons from residues
							34 Plackards, plates from RID chapter 5.3 are removed from wagon """ ;
    rdfs:domain :RID_Checking ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:City a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "City" ;
    rdfs:comment "City / Town",
        "City/Town" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CityTown a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CityTown" ;
    rdfs:comment "Name of the City or Town in Clear Text" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ClassificationCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ClassificationCode" ;
    rdfs:comment "CODE: OTIF RID-Specification",
        """The Classification Code of the dangerous good according to
							the RID chapter 3.2, table A, column 3b. Mandatory for Class 1 -
							optional, but possibly for all the other classes.""" ;
    rdfs:domain :RID ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ClosingTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ClosingTime" ;
    rdfs:comment """The closing Date and Time of the port for the delivery of the shipment
				by rail to a vessel.""" ;
    rdfs:domain :VesselIndication ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:Coasting a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Coasting" ;
    rdfs:comment """IM indicates to the RU whether the driver can rely on coasting. This
				is of both economic and ecological interest, as in many parts of the journey the
				trains may have enough inertia to be able to match the calculated time of the next
				location relying on coasting only.""" ;
    rdfs:domain :PlannedTrainTechnicalData ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :dataProperties .

:Code a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Code" ;
    rdfs:comment """Additional
																			charges code""",
        """Additional
																			charges code according
																			CIT GLV-CIM appendix 3""" ;
    rdfs:domain :AdditionalCharges ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CodeOfCause a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CodeOfCause" ;
    rdfs:comment "Code of reason for extension" ;
    rdfs:domain :TransitPeriodExtensions ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:Comments a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Comments" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CommercialRouteCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CommercialRouteCode" ;
    rdfs:comment """Route code (RIP) when
																the customer agreement or the tariff
																applied provide for it. """ ;
    rdfs:domain :ChargingSections ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CommercialSpecificationCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CommercialSpecificationCode" ;
    rdfs:comment "Commercial specifications code" ;
    rdfs:domain :CommercialSpecifications ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf :dataProperties .

:CommercialTrafficType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
