    rdfs:comment "AMEND: ",
        "CODE:",
        "READ: ",
        "Type of Rolling Road unit on Wagon",
        "WRITE: " ;
    rdfs:domain :RollingRoadUnitDetails ;
    rdfs:range [ ] ;
    rdfs:subPropertyOf :dataProperties .

:RouteClass a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "RouteClass" ;
    rdfs:comment """Indication of the route class (based on CEN EN 15528: line categories for managing the interface between load limits of vehicles on infrastructure). All the codes in this code list refer to CEN EN 15528: line categories for managing the interface between load limits of vehicles on infrastructure.
CM2, CM3 and CM 4 equal M2, M3 and M4 which might be used in some legacy systems which only support two character codes.""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:RouteCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "RouteCode" ;
    rdfs:comment "Route code (International RouteCode)" ;
    rdfs:domain :RouteSection ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:RouteInformation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "RouteInformation" ;
    rdfs:comment """The route of the journey for a wagon / shipment or Intermodal unit
				assigned by the LRU""" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:RouteText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "RouteText" ;
    rdfs:comment """Description of the
																	specific route section""",
        "Description of the specific route section" ;
    rdfs:domain :RouteSection ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:SRID a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "SRID" ;
    rdfs:comment "ID of coordinates system used (EPSG code)" ;
    rdfs:domain :GeographicCoordinates ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:SatelliteHDOP a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "SatelliteHDOP" ;
    rdfs:comment """HDOP = Horizontal Dilution Of Precision.
										Parameter used to describe the strength of the current
										satellite configuration, or geometry, and itâ€™s impact on the
										accuracy of the data collected by a GNSS receiver at the
										time of use. HDOP provides a measure of accuracy in 2-D
										position (e.g. Latitude and Longitude). Smaller value
										indicates better precision. Values less than 1 are the best.
										Values from 2 - 5 are good. Values greater 10 indicate bad
										quality """ ;
    rdfs:domain :SignalQuality ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf :dataProperties .

:ScheduledDateTimeAtTransfer a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ScheduledDateTimeAtTransfer" ;
    rdfs:comment """The referenced date and time of arrival or exit at the border between
				two different IMs""" ;
    rdfs:domain :OperationalTrainNumberIdentifier ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:ScheduledTimeAtHandover a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ScheduledTimeAtHandover" ;
    rdfs:comment """The referenced date and time of departure or entrance at the border
				between two different IMs""" ;
    rdfs:domain :OperationalTrainNumberIdentifier ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:ScheduledTimeAtLocation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ScheduledTimeAtLocation" ;
    rdfs:comment """Scheduled Date and Time at a location related to the status of the
				train or wagon at the given location""" ;
    rdfs:domain :ExceptionPoint ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:SealsDescription a owl:DatatypeProperty ;
    rdfs:label "SealsDescription" ;
    rdfs:comment """Additional information of the original consignor regarding
							the attached seals.""" ;
    rdfs:domain :Seals ;
    rdfs:range xsd:string ;
