    rdfs:subPropertyOf :dataProperties .

:WagonTrainPosition a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "WagonTrainPosition" ;
    rdfs:comment """Identifies the position of a wagon within a train. Sequential number
				starting with the first wagon at the front of train as NÂ°1.""" ;
    rdfs:domain :WagonData ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf :dataProperties .

:WagonWeightEmpty a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "WagonWeightEmpty" ;
    rdfs:comment """The weight of an empty wagon according to the entry in the rolling
				stock database""" ;
    rdfs:domain [ ] ;
    rdfs:range xsd:integer ;
