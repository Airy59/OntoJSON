@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:WagonPickupAtOrigin a owl:Class ;
    rdfs:label "WagonPickupAtOrigin" ;
    rdfs:comment """Place and Date and Time of when the wagon is ready to be taken over by
				the RU/Service Provider at the customer sidings""" .

