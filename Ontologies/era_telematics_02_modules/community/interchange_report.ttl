@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ArrivalTimeAtLocation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ArrivalTimeAtLocation" ;
    rdfs:comment "The actual arrival date and time at the defined location" ;
    rdfs:domain :ArrivalInterchangeReport ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:Source a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Source" ;
    rdfs:comment "Source of information" ;
    rdfs:domain :ArrivalInterchangeReport ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:hasArrivalInterchangeReport a owl:ObjectProperty ;
    rdfs:label "has ArrivalInterchangeReport" ;
    rdfs:domain :WagonETI_ETA_Message ;
    rdfs:range :ArrivalInterchangeReport .

:hasDepartureInterchangeReport a owl:ObjectProperty ;
    rdfs:label "has DepartureInterchangeReport" ;
    rdfs:domain :WagonETI_ETA_Message ;
    rdfs:range :DepartureInterchangeReport .

:DepartureInterchangeReport a owl:Class ;
    rdfs:label "DepartureInterchangeReport" ;
    rdfs:comment "Departure or interchange station ETI Orgin" .

:WagonETI_ETA_Message a owl:Class ;
    rdfs:label "WagonETI_ETA_Message" ;
    rdfs:comment """This message is sent by the RU to the next RU in the transport chain
				to give him the calculation of its ETI. The last RU sends this message with ETA to
				the Lead RU, which may inform its customer. Following the handover information from
				the IM, the RU sends with this message also the updated ETI to the next RU and the
				last RU sends the updated ETA to the LRU.""" .

:ArrivalInterchangeReport a owl:Class ;
    rdfs:label "ArrivalInterchangeReport" ;
    rdfs:comment "The arrival or interchange station where ETI end" .

