@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasTrainLocationReport a owl:ObjectProperty ;
    rdfs:label "has TrainLocationReport" ;
    rdfs:domain [ ] ;
    rdfs:range :TrainLocationReport .

:TrainLocationReport a owl:Class ;
    rdfs:label "TrainLocationReport" ;
    rdfs:comment """Specifies the relevant running data of a train related to a specific
				location""" .

[] rdf:first :TrainLocationReport .

[] rdf:first :TrainLocationReport .

[] rdf:first :TrainLocationReport .

[] rdf:first :TrainLocationReport .

[] rdf:first :TrainLocationReport .

[] rdf:first :TrainLocationReport .

[] rdf:first :TrainLocationReport .

