@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:TransfereeIM a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "TransfereeIM" ;
    rdfs:comment "Next IM" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ChangeofTrackMessage :TrainCompositionMessage :TrainDelayCauseMessage :TrainJourneyModificationMessage :TrainReadyMessage :TrainRunningForecastMessage :TrainRunningInformationMessage :TrainRunningInterruptionMessage ) ] ;
    rdfs:subPropertyOf :dataProperties .

