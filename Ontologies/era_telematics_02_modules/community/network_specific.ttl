@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasNetworkSpecificParameter a owl:ObjectProperty ;
    rdfs:label "has NetworkSpecificParameter" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AffectedSection :PathDetailsMessage :PathRequestMessage :PlannedJourneyLocation ) ] ;
    rdfs:range :NetworkSpecificParameter .

:NetworkSpecificParameter a owl:Class ;
    rdfs:label "NetworkSpecificParameter" ;
    rdfs:comment """The usage of this element must be specified in national rules and has
				to be defined by each IM""" .

