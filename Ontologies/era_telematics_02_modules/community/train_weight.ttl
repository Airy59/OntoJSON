@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:TrainWeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "TrainWeight" ;
    rdfs:comment "The sum of all weights of wagons and traction units" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :PlannedTrainTechnicalData :TrainRunningTechData ) ] ;
    rdfs:subPropertyOf :dataProperties .

