@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:ResponsibleRU a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ResponsibleRU" ;
    rdfs:comment "RU Responsible for the physical operation of the train or wagon" ;
    rdfs:domain [ ] ;
    rdfs:subPropertyOf :dataProperties .

