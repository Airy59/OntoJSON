@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasTransferPoint a owl:ObjectProperty ;
    rdfs:label "has TransferPoint" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ChangeofTrackMessage :TrainCompositionMessage :TrainDelayCauseMessage :TrainJourneyModificationMessage :TrainReadyMessage :TrainRunningForecastMessage :TrainRunningInformationMessage :TrainRunningInterruptionMessage ) ] ;
    rdfs:range :TransferPoint .

:TransferPoint a owl:Class ;
    rdfs:label "TransferPoint" ;
    rdfs:comment "Transfer point or station of destination in the considered network" .

