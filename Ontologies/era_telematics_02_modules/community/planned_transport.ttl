@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasPlannedTransportIdentifiers a owl:ObjectProperty ;
    rdfs:label "has PlannedTransportIdentifiers" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ErrorMessage :Identifiers ) ] ;
    rdfs:range :PlannedTransportIdentifiers .

:PlannedTransportIdentifiers a owl:Class ;
    rdfs:label "PlannedTransportIdentifiers" .

