@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasTrainID a owl:ObjectProperty ;
    rdfs:label "has TrainID" ;
    rdfs:domain [ ] ;
    rdfs:range :TrainID .

:TrainID a owl:Class ;
    rdfs:label "TrainID" .

