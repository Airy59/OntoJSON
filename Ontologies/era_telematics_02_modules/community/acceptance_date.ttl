@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AcceptanceDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AcceptanceDate" ;
    rdfs:comment """Date and time (month,
																day and hour) at which the goods
																were accepted. """,
        "Forwarding Date" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AcceptancePoint :ControlLabel ) ] ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:date xsd:dateTime ) ] ;
    rdfs:subPropertyOf :dataProperties .

