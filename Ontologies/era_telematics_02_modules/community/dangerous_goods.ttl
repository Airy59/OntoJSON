@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasDangerousGoodsIndication a owl:ObjectProperty ;
    rdfs:label "has DangerousGoodsIndication" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ConsignmentLevelData :PlannedTrainData :WagonOperationalData ) ] ;
    rdfs:range :DangerousGoodsIndication .

:DangerousGoodsIndication a owl:Class ;
    rdfs:label "DangerousGoodsIndication" ;
    :domain "Telematics" ;
    rdfs:comment "Identifies dangerous goods" .

