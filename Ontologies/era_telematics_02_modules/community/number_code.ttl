@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ATEXCertified a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ATEXCertified" ;
    rdfs:comment """Indication if the telematics device
									is ATEX certified.""" ;
    rdfs:domain :TelematicsDevice ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :dataProperties .

:ATEXLevel a owl:DatatypeProperty ;
    rdfs:label "ATEXLevel" ;
    rdfs:comment """Indication of ATEX level (gas and
									dust if applicable) based on ATEX/IECEx standard; e.g.: II 2G Ex
									ib IIB T4 Gb or II 2D Ex ib IIIC T135Â°C Db.""" ;
    rdfs:domain :TelematicsDevice ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AdditionalCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AdditionalCode" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AdditionalGoodInformation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AdditionalGoodInformation" ;
    rdfs:comment """Additional information regarding the
												loaded good, given by the customer.""",
        """Additional information regarding the loaded good, given by
							the customer.""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Goods :GoodsInWagon ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AdditionalInformation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AdditionalInformation" ;
    rdfs:comment "Additional Information supplied by Customer" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AdditionalInstruction a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AdditionalInstruction" ;
    rdfs:comment "Additional instructions regarding the wagon or shipment in free text" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Address a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Address" ;
    rdfs:comment "Generic postal address in clear text" ;
    rdfs:domain :AdministrativeContactInformation ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AgainstBooked a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AgainstBooked" ;
    rdfs:comment "Identifies the Delta delay time against the booked schedule in minutes" ;
    rdfs:domain :TrainDelay ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AgainstReferenced a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AgainstReferenced" ;
    rdfs:comment "Delay compared to the referenced Date/Time" ;
    rdfs:domain :TrainDelay ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AssociatedAttachedOTN a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AssociatedAttachedOTN" ;
    rdfs:comment """Identifies the associated train for the activity for traffic
				management purposes by the Dispatcher, GSMR services, etc.""" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:AssociatedAttachedTrainServiceNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AssociatedAttachedTrainServiceNumber" ;
    rdfs:comment """Identifies the associated train service line number for the train
				activity connecting service""" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:BitmapDays a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "BitmapDays" ;
    rdfs:comment """Structure BitmapDays must be provided if ValidityPeriod of associated
				calendar contains more than one day; it is optional otherwise.""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :PlannedCalendar :ReferenceTrainIDSubCalendar :RequestedCalendar ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:C1 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "C1" ;
    rdfs:domain :CombinedTrafficLoadProfile ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:C2 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "C2" ;
    rdfs:comment "C2 requires the code in case the gauge of the swap body is greater than 2550 mm less or equal 2600 mm" ;
    rdfs:domain :CombinedTrafficLoadProfile ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CarrierName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CarrierName" ;
    rdfs:comment "Name of Carrier",
        """Name of contractual
																carrier""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Carriers :LeadCarrier ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:City a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "City" ;
    rdfs:comment "City / Town",
        "City/Town" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Carriers :Customer :Customers :LeadCarrier ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CityTown a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CityTown" ;
    rdfs:comment "Name of the City or Town in Clear Text" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Code a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Code" ;
    rdfs:comment """Additional
																			charges code""",
        """Additional
																			charges code according
																			CIT GLV-CIM appendix 3""" ;
    rdfs:domain :AdditionalCharges ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Comments a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Comments" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :LocationPrimaryInformation :LocationSubsidiaryInformation ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ComponentMounted a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ComponentMounted" ;
    rdfs:comment """Indication of the component to which
									the telematics unit is attached.""" ;
    rdfs:domain :TelematicsDevice ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ConsignorReference a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ConsignorReference" ;
    rdfs:comment """Consignor's reference
																concerning the complete consignment""" ;
    rdfs:domain :GeneralInformation ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ContractNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ContractNumber" ;
    rdfs:comment "Number of agreement between LeadRU and Responsible RU",
        """Number of customer
																agreement.""",
        """additional contract
																number according to the given
																carrier code.""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommercialSpecifications :ConsignmentLevelData ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ContractNumberMovement a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ContractNumberMovement" ;
    rdfs:comment """Identifies the contract between LeadRU and RU involved in the
				transport""" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ContractualCarrierCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ContractualCarrierCode" ;
    rdfs:comment "Contractual Carrier Code" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ControlDigit a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ControlDigit" ;
    rdfs:comment """1 control digit as usual at the end of the 12 digit UIC
							identifier. Not used in Planning""" ;
    rdfs:domain :LocoTypeNumber ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Core a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Core" ;
    rdfs:comment """It is the main part of identifier and is determent by the company that
				creates it.""" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Country a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Country" ;
    rdfs:comment "Country Code (ISO Code)",
        "Country Code ISO" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Customer :Customers ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CountryCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CountryCode" ;
    rdfs:comment """Country Code (ISO
																Code)""",
        """Invoiced
																						section
																						specified by
																						country""",
        """Numerical country code as in Part 4 of the Appendix 6 of
							the decision 2007/756""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Carriers :LeadCarrier :LocoTypeNumber ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CurrencyCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CurrencyCode" ;
    rdfs:comment """Code for the currency
																of the amounts entered in the
																charging section.""",
        """Currency abbreviation
																(ISO-4217 alphanumeric)""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CashOnDelivery :ChargingSections :DeclarationOfValue :InterestInDelivery ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CustomerCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CustomerCode" ;
    rdfs:comment "CODE: Customer Code of the Contractal Carrier" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:CustomerNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CustomerNumber" ;
    rdfs:comment """The customer number of the COM differs from the customer code used in
				TAF/TSI, its format may not accord to the TAf element""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Customers :LoadingFacility ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:DeclarationText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DeclarationText" ;
    rdfs:comment "Additional Text for codes with free text" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ConsignorDeclarations :RU_Declaration ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:DeliveryReference a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DeliveryReference" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ILU_Details :ITU_Details :WagonDetails ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:DepartureCountry a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DepartureCountry" ;
    rdfs:comment "CODE: ISO-3166-2",
        "Code of departure country of the ILU.",
        "Code of departure country of the UTI." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ILU_Details :ITU_Details ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Description a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Description" ;
    rdfs:comment """Additional
																			charges description""",
        """Description for
																CodeOfCause no. 9.""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AdditionalCharges :TransitPeriodExtensions ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:DeviceType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DeviceType" ;
    rdfs:comment """Specification of type of telematics
									device.""" ;
    rdfs:domain :TelematicsDevice ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:DossierNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DossierNumber" ;
    rdfs:comment """Internal identification number of
													the Wo. This information is important to be able
													to identify the COM even after modifications.
													Format: RRRRYYYYMMDDNNNNNNN Where RRRR = railway
													code, YYYY = year, MM = month, DD = day and
													NNNNNNN = running number.""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :COM_Header :ConsignmentIdentification ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:EWC_Key a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "EWC_Key" ;
    rdfs:comment """CODE: European waste catalogue (EWC)
												2000/532/EC""",
        "CODE: European waste catalogue (EWC) 2000/532/EC",
        """Numeric key according to the European
												Waste Catalogue""",
        "Numeric key according to the European Waste Catalogue" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Goods :GoodsInWagon ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ExceptionalGaugingCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ExceptionalGaugingCode" ;
    rdfs:comment "Acceptance agreement number, based on guidelines of IM_Partner" ;
    rdfs:domain :ExceptionalGaugingIdent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:FaxNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "FaxNumber" ;
    rdfs:comment "Generic Fax number in Free text" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AdministrativeContactInformation :Contacts ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Forwarding a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Forwarding" ;
    rdfs:comment "Final destination of the ILU.",
        "Final destination of the UTI." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ILU_Details :ITU_Details ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:FreeTextField a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "FreeTextField" ;
    rdfs:comment "Free Text" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AdministrativeContactInformation :Error :PathCanceledMessage :PathDetailsMessage :PathDetailsRefusedMessage :PathNotAvailableMessage :PathRequestMessage :PlannedJourneyLocation ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:GeographicalCoordinates a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "GeographicalCoordinates" ;
    rdfs:comment "Longitude and latitude as defined in UIC Leafle 920-2" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:GoodsDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "GoodsDescription" ;
    rdfs:comment "This element describes the goods of the shipment as free text" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Goods :GoodsInWagon ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:HS_Code a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "HS_Code" ;
    rdfs:comment """HS-Code for sensible goods (appendix
												44c of ccip) 10 digits are needed, if a good code
												was already assigned for 'Zollanmeldung'. In this
												case this good code has to be taken. These good
												codes may have more than 6 digits.""",
        """HS-Code for sensible goods (appendix 44c of ccip) 10
							digits are needed, if a good code was already assigned for
							'Zollanmeldung'. In this case this good code has to be taken. These good
							codes may have more than 6 digits.""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Goods :GoodsInWagon ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:HandlingInstruction a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "HandlingInstruction" ;
    rdfs:comment """Special instructions regarding the handling of the wagon or shipment
				in free text""" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:HarbourName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "HarbourName" ;
    rdfs:comment """Name of harbour, where the transport will be handed over
							to a ship.""" ;
    rdfs:domain :Ship ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:InformationConsignee a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "InformationConsignee" ;
    rdfs:comment """Information from the
																consignor to the consignee relating
																to the consignment. This information
																is not to commit the carrier.""" ;
    rdfs:domain :GeneralInformation ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:InternalReferenceIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "InternalReferenceIdentifier" ;
    rdfs:comment "The link to the IM System Reference" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DelayCauseTime :Interruption :InterruptionInformation :ReceiptConfirmationMessage :TrainJourneyModificationMessage ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:InterruptionDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "InterruptionDescription" ;
    rdfs:comment "The free text description of an interruption" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ChangeofTrackMessage :ExceptionReason :Interruption :InterruptionInformation ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:KeeperShortNameVKM a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "KeeperShortNameVKM" ;
    rdfs:comment """Free text, short name/vehicle keeper marking of the wagon keeper as
				listed in VKM register (https://www.era.europa.eu/domains/registers/vkm_en, 2nd
				column (UNIQUE) - without special characters)""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AdministrativeDataSet :RefusedWagonNumbers ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:LoadingTackleType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "LoadingTackleType" ;
    rdfs:comment """Loading tackle according toUN/EDIFACT Data Element 8053
							UN/CEFACT Revision 2004B. Additional dummy code 'ZZZ' may be used in
							case the loading tackle is not included in the list. """ ;
    rdfs:domain :LoadingTackles ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:LocationSubsidiaryName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "LocationSubsidiaryName" ;
    rdfs:comment """To be completed in an official language of the Country using the ISO
				Unicode alphabet""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :LocationSubsidiaryIdentification :LocationSubsidiaryInformation ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ManufacturerName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ManufacturerName" ;
    rdfs:comment """Name of the manufacturer of the
									telematics device.""" ;
    rdfs:domain :TelematicsDevice ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:MessageDateTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageDateTime" ;
    rdfs:comment "Generated by the common Interface" ;
    rdfs:domain :MessageReference ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf :dataProperties .

:MessageIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageIdentifier" ;
    rdfs:comment "Identification of the Message" ;
    rdfs:domain :MessageReference ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:MessageType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageType" ;
    rdfs:comment """To indicate the message type transmitted or referred to. The following
				list was agreed within the sector: 1000 ConsignmentOrderMessage 2001
				PathCanceledMessage 2002 PathConfirmedMessage 2003 PathDetailsMessage 2004
				PathDetailsRefusedMessage 2005 PathNotAvailableMessage 2006 PathRequestMessage 2007
				ReceiptConfirmationMessage -- sector messages (Planning) -- 2500
				PathCoordinationMessage 2501 PathSectionNotificationMessage -- sector message end --
				3003 TrainCompositionMessage 3006 TrainReadyMessage 4001 TrainDelayCauseMessage 4003
				TrainForecastAtReportingLocationMessage 4004 TrainRunningForecastMessage 4005
				TrainRunningInformationMessage 4006 TrainRunningInterruptionMessage -- sector
				message (Operations) -- 4500 PassengerTrainCompositionMessage 4501
				RollingStockRestrictionMessage 4504 ChangeOfTrackMessage 4505
				TrainJourneyModificationMessage 4506 TrainForecastedDelayCauseMessage 4510
				RunningStatusReportMessage -- sector message end -- 5001 AlertMessage 5006
				WagonETI_ETA_Message -- sector message (Wagon interchange) -- 5009
				WagonInterchangeNoticeMessage 5012 WagonReceivedAtInterchangeMessage 5013
				WagonRefusedAtInterchangeMessage -- sector message end -- 5020 WagonStatusMessage
				6002 LocationFileDatasetMessage 6003 RollingStockDatasetMessage 6005
				ILUDataQueryMessage 6006 ILUDataMessage --sector (RU-RU) --- 5500
				WagonPerformanceMessage -- sector end--- 6004 RollingStockDatasetQueryMessage --
				Sector Messages TCR begin -- 6500 TCRMessage 6501 TCRResponseMessage 6502
				TCRCanceledMessage -- Sector Messages TCR end -- -- sector (TrainID) begin -- 8500
				UpateLinkMessage 8501 ObjectInfoMessage -- sector end -- 9000 ErrorMessage
				--Reserved: (IM-RU for SFERA) --- SF00 to SF99 for SFERA messages (see IRS90940) â€“
				Reserved end â€“ """ ;
    rdfs:domain :MessageReference ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:MessageTypeVersion a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MessageTypeVersion" ;
    rdfs:comment "Version of the Message Type" ;
    rdfs:domain :MessageReference ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:MountedPosition a owl:DatatypeProperty ;
    rdfs:label "MountedPosition" ;
    rdfs:comment """Indication of where the telematics
									unit is located on the component.""" ;
    rdfs:domain :TelematicsDevice ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:NHM_Code a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "NHM_Code" ;
    rdfs:comment "NHM code of the goods" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Goods :GoodsInContainer :GoodsInWagon ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Name a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Name" ;
    rdfs:comment "Generic Name in Free Text" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AdministrativeContactInformation :Customer :Customers :Haulier :NetworkSpecificParameter ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:NoGoodsOfClassX a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "NoGoodsOfClassX" ;
    rdfs:comment """Element has to be filled with the
												class of the dangerous goods which are mentioned in
												Table 3.2 RID but are not dangerous according to
												chapter 2 (5.4.1.5 RID)""",
        """Element has to be filled with the class of the dangerous
							goods which are mentioned in Table 3.2 RID but are not dangerous
							according to chapter 2 (5.4.1.5 RID)""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Goods :GoodsInWagon ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:Number a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Number" ;
    rdfs:comment "ITU number",
        "Number of the report form." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :FormalReports :ITU_Details ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:ObjectType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ObjectType" ;
    rdfs:comment """Provides a possibility for differentiation between the objects: Train
				(TR), Route (RO), Path (PA), Case Reference (CR), Path Request (PR), Capacity Needs
				Announcements (CN), Capacity Model (CM), Catalogue Path (CP)""" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:OperationalTrainNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "OperationalTrainNumber" ;
    rdfs:comment """Identifies the train for traffic management purposes by the
				Dispatcher, GSMR services, etc.""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :OperationalTrainNumberIdentifier :PlannedJourneyLocation ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:P1 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
