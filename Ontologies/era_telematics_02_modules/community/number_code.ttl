    rdfs:comment "P.O. Box" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Customer :Customers ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:PhonNumber a owl:DatatypeProperty,
