@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:DepartureJourneyTrack a owl:Class ;
    rdfs:label "DepartureJourneyTrack" ;
    :domain "Telematics" ;
    rdfs:comment "Indicates the track ID on which the train will start its journey." .

