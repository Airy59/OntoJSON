@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:TrainMaxSpeed a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "TrainMaxSpeed" ;
    rdfs:comment "The max. possible speed of a train in km/h" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :PlannedTrainTechnicalData :TrainRunningTechData ) ] ;
    rdfs:subPropertyOf :dataProperties .

