@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:SectionCarrierCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "SectionCarrierCode" ;
    rdfs:comment """Invoiced
																						section
																						specified by
																						carrier""" ;
    rdfs:subPropertyOf :dataProperties .

