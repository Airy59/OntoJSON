@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasTrainActivity a owl:ObjectProperty ;
    rdfs:label "has TrainActivity" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Activities :PlannedJourneyLocation ) ] ;
    rdfs:range :TrainActivity .

:TrainActivity a owl:Class ;
    rdfs:label "TrainActivity" ;
    rdfs:comment """Since the activites can be related to attaching / detaching of wagons
				and/or cars to different trains, the reference to other trains should be possible to
				be indicated.""" .

