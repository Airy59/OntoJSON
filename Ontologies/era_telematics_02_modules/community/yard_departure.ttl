@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:YardDeparture a owl:Class ;
    rdfs:label "YardDeparture" ;
    rdfs:comment """The departure point of a wagon and the Date and Time when the wagon is
				taken over by the RU/Service Provider""" .

