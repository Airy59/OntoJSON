@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:CarrierCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CarrierCode" ;
    rdfs:comment """Code of the carrier
														undertaking the examination (see CIM Article
														11 sections 2 and 3). """,
        """Code of the carrier who made
														it out.""",
        """Code of the shipping
																carrier mentioned in the consignment
																number.""",
        """Contractual carrier,
																railway undertaking (Railway Code).""",
        """Railway Undertaking
																(Railway Code)""",
        """additional carrier
																code belonging to the given contract
																number""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AcceptancePoint :Carriers :CommercialSpecifications :Examination :FormalReports :LeadCarrier ) ] ;
    rdfs:subPropertyOf :dataProperties .

