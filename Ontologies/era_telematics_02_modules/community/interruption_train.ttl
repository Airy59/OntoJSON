@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:DetailedDescriptionOfLocation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DetailedDescriptionOfLocation" ;
    rdfs:domain :InterruptionPoint ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataProperties .

:TrainInterrupted a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "TrainInterrupted" ;
    rdfs:comment "None" ;
    rdfs:domain :TrainRunningInterruptionStatus ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :dataProperties .

:hasInterruption a owl:ObjectProperty ;
    rdfs:label "has Interruption" ;
    rdfs:domain :InterruptionPoint ;
    rdfs:range :Interruption .

:hasInterruptionDuration a owl:ObjectProperty ;
    rdfs:label "has InterruptionDuration" ;
    rdfs:domain :InterruptionPoint ;
    rdfs:range :InterruptionDuration .

:hasInterruptionPoint a owl:ObjectProperty ;
    rdfs:label "has InterruptionPoint" ;
    rdfs:domain :TrainRunningInterruptionMessage ;
    rdfs:range :InterruptionPoint .

:hasTrainRunningInterruptionStatus a owl:ObjectProperty ;
    rdfs:label "has TrainRunningInterruptionStatus" ;
    rdfs:domain :TrainRunningInterruptionMessage ;
    rdfs:range :TrainRunningInterruptionStatus .

:TrainRunningInterruptionStatus a owl:Class ;
    rdfs:label "TrainRunningInterruptionStatus" .

:Interruption a owl:Class ;
    rdfs:label "Interruption" .

:InterruptionPoint a owl:Class ;
    rdfs:label "InterruptionPoint" ;
    rdfs:comment """describes the interruption points with location and the reason for the
				interruption""" .

:TrainRunningInterruptionMessage a owl:Class ;
    rdfs:label "TrainRunningInterruptionMessage" ;
    rdfs:comment """This message is used to inform about the trains which has been already
				interrupted. Message is sent only for those trains, directly interrupted by the
				disruption. """ .

[] rdf:first :TrainRunningInterruptionMessage .

[] rdf:first :TrainRunningInterruptionMessage .

[] rdf:first :TrainRunningInterruptionMessage .

[] rdf:first :TrainRunningInterruptionMessage .

[] rdf:first :TrainRunningInterruptionMessage .

[] rdf:first :InterruptionPoint .

[] rdf:first :InterruptionPoint .

[] rdf:first :Interruption .

[] rdf:first :Interruption .

[] rdf:first :Interruption .

[] rdf:first :Interruption .

[] rdf:first :TrainRunningInterruptionMessage .

[] rdf:first :InterruptionPoint .

[] rdf:first :InterruptionPoint .

[] rdf:first :TrainRunningInterruptionMessage .

[] rdf:first :TrainRunningInterruptionMessage .

[] rdf:first :InterruptionPoint .

