@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasProductionStation a owl:ObjectProperty ;
    rdfs:label "has ProductionStation" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AcceptancePoint :DeliveryPoint ) ] ;
    rdfs:range :ProductionStation .

:ProductionStation a owl:Class ;
    rdfs:label "ProductionStation" ;
    rdfs:comment """Details of production station serving the point, this element is used
				if the productional station differs from the commercial station""" .

