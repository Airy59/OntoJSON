@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Longitude a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Longitude" ;
    rdfs:comment """Longitudinal Coordinates as expressed in decimal degrees with a
				precision of 6 decimals.""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :GeographicCoordinates :Position ) ] ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:decimal xsd:float ) ] ;
    rdfs:subPropertyOf :dataProperties .

