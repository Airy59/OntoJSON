@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:AllocationCompany a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "AllocationCompany" ;
    :domain "Telematics" ;
    rdfs:comment """Name of company who is responsible for allocation and maintenance of
				codes""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :LocationSubsidiaryIdentification :LocationSubsidiaryInformation ) ] ;
    rdfs:subPropertyOf :dataProperties .

