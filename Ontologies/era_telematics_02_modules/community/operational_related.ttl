@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasRelatedTransportOperationalIdentifiers a owl:ObjectProperty ;
    rdfs:label "has RelatedTransportOperationalIdentifiers" ;
    rdfs:domain :TrainOperationalIdentification ;
    rdfs:range :RelatedTransportOperationalIdentifiers .

:hasTrainOperationalIdentification a owl:ObjectProperty ;
    rdfs:label "has TrainOperationalIdentification" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ChangeofTrackMessage :Train :TrainAtLocation :TrainDelayCauseMessage :TrainJourneyModificationMessage :TrainRunningForecastMessage :TrainRunningInformationMessage :TrainRunningInterruptionMessage ) ] ;
    rdfs:range :TrainOperationalIdentification .

:RelatedTransportOperationalIdentifiers a owl:Class ;
    rdfs:label "RelatedTransportOperationalIdentifiers" .

:TrainOperationalIdentification a owl:Class ;
    rdfs:label "TrainOperationalIdentification" .

