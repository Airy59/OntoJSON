@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:OriginCountry a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "OriginCountry" ;
    rdfs:comment "CODE: ISO-3166-2",
        "Code of origin country of the UTI." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ILU_Details :ITU_Details :WagonDetails ) ] ;
    rdfs:subPropertyOf :dataProperties .

