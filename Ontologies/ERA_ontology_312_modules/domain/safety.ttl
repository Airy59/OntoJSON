    skos:scopeNote "The list is in line with ERA/TD/2011-09/INT (v1.13), Table 3, and is now in 3.3 of the annex II of TSI CCS."@en .

:conditionsSwitchTrainProtectionSystems a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Special conditions to switch over between different class B train protection, control and warning systems"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "Applicable when at least two different protection, control and warning systems exist."@en ;
    :formatNote "NNN" ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.3.8.1.1",
        "1.2.1.1.7.1.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionsSwitchTrainProtectionSystems> ;
    :tsiOPEAppendixD2Index "3.4.2" ;
    dcterms:created "2022-10-28"^^xsd:date ;
    dcterms:relation :switchProtectControlWarning ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj>,
        <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Conditions to switch over between different class B train protection, control and warning systems."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :transitionsBetweenSystemsDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Switch over between different systems whilst running. Installation depends on local conditions. "@en .

