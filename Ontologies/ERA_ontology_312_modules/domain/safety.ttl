:emergencyBrake a owl:DatatypeProperty ;
    rdfs:label "Emergency braking"@en ;
    :eratvIndex "4.7.5" ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-08-26"^^xsd:date ;
    rdfs:comment "Stopping distance and deceleration profile for each load condition per design maximum speed."@en ;
    rdfs:domain :VehicleType ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :vehicleTypeTechnicalDataCharacteristic ;
    ns1:term_status "stable" .

:existenceOfIndustrialRisk a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Industrial risks â€” locations where it is dangerous for the driver to step out"@en ;
    :applicable "Y/N" ;
    :formatNote "Y/N" ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.0.0.1.1" ;
    :tsiOPEAppendixD2Index "3.2.5" ;
    dcterms:created "2025-01-30"^^xsd:date ;
    rdfs:comment "Indication that the full section of line (or a part of it) it is identified by the Infrastructure Managers (and communicated to the RU) where drivers are not supposed to get off the locomotive."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :SectionOfLine ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :SectionOfLine ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :SectionOfLine ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :SectionOfLine ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :SectionOfLine ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :routeBookDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Although it is just an indication of existence of an industrial risk, the area covering the industrial risk should be references on the topological network.
For the route book purpose, the industrial risks should be defined as linear references instead of area. SpecialArea of type "industrial risk" should be used"""@en .

:fireSafetyCategory a owl:ObjectProperty ;
    rdfs:label "Fire safety category"@en ;
    :eratvIndex "4.4.1" ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/rolling-stock-fire/Categories> ;
    dcterms:created "2020-08-29"^^xsd:date ;
    dcterms:modified "2021-08-03"^^xsd:date ;
    rdfs:comment "Fire safety category for tunnels."@en ;
    rdfs:domain :VehicleType ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf :vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" .

:frequencyBandsForDetection a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Frequency bands for detection"@en ;
    :applicable "Y/N/NYA" ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/train-detection/FrequencyBandsForDetection> ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.3.4.2",
        "1.2.1.1.3.2" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/FrequencyBandsForDetection>,
        <http://data.europa.eu/949/shapes/FrequencyBandsForDetectionSKOS> ;
    :usedInRCCCalculations true ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date ;
    dcterms:relation :maximumInterferenceCurrent,
        :minVehicleImpedance,
        :tdsMaximumMagneticField ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Bands of the frequency management of the train detection systems as defined in the TSI CCS, and in the specific cases or technical documents referred to in Article 13 of TSI CCS when they are available."@en ;
    rdfs:domain :TrainDetectionSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "https://eur-lex.europa.eu/eli/reg_impl/2023/1695/oj"^^xsd:anyURI,
        "https://www.era.europa.eu/system/files/2023-09/index077_-_ERA_ERTMS_033281_v5.pdf"^^xsd:anyURI ;
    rdfs:subPropertyOf :trainDetectionSystemBasedFrequencyBandsObjParameter ;
    ns1:term_status "unstable" ;
    skos:scopeNote """Verification of compliance with TSI includes application of notified national rules (when they exist).

Multiple selection from a predefined list:
- Axle Counters: bands A1-A3
- Track circuits: bands A1-A8"""@en .

:hasEmergencyPlan a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Existence of emergency plan"@en ;
    :XMLName "ITU_EmergencyPlan" ;
    :applicable "Y/N" ;
    :dependencyNote "Mandatory for tunnels longer than 1 km"@en ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.1.8.9",
        "1.2.1.0.5.6",
        "1.2.2.0.5.6" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasEmergencyPlan>,
        <http://data.europa.eu/949/shapes/HasEmergencyPlanApplicability> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2021-08-10"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1303/2024-01-29> ;
    rdfs:comment "Indication whether emergency plan exists."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """SRT TSI: 4.4.2
OPE TSI: 4.2.3.7""" ;
    rdfs:subPropertyOf :tunnelDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """A value may not be applicable for tunnels shorter than 1 km, as for them the fire category according SRT TSI does not exist.
Emergency plan has to be a document developed for each tunnel under the direction of the IM, in co-operation, where appropriate, with RUs, Rescue services and relevant authorities. It shall be consistent with the self-rescue, evacuation and rescue facilities provided.
It is applicable for tunnels longer than 1 km, in accordance with section 4.4.2 of SRT TSI, the emergency plan is mandatory only for tunnel length of more than 1km.

SRT TSI: 4.4.2
OPE TSI: 4.2.3.7"""@en .

:hasOtherTrainProtection a owl:DatatypeProperty ;
    rdfs:label "Existence of other train protection, control and warning systems installed"@en ;
    :rinfIndex "1.1.1.3.5.1" ;
