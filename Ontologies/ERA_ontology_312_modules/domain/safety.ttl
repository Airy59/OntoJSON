        <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Indication whether a switch over between different systems whilst running exists."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Track ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Track ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Track ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Track ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Track ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :transitionsBetweenSystemsDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Switch over between different systems whilst running. Installation depends on local conditions. "@en .

