:linkedToPrimaryLocation a owl:ObjectProperty ;
    rdfs:label "linked to primary location"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LinkedToPrimaryLocation> ;
    dcterms:created "2024-10-28"^^xsd:date ;
    rdfs:comment "Relates a subsidiary location with a primary location."@en ;
    rdfs:domain :SubsidiaryLocation ;
    rdfs:isDefinedBy : ;
    rdfs:range :PrimaryLocation .

:SubsidiaryLocation a owl:Class ;
    rdfs:label "Subsidiary location"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SubsidiaryLocationShape> ;
    dcterms:created "2024-05-24"^^xsd:date ;
    dcterms:modified "2025-03-10"^^xsd:date ;
    rdfs:comment "Subsidiary location must be linked to a Primary Location and specifies in more detailed way part, attributes, or usage of Primary location. It may be also a non-rail point or a rail point that is not managed by an Infrastructure Manager (IM). It may be defined by entity having company code according to their needs. The Subsidiary location is optional and dependent upon business needs."@en ;
    rdfs:isDefinedBy : ;
    rdfs:seeAlso "http://taf-jsg.info/wp-content/uploads/2024/01/20231018-JGS-Handbook-3.4-with-XSD-3.4.0.0.pdf" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :PrimaryLocation ;
            owl:onProperty :linkedToPrimaryLocation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :PrimaryLocation ;
            owl:onProperty :linkedToPrimaryLocation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :PrimaryLocation ;
            owl:onProperty :linkedToPrimaryLocation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :PrimaryLocation ;
            owl:onProperty :linkedToPrimaryLocation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :PrimaryLocation ;
            owl:onProperty :linkedToPrimaryLocation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :Feature .

:NetPointReference a owl:Class ;
    rdfs:label "Net Point Reference"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/NetPointReferenceShape> ;
    dcterms:created "2024-11-29"^^xsd:date ;
    rdfs:comment "Represents a point reference in the network."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :NetBasicReference ;
    skos:scopeNote "It is used for infrastructure elements positioned in relation to the topology as a point. (e.g.: signals, ETCS balises, buffer stops, etc.)"@en .

:PrimaryLocation a owl:Class ;
    rdfs:label "Primary Location"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PrimaryLocationShape> ;
    dcterms:modified "2024-10-28"^^xsd:date,
        "2025-03-01"^^xsd:date,
        "2025-06-06"^^xsd:date ;
    rdfs:comment """Primary Location is a place used by IM to define a path for a train in TAF/TAP TSI framework/messages. This location is a rail point inside the rail network where train starts, ends, stops, or runs through or change line. This location must be managed by an Infrastructure Manager (IM) identified by company code.

Primary locations are identified by single and unique Primary Location codes. Primary location code is allocated based on processes defined by national entity. Primary location codes are used in any kind of TAF/TAP communication.

See: Handbook 9.3.3 / page 60"""@en ;
    rdfs:isDefinedBy : ;
    rdfs:seeAlso "http://taf-jsg.info/wp-content/uploads/2024/01/20231018-JGS-Handbook-3.4-with-XSD-3.4.0.0.pdf"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :NetPointReference ;
            owl:onProperty :netReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom :NetPointReference ;
            owl:onProperty :netReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom :NetPointReference ;
            owl:onProperty :netReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom :NetPointReference ;
            owl:onProperty :netReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom :NetPointReference ;
            owl:onProperty :netReference ],
        :InfrastructureElement ;
    owl:disjointWith :RadioBlockCenter,
        :SectionOfLine,
        :Signal,
        :SpecialArea,
        :SubsidiaryLocation,
        :Switch,
        :Track,
        :Tunnel ;
    skos:example "Primary locations are for example: stations, yards, halts, handover points, border points, open access terminals. "@en .

