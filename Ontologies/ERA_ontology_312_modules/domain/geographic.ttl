    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.2.0.0.0.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PrimaryLocation> ;
    :tsiOPEAppendixD2Index "2.2.2" ;
    dcterms:modified "2024-12-03"^^xsd:date,
        "2025-01-30"^^xsd:date ;
    dcterms:replaces :tafTAPCode ;
    rdfs:comment "Primary location code developed for information exchange in accordance with the TSIs relating to the telematics applications subsystem."@en ;
    rdfs:domain :InfrastructureElement ;
    rdfs:isDefinedBy : ;
    rdfs:range :PrimaryLocation ;
    rdfs:subPropertyOf :opGenericObjParameter .

:primaryLocationCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "primary location code"@en ;
    :XMLName "OPTafTapCode" ;
    :rinfIndex "1.2.0.0.0.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PrimaryLocation>,
        <http://data.europa.eu/949/shapes/PrimaryLocationCode> ;
    :tsiOPEAppendixD2Index "2.2.2" ;
    dcterms:created "2024-06-03"^^xsd:date ;
    dcterms:replaces :tafTAPCode ;
    rdfs:comment "Primary location code developed for information exchange in accordance with the TSIs relating to the telematics applications subsystem."@en ;
    rdfs:domain :PrimaryLocation ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
