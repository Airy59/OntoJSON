:NetAreaReference a owl:Class ;
    rdfs:label "Net Area Reference"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/NetAreaReferenceShape> ;
    dcterms:created "2024-11-29"^^xsd:date ;
    rdfs:comment "Represents an area reference in the network."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :NetBasicReference ;
    skos:example "Example: non-stopping area, cross section area, area of implementation of GPRS etc."@en ;
    skos:scopeNote "It is used for infrastructure elements positioned in relation to the topology as a subnetwork. (e.g.: tunnels, non-stopping area, stations etc.)"@en .

:allocationCompany a owl:ObjectProperty ;
    rdfs:label "allocation company"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/AllocationCompany> ;
    dcterms:created "2024-05-24"^^xsd:date ;
    dcterms:modified "2024-10-24"^^xsd:date ;
    rdfs:comment "The organisation in charge to allocate the code for the subsidiary location."@en ;
    rdfs:domain :SubsidiaryLocation ;
    rdfs:isDefinedBy : ;
    rdfs:range :OrganisationRole .

:areaBoardingAid a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Range of use of the platform boarding aid"@en ;
    :XMLName "IPL_AreaBoardingAid" ;
    :applicable "Y/N" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.2.1.0.6.7" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/AreaBoardingAid> ;
    :unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
    dcterms:created "2021-08-02"^^xsd:date ;
    dcterms:modified "2023-01-20"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    rdfs:comment "Information of the train access level for which the boarding aid can be used."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :PlatformEdge ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :PlatformEdge ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :PlatformEdge ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :PlatformEdge ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :PlatformEdge ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :platformDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Information of the train access level for which the boarding aid can be used. Data is presented as the vertical difference that is overcome by the platform boarding aid in millimetres. The value â€œ0â€ means that the platform is not equipped with a platform boarding aid."@en .

:authorizedCountry a owl:ObjectProperty ;
    rdfs:label "authorized country"@en ;
    :inSkosConceptScheme <http://publications.europa.eu/resource/authority/country> ;
    dcterms:created "2020-09-30"^^xsd:date ;
    dcterms:modified "2020-09-30"^^xsd:date ;
    rdfs:comment "Indicates the country(ies) in where a vehicle type has been authorized to operate."@en ;
    rdfs:domain :VehicleType ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf :vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" .

:borderPointId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Border point identification"@en ;
    dcterms:created "2024-11-26"@en ;
    rdfs:comment "Border point identification in the list of reference border points in the RINF application guide."@en ;
    rdfs:domain :ReferenceBorderPoint ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "stable" .

:crossSectionArea a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Cross section area"@en ;
    :XMLName "ITU_CrossSectionArea" ;
    :applicable "Y/N" ;
    :dependencyNote "Mandatory if the speed of the line is equal or greater than 200km/h "@en ;
    :formatNote "NNN" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.1.8.8" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/CrossSectionAreaApplicability>,
        <http://data.europa.eu/949/shapes/CrossSectionAreaT> ;
    :unitOfMeasure <http://qudt.org/vocab/unit/M2> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2021-08-03"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    rdfs:comment "Smallest cross section area in square metres of the tunnel"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso "https://eur-lex.europa.eu/eli/reg/2014/1299/2023-09-28#:~:text=4.2.10.1.%C2%A0%C2%A0%C2%A0%20Maximum%20pressure%20variations%20in%20tunnels"^^xsd:anyURI,
        "[4.2.10.1 of INF TSI on Maximum pressure variations in tunnels | " ;
    rdfs:subPropertyOf :tunnelDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Smallest real cross section area (expressed in square metres) of the tunnel.

Reference: 4.2.10.1 of INF TSI on Maximum pressure variations in tunnels."""@en .

:endIntrinsicCoordinate a owl:DatatypeProperty ;
    rdfs:label "End intrinsic coordinate"@en ;
    dcterms:created "2021-04-01"^^xsd:date ;
    dcterms:modified "2021-04-01"^^xsd:date ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:double ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:endLocation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "End of tunnel"@en ;
    :XMLName "SOLTunnelEnd" ;
    :applicable "Y" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.1.8.4" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/EndLocation> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2024-02-05"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    rdfs:comment "Geographical coordinates in decimal degrees and km of the line at the end of a tunnel."@en ;
    rdfs:domain :Tunnel ;
    rdfs:isDefinedBy : ;
    rdfs:range <http://www.opengis.net/ont/sf#Point> ;
    rdfs:subPropertyOf :tunnelObjParameter,
        geo:hasGeometry ;
    ns1:term_status "stable" ;
    skos:example "Latitude=`51.5479123` Longitude=`-0.076732`" ;
    skos:scopeNote """Geographical coordinates according to the standard World Geodetic System (WGS).  Precision for both geographical latitude and geographical longitude is assumed as [NN.NNNNNNN] in degrees with decimals what gives discretion of 10 cm in the network.
Kilometre shall concern the national line identification given in 1.1.0.0.0.2
Location of the point which is assumed to be the end of the tunnel it is the point on the track centre line where is laid the vertical shadow of the extreme part of the tunnel s portal."""@en .

:gaugingCheckLocation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Railway location of particular points requiring specific checks"@en ;
    :XMLName "ILL_GaugeCheckLoc" ;
    :applicable "Y/N" ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.1.3.1.2",
        "1.2.1.0.3.5" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/GaugingCheckLocation> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    rdfs:comment "Location of particular points requiring specific checks due to deviations from gauging referred to in parameter \"Gauging\""@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :lineLayoutDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """This parameter is applicable when the IM wants to highlight a particular point requiring checks and provide info via parameter 'Document with the transversal section of the particular points requiring specific checks'.

The railway location identifies the location of the structure in the system of reference of the line to which the track belongs.

The location (generally the distance from the origin of the line to the point of interest for the specific check) on a line is given in kilometres with decimals (precision of 0.001)."""@en .

:gprsImplementationArea a owl:DatatypeProperty ;
    rdfs:label "Area of implementation of GPRS"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "GSM-R, ETCS L2 and GPRS for ETCS must be installed for this parameter to be applicable."@en ;
    :legalDeadline "1 January 2021"@en,
        "12 months after publication of Article 7 Guide for OP tracks"@en ;
    :rinfIndex "1.1.1.3.3.3.3",
        "1.2.1.1.2.3.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/GprsImplementationArea>,
        <http://data.europa.eu/949/shapes/GprsImplementationAreaApplicability> ;
    dcterms:created "2021-08-09"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation :etcsLevelType,
        :gprsForETCS ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Indication of the area in which GPRS can be used for ETCS, expressed as a list of GPRS-enabled RBCs."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "Sections of EIRENE optional for trackside in TSI"@en ;
    rdfs:subPropertyOf :tsiCompliantRadioDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Since GPRS can be used for ETCS, indicate in which areas it is implemented (e.g.: whole section, only between two signals, at the stationâ€¦)"@en .

:handoverPointFlag a owl:DatatypeProperty ;
    rdfs:label "handover point flag"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HandoverPointFlag> ;
    dcterms:created "2024-06-03"^^xsd:date ;
