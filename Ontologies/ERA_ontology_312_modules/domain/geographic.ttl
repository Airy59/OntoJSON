    rdfs:domain :OperationalPoint ;
    rdfs:isDefinedBy : ;
    rdfs:range :OperationalPoint ;
    owl:deprecated true ;
    owl:inverseOf :opInfoPerCountry ;
    ns1:term_status "stable" .

:referenceBorderPoint a owl:ObjectProperty ;
