:distSignToPhaseEnd a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Distance between signboard and phase separation ending"@en ;
    :XMLName "EOS_DistSignToPhaseEnd" ;
    :applicable "Y/N" ;
    :dependencyNote "It is applicable ( Y ) only if the value  Overhead contact line (OCL)  is selected for parameter \"Type of contact line system\""@en ;
    :formatNote "NNN" ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.2.4.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/DistSignToPhaseEnd> ;
    :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
    :usedInRCCCalculations true ;
    dcterms:created "2021-08-08"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date ;
    rdfs:comment "Distance between the signboard authorizing the driver to  raise pantograph  or  close the circuit breaker  after passing the phase separation and the end of the phase separation section."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :oclSeparationSectionsDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Specific for route compatibility check on French network."@en .

:documentRestrictionPowerConsumption a owl:ObjectProperty ;
    rdfs:label "Document with restriction related to power consumption of specific electric traction unit(s)"@en ;
    :applicable "Y/N/NYA" ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.2.5.4" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/DocumentRestrictionPowerConsumption> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-11-04"^^xsd:date ;
    rdfs:comment "Name and/or reference of the document specifying the restriction(s) related to power consumption of specific electric traction unit(s)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range :Document ;
    rdfs:subPropertyOf :requirementsRollingStockObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .

:eddyCurrentBrakePrevention a owl:DatatypeProperty ;
