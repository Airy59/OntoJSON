Applicable if trackside HABD is not TSI compliant, identification of trackside hot axle box detector."""@en ;
    rdfs:domain :HABD ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
    ns1:term_status "stable" .

:hotAxleBoxDetectorTSICompliant a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Trackside HABD TSI compliant"@en ;
    :XMLName "IHS_TSIHABD" ;
    :applicable "Y" ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.1.7.5" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HotAxleBoxDetectorTSICompliant> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-11"^^xsd:date ;
    rdfs:comment """Specific for the French, Italian and Swedish networks.
Trackside HABD compliant to TSI means that the HABD Trackside is compliant with:
- EN 15437-1:2009 referred in TSIs (LOC&PAS: 4.2.3.3.2.2, WAG TSI: 4.2.3.4),
- Specific cases mentioned in TSIs (LOC&PAS TSI, WAG TSI)."""@en ;
    rdfs:domain :HABD ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """TSI LOC&PAS: 4.2.3.3.2.2, and 7.3.2.3
WAG TSI: 4.2.3.4 and 7.3.2.2
EN 15437-1:2009""" ;
    rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
    ns1:term_status "stable" .

