        "2024-09-19"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1302/2023-09-28>,
        <http://data.europa.eu/eli/reg/2014/1303/2024-01-29>,
        <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Categorisation how a passenger train with a fire on board will continue to operate for a defined time period"@en,
        "Passenger train fire category in accordance with point 4.1.4 of TSI LOC&PAS."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
