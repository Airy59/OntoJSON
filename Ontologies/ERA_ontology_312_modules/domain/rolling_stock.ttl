:wheelSetGauge a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Nominal track gauge"@en ;
    :XMLName "ITP_NomGauge" ;
    :applicable "Y" ;
    :eratvIndex "4.1.3" ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/nominal-track-gauges/NominalTrackGauges> ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.1.4.1",
        "1.2.1.0.4.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/WheelSetGauge>,
        <http://data.europa.eu/949/shapes/WheelSetGaugeSKOS> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
    rdfs:comment "A single value expressed in millimetres that identifies the track gauge."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack :VehicleType ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack :VehicleType ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack :VehicleType ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack :VehicleType ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack :VehicleType ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "INF TSI: 4.2.4.1" ;
    rdfs:subPropertyOf :trackObjParameter,
        :vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote "In case of multi-rail track, a set of data is to be published separately to each pair of rails to be operated as separate track (the whole set of parameters for the separate track has to be delivered be careful then with the track identification). Nominal track gauges provided by the INF TSI are only 1435, 1520, 1524, 1600 and 1668."@en .

