        "2024-06-26"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-03-08"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28>,
        <http://data.europa.eu/eli/reg/2014/1302/2023-09-28> ;
