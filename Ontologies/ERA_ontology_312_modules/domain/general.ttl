:cantDeficiency a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Cant deficiency"@en ;
    :XMLName "ITP_CantDeficiency" ;
    :applicable "Y" ;
    :formatNote "+/-NNN" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.1.4.2" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/CantDeficiency> ;
    :unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-10"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
    rdfs:comment "Maximum cant deficiency expressed in millimetres defined as difference between the applied cant and a higher equilibrium cant the line has been designed for."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso "INF TSI: 4.2.4.3" ;
    rdfs:subPropertyOf :trackDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "In case of positive value of cant deficiency or zero symbol  '+' shall be applied. In case of negative cant deficiency symbol '-' has to be selected. Value of the cant deficiency shall be given in millimetres. In case of lateral uncompensated acceleration on a 1435 mm track gauge of 1.0 m/s2 the value of 153 mm may be published."@en .

:cantDeficiencyBasicSSP a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Cant Deficiency used for the basic SSP"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/cant-deficiencies/CantDeficiencies> ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.3.2.14",
        "1.2.1.1.1.14" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/CantDeficiencyBasicSSP>,
        <http://data.europa.eu/949/shapes/CantDeficiencyBasicSSPApplicability>,
        <http://data.europa.eu/949/shapes/CantDeficiencyBasicSSPSKOS> ;
    :tsiOPEAppendixD3Index "1.3" ;
    :unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation :etcsLevelType,
        :otherCantDeficiencyBasicSSP ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Essential information for railway undertakings with a worse (lower) tolerated cant deficiency than those for which the ETCS trackside provides SSP (Static Speed Profiles) in conjunction with parameter \"Other Cant Deficiency train categories for which the ETCS trackside is configured to provide SSP\"."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
    rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """The values indicated in millimetres correspond to tracks with UIC gauge. For tracks with a gauge different from UIC, the values provided here are the equivalent ones for UIC gauge, as the actual physical cant deficiency values differ. Please refer to parameter 1.1.1.1.4.2 for more details.
                           Subset-026 (3.11.3.2.1.1) definition:
a) The "Cant Deficiency" SSP categories: the cant deficiency value assigned to one category shall define the maximum speed, determined by suspension design, at which a particular train can traverse a curve and thus can be used to set a specific speed limit in a curve with regards to this category."""@en .

