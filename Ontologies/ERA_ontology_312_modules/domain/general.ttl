:hasWalkway a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Existence of walkways"@en ;
    :applicable "Y/NYA" ;
    :dependencyNote "Mandatory for TSI-compliant tunnels longer than 0.5 km"@en ;
    :formatNote """[Y/N]

If =Y then TSI-Compliant OR NON-TSI-Compliant""" ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.1.8.12",
        "1.2.1.0.5.10",
        "1.2.2.0.5.9" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasWalkway> ;
    :tsiOPEAppendixD2Index "3.2.3" ;
    dcterms:created "2022-10-27"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Indication of existence of walkways"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "Point 4.2.1.6. \"Escape walkways\" of the Commission Regulation (EU) No 1303/2014 of 18 November 2014 concerning the technical specification for interoperability relating to safety in railway tunnels of the rail system of the European Union|https://eur-lex.europa.eu/legal-content/EN/TXT/?qid=1566396648532&uri=CELEX%3A02014R1303-20190616 "^^xsd:anyURI ;
    rdfs:subPropertyOf :tunnelDataParameter ;
    ns1:term_status "stable" ;
    skos:altLabel "Existence of walkways in tunnel"@en ;
    skos:scopeNote """Indicates the existence of "Escape walkways", if the tunnel is longer than 0.5km then definition from Section 4.2.1.6 of TSI SRT applies.
If the selected value is "true", provide the boolean value for "Is TSI compliant".
On top of the requirements set out in the TSI SRT, the application guide to the TSI allows to use a ballastless track as a walkway. So, a 'Yes' in this parameters might not result in a physical standalone walkway.

For Siding the mechanism to locate a specific object is different depending on the member state. The TWG is still working on it."""@en .

