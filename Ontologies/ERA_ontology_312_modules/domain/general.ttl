            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """LOC&PAS TSI: 4.2.8.2.9.10
EN 50206-1:2010""" ;
    rdfs:subPropertyOf :requirementsRollingStockDataParameter ;
    ns1:term_status "stable" .

