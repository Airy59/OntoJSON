        "16 January 2020"@en ;
    :rinfIndex "1.1.1.3.3.10",
        "1.2.1.1.2.10" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/DataRadioCompatible>,
        <http://data.europa.eu/949/shapes/DataRadioCompatibleApplicability>,
        <http://data.europa.eu/949/shapes/DataRadioCompatibleSKOS> ;
