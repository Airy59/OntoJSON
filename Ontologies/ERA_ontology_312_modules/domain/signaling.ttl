            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack :VehicleType ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack :VehicleType ) ],
        [ a owl:Class ;
