            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf :automatedTrainOperationObjParameter ;
    ns1:term_status "unstable" ;
    skos:scopeNote """ATO system communication system to the specification referenced in TSI CCS (4.2.4 & 4.2.19).
                           Parameter only applicable when ETCS Baseline > 4 MR1 and ATO is implemented"""@en .

:dataRadioCompatible a owl:ObjectProperty ;
    rdfs:label "Radio system compatibility data"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "GSM-R  and ETCS L2 must be installed for this parameter to be applicable."@en ;
    :eratvIndex "4.13.2.8" ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/radio-system-compatibilities-data/RadioSystemCompatibilitiesData> ;
