    :inSkosConceptScheme <http://data.europa.eu/949/concepts/ato-commsys/ATOCommSystem> ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.3.13.3",
        "1.2.1.1.10.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/AtoCommunicationSystem>,
        <http://data.europa.eu/949/shapes/AtoCommunicationSystemSKOS> ;
    :tsiOPEAppendixD2Index "3.4.9" ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date,
        "2024-12-05"^^xsd:date ;
    dcterms:relation :atoGradeAutomation,
        :etcsBaseline ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Supported ATO communication systems from trackside."@en ;
