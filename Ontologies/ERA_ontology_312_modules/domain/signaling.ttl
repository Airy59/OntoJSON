        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :ccsSubsystemDeclarationsVerificationTrackDataParameter ;
    ns1:term_status "stable" .

:etcs a owl:ObjectProperty ;
    rdfs:label "TSI compliant train protection system (ETCS)"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/Etcs> ;
    dcterms:created "2021-08-07"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-08-13"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    rdfs:comment "European Train Control System (ETCS) application level supported by the track side equipment."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range :ETCS ;
    ns1:term_status "stable" ;
    skos:scopeNote """It can be repeated as many times as the number of different ETCS levels are present.

For RDF data provision:
The value of this property is an instance of the era:ETCS, which has as properties the parameters 1.1.1.3.2.1 and 1.1.1.3.2.2.

For RINF XML data sets:
As long as the data provision through XML data sets is allowed, this property is the equivalent of the "Set" attribute, grouping parameters 1.1.1.3.2.1 and 1.1.1.3.2.2."""@en .

