    dcterms:created "2022-07-07"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2024-10-28"^^xsd:date,
        "2025-04-30"^^xsd:date ;
    rdfs:comment """This class encompasses all those classes that represent features that are  implemented in the European railway infrastructure. It is a subclass of the ERA Feature that has a spatial representation. It covers tracks, platforms, signals, tunnels, operational points, and sections of line.
A feature that belongs to the infrastructure can be abstracted (hasAbstraction) as a topological object. It also is related to the infrastructure manager through the property infrastructureMgr."""@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Feature .

:Track a owl:Class ;
    rdfs:label "Track"@en ;
    dcterms:created "2024-11-20"^^xsd:date ;
    dcterms:modified "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    rdfs:comment "A pair of rails over which rail borne vehicles can run."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :Tunnel .

:SectionOfLine a owl:Class ;
    rdfs:label "Section Of Line"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SectionOfLineShape> ;
    dcterms:created "2021-04-02"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "A section of line means the part of line between adjacent operational points and may consist of several tracks."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :InfrastructureElement ;
    owl:disjointWith :Signal,
        :SpecialArea,
        :Switch,
        :Track,
        :Tunnel ;
    ns1:term_status "stable" ;
    skos:scopeNote "Each network shall be described using as many SoLs as necessary. Each SoL   is generated and identified by OP IDs at start and at end. A SoL only belongs to one Line."@en .

:PlatformEdge a owl:Class ;
    rdfs:label "Platform edge"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PlatformEdgeShape> ;
    dcterms:created "2021-08-02"^^xsd:date ;
    dcterms:modified "2023-11-10"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    rdfs:comment "Platform for the purpose of RINF is understood as a platform edge. A platform concerns only the part of the structure neighbouring to the track (interfaced with trains)."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :PrimaryLocation,
        :RadioBlockCenter,
        :RunningTrack,
        :SectionOfLine,
        :Siding,
        :Signal,
        :SpecialArea,
        :Switch,
        :Track,
        :Tunnel ;
    ns1:term_status "stable" .

:Signal a owl:Class ;
    rdfs:label "Signal"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SignalShape> ;
    dcterms:created "2021-04-01"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2023-09-28> ;
    rdfs:comment "A railway signal is a visual display device (next to the tracks or via a DMI in the cabin) that conveys instructions or provides advance warning of instructions regarding the driver's authority to proceed."@en ;
    rdfs:isDefinedBy : ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index003_-_SUBSET-023_v400.pdf"^^xsd:anyURI ;
    rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :SpecialArea,
        :Switch,
        :Track,
        :Tunnel ;
    ns1:term_status "stable" ;
    skos:definition "Apparatus by means of which a conventional visual or acoustic indication is given, generally concerning the movements/movement authorities of railway vehicles."@en .

:Tunnel a owl:Class ;
    rdfs:label "Tunnel"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TunnelShape> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1303/2024-01-29> ;
    rdfs:comment "A railway tunnel is an excavation or a construction around the track provided to allow the railway to pass for example higher land, buildings or water."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :InfrastructureElement ;
    ns1:term_status "stable" ;
    skos:definition """A railway tunnel is an excavation or a construction around the track provided to allow the railway to pass for example higher land, buildings or water.

The length of a tunnel is defined as the length of the fully enclosed section, measured at rail level. A tunnel in the context of this TSI is 0.1 km or longer.
Where certain requirements apply only to longer tunnels, thresholds are mentioned in the relevant clauses."""@en .

:RunningTrack a owl:Class ;
    rdfs:label "Running track"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/RunningTrackShape> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2024-11-20"^^xsd:date ;
    rdfs:comment "A running track means any track used for train service movements; passing loops and meeting loops on plain line or track connections only required for train operation are not published"@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Track ;
    owl:disjointWith :Siding,
        :Signal,
        :Switch,
        :Tunnel ;
    ns1:term_status "stable" ;
    skos:scopeNote "There might be more than one track within the Section of Line, so then the whole set of data for track has to be repeated for each track within the SoL."@en .

