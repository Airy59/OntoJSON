:lineReferenceTunnelEnd a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "End of tunnel kilometer"@en ;
    :XMLName "SOLTunnelEnd" ;
    :rinfIndex "1.1.1.1.8.4" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LineReferenceTunnelEnd> ;
    dcterms:created "2024-02-05"^^xsd:date ;
    dcterms:modified "2024-09-19"^^xsd:date,
        "2024-10-24"^^xsd:date,
        "2024-11-29"^^xsd:date,
        "2025-02-18"^^xsd:date ;
    dcterms:replaces :tunnelKilometerEnd ;
    rdfs:comment """Part of the End of tunnel that indicates the km of the line at the end of a tunnel.

The End of tunnel is the Geographical coordinates in decimal degrees and km of the line at the end of a tunnel."""@en ;
    rdfs:domain :Tunnel ;
    rdfs:isDefinedBy : ;
    rdfs:range :NetPointReference ;
    rdfs:subPropertyOf :tunnelObjParameter ;
    ns1:term_status "stable" ;
    skos:example "Kilometer=`0.270`" ;
    skos:scopeNote "Parameters of this group (from 1.1.1.1.8.1 to 1.1.1.1.8.13) are only applicable if tunnels exist on the SoL"@en .

:lineReferenceTunnelStart a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Start of tunnel kilometer"@en ;
    :XMLName "SOLTunnelStart" ;
    :applicable "Y" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.1.8.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LineReferenceTunnelStart> ;
    dcterms:created "2024-02-05"^^xsd:date ;
    dcterms:modified "2024-09-19"^^xsd:date,
        "2024-10-24"^^xsd:date,
        "2024-11-29"^^xsd:date,
        "2025-02-18"^^xsd:date ;
    dcterms:replaces :tunnelKilometerStart ;
    rdfs:comment """Part of the Start of tunnel that indicates the km of the line at the beginning of a tunnel.

The Start of tunnel is the Geographical coordinates in decimal degrees and km of the line at the beginning of a tunnel."""@en ;
    rdfs:domain :Tunnel ;
    rdfs:isDefinedBy : ;
    rdfs:range :NetPointReference ;
    rdfs:subPropertyOf :tunnelObjParameter ;
    ns1:term_status "stable" ;
    skos:example "Kilometer=`0.895`" ;
    skos:scopeNote """Geographical coordinates according to the standard World Geodetic System (WGS).  Precision for both geographical latitude and geographical longitude is assumed as [NN.NNNNNNN] in degrees with decimals what gives discretion of 10 cm in the network.
Kilometre shall concern the national line identification given in 1.1.0.0.0.2
Location of the point which is assumed to be the beginning of the tunnel it is the point on the track centre line where is laid the vertical shadow of the extreme part of the tunnel s portal."""@en .

:publicNetworkRoaming a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Existence of GSM-R roaming to public networks"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "GSM-R must be installed for this parameter to be applicable"@en ;
    :legalDeadline "1 January 2021"@en,
        "12 months after publication of Article 7 Guide for OP tracks"@en ;
    :rinfIndex "1.1.1.3.3.6",
        "1.2.1.1.2.6" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PublicNetworkRoaming>,
        <http://data.europa.eu/949/shapes/PublicNetworkRoamingApplicability> ;
    dcterms:created "2021-08-09"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation :publicNetworkRoamingDetails ;
    rdfs:comment """Existence of roaming to a public network.

                         In case of Y, provide the name of the public network(s) under parameter "Details on GSM-R roaming to public networks"."""@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :tsiCompliantRadioDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Sections of EIRENE not covered by references in TSI."@en .

:publicNetworkRoamingDetails a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Details on GSM-R roaming to public networks"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "Mandatory if GSM-R is installed and era:publicNetworkRoaming is 'true'. Otherwise, it is not applicable."@en ;
    :legalDeadline "1 January 2021"@en,
        "12 months after publication of Article 7 Guide for OP tracks"@en ;
    :rinfIndex "1.1.1.3.3.7",
        "1.2.1.1.2.7" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PublicNetworkRoamingDetails>,
        <http://data.europa.eu/949/shapes/PublicNetworkRoamingDetailsApplicability> ;
    dcterms:created "2021-08-09"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation :publicNetworkRoaming ;
    rdfs:comment "If roaming to public networks is configured, please indicate to which networks, for which users and in which areas."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :tsiCompliantRadioDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """List if any GSM-R functionality is not available when roaming to a public network (e.g. REC, Functional Addressing, Group Calls).
Please also add if there is any operational restriction for vehicles that cannot roam into any of the available public networks."""@en .

