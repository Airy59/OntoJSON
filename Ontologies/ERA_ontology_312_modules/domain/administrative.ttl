:additionalBrakingInformationDocument a owl:ObjectProperty ;
    rdfs:label "Documents available by the IM relating to braking performance"@en ;
    :XMLName "CBP_BrakePerfDocRef" ;
    :applicable "Y/N" ;
    :dependencyNote "Only applicable when for parameter 1.1.1.3.11.2 True is selected"@en ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.3.11.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/AdditionalBrakingInformationDocument>,
        <http://data.europa.eu/949/shapes/AdditionalBrakingInformationDocumentApplicability> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-23"^^xsd:date ;
    rdfs:comment "Electronic document available in two EU languages from the IM stored by the Agency providing additional information as defined in point (2) of point 4.2.2.6.2 of TSI OPE."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range :Document ;
    rdfs:subPropertyOf :brakeRelatedObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
    skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .

:certificate a owl:ObjectProperty ;
    rdfs:label "Certificate"@en ;
    dcterms:created "2022-06-15"^^xsd:date ;
    dcterms:modified "2022-11-15"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-10-30"^^xsd:date ;
    rdfs:comment """For this Vehicle Type, the type or design examination certificate described in the relevant verification module as issued by
Notified Bodies, supporting the EC Declaration(s) of Verification for the subsystems in scope of the type's authorisation by an authorizing entity."""@en ;
    rdfs:domain :VehicleType ;
    rdfs:isDefinedBy : ;
    rdfs:range :Certificate ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:compatibilityProcedureDocument a owl:ObjectProperty ;
    rdfs:label "Document with the procedure(s) for static and dynamic route compatibility checks"@en ;
    :XMLName "IPP_StructureCheckDocRef" ;
    :applicable "Y/N" ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.1.2.4.4" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/CompatibilityProcedureDocument> ;
    :usedInRCCCalculations true ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-04-23"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    rdfs:comment """Electronic document available in two EU languages from the IM stored by the Agency with:
- precise procedures for the static and dynamic route compatibility checks;
Or
- relevant information for carrying out the checks for specific structures."""@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range :Document ;
    rdfs:subPropertyOf :performanceObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
    skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .

:complianceInfTsi a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Compliance of the tunnel with TSI INF"@en ;
    :XMLName "ITU_TSITunnel" ;
    :applicable "Y/N" ;
    :dependencyNote "Mandatory if the speed of the line is equal or greater than 200km/h "@en ;
    :legalDeadline "1 January 2021"@en ;
    :rinfIndex "1.1.1.1.8.8.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/ComplianceInfTsiApplicability>,
        <http://data.europa.eu/949/shapes/ComplianceInfTsiP> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    rdfs:comment "Compliance of the tunnel with TSI INF at the maximum permitted speed"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Tunnel ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "https://eur-lex.europa.eu/eli/reg/2014/1299/2023-09-28#:~:text=4.2.10.1.%C2%A0%C2%A0%C2%A0%20Maximum%20pressure%20variations%20in%20tunnels"^^xsd:anyURI,
        "[4.2.10.1 of INF TSI on Maximum pressure variations in tunnels | ]" ;
    rdfs:subPropertyOf :tunnelDataParameter ;
    ns1:term_status "stable" .

:documentUrl a owl:DatatypeProperty ;
    rdfs:label "Document URL"@en ;
    dcterms:created "2024-04-23"^^xsd:date ;
