    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2024-04-23"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    rdfs:comment "Electronic document available from the IM stored by the Agency with the transversal section of the particular points requiring specific checks due to deviations from gauging referred to in parameter \"Gauging\". Where relevant, guidance for the check with the particular point may be attached to the document with the transversal section."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range :Document ;
    rdfs:subPropertyOf :lineLayoutObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
    skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .

:highSpeedLoadModelCompliance a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Compliance of structures with the High Speed Load Model (HSLM)"@en ;
    :XMLName "IPP_HSLMCompliant" ;
    :applicable "Y/N" ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.1.2.4.2" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HighSpeedLoadModelCompliance> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28#tocId3>,
        <http://data.europa.eu/eli/reg/2014/1299/2023-09-28#tocId30> ;
    rdfs:comment "For sections of line with a maximum permitted speed of 200 km/h or more. Information regarding the procedure to be used to perform the dynamic compatibility check."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """Annex D1 OPE TSI
INF TSI: 4.2.7.1.2(2)""" ;
    rdfs:subPropertyOf :performanceDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "(TSI INF 4.2.7.1.2(2)) Applicable if the maximum permitted speed of the running track is more than 200km/h and the structures within the section of line are all compatible with the High Speed Load Model (HSLM); information regarding the procedure to be used to perform the dynamic compatibility check shall be provided as well."@en .

:localRulesOrRestrictionsDoc a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Documents regarding the rules or restrictions of a strictly local nature available by the IM"@en ;
    :XMLName "RUL_LocalRulesOrRestrictionsDocRef" ;
    :applicable "Y/N" ;
    :dependencyNote "Mandatory to provide at least a document if parameter \"Existence of rules and restrictions of a strictly local nature\" value is boolean \"Yes\""@en ;
    :legalDeadline "1 January 2021"@en ;
    :rinfIndex "1.1.1.4.2",
        "1.2.3.2" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LocalRulesOrRestrictionsDoc> ;
    dcterms:created "2021-08-09"^^xsd:date ;
    dcterms:modified "2023-01-20"^^xsd:date,
        "2024-04-23"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    rdfs:comment "Electronic document available from the IM stored by the Agency providing additional information."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :OperationalPoint :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :OperationalPoint :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :OperationalPoint :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :OperationalPoint :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :OperationalPoint :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range :Document ;
    rdfs:seeAlso "IOD: Notification of national rules Art 14. 11" ;
    rdfs:subPropertyOf :rulesObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
    skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link.

IOD: Notification of national rules Art 14. 11. Member States may decide not to notify rules and restrictions of a strictly local nature. In such cases, Member States shall mention those rules and restrictions in the registers of infrastructure referred to in Article 49"""@en .

:magneticBrakingConditionsDocument a owl:ObjectProperty ;
    rdfs:label "Document with the conditions for the use of magnetic brakes"@en ;
    :XMLName "ILR_MBDocRef" ;
    :applicable "Y/N" ;
    :dependencyNote "Mandatory value to be provided when 1.1.1.1.6.3 / Use of magnetic brakes is 'allowed under conditions' or 'allowed under conditions only for emergency brake'."@en ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.1.6.5" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MagneticBrakingConditionsDocument>,
        <http://data.europa.eu/949/shapes/MagneticBrakingConditionsDocumentApplicability> ;
    :tsiOPEAppendixD2Index "3.4.6" ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-11"^^xsd:date,
        "2024-04-23"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Electronic document available in two EU languages from the IM stored by the Agency with conditions for the use of magnetic brakes identified in 1.1.1.1.6.3."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range :Document ;
    rdfs:subPropertyOf :trackResistanceToAppliedLoadsObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
    skos:scopeNote """If there exist conditions to allow the use of magnetic brakes.

The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .

