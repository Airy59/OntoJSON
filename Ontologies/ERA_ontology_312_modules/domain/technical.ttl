:profileNumberSemiTrailers a owl:ObjectProperty ;
    rdfs:label "Standard combined transport profile number for semi-trailers"@en ;
    :XMLName "ILL_ProfileNumSemiTrailers" ;
    :applicable "Y/N" ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/profile-num-semi-trailers/ProfileNumbersSemiTrailers> ;
    :legalDeadline "by 16 March 2019 at the latest for lines belonging to the TEN (1.1.1.1.2.1)"@en ;
    :rinfIndex "1.1.1.1.3.5" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/ProfileNumberSemiTrailersSKOS> ;
    :usedInRCCCalculations true ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date ;
    rdfs:comment "Coding for combined transport for semi-trailers (for all freight and mixed-traffic lines) in accordance with the specification referenced in Appendix A-1, index [B]."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf :lineLayoutObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """The technical number is made up of the wagon compatibility code (1 letter) and the standard combined transport profile number (2 digits when width <= 2500 mm or 3 digits when 2500 < width <= 2600 mm).
Additional values than the already identified in the list above are possible. They will be introduced by the Agency on request via a process of change request."""@en .

