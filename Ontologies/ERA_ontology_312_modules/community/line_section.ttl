@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:hasLRS a owl:ObjectProperty ;
    rdfs:label "has linear referencing system"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasLrsCoordinate> ;
    dcterms:created "2024-11-29"^^xsd:date ;
    dcterms:modified "2025-03-10"^^xsd:date ;
    rdfs:comment "Specifies the linear referencing system to which the kilometre post is referenced. The linear referencing system is commonly the main railway line and it provides the framework for identifying the post's location along the railway line, using distance measurements rather than geographical coordinates."@en ;
    rdfs:domain :KilometricPost ;
    rdfs:isDefinedBy : ;
    rdfs:range :LinearPositioningSystem .

:lengthOfSectionOfLine a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Length of section of line"@en ;
    :XMLName "SOLLength" ;
    :applicable "Y" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.0.0.0.5" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SolLength> ;
    :tsiOPEAppendixD2Index "3.2.3" ;
    :unitOfMeasure <http://qudt.org/vocab/unit/KiloM> ;
    :usedInRCCCalculations true ;
    dcterms:created "2024-05-16"^^xsd:date ;
    dcterms:modified "2025-03-11"^^xsd:date ;
    rdfs:comment "Length between operational points at start and end of section of line."@en ;
    rdfs:domain :SectionOfLine ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf :length,
        :solGenericDataParameter ;
    ns1:term_status "stable" .

:lineId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "line identifier"@en ;
    :XMLName "SOLLineIdentification" ;
    :applicable "Y" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.0.0.0.2" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LineId> ;
    :tsiOPEAppendixD2Index "2.2.1.1" ;
    dcterms:modified "2024-11-18"^^xsd:date ;
    rdfs:comment "Unique line identification or unique line number within Member State."@en ;
    rdfs:domain :LinearPositioningSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string .

:lrsMethod a owl:ObjectProperty ;
    rdfs:label "type of line referencing system"@en ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/lines/ReferenceSystems> ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LrsMethod>,
        <http://data.europa.eu/949/shapes/LrsMethodSKOS> ;
    dcterms:created "2024-04-18"^^xsd:date ;
    dcterms:modified "2024-11-29"^^xsd:date ;
    rdfs:comment "The preferred line referencing system."@en ;
    rdfs:domain :LinearPositioningSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    skos:editorialNote "TODO: provide example" .

:operationalRegimeType a owl:ObjectProperty ;
    rdfs:label "Operational regime"@en ;
    :applicable "Y/N/NYA" ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/operational-regime-types/OperationalRegimeTypes> ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.0.0.1.3" ;
    :tsiOPEAppendixD2Index "3.2.7" ;
    dcterms:created "2022-10-27"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2024-09-24"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Double track type."@en ;
    rdfs:domain :SectionOfLine ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf :routeBookObjectParameter ;
    ns1:term_status "unstable" .

:solNature a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Nature of Section of Line"@en ;
    :XMLName "SOLNature" ;
    :applicable "Y" ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/sol-natures/SoLNatures> ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.0.0.0.6" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SolNature>,
        <http://data.europa.eu/949/shapes/SolNatureApplicability>,
        <http://data.europa.eu/949/shapes/SolNatureSKOS> ;
    dcterms:created "2021-08-08"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    rdfs:comment "Kind of section of line expressing size of presented data which depends on fact whether it connects OPs generated by division of a big node into several OPs or not."@en ;
    rdfs:domain :SectionOfLine ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf :solGenericObjParameter ;
    ns1:term_status "stable" .

:nationalLine a owl:ObjectProperty ;
    rdfs:label "national line identification"@en ;
    :XMLName "SOLLineIdentification" ;
    :rinfIndex "1.1.0.0.0.2" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/NationalLineSoL> ;
    dcterms:created "2024-05-24"^^xsd:date ;
    dcterms:modified "2024-10-24"^^xsd:date,
        "2024-11-18"^^xsd:date,
        "2024-11-29"^^xsd:date,
        "2025-02-18"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:replaces :lineNationalId,
        :lineReference ;
    rdfs:comment """Indicates a relationship with a national railway line at a specific kilometer point.
For a Section of Line: unique line identification or unique line number within Member State."""@en ;
    rdfs:domain :SectionOfLine ;
    rdfs:isDefinedBy : ;
    rdfs:range :LinearPositioningSystem ;
    rdfs:subPropertyOf :solGenericObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Each SoL can belong to only one national line.

In case when SoL is the track connecting between OPs within big node (resulting from division of big station into several smaller) the line can be identified using the name of this track."""@en .

:opEnd a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Operational point at end of section of line"@en ;
    :XMLName "SOLOPEnd" ;
    :applicable "Y" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.0.0.0.4" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/OpEnd>,
        <http://data.europa.eu/949/shapes/OpEndExists> ;
    :tsiOPEAppendixD2Index "3.1.2" ;
    dcterms:created "2021-09-09"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Operational point at the end of section of line (kilometres increasing from start OP to the end OP)."@en ;
    rdfs:domain :SectionOfLine ;
    rdfs:isDefinedBy : ;
    rdfs:range :OperationalPoint ;
    rdfs:subPropertyOf :solGenericObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Each SoL may have only one end OP, and each OP has unique OP ID within the MS. The â€œuniqueOPIDâ€ is defined in parameter 1.2.0.0.0.2.
Each SoL has the principal direction of the traffic defined by increasing kilometres running from the start OP to the end OP.
That is why the end OP is always located at highest kilometre of the line within the SoL.
No validation will be performed by RINF application regarding which is the start and which the end OP. This requires IM's verification. """@en .

:opStart a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Operational point at start of section of line"@en ;
    :XMLName "SOLOPStart" ;
    :applicable "Y" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.0.0.0.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/OpStart>,
        <http://data.europa.eu/949/shapes/OpStartExists> ;
    :tsiOPEAppendixD2Index "3.1.1" ;
    dcterms:created "2021-09-09"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Operational point at the start of section of line (kilometres increasing from start OP to the end OP)."@en ;
    rdfs:domain :SectionOfLine ;
    rdfs:isDefinedBy : ;
    rdfs:range :OperationalPoint ;
    rdfs:subPropertyOf :solGenericObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Each SoL may have only one start OP, and each OP has unique OP ID within the MS. The â€œuniqueOPIDâ€ is defined in parameter 1.2.0.0.0.2.
Each SoL has the principal direction of the traffic defined by increasing kilometres running from the start OP to the end OP.
That is why the start OP is always located at lowest kilometre of the line within the SoL.
No validation will be performed by RINF application regarding which is the start and which the end OP. This requires IM's verification. """@en .

:SectionOfLine a owl:Class ;
    rdfs:label "Section Of Line"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SectionOfLineShape> ;
    dcterms:created "2021-04-02"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "A section of line means the part of line between adjacent operational points and may consist of several tracks."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :InfrastructureElement ;
    owl:disjointWith :Signal,
        :SpecialArea,
        :Switch,
        :Track,
        :Tunnel ;
    ns1:term_status "stable" ;
    skos:scopeNote "Each network shall be described using as many SoLs as necessary. Each SoL   is generated and identified by OP IDs at start and at end. A SoL only belongs to one Line."@en .

:LinearPositioningSystem a owl:Class ;
    rdfs:label "Linear Positioning System"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/LinearPositioningSystemShape> ;
    dcterms:created "2024-11-29"^^xsd:date ;
    dcterms:modified "2025-02-18"^^xsd:date ;
    dcterms:replaces :LineReference ;
    rdfs:comment """Represents a linear positioning system used for referencing positions on the network.
It can also represent a sequence of one or more sections of line, used for regular railway operations."""@en ;
    rdfs:isDefinedBy : ;
    owl:disjointWith :LinearPositioningSystemCoordinate .

