@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:dNvpotrp a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "D_NVPOTRP"@en ;
    :applicable "Y/N/NYA" ;
    :formatNote "NNNNNNN.N whereby the last digit is only used when Q_SCALE = 10 CM" ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.3.2.16.7",
        "1.2.1.1.1.16.7" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/DNvpotrp>,
        <http://data.europa.eu/949/shapes/DNvpotrpApplicability> ;
    :tsiOPEAppendixD3Index "1.5.7" ;
    :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
    dcterms:created "2022-11-07"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-12-05"^^xsd:date ;
    dcterms:relation :etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Maximum distance for reversing in Post Trip mode in metres, according to the specification referenced in Appendix A-1, index [C]."@en ;
    rdfs:domain [ ],
        [ ],
        [ ] ;
    rdfs:isDefinedBy : ;
    rdfs:range [ ],
        [ ],
        [ ] ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
    rdfs:subPropertyOf :etcsNationalValuesDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Precision: the value must be expressed in meter.

Depending on the chosen Q_SCALE, the maximal value will be: +327670 M, +32767 M or +3276.7 M.

See: TSI CCS (Subset 26, chapter 7. 7.5.1.16 D_NVPOTRP)"""@en .

