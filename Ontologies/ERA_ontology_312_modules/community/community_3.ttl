:canonicalURI a owl:AnnotationProperty ;
    rdfs:label "Canonical URI"@en ;
    dcterms:created "2022-12-13"^^xsd:date ;
    dcterms:modified "2024-02-06"^^xsd:date ;
    rdfs:comment """The canonical URI is defined for each instance of an Infrastructure element, e.g. section of line, operational point, track, tunnel, siding.
Objects of the infrastructure generated through RML mappings include (when provided) their validity start and end dates. With its identifier, plus all identifiers of its "parent" elements, and its validity dates, a hash URI is generated.
The canonical URI is the element's URI with its identifiers and without the validity dates. All of the hash URIs of an element point to its canonical URI.
Additionally, SoLs point to the canonical URIs of their start OP and end OP."""@en ;
    rdfs:domain :InfrastructureElement ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:anyURI .

:conditionalRegenerativeBrake a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Permission for regenerative braking"@en ;
    :XMLName "ECS_RegenerativeBraking" ;
    :applicable "Y/N" ;
    :dependencyNote "When `not electrified` is chosen in parameter 1.1.1.2.2.1.1, then this parameter is not applicable. "@en ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/regenerative-braking/RegenerativeBraking> ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.2.2.4" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionalRegenerativeBrake>,
        <http://data.europa.eu/949/shapes/ConditionalRegenerativeBrakeSKOS> ;
    :tsiOPEAppendixD2Index "3.3.7" ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
