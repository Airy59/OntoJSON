:gsmRNoCoverage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "No GSMR coverage"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "GSM-R (parameter 1.1.1.3.3.1) must be installed for this parameter to be applicable."@en,
        "GSM-R must be installed for this parameter to be applicable"@en ;
    :legalDeadline "1 January 2021"@en,
        "12 months after publication of Article 7 Guide for OP tracks"@en ;
    :rinfIndex "1.1.1.3.3.8",
        "1.2.1.1.2.8" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/GsmRNoCoverage>,
        <http://data.europa.eu/949/shapes/GsmRNoCoverageApplicability> ;
    dcterms:created "2021-08-09"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    rdfs:comment "Indication if there is no GSMR coverage"@en ;
    rdfs:domain [ ],
        [ ],
        [ ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :tsiCompliantRadioDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """If GSM-R is not installed, this parameter should not be used.
This parameter is mainly to capture the case of Radio Hole functionality (lack of GSM-R coverage), that is foreseen in the ETCS specifications as packet 68.
Another possible use is the declaration of a temporary situation where, although the area is in principle covered by GSM-R, there is a long-term outage or a project for replacement of the radio (i.e. a section that will not be covered with GSM-R for half a year or longer)."""@en .

