:etcsImplementsLevelCrossingProcedure a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ETCS trackside implements level crossing procedure or an equivalent solution"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "Applicable and mandatory when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.3.2.13",
        "1.2.1.1.1.13" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsImplementsLevelCrossingProcedure>,
        <http://data.europa.eu/949/shapes/EtcsImplementsLevelCrossingProcedureApplicability> ;
    :tsiOPEAppendixD3Index "1.2" ;
    dcterms:created "2022-11-04"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation :etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "If the trackside does not implement any solution to cover non-protected LXs (which are normally protected by means of a technical system), then drivers will be required to comply with instructions received from other sources"@en ;
    rdfs:domain [ ],
        [ ],
        [ ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
    rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "See: TSI CCS (Subset-026, Chapter 5, section 5.16)"@en .

:etcsInfillLineAccess a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ETCS infill necessary for line access"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1) and the ETCS level is 1."@en ;
    :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.3.2.3",
        "1.2.1.1.1.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsInfillLineAccess>,
        <http://data.europa.eu/949/shapes/EtcsInfillLineAccessApplicability> ;
    dcterms:created "2021-08-08"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation :etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Indication whether infill is required to access the line for safety reasons."@en ;
    rdfs:domain [ ],
        [ ],
        [ ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """As indicated in CCS TSI section 7.2.9.1, an ETCS Level 1 trackside application may require that the on-board is equipped with the corresponding in-fill data transmission (Euroloop or radio) if the release speed is set to zero for safety reasons.

See: TSI CCS 7.2.9.1 & 4.2.3 """@en .

