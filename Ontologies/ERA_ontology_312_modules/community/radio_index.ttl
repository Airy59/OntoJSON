    rdfs:comment """Specific for the French, Italian and Swedish networks.
Trackside HABD compliant to TSI means that the HABD Trackside is compliant with:
- EN 15437-1:2009 referred in TSIs (LOC&PAS: 4.2.3.3.2.2, WAG TSI: 4.2.3.4),
- Specific cases mentioned in TSIs (LOC&PAS TSI, WAG TSI)."""@en ;
    rdfs:domain :HABD ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """TSI LOC&PAS: 4.2.3.3.2.2, and 7.3.2.3
WAG TSI: 4.2.3.4 and 7.3.2.2
EN 15437-1:2009""" ;
    rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
    ns1:term_status "stable" .

