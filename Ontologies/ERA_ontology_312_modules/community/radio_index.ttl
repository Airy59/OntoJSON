:permittedContactForce a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Contact force permitted"@en ;
    :XMLName "ERS_ContactForce" ;
    :applicable "Y/N" ;
    :dependencyNote "A value is mandatory if the value  Overhead contact line (OCL)  is selected for parameter \"Type of contact line system\""@en ;
    :formatNote "The force is either given as: a value of the static force and of the maximum force expressed in newtons, or as a formula for function of the speed" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.2.5.2" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PermittedContactForce>,
        <http://data.europa.eu/949/shapes/PermittedContactForceApplicability> ;
    :unitOfMeasure <http://qudt.org/vocab/unit/N> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-25"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date ;
    rdfs:comment "Indication of contact force allowed expressed in newton."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
