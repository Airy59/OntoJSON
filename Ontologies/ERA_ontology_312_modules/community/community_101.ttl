@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:conditionsSwitchTrainProtectionSystems rdfs:subPropertyOf :transitionsBetweenSystemsDataParameter .

:switchProtectControlWarning rdfs:subPropertyOf :transitionsBetweenSystemsDataParameter .

:switchRadioSystem rdfs:subPropertyOf :transitionsBetweenSystemsDataParameter .

:transitionsBetweenSystemsDataParameter a owl:DatatypeProperty ;
    rdfs:label "Transitions between systems"@en ;
    :rinfIndex "1.1.1.3.8",
        "1.2.1.1.7" ;
    dcterms:created "2024-10-31"^^xsd:date ;
    rdfs:isDefinedBy : ;
    rdfs:subPropertyOf :ccsSubsystemDataParameter .

