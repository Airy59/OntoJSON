:gsmrConstraintsOperateOnlyInCircuitSwitch rdfs:subPropertyOf :tsiCompliantRadioObjParameter .

:gsmrNetworkCoverage rdfs:subPropertyOf :tsiCompliantRadioObjParameter .

:voiceRadioCompatible rdfs:subPropertyOf :tsiCompliantRadioObjParameter .

:tsiCompliantRadioObjParameter a owl:ObjectProperty ;
