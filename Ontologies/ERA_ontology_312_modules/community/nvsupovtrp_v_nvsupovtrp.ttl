        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:unsignedInt ;
            owl:withRestrictions ( [ xsd:minInclusive "0"^^xsd:unsignedInt ] [ xsd:maxInclusive "600"^^xsd:unsignedInt ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:unsignedInt ;
            owl:withRestrictions ( [ xsd:minInclusive "0"^^xsd:unsignedInt ] [ xsd:maxInclusive "600"^^xsd:unsignedInt ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:unsignedInt ;
            owl:withRestrictions ( [ xsd:minInclusive "0"^^xsd:unsignedInt ] [ xsd:maxInclusive "600"^^xsd:unsignedInt ] ) ],
        [ a rdfs:Datatype ;
