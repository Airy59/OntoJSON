:vNvsupovtrp a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "V_NVSUPOVTRP"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    :formatNote "NNF, with N a decimal number (0 9), NNF must be divisible by 5, so F=(0|5), max. `600`" ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en,
        "12 months after publication of Article 7 Guide for OP tracks"@en ;
    :rinfIndex "1.1.1.3.2.16.4",
        "1.2.1.1.1.16.4" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/VNvsupovtrp>,
        <http://data.europa.eu/949/shapes/VNvsupovtrpApplicability> ;
    :tsiOPEAppendixD3Index "1.5.4" ;
    :unitOfMeasure <http://qudt.org/vocab/unit/KiloM-PER-HR> ;
    dcterms:created "2022-11-07"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2024-12-05"^^xsd:date ;
    dcterms:relation :etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment """Override speed limit to be supervised when the "override" function is active in km/h.
