@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:manufacturingCountry rdfs:subPropertyOf :vehicleTechnicalObjCharacteristic .

:operationalRestriction rdfs:subPropertyOf :vehicleTechnicalObjCharacteristic .

:quieterRoutesExemptedCountry rdfs:subPropertyOf :vehicleTechnicalObjCharacteristic .

:vehicleKeeper rdfs:subPropertyOf :vehicleTechnicalObjCharacteristic .

:vehicleType rdfs:subPropertyOf :vehicleTechnicalObjCharacteristic .

:vehicleTechnicalObjCharacteristic a owl:ObjectProperty ;
    rdfs:label "Vehicle technical characteristic"@en ;
    rdfs:isDefinedBy : .

