@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:gprsForETCS rdfs:subPropertyOf :tsiCompliantRadioDataParameter .

:gprsImplementationArea rdfs:subPropertyOf :tsiCompliantRadioDataParameter .

:gsmRNoCoverage rdfs:subPropertyOf :tsiCompliantRadioDataParameter .

:gsmrForcedDeregistrationFunctionalNumber rdfs:subPropertyOf :tsiCompliantRadioDataParameter .

:publicNetworkRoaming rdfs:subPropertyOf :tsiCompliantRadioDataParameter .

:publicNetworkRoamingDetails rdfs:subPropertyOf :tsiCompliantRadioDataParameter .

:radioNetworkId rdfs:subPropertyOf :tsiCompliantRadioDataParameter .

:usesGroup555 rdfs:subPropertyOf :tsiCompliantRadioDataParameter .

:tsiCompliantRadioDataParameter a owl:DatatypeProperty ;
    rdfs:label "TSI compliant radio (RMR)"@en ;
    :rinfIndex "1.1.1.3.3",
        "1.2.1.1.2" ;
    dcterms:created "2024-10-31"^^xsd:date ;
    rdfs:isDefinedBy : ;
    rdfs:subPropertyOf :ccsSubsystemDataParameter .

