:siding dcterms:isReplacedBy :hasPart .

:track dcterms:isReplacedBy :hasPart .

:vehicleKeeper dcterms:replaces :VehicleKeeper .

:Manufacturer a owl:Class ;
    rdfs:label "(deprecated) Manufacturer"@en ;
    dcterms:created "2020-11-19"^^xsd:date ;
    dcterms:isReplacedBy :Body,
        :manufacturer ;
    dcterms:modified "2020-11-19"^^xsd:date,
        "2024-06-03"^^xsd:date ;
    rdfs:comment "(deprecated) Replaced by the era:Body class and era:manufacturer property. A company or organization that manufactures vehicles."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf org:Organization ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:OperationalPoint rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :PrimaryLocation,
        :Signal,
        :Switch .

:PlatformEdge rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :PrimaryLocation,
        :Signal,
        :Switch .

:RunningTrack owl:disjointWith :Signal,
        :Switch .

:Siding owl:disjointWith :Signal,
        :Switch .

:VehicleKeeper a owl:Class ;
    rdfs:label "(deprecated) Vehicle Keeper"@en ;
    dcterms:created "2020-11-23"^^xsd:date ;
    dcterms:isReplacedBy :Body,
        :vehicleKeeper ;
    dcterms:modified "2020-11-23"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-06-03"^^xsd:date ;
    rdfs:comment """The natural or legal person that, being the owner of a vehicle or having the right to use it,
exploits the vehicle as a means of transport and is registered as such in a vehicle register referred to in Article 47 of (EU)2016/797."""@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf org:Organization ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:hasPart a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasPart>,
        <http://data.europa.eu/949/shapes/HasPartOP> ;
    dcterms:created "2024-05-24"^^xsd:date ;
    dcterms:modified "2025-01-30"^^xsd:date,
        "2025-02-18"^^xsd:date ;
    dcterms:replaces :siding,
        :track ;
    rdfs:comment """Indicates that an infrastructure element is composed of one or more other (distinct) infrastructure elements.
This property is used to represent part-whole relationships between infrastructure elements.
An element cannot be a part of itself."""@en ;
    rdfs:domain :InfrastructureElement ;
    rdfs:isDefinedBy : ;
    rdfs:range :InfrastructureElement ;
    owl:inverseOf :isPartOf .

:nationalLine dcterms:replaces :lineNationalId,
        :lineReference .

:signalId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Name of signal"@en ;
    :applicable "Y/N/NYA" ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.3.14.1",
        "1.2.1.0.8.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SignalId> ;
    :tsiOPEAppendixD2Index "2.2.3",
        "2.3.3" ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Identifier of signal."@en ;
    rdfs:domain :Signal ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :signalDataParameter,
        dcterms:identifier ;
    ns1:term_status "stable" ;
    skos:scopeNote "Operational identifier of the signal (on the track or in OP), as in the operational and maintenance provisions."@en .

:tafTAPCode dcterms:isReplacedBy :primaryLocation,
        :primaryLocationCode .

xsd:date a rdfs:Datatype .

:Body dcterms:replaces :InfrastructureManager,
        :Manufacturer,
        :VehicleKeeper ;
    owl:disjointWith :InfrastructureElement .

:InfrastructureManager a owl:Class ;
    rdfs:label "Infrastructure manager"@en ;
    dcterms:isReplacedBy :Body ;
    rdfs:comment "(deprecated) The infrastructure manager owns and operates the railway network and related infrastructure."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf org:Organization ;
    owl:deprecated true ;
    skos:scopeNote "See point (2) of Article 3 of Directive 2012/34/EU of the European Parliament and of the Council establishing a single European railway area."@en .

:LevelCrossing a owl:Class ;
    rdfs:label "Level crossing"@en ;
    dcterms:modified "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    rdfs:comment "A level crossing is an intersection where a railway line crosses a road or a path at the same level. It can be used for the implementation of the ETCS trackside or to identify potential collision scenarios"@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :OperationalPoint,
        :PlatformEdge,
        :PrimaryLocation,
        :RadioBlockCenter,
        :RunningTrack,
        :SectionOfLine,
        :Siding,
        :Signal,
        :SpecialArea,
        :Switch,
        :Track,
        :Tunnel .

:RadioBlockCenter rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :Signal,
        :Switch .

:SectionOfLine rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :Signal,
        :Switch .

:SpecialArea rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :Switch .

:LineReference a owl:Class ;
    rdfs:label "(deprecated) Railway location"@en ;
    dcterms:created "2021-01-29"^^xsd:date ;
    dcterms:isReplacedBy :LinearPositioningSystem ;
    dcterms:modified "2021-01-29"^^xsd:date,
        "2024-10-24"^^xsd:date,
        "2024-11-29"^^xsd:date ;
    rdfs:comment "A reference to a specific railway line."@en ;
    rdfs:isDefinedBy : ;
    owl:deprecated true ;
    ns1:term_status "stable" ;
    skos:altLabel "Line reference" .

:Track rdfs:subClassOf :InfrastructureElement .

:Tunnel rdfs:subClassOf :InfrastructureElement .

org:Organization a owl:Class ;
    rdfs:label "Organization"@en,
        "organizaciÃ³n"@es,
        "Organisation"@fr,
        "Organizzazione"@it .

:Switch a owl:Class ;
    rdfs:label "Switch"@en ;
    dcterms:modified "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/776/oj> ;
    rdfs:comment "A unit of track comprising two fixed rails (stock rails) and two movable rails (switch rails) used to direct vehicles from one track to another track."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :Track,
        :Tunnel ;
    ns1:term_status "stable" .

:PrimaryLocation a owl:Class ;
    rdfs:label "Primary Location"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PrimaryLocationShape> ;
    dcterms:modified "2024-10-28"^^xsd:date,
        "2025-03-01"^^xsd:date,
        "2025-06-06"^^xsd:date ;
    rdfs:comment """Primary Location is a place used by IM to define a path for a train in TAF/TAP TSI framework/messages. This location is a rail point inside the rail network where train starts, ends, stops, or runs through or change line. This location must be managed by an Infrastructure Manager (IM) identified by company code.

Primary locations are identified by single and unique Primary Location codes. Primary location code is allocated based on processes defined by national entity. Primary location codes are used in any kind of TAF/TAP communication.

See: Handbook 9.3.3 / page 60"""@en ;
    rdfs:isDefinedBy : ;
    rdfs:seeAlso "http://taf-jsg.info/wp-content/uploads/2024/01/20231018-JGS-Handbook-3.4-with-XSD-3.4.0.0.pdf"^^xsd:anyURI ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        :InfrastructureElement ;
    owl:disjointWith :RadioBlockCenter,
        :SectionOfLine,
        :Signal,
        :SpecialArea,
        :SubsidiaryLocation,
        :Switch,
        :Track,
        :Tunnel ;
    skos:example "Primary locations are for example: stations, yards, halts, handover points, border points, open access terminals. "@en .

:Signal a owl:Class ;
    rdfs:label "Signal"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SignalShape> ;
    dcterms:created "2021-04-01"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2023-09-28> ;
    rdfs:comment "A railway signal is a visual display device (next to the tracks or via a DMI in the cabin) that conveys instructions or provides advance warning of instructions regarding the driver's authority to proceed."@en ;
    rdfs:isDefinedBy : ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index003_-_SUBSET-023_v400.pdf"^^xsd:anyURI ;
    rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :SpecialArea,
        :Switch,
        :Track,
        :Tunnel ;
    ns1:term_status "stable" ;
    skos:definition "Apparatus by means of which a conventional visual or acoustic indication is given, generally concerning the movements/movement authorities of railway vehicles."@en .

:InfrastructureElement a owl:Class ;
    rdfs:label "Infrastructure element"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/InfrastructureElementShape> ;
    dcterms:created "2022-07-07"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2024-10-28"^^xsd:date,
        "2025-04-30"^^xsd:date ;
    rdfs:comment """This class encompasses all those classes that represent features that are  implemented in the European railway infrastructure. It is a subclass of the ERA Feature that has a spatial representation. It covers tracks, platforms, signals, tunnels, operational points, and sections of line.
A feature that belongs to the infrastructure can be abstracted (hasAbstraction) as a topological object. It also is related to the infrastructure manager through the property infrastructureMgr."""@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Feature .

:CommonCharacteristicsSubset a owl:Class ;
    rdfs:label "Subset with common characteristics"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/CommonCharacteristicsSubsetShape> ;
    dcterms:created "2022-11-04"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-10-31"^^xsd:date ;
    rdfs:comment "A set of different infrastructure objects sharing the same common technical characteristics. The parameters may not be restricted to only one railway subsystem, but it can include common characteristics from each one of them (infrastructure, energy, track-side CCS)"@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf rdf:List ;
    ns1:term_status "stable" .

