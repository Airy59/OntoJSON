@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Bridge a owl:Class ;
    rdfs:label "Bridge"@en ;
    dcterms:modified "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    rdfs:comment "It is a structure constructed for the exclusive purpose of carrying railroad traffic across an obstruction. It can be used for defining non-stopping areas, big metal mass, resistance to traffic load etc."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :HABD,
        :KilometricPost,
        :LevelCrossing,
        :OperationalPoint,
        :PlatformEdge,
        :PrimaryLocation,
        :RadioBlockCenter,
        :RunningTrack,
        :SectionOfLine,
        :Siding,
        :Signal,
        :SpecialArea,
        :Switch,
        :Track,
        :Tunnel .

:belongsTo a owl:ObjectProperty ;
    rdfs:label "belongs to"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/BelongsTo>,
        <http://data.europa.eu/949/shapes/BelongsToUniqueIM> ;
    dcterms:created "2024-05-24"^^xsd:date ;
    dcterms:modified "2024-10-24"^^xsd:date ;
    rdfs:comment "Indicates that an infrastructure element belongs to a certain subset that contains common characteristics."@en ;
    rdfs:domain :InfrastructureElement ;
    rdfs:isDefinedBy : ;
    rdfs:range :CommonCharacteristicsSubset ;
    owl:inverseOf :contains .

:canonicalURI rdfs:domain :InfrastructureElement .

:containerHandlingFlag a owl:DatatypeProperty ;
    rdfs:label "container handling flag"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/ContainerHandlingFlag> ;
    dcterms:created "2024-06-03"^^xsd:date ;
    rdfs:domain :PrimaryLocation ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean .

:definesSubset a owl:ObjectProperty ;
    rdfs:label "Defines subset"@en ;
    dcterms:created "2022-11-04"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date ;
    rdfs:comment "(deprecated) not in use anymore. For the purposes of the register of infrastructure, each infrastructure manager may describe its railway network optionally via common characteristic subsets."@en ;
    rdfs:domain :InfrastructureManager ;
    rdfs:isDefinedBy : ;
    rdfs:range :CommonCharacteristicsSubset ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:freightFlag a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "freight flag"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/FreightFlag> ;
    dcterms:created "2024-06-03"^^xsd:date ;
    rdfs:domain :PrimaryLocation ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean .

:handoverPointFlag a owl:DatatypeProperty ;
    rdfs:label "handover point flag"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HandoverPointFlag> ;
    dcterms:created "2024-06-03"^^xsd:date ;
    rdfs:domain :PrimaryLocation ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean .

:hasAbstraction a owl:ObjectProperty ;
    rdfs:label "Has abstraction"@en ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2025-02-18"^^xsd:date ;
    rdfs:comment "Property that links a physical entity with its topological abstraction representation."@en ;
    rdfs:domain :InfrastructureElement ;
    rdfs:isDefinedBy : ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:hasImplementation a owl:ObjectProperty ;
    rdfs:label "Has implementation"@en ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2025-02-18"^^xsd:date ;
    rdfs:comment "Property that links a topological abstraction entity with its physical representation."@en ;
    rdfs:isDefinedBy : ;
    rdfs:range :InfrastructureElement ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:hasOrientation a owl:ObjectProperty ;
    rdfs:label "has orientation"@en ;
    dcterms:created "2024-10-28"^^xsd:date ;
    rdfs:domain :Signal ;
    rdfs:isDefinedBy : ;
    rdfs:range :Orientation .

:hashSource a owl:AnnotationProperty ;
    rdfs:label "Hash source"@en ;
    dcterms:created "2024-02-06"^^xsd:date ;
    rdfs:comment "This property indicates for each infrastructure element, the source, i.e. the identifier  or key that was input to the hash function in order to generate the hash value that is part of the hash URI."@en ;
    rdfs:domain :InfrastructureElement ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string .

:linkedToPrimaryLocation rdfs:range :PrimaryLocation .

:operatingLanguage a owl:ObjectProperty ;
    rdfs:label "Operating language"@en ;
    :applicable "Y/NYA" ;
    :formatNote "http://publications.europa.eu/resource/authority/language" ;
    :inSkosConceptScheme <http://publications.europa.eu/resource/authority/language> ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.0.0.1.2",
        "1.2.0.0.0.8" ;
    :tsiOPEAppendixD2Index "3.5.1" ;
    dcterms:created "2022-10-28"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "The language or languages used in daily operation by infrastructure manager and published in its Network Statement, for the communication of operational or safety related messages between the staff of the infrastructure manager and the railway undertaking."@en ;
    rdfs:domain :InfrastructureElement ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf :routeBookObjectParameter ;
    ns1:term_status "unstable" .

:primaryLocationName a owl:DatatypeProperty ;
    rdfs:label "primary location name"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PrimaryLocationName> ;
    dcterms:created "2024-06-03"^^xsd:date ;
    rdfs:domain :PrimaryLocation ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string .

:railSystemType a owl:DatatypeProperty ;
    rdfs:label "Rail system type"@en ;
    dcterms:created "2022-11-04"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date ;
    rdfs:comment "(deprecated) Type of railway system. Can be \"High-speed\" or \"Conventional\". Deprecated due to the lack of information"@en ;
    rdfs:domain :CommonCharacteristicsSubset ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:relativeDistanceDangerPoint a owl:DatatypeProperty ;
    rdfs:label "Relative distance of the danger point"@en ;
    :applicable "Y/N/NYA" ;
    :formatNote "NNN" ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.3.14.4",
        "1.2.1.0.8.4" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/RelativeDistanceDangerPoint> ;
    :tsiOPEAppendixD2Index "2.2.3",
        "2.3.3" ;
    :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Distance in meters to the danger point"@en ;
    rdfs:domain :Signal ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :signalDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Danger point is defined in ERTMS/ETCS - Glossary of Terms and Abbreviations - version  4.0.0 - date 05/07/2023. For installations without ERTMS, the signalling definition is equivalent.
See: TSI OPE Appendix D2 (2.3.3), the danger point relative distance from the signal itself."""@en .

:signalOrientation dcterms:relation :signalId .

:signalType dcterms:relation :signalId .

:subsetName a owl:DatatypeProperty ;
    rdfs:label "Name of a subset with common characteristics"@en ;
    dcterms:created "2023-03-14"^^xsd:date ;
    rdfs:comment "A subset of elements with common characteristics could be identified with a unique name/id."@en ;
    rdfs:domain :CommonCharacteristicsSubset ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" ;
    skos:example "Example: \"ETCSbaseline2\": describes all ETCS National values (1.1.1.3.2.16 group) "@en .

:subsetOf a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "subset of"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SubsetOf> ;
    dcterms:created "2024-10-31"^^xsd:date ;
    dcterms:modified "2025-03-10"^^xsd:date ;
    rdfs:comment "Relates a subset with common characteristics with another subset with common characteristics."@en ;
    rdfs:domain :CommonCharacteristicsSubset ;
    rdfs:isDefinedBy : ;
    rdfs:range :CommonCharacteristicsSubset ;
    skos:scopeNote "Whenever a subset (A) is a subset of another subset (B), then the subset (A) inherits all the common characteristics of subset (B), which is that all the infrastructure elements belonging to subset (A) will have as common characteristics the union of parameters (A) and (B)."@en .

:validityEndDate a owl:DatatypeProperty ;
    rdfs:label "Validity end date"@en ;
    dcterms:created "2022-10-19"^^xsd:date ;
    rdfs:domain :InfrastructureElement ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:date ;
    owl:deprecated true ;
    ns1:term_status "stable" ;
    skos:editorialNote "To be deprecated with the introduction of temporal entity"@en .

:validityStartDate a owl:DatatypeProperty ;
    rdfs:label "Validity start date"@en ;
    dcterms:created "2022-10-20"^^xsd:date ;
    rdfs:domain :InfrastructureElement ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:date ;
    owl:deprecated true ;
    ns1:term_status "stable" ;
    skos:editorialNote "To be deprecated with the introduction of temporal entity"@en .

:vehicleTypesCompatibleTrafficLoad a owl:ObjectProperty ;
    rdfs:label "List of vehicle types already identified as compatible with Traffic load and load carrying capacity of infrastructure and train detection systems"@en ;
    :applicable "Y/N/NYA" ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.5.1" ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-10-24"^^xsd:date,
        "2025-03-10"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    rdfs:comment "The infrastructure managers shall provide through RINF the information to the RU regarding list of vehicle types compatible with the route for which they have already verified compatibility for parameter Traffic load and load carrying capacity of infrastructure and train detection systems, where such information is available."@en ;
    rdfs:domain :CommonCharacteristicsSubset ;
    rdfs:isDefinedBy : ;
    rdfs:range [ ],
        [ ],
        [ ] ;
    rdfs:subPropertyOf :verifiedRccObjParameter ;
    ns1:term_status "unstable" .

:vehiclesCompatibleTrafficLoad a owl:ObjectProperty ;
    rdfs:label "List of vehicles already identified as compatible with Traffic load and load carrying capacity of infrastructure and train detection systems"@en ;
    :applicable "Y/N/NYA" ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.5.2" ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-10-24"^^xsd:date,
        "2025-03-10"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    rdfs:comment "The infrastructure managers shall provide through RINF the information or a document to the RU regarding list of vehicles compatible with the route for which they have already verified compatibility for parameter Traffic load and load carrying capacity of infrastructure and train detection systems, where such information is available."@en ;
    rdfs:domain :CommonCharacteristicsSubset ;
    rdfs:isDefinedBy : ;
    rdfs:range [ ],
        [ ],
        [ ] ;
    rdfs:subPropertyOf :verifiedRccObjParameter ;
    ns1:term_status "unstable" .

org:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier"@en,
        "tiene identificador"@es,
        "identifiant"@fr,
        "identificatore"@it ;
    rdfs:comment "Gives an identifier, such as a company registration number, that can be used to used to uniquely identify the organization. Many different national and international identier schemes are available. The org ontology is neutral to which schemes are used. The particular identifier scheme should be indicated by the datatype of the identifier value.  Using datatypes to distinguish the notation scheme used is consistent with recommended best practice for `skos:notation` of which this property is a specialization."@en,
        "CÃ³digo o identificador, como por ejemplo el CIF de una empresa, que permite identificar de forma inequÃ­voca a una organizaciÃ³n. Existen muchos cÃ³digos de identificaciÃ³n tanto nacionales como internacionales. Esta ontologÃ­a no obliga al uso de ningÃºn esquema en concreto. Los cÃ³digos de identificaciÃ³n utilizados en cada caso se deberÃ­an indicar mediante el uso de la propiedad â€œdatatypeâ€ del valor del identificador. El uso de la propiedad â€œdatatypeâ€ para especificar el esquema de notaciÃ³n utilizado estÃ¡ en consonancia con las buenas prÃ¡cticas recomendadas para el uso de la propiedad `skos:notation`, de la que esta propiedad es una especializaciÃ³n."@es,
        "Donne un identifiant, comme par exemple le numÃ©ro d'enregistrement d'une entreprise, qui peut Ãªtre utilisÃ© comme identifiant unique pour l'Organisation. De nombreux schÃ©mas nationaux et internationaux sont disponibles. Cette ontologie reste neutre par rapport au schÃ©ma utilisÃ©. Le schÃ©ma particulier utilisÃ© devrait Ãªtre indiquÃ© par le `datatype` de la valeur de l'identifiant. Utiliser les datatypes pour distinguer les schÃ©mas de notation est cohÃ©rent avec les bonnes pratiques pour `skos:notation` dont cette propriÃ©tÃ© est une spÃ©cialisation."@fr,
        "Indica un identificatore univoco per l'organizzazione, come ad esempio la partita IVA di un'azienda. Molti schemi di identificazione a livello nazionale e internazionale sono disponibili allo scopo. L'ontologia ORG Ã¨ neutrale rispetto allo schema da utilizzare. Lo schema di identificazione dovrebbe essere indicato dal datatype del valore dell'identificatore. L'uso del datatype per distinguere lo schema di identificazione Ã¨ coerente con le best practice per `skos:notation`, di cui questa proprietÃ  Ã¨ una specializzazione."@it,
        "çµ„ç¹”ã‚’ä¸€æ„ã«è­˜åˆ¥ã™ã‚‹ãŸã‚ã«ä½¿ç”¨ã§ãã‚‹ä¼šç¤¾ç™»éŒ²ç•ªå·ãªã©ã®è­˜åˆ¥å­ã‚’ä¸Žãˆã¾ã™ã€‚"@ja ;
    rdfs:domain org:Organization ;
    rdfs:isDefinedBy <http://www.w3.org/ns/org> ;
    rdfs:subPropertyOf skos:notation .

:HABD rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :LevelCrossing,
        :PrimaryLocation,
        :Signal,
        :Switch .

:KilometricPost rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :LevelCrossing,
        :PrimaryLocation,
        :Signal,
        :Switch .

:LinearPositioningSystem dcterms:replaces :LineReference .

:NationalRailwayLine a owl:Class ;
    rdfs:label "(deprecated) National railway line"@en ;
    dcterms:created "2021-01-25"^^xsd:date ;
    dcterms:modified "2021-08-03"^^xsd:date,
        "2024-11-29"^^xsd:date ;
    rdfs:comment """Railway line within a member state.
A line is a sequence of one or more sections of line, which connects operational points and which may consist of several tracks used for regular railway operation."""@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :InfrastructureElement ;
    owl:deprecated true ;
    owl:disjointWith :PrimaryLocation ;
    ns1:term_status "stable" .

:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/Contains> ;
    dcterms:created "2024-10-31"^^xsd:date ;
    rdfs:comment "Indicates that a subset with common characteristics contains a certain infrastructure element."@en ;
    rdfs:domain :CommonCharacteristicsSubset ;
    rdfs:isDefinedBy : ;
    rdfs:range :InfrastructureElement .

:infrastructureManager dcterms:replaces :infrastructureMgr .

:infrastructureMgr a owl:ObjectProperty ;
    rdfs:label "Infrastructure manager"@en ;
    dcterms:created "2022-07-07"^^xsd:date ;
    dcterms:isReplacedBy :infrastructureManager ;
    rdfs:comment "(deprecated) not in use. Relates any feature implemented in the European railway infrastructure with its infrastructure manager."@en ;
    rdfs:domain :InfrastructureElement ;
    rdfs:isDefinedBy : ;
    rdfs:range :InfrastructureManager ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:isPartOf a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "is part of"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/IsPartOf> ;
    dcterms:created "2024-05-24"^^xsd:date ;
    dcterms:modified "2025-01-30"^^xsd:date ;
    rdfs:comment """Indicates that an infrastructure element is a part of another (distinct) infrastructure element.
An element cannot be part of itself.
This property is the inverse of era:hasPart and represents the partial or whole-part relationship between infrastructure elements."""@en ;
    rdfs:domain :InfrastructureElement ;
    rdfs:isDefinedBy : ;
    rdfs:range :InfrastructureElement .

