        "2025-02-28"^^xsd:date ;
    dcterms:relation :contactLineSystemType ;
    rdfs:comment "Indication of the maximum contact wire height expressed in metres."@en ;
    rdfs:domain [ ],
        [ ],
        [ ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf :contactLineSystemDataParameter,
        :vehicleTypeTechnicalDataCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote """The value given can be design value or the last known measured value. If there is no change in height, nominal value will be given.

Values shall be given in metres with precision of 0.01 m."""@en .

:maximumInterferenceCurrent rdfs:range xsd:double .

:maximumTrainDeceleration a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum train deceleration"@en ;
    :XMLName "ILR_MaxDeceleration" ;
    :applicable "Y/N" ;
    :dependencyNote "Not applicable if line is not in scope of INF TSI"@en ;
    :formatNote "N.N" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.1.6.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumTrainDeceleration> ;
    :unitOfMeasure <http://qudt.org/vocab/unit/M-PER-SEC2> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-10"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
    rdfs:comment "Limit for longitudinal track resistance given as a maximum allowed train deceleration and expressed in metres per square second."@en ;
    rdfs:domain [ ],
        [ ],
        [ ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:double ;
    rdfs:seeAlso "INF TSI: 4.2.6" ;
    rdfs:subPropertyOf :trackResistanceToAppliedLoadsDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """New lines are assumed to be compliant with the TSI INF.
For TSI compliant lines the default value of 2.5 m/s2 shall be presented.

If for the design of the track the braking forces were assumed on basis of the deceleration lower value than 2.5 m/s2, the applied value of the deceleration has to be specified."""@en .

