:maximumContactWireHeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum contact wire height"@en ;
    :XMLName "ECS_MaxWireHeight" ;
    :applicable "Y/N" ;
    :dependencyNote "Mandatory only if â€œOverhead contact line (OCL)â€ is selected in 1.1.1.2.2.1.1, otherwise the parameter is not applicable."@en ;
    :eratvIndex "4.10.5" ;
    :formatNote "N.NN" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.2.2.5" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumContactWireHeight>,
        <http://data.europa.eu/949/shapes/MaximumContactWireHeightApplicability> ;
    :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
