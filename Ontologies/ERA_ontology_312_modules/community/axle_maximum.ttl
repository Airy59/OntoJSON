:hasLRS a owl:ObjectProperty ;
    rdfs:label "has linear referencing system"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasLrsCoordinate> ;
    dcterms:created "2024-11-29"^^xsd:date ;
    dcterms:modified "2025-03-10"^^xsd:date ;
    rdfs:comment "Specifies the linear referencing system to which the kilometre post is referenced. The linear referencing system is commonly the main railway line and it provides the framework for identifying the post's location along the railway line, using distance measurements rather than geographical coordinates."@en ;
    rdfs:domain :KilometricPost ;
    rdfs:isDefinedBy : ;
    rdfs:range :LinearPositioningSystem .

:hasLrsCoordinate a owl:ObjectProperty ;
    rdfs:label "has line referencing system coordinate"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasLrsCoordinate> ;
    dcterms:created "2024-11-29"^^xsd:date ;
    rdfs:comment "Specifies the LRS coordinate associated with a topological coordinate."@en ;
    rdfs:domain :NetPointReference ;
    rdfs:isDefinedBy : ;
    rdfs:range :LinearPositioningSystemCoordinate .

:hotAxleBoxDetectorDirection a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Direction of measurement of trackside HABD"@en ;
    :XMLName "IHS_HABDDirection" ;
    :applicable "Y/N" ;
    :dependencyNote "Mandatory if the HABD is not TSI compliant (the value of parameter 1.1.1.1.7.5 (Trackside HABD TSI compliant) is 'False')"@en ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/hot-axle-box-detector-direction/HotAxleBoxDetectorDirections> ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.1.7.9" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HotAxleBoxDetectorDirection>,
        <http://data.europa.eu/949/shapes/HotAxleBoxDetectorDirectionApplicability>,
        <http://data.europa.eu/949/shapes/HotAxleBoxDetectorDirectionSKOS> ;
    :usedInRCCCalculations true ;
    dcterms:created "2022-07-08"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2025-02-20"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    rdfs:comment "Direction of measurement of trackside HABD, specific for the French Italian and Swedish networks."@en ;
    rdfs:domain :HABD ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf :healthSafetyAndEnvironmentObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "This property was previously a datatype property with domain Track and range string. As its values are a list of three predefined values, it is now a SKOS."@en ;
    skos:scopeNote """Specific for the French Italian and Swedish networks.
Applicable if trackside HABD is not TSI compliant, direction of measurement of trackside hot axle box detector.
If the direction of measurement is:
-	the same as the direction defined by the start and end of the SoL: (N)
-	the opposite to the direction defined by the start and end of the SoL: (O)
-	both directions: (B)"""@en .

:hotAxleBoxDetectorGeneration a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Generation of trackside HABD"@en ;
    :XMLName "IHS_HABDGen" ;
    :applicable "Y/N" ;
    :dependencyNote "Mandatory if the HABD is not TSI compliant (the value of parameter 1.1.1.1.7.5 (Trackside HABD TSI compliant) is 'False')"@en ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.1.7.7" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HotAxleBoxDetectorGeneration>,
        <http://data.europa.eu/949/shapes/HotAxleBoxDetectorGenerationApplicability> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-11"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    rdfs:comment """Specific for the French Italian and Swedish networks.
Generation of trackside hot axle box detector."""@en ;
    rdfs:domain :HABD ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Waiting provision of possible answers by the French, Italian and Swedish NREs "@en .

:hotAxleBoxDetectorIdentification a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Identification of trackside HABD"@en ;
    :XMLName "IHS_HABDID" ;
    :applicable "Y/N" ;
    :dependencyNote "Mandatory if the HABD is not TSI compliant (the value of parameter 1.1.1.1.7.5 (Trackside HABD TSI compliant) is 'False')"@en ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.1.7.6" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HotAxleBoxDetectorIdentification>,
        <http://data.europa.eu/949/shapes/HotAxleBoxDetectorIdentificationApplicability> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-11"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    rdfs:comment """Specific for the French, Italian and Swedish networks.
Applicable if trackside HABD is not TSI compliant, identification of trackside hot axle box detector."""@en ;
    rdfs:domain :HABD ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
    ns1:term_status "stable" .

:hotAxleBoxDetectorLocation a owl:DatatypeProperty ;
    rdfs:label "Railway location of trackside HABD"@en ;
    :XMLName "IHS_HABDLoc" ;
    :applicable "Y/N" ;
    :dependencyNote "Mandatory if the HABD is not TSI compliant (the value of parameter 1.1.1.1.7.5 (Trackside HABD TSI compliant) is 'False')"@en ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.1.7.8" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HotAxleBoxDetectorLocation>,
        <http://data.europa.eu/949/shapes/HotAxleBoxDetectorLocationApplicability> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-11"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    rdfs:comment """Specific for the French Italian and Swedish networks.
Applicable if trackside HABD is not TSI compliant, localisation of trackside hot axle box detector."""@en ;
    rdfs:domain :HABD ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """The location (generally the distance from the origin of the line to the point of interest) on a line is given in kilometres with decimals (precision of 0.001).

It may be also possible to provide the location of the HABD as an era:netReference property for the HABD pointing to an era:NetPointReference with (at least)era:LinearPositioningSystemCoordinate"""@en .

:hotAxleBoxDetectorTSICompliant a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Trackside HABD TSI compliant"@en ;
    :XMLName "IHS_TSIHABD" ;
    :applicable "Y" ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.1.7.5" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/HotAxleBoxDetectorTSICompliant> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-11"^^xsd:date ;
    rdfs:comment """Specific for the French, Italian and Swedish networks.
Trackside HABD compliant to TSI means that the HABD Trackside is compliant with:
- EN 15437-1:2009 referred in TSIs (LOC&PAS: 4.2.3.3.2.2, WAG TSI: 4.2.3.4),
- Specific cases mentioned in TSIs (LOC&PAS TSI, WAG TSI)."""@en ;
    rdfs:domain :HABD ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """TSI LOC&PAS: 4.2.3.3.2.2, and 7.3.2.3
WAG TSI: 4.2.3.4 and 7.3.2.2
EN 15437-1:2009""" ;
    rdfs:subPropertyOf :healthSafetyAndEnvironmentDataParameter ;
    ns1:term_status "stable" .

:kilometer a owl:DatatypeProperty ;
    rdfs:label "kilometer number"@en ;
    :XMLName "OPRailwayLocation" ;
    :applicable "Y/N" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.2.0.0.0.6" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/Kilometer> ;
    :tsiOPEAppendixD2Index "2.2.2" ;
    :unitOfMeasure <http://qudt.org/vocab/unit/KiloM> ;
    dcterms:created "2021-01-29"^^xsd:date ;
    dcterms:modified "2021-01-29"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2024-10-24"^^xsd:date,
        "2025-01-30"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Kilometer number of the kilometric post related to line identification defining the location of an infrastructure element."@en ;
    rdfs:domain :KilometricPost ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf :signalDataParameter,
        :tunnelDataParameter ;
    ns1:term_status "stable" ;
    skos:altLabel "Railway location of Operational point"@en ;
    skos:scopeNote """For walkways: Value provided in Kilometric point of the start of the walkway and the length in m. Repeatable values for each location.
For rescue points: Value provided in Kilometric point of the start of the point of evacuation and rescue point and the length in m. Repeatable values for each location.
For signals: Relative position to the line identified under parameter 1.1.0.0.0.2, given in km ([reference point, via era:referent] / [NNN.NNN] )."""@en .

