    :dependencyNote "This information is to be linked with parameter 1.1.1.1.2.4.4"@en ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.1.2.4.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/StructureCheckLocation> ;
    :usedInRCCCalculations true ;
