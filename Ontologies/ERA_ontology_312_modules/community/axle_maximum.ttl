    rdfs:comment "Indication of the maximum contact wire height expressed in metres."@en ;
    rdfs:domain [ ],
        [ ],
        [ ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf :contactLineSystemDataParameter,
        :vehicleTypeTechnicalDataCharacteristic ;
