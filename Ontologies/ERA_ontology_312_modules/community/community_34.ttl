@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:gaugingProfile rdfs:subPropertyOf :lineLayoutObjParameter .

:gaugingTransversalDocument rdfs:subPropertyOf :lineLayoutObjParameter .

:profileNumberSemiTrailers rdfs:subPropertyOf :lineLayoutObjParameter .

:profileNumberSwapBodies rdfs:subPropertyOf :lineLayoutObjParameter .

:standardCombinedTransportContainers rdfs:subPropertyOf :lineLayoutObjParameter .

:standardCombinedTransportRollerUnits rdfs:subPropertyOf :lineLayoutObjParameter .

:lineLayoutObjParameter a owl:ObjectProperty ;
    rdfs:label "Line layout"@en ;
    :rinfIndex "1.1.1.1.3",
        "1.2.1.0.3" ;
    dcterms:created "2024-10-31"^^xsd:date ;
    rdfs:isDefinedBy : ;
    rdfs:subPropertyOf :infraSubsystemObjParameter .

