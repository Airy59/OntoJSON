:maximumBrakeThermalEnergyCapacity a owl:DatatypeProperty ;
    rdfs:label "Maximum brake thermal energy capacity"@en ;
    :eratvIndex "4.7.2.1.6" ;
    :unitOfMeasure <http://qudt.org/vocab/unit/KiloJ> ;
