    dcterms:modified "2023-01-20"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    rdfs:comment "Information of the train access level for which the boarding aid can be used."@en ;
    rdfs:domain [ ],
        [ ],
        [ ],
        [ ],
        [ ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :platformDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Information of the train access level for which the boarding aid can be used. Data is presented as the vertical difference that is overcome by the platform boarding aid in millimetres. The value â€œ0â€ means that the platform is not equipped with a platform boarding aid."@en .

:cantDefficiency a owl:DatatypeProperty ;
    rdfs:label "Cant defficiency"@en ;
    :eratvIndex "4.6.1" ;
    :unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
    dcterms:created "2021-08-26"^^xsd:date ;
    dcterms:modified "2021-08-26"^^xsd:date,
        "2024-06-26"^^xsd:date,
        "2025-03-05"^^xsd:date ;
    rdfs:comment "Cant deficiency (maximum uncompensated lateral acceleration) for which the vehicle has been assessed. For dual gauge vehicles values for each gauge have to be indicated."@en ;
    rdfs:domain :VehicleType ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :vehicleTypeTechnicalDataCharacteristic ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:cantDeficiency a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Cant deficiency"@en ;
    :XMLName "ITP_CantDeficiency" ;
    :applicable "Y" ;
    :formatNote "+/-NNN" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.1.4.2" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/CantDeficiency> ;
    :unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-10"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
    rdfs:comment "Maximum cant deficiency expressed in millimetres defined as difference between the applied cant and a higher equilibrium cant the line has been designed for."@en ;
    rdfs:domain [ ],
        [ ],
        [ ],
        [ ],
        [ ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso "INF TSI: 4.2.4.3" ;
    rdfs:subPropertyOf :trackDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "In case of positive value of cant deficiency or zero symbol  '+' shall be applied. In case of negative cant deficiency symbol '-' has to be selected. Value of the cant deficiency shall be given in millimetres. In case of lateral uncompensated acceleration on a 1435 mm track gauge of 1.0 m/s2 the value of 153 mm may be published."@en .

:contactStripMaterialMetallicContent a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Contact strip material metallic content"@en ;
    :XMLName "EPA_StripMaterial" ;
    :dependencyNote "Mandatory only if impregnated carbon ([NN] % of metallic content)â€ is selected in 1.1.1.2.3.4, otherwise no value should be provided"@en ;
