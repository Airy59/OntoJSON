    dcterms:source <http://data.europa.eu/eli/reg/2014/1302/2023-09-28> ;
    rdfs:comment "Indication of max. percentage of contact strip material Impregnated Carbon permitted to be used." ;
    rdfs:domain [ ],
        [ ],
        [ ],
        [ ],
        [ ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso "LOC&PAS TSI: 4.2.8.2.9.4.2" ;
    rdfs:subPropertyOf :pantographDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "In case that the value of the property era:contactStripMaterial is \"impregnated carbon\", it is the metallic content in % (this value must be added). This is the maximum percentage allowed."@en .

:crossSectionArea a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Cross section area"@en ;
    :XMLName "ITU_CrossSectionArea" ;
    :applicable "Y/N" ;
    :dependencyNote "Mandatory if the speed of the line is equal or greater than 200km/h "@en ;
    :formatNote "NNN" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.1.8.8" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/CrossSectionAreaApplicability>,
        <http://data.europa.eu/949/shapes/CrossSectionAreaT> ;
    :unitOfMeasure <http://qudt.org/vocab/unit/M2> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2021-08-03"^^xsd:date,
        "2024-09-19"^^xsd:date ;
