@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:frequencyBandsForDetection dcterms:relation :tdsMaximumMagneticField .

:maximumMagneticFieldDirectionX a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum magnetic field direction X"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumMagneticFieldDirectionX> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-09-19"^^xsd:date ;
    dcterms:relation :trainDetectionSystemType ;
    rdfs:comment "The maximum magnetic field limits allowed for axle counters (in dB ÂµA/m) for a defined frequency band. Direction X."@en ;
    rdfs:domain :MaximumMagneticField ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    ns1:term_status "stable" ;
    skos:scopeNote "The maximumMagneticFieldDirectionX parameter is only applicable for axle counters."@en .

:maximumMagneticFieldDirectionY a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum magnetic field direction Y"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumMagneticFieldDirectionY> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-09-19"^^xsd:date ;
    dcterms:relation :trainDetectionSystemType ;
    rdfs:comment "The maximum magnetic field limits allowed for axle counters (in dB ÂµA/m) for a defined frequency band. Direction Y."@en ;
    rdfs:domain :MaximumMagneticField ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    ns1:term_status "stable" ;
    skos:scopeNote "The maximumMagneticFieldDirectionY parameter is only applicable for axle counters."@en .

:maximumMagneticFieldDirectionZ a owl:DatatypeProperty ;
    rdfs:label "Maximum magnetic field direction Z"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumMagneticFieldDirectionZ> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-09-19"^^xsd:date ;
    dcterms:relation :trainDetectionSystemType ;
    rdfs:comment "The maximum magnetic field limits allowed for axle counters (in dB ÂµA/m) for a defined frequency band. Direction Z."@en ;
    rdfs:domain :MaximumMagneticField ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    ns1:term_status "stable" ;
    skos:scopeNote "The maximumMagneticFieldDirectionZ parameter is applicable for axle counters."@en .

:tdsMaximumMagneticField a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Maximum magnetic field"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "Mandatory for train detection systems based on axle counters"@en ;
    :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        """For train detection system compliant with TSIs, 12 months after publication of Article 7 Guide.
For train detection system not TSI compliant: in relation to article 13 of TSI CCS"""@en ;
    :rinfIndex "1.1.1.3.4.2.3",
        "1.2.1.1.3.2.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TdsMaximumMagneticField>,
        <http://data.europa.eu/949/shapes/TdsMaximumMagneticFieldApplicability> ;
    :usedInRCCCalculations true ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation :trainDetectionSystemType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/2023-09-08> ;
    rdfs:comment """The maximum magnetic field limits allowed for axle counters (in dB ÂµA/m) for a defined frequency band.
It should be provided in 3 directions."""@en ;
    rdfs:domain :TrainDetectionSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range :MaximumMagneticField ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index077_-_ERA_ERTMS_033281_v5.pdf"^^xsd:anyURI ;
    rdfs:subPropertyOf :trainDetectionSystemBasedFrequencyBandsObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Relates the Axle Counter TrainDetectionSystem with its MaximumMagneticField in (X,Y,Z). Verification of compliance with TSI includes application of notified national rules (when they exist)."@en .

:MaximumMagneticField a owl:Class ;
    rdfs:label "Maximum magnetic field"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumMagneticFieldShape> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:relation :trainDetectionSystemType ;
    rdfs:isDefinedBy : ;
    ns1:term_status "stable" .

