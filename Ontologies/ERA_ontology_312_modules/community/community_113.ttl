@prefix : <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:compositeBrakeBlockRetrofitted rdfs:subPropertyOf :vehicleTechnicalDataCharacteristic .

:vehicleNumber rdfs:subPropertyOf :vehicleTechnicalDataCharacteristic .

:vehicleSeries rdfs:subPropertyOf :vehicleTechnicalDataCharacteristic .

:vehicleTechnicalDataCharacteristic a owl:DatatypeProperty ;
    rdfs:label "Vehicle technical characteristic"@en ;
    rdfs:isDefinedBy : .

