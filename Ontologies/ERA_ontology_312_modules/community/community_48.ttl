@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:nationalLine rdfs:subPropertyOf :solGenericObjParameter .

:opEnd rdfs:subPropertyOf :solGenericObjParameter .

:opStart rdfs:subPropertyOf :solGenericObjParameter .

:solNature rdfs:subPropertyOf :solGenericObjParameter .

:solGenericObjParameter a owl:ObjectProperty ;
    rdfs:label "Section of line generic information"@en ;
    :rinfIndex "1.1.0.0.0" ;
    dcterms:created "2025-03-11"^^xsd:date ;
    rdfs:isDefinedBy : ;
    rdfs:subPropertyOf :rinfTechnicalObjectCharacteristic .

