@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:conditionalRegenerativeBrake rdfs:subPropertyOf :trackObjParameter .

:eddyCurrentBraking rdfs:subPropertyOf :trackObjParameter .

:railInclination rdfs:subPropertyOf :trackObjParameter .

:wheelSetGauge rdfs:subPropertyOf :trackObjParameter .

:trackObjParameter a owl:ObjectProperty ;
    rdfs:label "Track parameters"@en ;
    :rinfIndex "1.1.1.1.4",
        "1.2.1.0.4" ;
    dcterms:created "2024-10-31"^^xsd:date ;
    rdfs:isDefinedBy : ;
    rdfs:subPropertyOf :infraSubsystemObjParameter .

