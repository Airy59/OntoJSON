@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:existenceOfIndustrialRisk rdfs:subPropertyOf :routeBookDataParameter .

:routeBookDataParameter a owl:DatatypeProperty ;
    rdfs:label "Route book specific parameters"@en ;
    :rinfIndex "1.1.0.0.1" ;
    dcterms:created "2025-01-30"^^xsd:date ;
    rdfs:isDefinedBy : ;
    rdfs:subPropertyOf :rinfTechnicalDataCharacteristic .

