:InfrastructureManager dcterms:isReplacedBy :Body .

:imCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Infrastructure manager (IM)'s code"@en ;
    dcterms:created "2021-08-02"^^xsd:date ;
    dcterms:isReplacedBy :organisationCode ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-06-03"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2024-10-30"^^xsd:date,
        "2024-11-12"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/dec_impl/2018/1614>,
        <http://data.europa.eu/eli/dir/2012/34/oj>,
        <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment """Infrastructure manager means any body or firm responsible in particular for establishing, managing and maintaining railway infrastructure, including traffic management and control-command signalling;
the functions of the infrastructure manager on a network or part of a network may be allocated to different bodies or firms. Definition in (Article 3(2))"""@en ;
    rdfs:domain :OrganisationRole ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "https://eur-lex.europa.eu/eli/dir/2012/34/oj#d1e885-32-1"^^xsd:anyURI ;
    rdfs:subPropertyOf dcterms:identifier ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:infrastructureManager a owl:ObjectProperty ;
    rdfs:label "infrastructure manager"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/InfrastructureManagerSKOSValue> ;
    dcterms:created "2024-10-24"^^xsd:date ;
    dcterms:modified "2025-03-10"^^xsd:date ;
    dcterms:replaces :infrastructureMgr ;
    rdfs:comment "Relates a subset with common characteristics with its IM, represented by an instance of organisation role that points to the \"infrastructure manager\" concept in the taxonomy."@en ;
    rdfs:domain [ ],
        [ ],
        [ ] ;
    rdfs:isDefinedBy : ;
    rdfs:range :OrganisationRole ;
    ns1:term_status "stable" .

:infrastructureMgr dcterms:isReplacedBy :infrastructureManager .

:manufacturer a owl:ObjectProperty ;
    rdfs:label "manufactured by"@en ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2020-11-19"^^xsd:date,
        "2024-06-03"^^xsd:date,
        "2024-10-24"^^xsd:date,
        "2025-02-18"^^xsd:date ;
    dcterms:replaces :Manufacturer ;
    rdfs:comment "Vehicle manufacturer company."@en ;
    rdfs:domain :VehicleType ;
    rdfs:isDefinedBy : ;
    rdfs:range :OrganisationRole ;
    rdfs:subPropertyOf :vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" .

:organisationCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "organisation code" ;
    :XMLName "OPSidingIMCode",
        "OPSidingTunnelIMCode",
        "OPTrackIMCode",
        "OPTrackPlatformIMCode",
        "OPTrackTunnelIMCode",
        "SOLIMCode",
        "SOLTunnelIMCode" ;
    :applicable "Y" ;
    :formatNote "AAAA" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.0.0.0.1",
        "1.1.1.1.8.1",
        "1.2.1.0.0.1",
        "1.2.1.0.5.1",
        "1.2.1.0.6.1",
        "1.2.2.0.0.1",
        "1.2.2.0.5.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/OrganisationCode> ;
    :tsiOPEAppendixD2Index "1.1" ;
    dcterms:created "2024-06-03"^^xsd:date ;
    dcterms:modified "2024-11-06"^^xsd:date,
        "2024-11-12"^^xsd:date,
        "2025-02-18"^^xsd:date,
        "2025-03-08"^^xsd:date ;
    dcterms:replaces :imCode ;
    dcterms:source <http://data.europa.eu/eli/dec_impl/2018/1614>,
        <http://data.europa.eu/eli/dir/2012/34/oj>,
        <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment """Four alpha-numeric code allocated by ERA to a body. It represents the Infrastructure Manager (IM) code in RINF.
Infrastructure manager means any body or firm responsible in particular for establishing, managing and maintaining railway infrastructure, including traffic management and control-command signalling;
the functions of the infrastructure manager on a network or part of a network may be allocated to different bodies or firms. Definition in (Article 3(2))"""@en,
        "Infrastructure manager means any body or undertaking that is responsible in particular for establishing and maintaining railway infrastructure or a part thereof."@en ;
    rdfs:domain :OrganisationRole ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "https://eur-lex.europa.eu/eli/dir/2012/34/oj#d1e885-32-1"^^xsd:anyURI ;
    rdfs:subPropertyOf :platformDataParameter,
        :sidingDataParameter,
        :solGenericDataParameter,
        :trackGenericDataParameter,
        :tunnelDataParameter,
        dcterms:identifier ;
    skos:altLabel "IM's code"@en ;
    skos:example """Simplified example:
:ABCD_IM rdf:type era:OrganisationRole;
	era:hasOrganisationRole era-skos:InfrastructureManager.
	era:organisationCode "ABCD".

:0000_IM rdf:type era:OrganisationRole;
	era:hasOrganisationRole era-skos:InfrastructureManager.
	era:organisationCode "0000".

:imNetwork rdf:type era:SubsetWithCommonCharacteristics;
	era:infrastructureManager :ABCD_IM.
#IM code parameter as a common characteristic
:track1 rdf:type era:Track;
	era:belongsTo :imNetwork.
#IM Code parameter - directly attached to a track
:track2 rdf:type era:Track;
	era:infrastructureManager :0000_IM.""" ;
    skos:scopeNote """The Code is a unique identifier for the Infrastructure Manager and it shall be verified on national level.
- If the IM is subject to TAF/TAP TSIs, it corresponds to the code used in TAF/TAP TSIs.
- In other cases, it corresponds to the "organisation code" assigned by the Agency for the specific needs of the RINF.
Each Section of Line shall concern only one IM.
To be able to follow the "only once" principle, the infrastructure manager code is a property of the organisation having the role of infrastructuer manager. For data provision, a subset of elements with common characteristics should be created with the era:infrastructureManager property having as value the instance of the infrastructure mananger role."""@en .

:roleOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "role of"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/RoleOf> ;
    dcterms:created "2024-10-24"^^xsd:date ;
    rdfs:comment "Indicates the corresponding Body that plays a certain organisation role."@en ;
    rdfs:domain :OrganisationRole ;
    rdfs:isDefinedBy : ;
    rdfs:range :Body .

:vehicleKeeper a owl:ObjectProperty ;
    rdfs:label "vehicle keeper"@en ;
    dcterms:created "2020-11-23"^^xsd:date ;
    dcterms:modified "2024-06-03"^^xsd:date,
        "2024-10-24"^^xsd:date,
        "2025-02-18"^^xsd:date ;
    dcterms:replaces :VehicleKeeper ;
    rdfs:comment """The natural or legal person that, being the owner of a vehicle or having the right to use it,
exploits the vehicle as a means of transport and is registered as such in a vehicle register referred to in Article 47 of (EU)2016/797."""@en ;
    rdfs:domain :Vehicle ;
    rdfs:isDefinedBy : ;
    rdfs:range :OrganisationRole ;
    rdfs:subPropertyOf :vehicleTechnicalObjCharacteristic ;
    ns1:term_status "stable" .

:Manufacturer dcterms:isReplacedBy :Body,
        :manufacturer .

:VehicleKeeper dcterms:isReplacedBy :Body,
        :vehicleKeeper .

:Body a owl:Class ;
    rdfs:label "Body"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/BodyRoleShape> ;
    dcterms:created "2024-06-03"^^xsd:date ;
    dcterms:modified "2025-02-18"^^xsd:date ;
    dcterms:replaces :InfrastructureManager,
        :Manufacturer,
        :VehicleKeeper ;
    rdfs:comment "Is an organisation or a physical person"@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf [ ],
        [ ],
        [ ] ;
    owl:disjointWith :InfrastructureElement,
        :OrganisationRole .

:OrganisationRole a owl:Class ;
    rdfs:label "Organisation Role"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/OrganisationRoleShape> ;
    rdfs:comment "Represents an n-ary relationship between a Body and a role"@en ;
    rdfs:isDefinedBy : .

:Vehicle a owl:Class ;
    rdfs:label "Vehicle"@en ;
    dcterms:created "2020-11-22"^^xsd:date ;
    dcterms:modified "2020-11-22"^^xsd:date ;
    rdfs:comment "A specific vehicle or wagon able and allowed to operate over railway infrastructure."@en ;
    rdfs:isDefinedBy : ;
    owl:disjointWith :VehicleType ;
    ns1:term_status "stable" .

