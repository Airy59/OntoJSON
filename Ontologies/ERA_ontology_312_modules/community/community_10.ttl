    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :vehicleTypeTechnicalDataCharacteristic ;
    ns1:term_status "stable" .

:vehicleTypeMaximumSpeedAndCantDeficiency a owl:ObjectProperty ;
    rdfs:label "Vehicle type maximum speed and cant deficiency"@en ;
    :eratvIndex "4.6.4" ;
    dcterms:created "2023-04-05"^^xsd:date ;
    dcterms:modified "2025-02-18"^^xsd:date ;
    dcterms:replaces :maximumSpeedAndCantDeficiency ;
    rdfs:comment "Relates the vehicle type with its values of maximum speed and cant deficiency."@en ;
    rdfs:domain :VehicleType ;
    rdfs:isDefinedBy : ;
    rdfs:range :MaximumSpeedAndCantDeficiency ;
    rdfs:subPropertyOf :vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" .

:temperatureRange dcterms:replaces :maximumTemperature,
        :minimumTemperature .

:MinimumVerticalRadius a owl:Class ;
    rdfs:label "Minimum radius of vertical curve"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MinimumVerticalRadiusShape> ;
    dcterms:created "2021-12-12"^^xsd:date ;
    rdfs:isDefinedBy : ;
    ns1:term_status "stable" ;
    skos:scopeNote "Presentation of parameter 1.2.2.0.3.3 'Minimum radius of vertical curve'"@en .

:MaximumMagneticField a owl:Class ;
    rdfs:label "Maximum magnetic field"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumMagneticFieldShape> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:relation :trainDetectionSystemType ;
    rdfs:isDefinedBy : ;
    ns1:term_status "stable" .

:MaximumSpeedAndCantDeficiency a owl:Class ;
    rdfs:label "Maximum speed and cant deficiency"@en ;
    dcterms:created "2023-04-05"^^xsd:date ;
    dcterms:modified "2025-02-18"^^xsd:date ;
    dcterms:replaces :maximumSpeedAndCantDeficiency ;
    rdfs:comment "Combination of maximum speed and maximum cant deficiency for which the vehicle was assessed."@en ;
    rdfs:isDefinedBy : ;
    ns1:term_status "stable" .

:RaisedPantographsDistanceAndSpeed a owl:Class ;
    rdfs:label "Requirements for number of raised pantographs and spacing between them, at the given speed"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/RaisedPantographsDistanceAndSpeedShape> ;
    dcterms:created "2023-04-05"^^xsd:date ;
    rdfs:comment """Indication of maximum number of raised pantographs per train allowed and minimum spacing centre line to centre line of adjacent pantograph heads, expressed in metres, at the given speed.
Each track can have several raised pantographs per train allowed (structured) values, and each one has values for number of pantographs, minimum distance between pantographs, in metres, and speed considered in km/h."""@en ;
    rdfs:isDefinedBy : ;
    ns1:term_status "stable" ;
    skos:scopeNote """This class gives the information about the number of pantographs and the distance between them at a given speed for which the Overhead Contact Line (OCL) has been designed.
As for different speeds different combinations of number of pantographs and distance between them may exist, so this class can be repeated to present all of them."""@en .

:maximumSpeedAndCantDeficiency dcterms:isReplacedBy :MaximumSpeedAndCantDeficiency,
        :vehicleTypeMaximumCantDeficiency,
        :vehicleTypeMaximumSpeed,
        :vehicleTypeMaximumSpeedAndCantDeficiency ;
    rdfs:domain :VehicleType .

:VehicleType a owl:Class ;
    rdfs:label "Vehicle Type"@en ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2020-07-29"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-06-03"^^xsd:date ;
    rdfs:comment """A vehicle type that has been authorized to operate on the EU railway infrastructure. Type means a vehicle type defining the basic design characteristics of the vehicle as covered by a type or design examination certificate described in the relevant verification module.

Basic design characteristics means the parameters that are used to identify the vehicle type as specified in the issued vehicle type authorisation and recorded in the European Register of Authorised Vehicle Types ('ERATV').

The above mentioned certificate should be documented using era:certificate.
"""@en ;
    rdfs:isDefinedBy : ;
    ns1:term_status "stable" .

