@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

geo:asWKT a owl:DatatypeProperty ;
    rdfs:label "asWKT"@en ;
    :applicable "Y/N/NYA" ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.0.0.1.1",
        "1.1.1.0.1.1",
        "1.1.1.3.14.6",
        "1.2.0.0.0.5",
        "1.2.1.0.8.5" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/AsWKT> ;
    :tsiOPEAppendixD2Index "2.1.1",
        "2.1.2",
        "2.2.2",
        "3.2.5" ;
    dcterms:contributor "Matthew Perry" ;
    dcterms:creator "OGC GeoSPARQL 1.0 Standard Working Group" ;
    dcterms:date "2011-06-16"^^xsd:date ;
    rdfs:comment """
      The WKT serialization of a geometry
    """@en,
        "Well Known Text line string representing the geographical shape of the track"@en,
        "Well Known Text polygonal shape"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql>,
        <http://www.opengis.net/spec/geosparql/1.0> ;
    rdfs:seeAlso "ERA - TWG Route Book" ;
    skos:altLabel "Accurate geographical description"@en,
        "Industrial risks   locations where it is dangerous for the driver to step out"@en ;
    skos:definition """
      The WKT serialization of a geometry
    """@en ;
    skos:prefLabel "asWKT"@en .

