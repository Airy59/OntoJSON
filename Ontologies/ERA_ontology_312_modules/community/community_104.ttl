@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:complianceInfTsi rdfs:subPropertyOf :tunnelDataParameter .

:crossSectionArea rdfs:subPropertyOf :tunnelDataParameter .

:demonstrationSRT rdfs:subPropertyOf :tunnelDataParameter .

:dieselThermalAllowed rdfs:subPropertyOf :tunnelDataParameter .

:hasEmergencyPlan rdfs:subPropertyOf :tunnelDataParameter .

:hasEvacuationAndRescuePoints rdfs:subPropertyOf :tunnelDataParameter .

:hasWalkway rdfs:subPropertyOf :tunnelDataParameter .

:kilometer rdfs:subPropertyOf :tunnelDataParameter .

:lengthOfTunnel rdfs:subPropertyOf :tunnelDataParameter .

:nationalRollingStockFireCategory rdfs:subPropertyOf :tunnelDataParameter .

:organisationCode rdfs:subPropertyOf :tunnelDataParameter .

:tunnelIdentification rdfs:subPropertyOf :tunnelDataParameter .

:verificationSRT rdfs:subPropertyOf :tunnelDataParameter .

:tunnelDataParameter a owl:DatatypeProperty ;
    rdfs:label "Tunnel"@en ;
    :rinfIndex "1.1.1.1.8",
        "1.2.1.0.5",
        "1.2.2.0.5" ;
    dcterms:created "2024-10-31"^^xsd:date ;
    rdfs:isDefinedBy : ;
    rdfs:subPropertyOf :infraSubsystemDataParameter .

