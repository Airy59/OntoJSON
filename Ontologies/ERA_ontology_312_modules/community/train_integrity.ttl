@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:trainIntegrityOnBoardRequired a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Train integrity confirmation from on-board (not from driver) necessary for line access"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "A value has to be provided when ETCS Level 2 is present, ETCS Baseline > 4 MR1 and IM confirms train integrity function is required)."@en,
        "Parameter only applicable when ETCS Baseline > 4 MR1 with operation requiring train integrity."@en ;
    :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "16 January 2020"@en ;
    :rinfIndex "1.1.1.3.2.8",
        "1.2.1.1.1.8" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrainIntegrityOnBoardRequired> ;
    :tsiOPEAppendixD2Index "3.4.11" ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-31"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Indication whether train confirmation from on-board is required to access the line for safety reasons."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "N" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "Optional" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "Y" ;
                                    rdf:rest () ] ] ] ],
        [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "N" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "Optional" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "Y" ;
                                    rdf:rest () ] ] ] ],
        [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "N" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "Optional" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "Y" ;
                                    rdf:rest () ] ] ] ],
        [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "N" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "Optional" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "Y" ;
                                    rdf:rest () ] ] ] ],
        [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "N" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "Optional" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "Y" ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """In hybrid operation, the confirmation can be optional.
See also: TSI CCS BDC 4.2.2 (Managing information about the completeness of the train (not from driver))"""@en .

