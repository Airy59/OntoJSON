:tdsMaximumMagneticField rdfs:subPropertyOf :trainDetectionSystemBasedFrequencyBandsObjParameter .

:trainDetectionSystemBasedFrequencyBandsObjParameter a owl:ObjectProperty ;
    rdfs:label "Train detection systems defined based on frequency bands"@en ;
    :rinfIndex "1.1.1.3.4",
        "1.2.1.1.3" ;
    dcterms:created "2024-10-31"^^xsd:date ;
    rdfs:isDefinedBy : ;
    rdfs:subPropertyOf :ccsSubsystemObjParameter .

