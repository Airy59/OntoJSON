@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:etcsTransmitsTrackConditions a owl:DatatypeProperty ;
    rdfs:label "Is the ETCS trackside engineered to transmit Track Conditions"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.3.2.12",
        "1.2.1.1.1.12" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsTransmitsTrackConditions>,
        <http://data.europa.eu/949/shapes/EtcsTransmitsTrackConditionsApplicability> ;
    :tsiOPEAppendixD3Index "1.1" ;
    dcterms:created "2022-11-04"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation :etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment """If the trackside does not provide Track Conditions, the driver will need to be informed about such conditions via alternative methods.
According to the specification referenced in Appendix A-1, index [C]"""@en ;
    rdfs:domain :ETCS ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
    rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """According to the specification referenced in Appendix A-1, index [C]
If the trackside does not provide Track Conditions, the driver will need to be informed about such conditions via alternative methods.
In ETCS level NTC and level 0 track conditions are not managed (at least in Baseline 2)
See: TSI CCS (Subset-026, Chapter 5, section 5.18)"""@en .

:etcsMVersion a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "ETCS M_version"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-m-versions/ETCSMVersions> ;
    :legalDeadline "1 January 2021"@en,
        "12 months after publication of Article 7 Guide for OP tracks"@en ;
    :rinfIndex "1.1.1.3.2.10",
        "1.2.1.1.1.10" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsMVersion>,
        <http://data.europa.eu/949/shapes/EtcsMVersionApplicability>,
        <http://data.europa.eu/949/shapes/EtcsMVersionSKOS> ;
    :usedInRCCCalculations true ;
    dcterms:created "2021-08-08"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation :etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "ETCS M_version according to the specification referenced in Appendix A-1, index [C], SRS 7.5.1.9."@en ;
    rdfs:domain :ETCS ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
    rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "See: TSI CCS (Subset-026, Chapter 7, 7.5.1.79 M_VERSION)"@en .

:etcsTransmittedTrackConditions a owl:ObjectProperty ;
    rdfs:label "Track conditions which can be transmitted"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "Mandatory when ETCS is present (a value is provided on 1.1.1.3.2.1) and value of 1.1.1.3.2.12 is True."@en ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-transmitted-tcs/TransmittedTrackConditions> ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.3.2.12.1",
        "1.2.1.1.1.12.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsTransmittedTrackConditions>,
        <http://data.europa.eu/949/shapes/EtcsTransmittedTrackConditionsApplicability>,
        <http://data.europa.eu/949/shapes/EtcsTransmittedTrackConditionsSKOS> ;
    :tsiOPEAppendixD3Index "1.1" ;
    dcterms:created "2022-11-16"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2023-04-18"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation :etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Transmittable track conditions by the CCSSubsystem, according to the specification referenced in Appendix A-1, index [C]"@en ;
    rdfs:domain :ETCS ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
    rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemObjParameter ;
    ns1:term_status "unstable" ;
    skos:scopeNote "See: TSI CCS (Subset-026, Chapter 5, section 5.18.1.1)"@en .

:etcsLevelType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "European Train Control System (ETCS) level"@en ;
    :applicable "Y/N" ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-levels/ETCSLevels> ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.3.2.1",
        "1.2.1.1.1.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsLevelType>,
        <http://data.europa.eu/949/shapes/EtcsLevelTypeSKOS> ;
    :tsiOPEAppendixD2Index "3.2.7" ;
    dcterms:created "2021-08-07"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-08-13"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation :cantDeficiencyBasicSSP,
        :etcsBaseline,
        :etcsDegradedSituation,
        :etcsMVersion,
        :etcsSystemCompatibility,
        :etcsTransmittedTrackConditions,
        :gsmRActiveMobiles,
        :rbcID,
        :rbcPhone ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "ETCS application level related to the track side equipment."@en ;
    rdfs:domain :ETCS ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "TSI CCS (Subset-026, Chapter 2, 2.6)" ;
    rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """The different ERTMS / ETCS application levels are a way to express the possible operating relationships between track and train.

Level definitions are principally related to the track side equipment used, to the way the track side information reaches the on-board units and to which functions are processed in the track side and in the on-board equipment respectively.

If ETCS is on the trackside (one or more levels are selected), all other ETCS parameters (from 1.1.1.3.2.2 to 1.1.1.3.2.10) are applicable and mandatory to be populated with values .
If the line is only equipped with Class B, this should be reflected in Parameter 1.1.1.3.5.3, and this parameter is â€œNâ€(not applicable).

The ETCS value NTC is only relevant when the line is dual equipped with ETCS (i.e., balises are placed in the track) and Class B system, and both systems are in operation at the same time.
In those cases, this parameter should be filled relevant ETCS Level and repeated with the value NTC.

If the line is only equipped with Class B, this should be reflected in Parameter 1.1.1.3.5.3, and this parameter etcsLevelType should not be used.

See: TSI CCS (Subset-026, Chapter 2, 2.6)"""@en .

:ETCS a owl:Class ;
    rdfs:label "ETCS"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/ETCSShape> ;
    dcterms:created "2021-08-07"^^xsd:date ;
    dcterms:modified "2021-08-07"^^xsd:date ;
    rdfs:comment "TSI compliant train protection system ERTMS / ETCS application level and baseline related to the track side equipment."@en ;
    rdfs:isDefinedBy : ;
    ns1:term_status "stable" .

