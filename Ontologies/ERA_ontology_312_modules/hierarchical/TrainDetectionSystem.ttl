    dcterms:isReplacedBy :frenchTrainDetectionSystemLimitationApplicable,
        :frenchTrainDetectionSystemLimitationNumber,
        :tdsFrenchTrainDetectionSystemLimitation ;
    dcterms:modified "2022-04-05"^^xsd:date ;
    rdfs:comment "Specific for route compatibility check on French network. The reason for deprecation is because of replacement by a class, an object property and two datatype properties. The reason is that the property is composed of two values: A boolean [Y/N] and  a number N is between 1 and 8."@en ;
    rdfs:domain :TrainDetectionSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:maximumInterferenceCurrentEvaluation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Evaluation parameters if maximum interference current is not measured in the preferred bands"@en ;
    :dependencyNote """If the preferred frequency bands are not used, (mandatory) description of the parameters for evaluation of compliance.
If the preferred frequency bands are used, this parameter is optional."""@en ;
    :rinfIndex "1.1.1.3.4.2.1",
        "1.2.1.1.3.2.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumInterferenceCurrentEvaluation> ;
    :usedInRCCCalculations true ;
    dcterms:created "2024-04-18"^^xsd:date ;
    dcterms:relation :maximumInterferenceCurrent,
        :trainDetectionSystemType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Maximum interference current limits allowed for track circuits for a defined frequency band. "@en ;
    rdfs:domain :TrainDetectionSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index077_-_ERA_ERTMS_033281_v5.pdf"^^xsd:anyURI ;
    rdfs:subPropertyOf :trainDetectionSystemBasedFrequencyBandsDataParameter ;
    ns1:term_status "stable" .

:minVehicleImpedance a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Vehicle impedance"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "Mandatory only for track circuits" ;
    :formatNote "The values is an instance of era:MinVehicleImpedance class with its 2 properties.	Per voltage : input Capacitance (Cin) and Input Impedance (Zin)"@en ;
    :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        """For train detection system compliant with TSIs, 12 months after publication of Article 7 Guide.
For train detection system not TSI compliant: in relation to article 13 of TSI CCS"""@en ;
    :rinfIndex "1.1.1.3.4.2.2",
        "1.2.1.1.3.2.2" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MinVehicleImpedance>,
        <http://data.europa.eu/949/shapes/MinVehicleImpedanceApplicability> ;
    :usedInRCCCalculations true ;
    dcterms:modified "2025-02-28"^^xsd:date ;
    rdfs:comment "Impedance as defined in the specification referenced in Appendix A-1, index [D]"@en ;
    rdfs:domain :TrainDetectionSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range :MinVehicleImpedance ;
    rdfs:seeAlso "https://eur-lex.europa.eu/eli/reg_impl/2023/1695/oj"^^xsd:anyURI ;
    rdfs:subPropertyOf :trainDetectionSystemBasedFrequencyBandsObjParameter ;
    skos:scopeNote "Compatibility with track circuits. A track circuit is only able to detect rolling stock if the impedance between rails does not exceed a certain value."@en .

:tdsFrenchTrainDetectionSystemLimitation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Section with train detection limitation"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "Only applicable on running tracks in France"@en ;
    :formatNote """The value of this parameter is an instance of the era:FrenchTrainDetectionSystemLimitation class with all its properties:
 - true/false for the existence of a section with train detection limitation
 - list of values from 1 to 8 defined in the taxonomy""" ;
    :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "16 January 2020"@en ;
    :rinfIndex "1.1.1.3.7.1.4",
        "1.2.1.1.6.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TdsFrenchTrainDetectionSystemLimitation> ;
    :usedInRCCCalculations true ;
    dcterms:created "2023-04-05"^^xsd:date ;
    dcterms:modified "2025-02-18"^^xsd:date,
        "2025-03-04"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:relation :frenchTrainDetectionSystemLimitationApplicable,
        :frenchTrainDetectionSystemLimitationNumber ;
    dcterms:replaces :frenchTrainDetectionSystemLimitation ;
    rdfs:comment "Specific for route compatibility check on French network."@en ;
    rdfs:domain :TrainDetectionSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range :FrenchTrainDetectionSystemLimitation ;
    rdfs:subPropertyOf :otherTrainDetectionSystemsObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Relates the class train detection system with the class that represents the section with train detection limitation. Select the special condition as applicable through National Rule from the List.

For RINF XML data sets:
As long as the data provision through XML data sets is allowed, the data format is a character string with the following structure:
[Y/N]+[N]
where:
- [Y/N] - is the existence of section with train detection limitation
- [N] is a number from 1 to 8 referring to sections with:
    [1] Tonnage circulated per track is inferior to 15000 tons/day/track
    [2] Directional Interlocking
    [3] 45-second delay for directional interlocking
    [4] Installation with track circuit announcement
    [5] Absence of a shunting assistance pedal in the normal direction of circulation for non-reversible double track lines
    [6] Absence of a shunting assistance pedal regardless of the direction of traffic for single track lines and tracks for two way working
    [7] Absence of a pedal announcement mechanism
    [8] 45-second delay for specific announcement reset devices."""@en .

:tdsMaximumMagneticField a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Maximum magnetic field"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "Mandatory for train detection systems based on axle counters"@en ;
    :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        """For train detection system compliant with TSIs, 12 months after publication of Article 7 Guide.
For train detection system not TSI compliant: in relation to article 13 of TSI CCS"""@en ;
    :rinfIndex "1.1.1.3.4.2.3",
        "1.2.1.1.3.2.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TdsMaximumMagneticField>,
        <http://data.europa.eu/949/shapes/TdsMaximumMagneticFieldApplicability> ;
    :usedInRCCCalculations true ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation :trainDetectionSystemType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/2023-09-08> ;
    rdfs:comment """The maximum magnetic field limits allowed for axle counters (in dB ÂµA/m) for a defined frequency band.
It should be provided in 3 directions."""@en ;
    rdfs:domain :TrainDetectionSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range :MaximumMagneticField ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index077_-_ERA_ERTMS_033281_v5.pdf"^^xsd:anyURI ;
    rdfs:subPropertyOf :trainDetectionSystemBasedFrequencyBandsObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Relates the Axle Counter TrainDetectionSystem with its MaximumMagneticField in (X,Y,Z). Verification of compliance with TSI includes application of notified national rules (when they exist)."@en .

:trainDetectionSystemSpecificCheckDocument a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Document with the procedure(s) related to the type of train detection systems declared in \"Type of track circuits or axle counters to which specific checks are needed\""@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "It is applicable only when parameter \"Type of train detection system\" is applicable"@en ;
    :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "In accordance with TSI CCS Art. 13 and 12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.3.7.1.3",
        "1.2.1.1.6.2" ;
