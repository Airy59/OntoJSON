:maximumMagneticFieldDirectionX a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum magnetic field direction X"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumMagneticFieldDirectionX> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-09-19"^^xsd:date ;
    dcterms:relation :trainDetectionSystemType ;
    rdfs:comment "The maximum magnetic field limits allowed for axle counters (in dB ÂµA/m) for a defined frequency band. Direction X."@en ;
    rdfs:domain :MaximumMagneticField ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    ns1:term_status "stable" ;
    skos:scopeNote "The maximumMagneticFieldDirectionX parameter is only applicable for axle counters."@en .

