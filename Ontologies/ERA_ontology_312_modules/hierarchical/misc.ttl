        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:double ;
    rdfs:seeAlso "INF TSI: 4.2.6" ;
    rdfs:subPropertyOf :trackResistanceToAppliedLoadsDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """New lines are assumed to be compliant with the TSI INF.
For TSI compliant lines the default value of 2.5 m/s2 shall be presented.

If for the design of the track the braking forces were assumed on basis of the deceleration lower value than 2.5 m/s2, the applied value of the deceleration has to be specified."""@en .

