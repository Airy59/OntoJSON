:Bridge a owl:Class ;
    rdfs:label "Bridge"@en ;
    dcterms:modified "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    rdfs:comment "It is a structure constructed for the exclusive purpose of carrying railroad traffic across an obstruction. It can be used for defining non-stopping areas, big metal mass, resistance to traffic load etc."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :HABD,
        :KilometricPost,
        :LevelCrossing,
        :OperationalPoint,
        :PlatformEdge,
        :PrimaryLocation,
        :RadioBlockCenter,
        :RunningTrack,
        :SectionOfLine,
        :Siding,
        :Signal,
        :SpecialArea,
        :Switch,
        :Track,
        :Tunnel .

:accelerationLevelCrossing a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Acceleration allowed near level crossing"@en ;
    :XMLName "IHS_AccelerationLevelCrossing" ;
    :applicable "Y/N" ;
    :dependencyNote "Mandatory value when the level crossing is defined"@en ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.1.7.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/AccelerationLevelCrossing>,
        <http://data.europa.eu/949/shapes/AccelerationLevelCrossingApplicability> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-11-20"^^xsd:date ;
    rdfs:comment "Existence of limit for acceleration of train if stopping or recovering speed close to a level crossing expressed in a specific reference acceleration curve."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Track ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Track ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Track ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Track ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :Track ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range :Document ;
    rdfs:subPropertyOf :healthSafetyAndEnvironmentObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .

:additionalBrakingInformationDocument a owl:ObjectProperty ;
    rdfs:label "Documents available by the IM relating to braking performance"@en ;
    :XMLName "CBP_BrakePerfDocRef" ;
    :applicable "Y/N" ;
    :dependencyNote "Only applicable when for parameter 1.1.1.3.11.2 True is selected"@en ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.3.11.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/AdditionalBrakingInformationDocument>,
        <http://data.europa.eu/949/shapes/AdditionalBrakingInformationDocumentApplicability> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-23"^^xsd:date ;
    rdfs:comment "Electronic document available in two EU languages from the IM stored by the Agency providing additional information as defined in point (2) of point 4.2.2.6.2 of TSI OPE."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range :Document ;
    rdfs:subPropertyOf :brakeRelatedObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
    skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .

