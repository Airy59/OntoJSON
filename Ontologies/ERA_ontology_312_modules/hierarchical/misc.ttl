:etcsLevelType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "European Train Control System (ETCS) level"@en ;
    :applicable "Y/N" ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-levels/ETCSLevels> ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.3.2.1",
        "1.2.1.1.1.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsLevelType>,
        <http://data.europa.eu/949/shapes/EtcsLevelTypeSKOS> ;
    :tsiOPEAppendixD2Index "3.2.7" ;
    dcterms:created "2021-08-07"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-08-13"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation :cantDeficiencyBasicSSP,
        :etcsBaseline,
        :etcsDegradedSituation,
        :etcsMVersion,
        :etcsSystemCompatibility,
        :etcsTransmittedTrackConditions,
        :gsmRActiveMobiles,
        :rbcID,
        :rbcPhone ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "ETCS application level related to the track side equipment."@en ;
    rdfs:domain :ETCS ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "TSI CCS (Subset-026, Chapter 2, 2.6)" ;
    rdfs:subPropertyOf :tsiCompliantTrainProtectionSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """The different ERTMS / ETCS application levels are a way to express the possible operating relationships between track and train.

Level definitions are principally related to the track side equipment used, to the way the track side information reaches the on-board units and to which functions are processed in the track side and in the on-board equipment respectively.

If ETCS is on the trackside (one or more levels are selected), all other ETCS parameters (from 1.1.1.3.2.2 to 1.1.1.3.2.10) are applicable and mandatory to be populated with values .
If the line is only equipped with Class B, this should be reflected in Parameter 1.1.1.3.5.3, and this parameter is â€œNâ€(not applicable).

The ETCS value NTC is only relevant when the line is dual equipped with ETCS (i.e., balises are placed in the track) and Class B system, and both systems are in operation at the same time.
In those cases, this parameter should be filled relevant ETCS Level and repeated with the value NTC.

If the line is only equipped with Class B, this should be reflected in Parameter 1.1.1.3.5.3, and this parameter etcsLevelType should not be used.

See: TSI CCS (Subset-026, Chapter 2, 2.6)"""@en .

:OperationalPoint a owl:Class ;
    rdfs:label "Operational Point"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/OperationalPointShape> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    rdfs:comment "An operational point (OP) means any location for train service operations, where train services may begin and end or change route, and where passenger or freight services may be provided; operational point also means any location at boundaries between Member States or infrastructure managers."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :PlatformEdge,
        :PrimaryLocation,
        :RadioBlockCenter,
        :SectionOfLine,
        :Signal,
        :SpecialArea,
        :Switch,
        :Track,
        :Tunnel ;
    ns1:term_status "stable" .

:Track a owl:Class ;
    rdfs:label "Track"@en ;
    dcterms:created "2024-11-20"^^xsd:date ;
    dcterms:modified "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    rdfs:comment "A pair of rails over which rail borne vehicles can run."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :Tunnel .

:Siding a owl:Class ;
    rdfs:label "Siding"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SidingShape> ;
    dcterms:created "2021-08-10"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2024-11-20"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2020-06-16> ;
    rdfs:comment "Sidings are all those tracks where running trains in service movements ends and which are not used for operational routing of a train."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Track ;
    owl:disjointWith :Signal,
        :Switch,
        :Tunnel ;
    ns1:term_status "stable" ;
    skos:definition "Siding - Any track(s) within an operational point which is not used for operational routing of a train."@en .

:Tunnel a owl:Class ;
    rdfs:label "Tunnel"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TunnelShape> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1303/2024-01-29> ;
    rdfs:comment "A railway tunnel is an excavation or a construction around the track provided to allow the railway to pass for example higher land, buildings or water."@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :InfrastructureElement ;
    ns1:term_status "stable" ;
    skos:definition """A railway tunnel is an excavation or a construction around the track provided to allow the railway to pass for example higher land, buildings or water.

The length of a tunnel is defined as the length of the fully enclosed section, measured at rail level. A tunnel in the context of this TSI is 0.1 km or longer.
Where certain requirements apply only to longer tunnels, thresholds are mentioned in the relevant clauses."""@en .

:vehicleTypeTechnicalDataCharacteristic a owl:DatatypeProperty ;
    rdfs:label "Vehicle type technical characteristic"@en ;
    rdfs:isDefinedBy : .

:RunningTrack a owl:Class ;
    rdfs:label "Running track"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/RunningTrackShape> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2024-11-20"^^xsd:date ;
    rdfs:comment "A running track means any track used for train service movements; passing loops and meeting loops on plain line or track connections only required for train operation are not published"@en ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :Track ;
    owl:disjointWith :Siding,
        :Signal,
        :Switch,
        :Tunnel ;
    ns1:term_status "stable" ;
    skos:scopeNote "There might be more than one track within the Section of Line, so then the whole set of data for track has to be repeated for each track within the SoL."@en .

