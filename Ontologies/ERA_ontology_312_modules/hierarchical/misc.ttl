:maximumTrainDeceleration a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum train deceleration"@en ;
    :XMLName "ILR_MaxDeceleration" ;
    :applicable "Y/N" ;
    :dependencyNote "Not applicable if line is not in scope of INF TSI"@en ;
    :formatNote "N.N" ;
