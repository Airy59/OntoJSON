        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LinearPositioningSystem ;
            owl:onProperty :nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :OperationalPoint ;
            owl:onProperty :opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :InfrastructureElement ;
    owl:disjointWith :Signal,
        :SpecialArea,
        :Switch,
        :Track,
        :Tunnel ;
    ns1:term_status "stable" ;
    skos:scopeNote "Each network shall be described using as many SoLs as necessary. Each SoL   is generated and identified by OP IDs at start and at end. A SoL only belongs to one Line."@en .

:Signal a owl:Class ;
    rdfs:label "Signal"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/SignalShape> ;
    dcterms:created "2021-04-01"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2023-09-28> ;
    rdfs:comment "A railway signal is a visual display device (next to the tracks or via a DMI in the cabin) that conveys instructions or provides advance warning of instructions regarding the driver's authority to proceed."@en ;
    rdfs:isDefinedBy : ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index003_-_SUBSET-023_v400.pdf"^^xsd:anyURI ;
    rdfs:subClassOf :InfrastructureElement ;
    owl:disjointWith :SpecialArea,
        :Switch,
        :Track,
        :Tunnel ;
    ns1:term_status "stable" ;
    skos:definition "Apparatus by means of which a conventional visual or acoustic indication is given, generally concerning the movements/movement authorities of railway vehicles."@en .

:PlatformEdge a owl:Class ;
    rdfs:label "Platform edge"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PlatformEdgeShape> ;
    dcterms:created "2021-08-02"^^xsd:date ;
    dcterms:modified "2023-11-10"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    rdfs:comment "Platform for the purpose of RINF is understood as a platform edge. A platform concerns only the part of the structure neighbouring to the track (interfaced with trains)."@en ;
