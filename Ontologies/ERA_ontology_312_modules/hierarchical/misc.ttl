    rdfs:isDefinedBy : ;
    rdfs:range xsd:anyURI ;
    owl:deprecated true ;
    ns1:term_status "stable" ;
    skos:scopeNote """Not needed for internal trackside params (no use at the moment).
This parameter was intented for a former version of Appendix G, but the requirement is stil in CCS TSI 6.1.1.2. """@en .

:etcsTransmitsTrackConditions a owl:DatatypeProperty ;
