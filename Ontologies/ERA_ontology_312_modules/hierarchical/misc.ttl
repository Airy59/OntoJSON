:structureCheckLocation a owl:DatatypeProperty ;
    rdfs:label "Railway location of structures requiring specific checks"@en ;
    :XMLName "IPP_StructureCheckLoc" ;
    :applicable "Y/N" ;
    :dependencyNote "This information is to be linked with parameter 1.1.1.1.2.4.4"@en ;
    :legalDeadline "16 January 2020"@en ;
    :rinfIndex "1.1.1.1.2.4.3" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/StructureCheckLocation> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    dcterms:relation :compatibilityProcedureDocument ;
    rdfs:comment "Localisation of structures requiring specific checks"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
