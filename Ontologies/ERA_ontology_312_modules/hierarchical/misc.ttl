        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf :automatedTrainOperationObjParameter ;
    ns1:term_status "unstable" ;
    skos:scopeNote """ATO system communication system to the specification referenced in TSI CCS (4.2.4 & 4.2.19).
                           Parameter only applicable when ETCS Baseline > 4 MR1 and ATO is implemented"""@en .

