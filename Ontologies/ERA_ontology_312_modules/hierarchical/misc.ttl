:gsmRActiveMobiles a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Number of active GSM-R mobiles (EDOR) or simultaneous communication session on board for ETCS level 2 needed to perform radio block centre handovers without having an operational disruption"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "GSM-R and ETCS level 2 must be installed for this parameter to be applicable."@en ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/gsmr-number-active-mobiles/NumberActiveMobiles> ;
    :legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.3.3.2",
        "1.2.1.1.2.2" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/GsmRActiveMobiles>,
        <http://data.europa.eu/949/shapes/GsmRActiveMobilesApplicability>,
        <http://data.europa.eu/949/shapes/GsmRActiveMobilesSKOS> ;
    dcterms:created "2021-08-08"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-04-18"^^xsd:date ;
    dcterms:relation :etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Number of simultaneous communication session on board for ETCS level 2 required for a smooth running of the train. This relates to the radio block centre (RBC) handling of communication sessions. Not safety critical and no matter of interoperability."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf :tsiCompliantRadioObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """In case there is no ETCS Level 2 in the line, do this parameter must be flagged as Not Applicable.
In case there is ETCS Level 2 in the line, the minimum number of EDOR required on board would be 1.
In case ETCS baseline 3 release 2 or baseline 4 is selected, select "2" .
Please select " 1"  or "2" , taking into account that TSI compliant trains may only be fitted with 1 EDOR."""@en .

