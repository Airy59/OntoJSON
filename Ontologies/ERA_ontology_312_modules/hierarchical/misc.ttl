:trainDetectionSystem a owl:ObjectProperty ;
    rdfs:label "train detection system"@en ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrainDetectionSystem> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    rdfs:comment "Technical characteristics of the train detection systems installed in the section of line."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
