:maximumPermittedSpeed a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum permitted speed"@en ;
    :XMLName "IPP_MaxSpeed" ;
    :applicable "Y/N" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.1.2.5" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumPermittedSpeed> ;
    :tsiOPEAppendixD2Index "3.1.4" ;
    :unitOfMeasure <http://qudt.org/vocab/unit/KiloM-PER-HR> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-26"^^xsd:date ;
    rdfs:comment "Nominal maximum operational speed on the line as a result of infrastructure, energy and control, command signalling subsystem characteristics expressed in kilometres/hour."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso "INF TSI, ENE TSI, CCS TSI" ;
    rdfs:subPropertyOf :performanceDataParameter ;
    ns1:term_status "stable" ;
    skos:example """In case INF, ENE and/or CCS allow different speeds, the max permitted speed on this track of this section of line shall be the lowest one.
In case the maximum permitted speed for freight and passenger trains operation are different, the max permitted speed on this track of this section of line shall be the highest one.""" ;
    skos:scopeNote "\"Speed on the line\" shall be understood as speed on the track of the section of line in question. "@en .

