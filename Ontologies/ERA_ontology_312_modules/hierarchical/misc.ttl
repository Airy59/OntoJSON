:maximumBrakingDistance a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum braking distance requested"@en ;
    :XMLName "CBP_MaxBrakeDist" ;
    :applicable "Y/N" ;
    :formatNote "NNNNN" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.3.11.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumBrakingDistance> ;
    :unitOfMeasure <http://qudt.org/vocab/unit/M> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-06-26"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj>,
        <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "The maximum value of the braking distance [in metres] of a train shall be given for the maximum line speed."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ],
        [ a owl:Class ;
            owl:unionOf ( :CommonCharacteristicsSubset :RunningTrack ) ] ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :brakeRelatedDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """This distance corresponds to the smallest physical distance between signals of the section of line at V max, taking into account the effect of gradient, minus the value of the safety margin used by the IM.

The braking capability of a train allows it to respect this braking distance.

Note that the OPE TSI provides for an exchange of detailed information between the infrastructure manager and the railway undertaking to ensure safe operation.

See also:
- OPE TSI: 4.2.2.6
- CCS TSI: 4.2.2"""@en .

