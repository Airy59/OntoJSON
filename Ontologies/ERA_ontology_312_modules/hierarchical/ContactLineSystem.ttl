@prefix : <http://data.europa.eu/949/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:conditionalRegenerativeBrake a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Permission for regenerative braking"@en ;
    :XMLName "ECS_RegenerativeBraking" ;
    :applicable "Y/N" ;
    :dependencyNote "When `not electrified` is chosen in parameter 1.1.1.2.2.1.1, then this parameter is not applicable. "@en ;
    :inSkosConceptScheme <http://data.europa.eu/949/concepts/regenerative-braking/RegenerativeBraking> ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.2.2.4" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionalRegenerativeBrake>,
        <http://data.europa.eu/949/shapes/ConditionalRegenerativeBrakeSKOS> ;
    :tsiOPEAppendixD2Index "3.3.7" ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2023-01-20"^^xsd:date,
        "2024-09-25"^^xsd:date,
        "2024-12-10"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation :contactLineSystemType ;
    rdfs:comment "Indication whether regenerative braking is permitted, not permitted, or permitted under specific conditions."@en ;
    rdfs:domain :ContactLineSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf :trackObjParameter,
        :trackResistanceToAppliedLoadsObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """When regenerative braking is "allowed under conditions", a document must be provided under 1.1.1.2.2.4.1.

For RINF XML data sets:
As long as the data provision through XML data sets is allowed, an XML attribute called â€œSetâ€ will be used to link the value of this parameter to the parameter 1.1.1.2.2.1.1 / ECS_SystemType"""@en .

:conditionsAppliedRegenerativeBraking a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Conditions applying in regards to regenerative braking"@en ;
    :applicable "Y/N/NYA" ;
    :dependencyNote "When `not electrified` is chosen in parameter 1.1.1.2.2.1.1, then this parameter is not applicable. Mandatory when parameter 1.1.1.2.2.4 announces Conditions."@en ;
    :legalDeadline "12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.1.1.2.2.4.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionsAppliedRegenerativeBraking>,
        <http://data.europa.eu/949/shapes/ConditionsAppliedRegenerativeBrakingApplicability> ;
    :tsiOPEAppendixD2Index "3.3.7" ;
    dcterms:created "2022-11-10"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-11-04"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation :contactLineSystemType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj>,
        <http://data.europa.eu/eli/reg_impl/2019/777/2023-09-28> ;
    rdfs:comment "Name and/or reference of the document specifying the conditions applying in regards to regenerative braking."@en ;
    rdfs:domain :ContactLineSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range :Document ;
    rdfs:subPropertyOf :contactLineSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document.
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document.
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .

:conditionsChargingElectricEnergyStorage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Permitted conditions for charging electric energy storage for traction purposes at standstill"@en ;
    :applicable "Y/N" ;
    :legalDeadline "Contrary to the Regulation, the deadline is not 30 June 2024 at the latest, but 12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.2.1.0.7.2" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionsChargingElectricEnergyStorage> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    rdfs:comment "Conditions set by IMs according to a standardised document"@en ;
    rdfs:domain :ContactLineSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf :contactLineSystemDataParameter ;
    ns1:term_status "stable" .

:currentLimitationRequired a owl:DatatypeProperty ;
    rdfs:label "Current or power limitation on board required"@en ;
    :XMLName "ERS_PowerLimitOnBoard" ;
    :applicable "Y/N" ;
    :dependencyNote "When \"not electrified\" is chosen in parameter \"Type of contact line system\", then this parameter is not applicable. "@en ;
    :formatNote "Y/N" ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.2.5.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/CurrentLimitationRequired>,
        <http://data.europa.eu/949/shapes/CurrentLimitationRequiredApplicability> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-25"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    rdfs:comment "Indication of whether an on board current or power limitation function on vehicles is required."@en ;
    rdfs:domain :ContactLineSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso " LOC&PAS TSI: 4.2.8.2.4" ;
    rdfs:subPropertyOf :requirementsRollingStockDataParameter ;
    ns1:term_status "stable" .

:energySupplySystemTSICompliant a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Energy supply system TSI compliant"@en ;
    :XMLName "ECS_TSIVoltFreq" ;
    :rinfIndex "1.1.1.2.2.1.2.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/EnergySupplySystemTSICompliant> ;
    :usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-08-06"^^xsd:date,
        "2023-03-14"^^xsd:date ;
    rdfs:comment "Deprecated according to the amendment to the Regulation (EU) 2019/777. Indication if the traction supply system (nominal voltage and frequency) is fully compliant with TSI."@en ;
    rdfs:domain :ContactLineSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :contactLineSystemDataParameter ;
    owl:deprecated true ;
    ns1:term_status "stable" .

:maxTrainCurrent a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum train current"@en ;
    :XMLName "ECS_MaxTrainCurrent" ;
    :applicable "Y/N" ;
    :dependencyNote "When `not electrified` is chosen in parameter 1.1.1.2.2.1.1, then this parameter is not applicable."@en ;
    :legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    :rinfIndex "1.1.1.2.2.2" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumTrainCurrent> ;
    :tsiOPEAppendixD2Index "3.3.2" ;
    :unitOfMeasure <http://qudt.org/vocab/unit/A> ;
    dcterms:created "2021-08-06"^^xsd:date ;
    dcterms:modified "2021-08-06"^^xsd:date,
        "2024-05-16"^^xsd:date,
        "2024-09-25"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation :contactLineSystemType ;
    rdfs:comment "Indication of the maximum allowable train current expressed in amperes."@en ;
    rdfs:domain :ContactLineSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :contactLineSystemDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """For RINF XML data sets:
As long as the data provision through XML data sets is allowed, an XML attribute called â€œSetâ€ will be used to link the value of this parameter to the parameter 1.1.1.2.2.1.1 / ECS_SystemType"""@en .

:permissionChargingElectricEnergyTractionStandstill a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Permission for charging electric energy storage for traction purposes at standstill"@en ;
    :applicable "Y/N" ;
    :legalDeadline "Contrary to the Regulation, the deadline is not 30 June 2024 at the latest, but 12 months after publication of Article 7 Guide"@en ;
    :rinfIndex "1.2.1.0.7.1" ;
    :shaclShapeValidationRule <http://data.europa.eu/949/shapes/PermissionChargingElectricEnergyTractionStandstill> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    rdfs:comment "Point at which IM authorises charging of electric energy storage for traction purposes at standstill."@en ;
    rdfs:domain :ContactLineSystem ;
    rdfs:isDefinedBy : ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf :contactLineSystemDataParameter ;
